call UnitRemoveAbility(f,'B090')
loop
exitwhen IssueTargetOrderById(bj_lastCreatedUnit,$D0200,f)or l>$A
set l=l+1
endloop
endif
call GroupRemoveUnit(g,f)
endloop
call DestroyBoolExpr(b)
call KGV(g)
set g=null
set b=null
set s=null
set f=null
