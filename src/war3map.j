local integer DFO
local integer JLX
if DHO==2 then
set DDO=IMinBJ(B7V(m5,false)-1,2)
set DFO=IMinBJ(B6V(m5,false)-1,1)
set JLX=IMinBJ(B8V(m5,false)-1,1)
elseif DHO==3 then
set DDO=IMinBJ(B7V(m5,false)-1,1)
set DFO=IMinBJ(B6V(m5,false)-1,2)
set JLX=IMinBJ(B8V(m5,false)-1,1)
elseif DHO==1 then
set DDO=IMinBJ(B7V(m5,false)-1,1)
set DFO=IMinBJ(B6V(m5,false)-1,1)
set JLX=IMinBJ(B8V(m5,false)-1,2)
endif
call SetHeroAgi(p5,B7V(p5,false)+DDO+JLX+DFO,true)
call SetHeroAgi(m5,B7V(m5,false)-DDO,true)
call SetHeroStr(m5,B6V(m5,false)-DFO,true)
call SetHeroInt(m5,B8V(m5,false)-JLX,true)
call FUV(p5,"SAAgi",F0V(p5,"SAAgi")+DDO+JLX+DFO)
call FUV(m5,"SAStr",F0V(m5,"SAStr")-DFO)
call FUV(m5,"SAAgi",F0V(m5,"SAAgi")-DDO)
call FUV(m5,"SAInt",F0V(m5,"SAInt")-JLX)
call n7(K3V,"StolenAgi",DDO)
call n7(K3V,"StolenInt",JLX)
call n7(K3V,"StolenStr",DFO)
call A7(K3V,"Source",p5)
call A7(K3V,"Target",m5)
call O7(K3V,"SourceRestored",false)
call O7(K3V,"TargetRestored",false)
call TriggerRegisterTimerEvent(t,$F*JFV,false)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
