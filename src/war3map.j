function J0V takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
local integer id=DTV(t,'d')
if GetUnitAbilityLevel(u,id)==0 and GetUnitAbilityLevel(u,DTV(t,'i'))==0 then
call FPV(u,"TriggerOf"+I2S(id),null)
call G6V(u,-F_V(u,I2S(id)+"ATK"))
call G5V(u,-F_V(u,I2S(id)+"DEF"))
call G7V(u,-F_V(u,I2S(id)+"IAS"))
call G2V(u,-F_V(u,I2S(id)+"STR"))
call G3V(u,-F_V(u,I2S(id)+"AGI"))
call G4V(u,-F_V(u,I2S(id)+"INT"))
call HVV(u,-F0V(u,I2S(id)+"SPEED"))
call FSV(u,I2S(id)+"ATK",0)
call FSV(u,I2S(id)+"DEF",0)
call FSV(u,I2S(id)+"IAS",0)
call FSV(u,I2S(id)+"STR",0)
call FSV(u,I2S(id)+"AGI",0)
call FSV(u,I2S(id)+"INT",0)
call FUV(u,I2S(id)+"SPEED",0)
call HEV(u)
if GetTriggerEventId()==EVENT_UNIT_DEATH and IsUnitType(u,UNIT_TYPE_HERO)==false and id=='AA67' then
call RemoveUnit(u)
endif
call GDV()
elseif GetTriggerEventId()==EVENT_UNIT_DEATH or ITV-F0V(u,I2S(id)+"TIME")>0 or GetUnitAbilityLevel(u,id)==0 or DZV(t,'dest')or((GetUnitAbilityLevel(u,'AB36')+GetUnitAbilityLevel(u,'AB37')+GetUnitAbilityLevel(u,'AB38')>0)and F_V(u,I2S(id)+"ATK")+F_V(u,I2S(id)+"DEF")+F_V(u,I2S(id)+"IAS")+F_V(u,I2S(id)+"STR")+F_V(u,I2S(id)+"AGI")+F_V(u,I2S(id)+"INT")+F0V(u,I2S(id)+"SPEED")<0)then
call UnitRemoveAbility(u,id)
call UnitRemoveAbility(u,DTV(t,'i'))
else
if id=='AB39' then
set XWV=u
call ExecuteFunc("J1V")
endif
endif
set t=null
set u=null
endfunction
function J2V takes unit u,integer id returns nothing
local trigger t=F4V(u,"TriggerOf"+I2S(id))
if t!=null then
call DYV(t,'dest',true)
call TriggerEvaluate(t)
endif
set t=null
endfunction
function J3V takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'s')
local integer id=DTV(t,'i')
local integer J4V=DTV(t,'l')
local string fx="BuffSystem|"+I2S(id)
if GetUnitAbilityLevel(u,id)==0 and GetUnitAbilityLevel(u,J4V)==0 and(GetWidgetLife(u)>1 or IsUnitType(u,UNIT_TYPE_HERO)==false)then
call G2V(u,-DTV(t,'bstr'))
call G3V(u,-DTV(t,'bagi'))
call G4V(u,-DTV(t,'bint'))
call G6V(u,-DTV(t,'batk'))
call G5V(u,-DTV(t,'bdef'))
call G7V(u,-DTV(t,'bias'))
call HVV(u,-DWV(t,'bspd'))
call FPV(u,fx+"Trigger",null)
call HEV(u)
if id=='AA67'and IsUnitType(u,UNIT_TYPE_HERO)==false and IsUnitIllusion(u)==false and IsUnitType(u,UNIT_TYPE_DEAD)then
call ShowUnit(u,false)
endif
call GDV()
elseif GetTriggerEventId()==EVENT_UNIT_DEATH or ITV-F0V(u,fx+"Time")>=0 or(GetUnitAbilityLevel(u,'AB36')+GetUnitAbilityLevel(u,'AB37')+GetUnitAbilityLevel(u,'AB38')>0 and DZV(t,'b'))then
call UnitRemoveAbility(u,id)
call UnitRemoveAbility(u,J4V)
endif
set t=null
set u=null
endfunction
function J5V takes unit u,integer id returns real
return F0V(u,"BuffSystem|"+I2S(id)+"Time")-ITV
endfunction
function J6V takes unit u,integer id,integer J4V,real r,integer J7V,integer GOV,integer J8V,integer J9V,integer KVV,integer KEV,real KXV returns nothing
local trigger t=null
local string fx="BuffSystem|"+I2S(id)
if((GetUnitAbilityLevel(u,'AB36')+GetUnitAbilityLevel(u,'AB37')+GetUnitAbilityLevel(u,'AB38')>0)and J7V+GOV+J8V+J9V+KVV+KEV+KXV<0)or IsUnitType(u,UNIT_TYPE_DEAD)then
return
endif
set t=F4V(u,fx+"Trigger")
if t==null then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function J3V))
call DFV(t,'s',u)
call DPV(t,'i',id)
call DPV(t,'l',J4V)
call DYV(t,'b',J7V+GOV+J8V+J9V+KVV+KEV+KXV<0)
call FPV(u,fx+"Trigger",t)
call FUV(u,fx+"Time",ITV+r)
else
call FUV(u,fx+"Time",RMaxBJ(ITV+r,F0V(u,fx+"Time")))
endif
call G2V(u,J9V-DTV(t,'bstr'))
call G3V(u,KVV-DTV(t,'bagi'))
call G4V(u,KEV-DTV(t,'bint'))
call G6V(u,J7V-DTV(t,'batk'))
call G5V(u,GOV-DTV(t,'bdef'))
call G7V(u,J8V-DTV(t,'bias'))
call HVV(u,KXV-DWV(t,'bspd'))
call DPV(t,'bstr',J9V)
call DPV(t,'bagi',KVV)
call DPV(t,'bint',KEV)
call DPV(t,'batk',J7V)
call DPV(t,'bdef',GOV)
call DPV(t,'bias',J8V)
call DUV(t,'bspd',KXV)
call HEV(u)
call UnitAddAbility(u,id)
call UnitAddAbility(u,J4V)
call UnitMakeAbilityPermanent(u,true,id)
call UnitMakeAbilityPermanent(u,true,J4V)
set t=null
endfunction
function KOV takes unit u,integer i,real t returns nothing
if IVV==false then
return
endif
if GetUnitAbilityLevel(u,i)==0 then
call UnitAddAbility(u,i)
endif
call DUV(u,i,ITV+t-.05)
endfunction
function KRV takes unit u,integer i,integer l returns nothing
if ITV-DWV(u,i)>0 or GetWidgetLife(u)<1 then
call UnitRemoveAbility(u,i)
call UnitRemoveAbility(u,l)
endif
endfunction
function KIV takes integer i returns string
return GetObjectName(i)
endfunction
function KAV takes force ir,real Hk,string iR returns nothing
if(IsPlayerInForce(GetLocalPlayer(),ir))then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,Qx,Hk,iR)
endif
endfunction
function KNV takes unit u,unit f returns nothing
if u!=null and IsUnitType(u,UNIT_TYPE_DEAD)==false then
call IssueTargetOrderById(f,$D0012,u)
else
if IsUnitAlly(f,A7V[0])then
call IssueTargetOrderById(f,$D0012,lp)
else
call IssueTargetOrderById(f,$D0012,ts)
endif
endif
endfunction
function KBV takes nothing returns nothing
local unit f=DHV(GetExpiredTimer(),'f')
local unit u=HMV(f)
call KNV(u,f)
set f=null
set u=null
endfunction
function KCV takes player p,integer id returns unit
local integer l=GetPlayerId(p)
local unit f=null
local timer t=null
if LoadUnitHandle(GB,GetHandleId(p),'!Pet')==null then
set f=CreateUnit(p,id,GetUnitX(ie[l])+GetRandomInt(-300,300),GetUnitY(ie[l])+GetRandomInt(-300,300),0)
call SetUnitScale(f,.65,.65,.65)
if id=='n00M' then
call AddSpecialEffectTarget("Abilities\\Spells\\Undead\\PlagueCloud\\PlagueCloudCaster.mdl",f,"origin")
elseif id=='okod' then
call SetUnitScale(f,1,1,1)
call UnitAddAbility(f,'AB80')
endif
call HVV(f,$5F2)
call UnitAddAbility(f,'Aloc')
set t=CreateTimer()
call KNV(HMV(f),f)
call DFV(t,'f',f)
call TimerStart(t,4,true,function KBV)
call SaveUnitHandle(GB,GetHandleId(p),'!Pet',f)
set bj_lastCreatedUnit=f
set t=null
set f=null
return bj_lastCreatedUnit
endif
return null
endfunction
function KDV takes player p,integer i returns nothing
local integer l=GetPlayerId(p)
local integer k=0
local timer t=null
local unit f=null
if LoadBoolean(GB,GetHandleId(p),i)==false and l!=0 and l!=6 and l<$C and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING then
call KAV(Px,$A,R[l]+lt[l]+"|r "+GetObjectName('CJ01')+"|cffffff00"+GetObjectName(i)+"|r!")
set REV[l]=GetObjectName(i)
set k=LoadInteger(GB,GetHandleId(p),0)+1
call SaveInteger(GB,GetHandleId(p),0,k)
call SaveInteger(GB,GetHandleId(p),k,i)
call SaveBoolean(GB,GetHandleId(p),i,true)
set X_V[l]=X_V[l]+DTV(Player($D),i)
set f=LoadUnitHandle(GB,GetHandleId(p),'!Pet')
if f==null then
if i=='CJ05' then
call KCV(p,'n00M')
endif
endif
endif
endfunction
function KFV takes player p returns nothing
local integer i=GetPlayerId(p)
if REV[i]!=null and REV[i]!="" then
call SetPlayerName(p,REV[i]+lt[i]+"("+GetUnitName(ie[i])+")")
endif
endfunction
function l5 takes nothing returns nothing
local integer i=0
if qx==false and GF==false then
loop
call DisplayTimedTextToPlayer(Player(i),0,0,'x',"|c00ff0303An internal checksum has failed|r")
call DisplayTimedTextToPlayer(Player(i),0,0,'x',"|c00ff0303This might not be a serious glitch, but it is important for me to get it|r")
call DisplayTimedTextToPlayer(Player(i),0,0,'x',"|c00ff0303Please send me the replay for this game to IceFrog@gmail.com|r")
set i=i+1
exitwhen i==$C
endloop
endif
endfunction
