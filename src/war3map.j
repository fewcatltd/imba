call DestroyEffect(AddSpecialEffect("Units\\Demon\\Infernal\\InfernalBirth.mdl",x,y))
call DFV(t,'s',s)
call DPV(t,'i',i)
call DUV(t,'x',x)
call DUV(t,'y',y)
set t=null
endfunction
function U3R takes nothing returns nothing
