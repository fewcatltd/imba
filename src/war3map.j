function FUX takes unit K8V,integer FWX,integer FYX returns nothing
local integer FZX=B7V(K8V,false)
local integer F_X=B6V(K8V,false)
local real F0X=GetUnitState(K8V,UNIT_STATE_MANA)
if FWX==0 then
if F0X>=FYX and FZX>2 and LAV(K8V)==false then
call SetUnitState(K8V,UNIT_STATE_MANA,F0X-FYX)
call FPX(K8V,0,0,2)
call FPX(K8V,1,1,2)
endif
elseif FWX==1 then
if F0X>=FYX and F_X>2 and LAV(K8V)==false then
call SetUnitState(K8V,UNIT_STATE_MANA,F0X-FYX)
call FPX(K8V,1,0,2)
call FPX(K8V,0,1,2)
endif
endif
endfunction
