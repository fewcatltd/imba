else
set pl=i3(S2I(SubString(VH,0,StringLength(VH))))
endif
if((pl!=null)and(m8(pl))and(GetPlayerController(pl)==MAP_CONTROL_COMPUTER)and(IsPlayerAlly(pl,GetTriggerPlayer())))then
set UP=GetPlayerId(pl)
if((ie[UP]!=null)and(A5(ie[UP]))and(not N5(ie[UP]))and(i0(ie[UP])and(h4[UP]==null)))then
call LHO(ie[UP],false)
call TriggerSleepAction(1.)
call LYO(ie[UP],m5)
set G0[$A0+UP]=true
set h4[$90+UP]=ie[GetPlayerId(i3(JDO))]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,R[UP]+GetPlayerName(pl)+"|r is ambushing "+R[GetPlayerId(i3(JDO))]+GetPlayerName(i3(JDO)))
elseif(h4[UP]!=null)then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,R[UP]+GetPlayerName(pl)+"|r |cffffcc00is busy fighting|r")
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,R[UP]+GetPlayerName(pl)+"|r |cffffcc00cannot attack|r")
endif
endif
exitwhen kg<0
endloop
elseif(kg>=0)then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"|cffffcc00Invalid Target|r")
endif
elseif(VH=="g")then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Commands:
Type \"-o\",\"-c\" or \" c\" before any of these, you can order more than one by using \",\":
 gl<Player no> - order bot to go left
 gr<Player no> - order bot to go right
 gm<Player no> - order bot to go mid")
elseif((SubString(VH,0,2)=="gl")or(SubString(VH,0,2)=="gr")or(SubString(VH,0,2)=="gm"))then
if(SubString(VH,0,2)=="gl")then
