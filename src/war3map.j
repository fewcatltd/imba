function UK takes nothing returns nothing
local unit K8V=GetTriggerUnit()
local unit m5=GetEnumUnit()
local unit oA=null
if DZV(m5,'boss')then
set K8V=null
set m5=null
return
endif
set oA=CreateUnit(GetOwningPlayer(K8V),'e00C',GetUnitX(m5),GetUnitY(m5),270)
call UnitAddAbility(oA,'A07T')
call SetUnitAbilityLevel(oA,'A07T',GetUnitAbilityLevel(K8V,'A07U'))
call UnitApplyTimedLife(oA,'BTLF',5.)
call IssueTargetOrderById(oA,$D0103,m5)
call SetUnitPathing(oA,false)
call SetUnitInvulnerable(oA,true)
call UnitAddAbility(oA,'Aloc')
set K8V=null
set m5=null
set oA=null
endfunction
