local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local timer t=CreateTimer()
call TimerStart(t,.075,true,function JTX)
call DFV(t,'s',s)
call DPV(t,'i',i)
call DUV(t,'x',x)
call DUV(t,'y',y)
call DUV(t,'t',ITV+8.4)
call DUV(t,'d',ITV+.4)
call GQV(GetOwningPlayer(s),x,y,375+'}'*i,8.4)
set s=null
endfunction
