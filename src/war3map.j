if GetUnitAbilityLevel(K8V,'B01S')==0 then
call UnitRemoveAbility(K8V,'B01S')
call UnitRemoveAbility(K8V,'B04A')
call a7(K3V)
call KJV(t)
elseif GetUnitState(K8V,UNIT_STATE_LIFE)==GetUnitState(K8V,UNIT_STATE_MAX_LIFE)and GetUnitState(K8V,UNIT_STATE_MANA)==GetUnitState(K8V,UNIT_STATE_MAX_MANA)then
call UnitRemoveAbility(K8V,'B01S')
call UnitRemoveAbility(K8V,'B04A')
call a7(K3V)
call KJV(t)
endif
set t=null
set K8V=null
