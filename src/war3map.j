function QNV takes real PNV returns integer
if PNV>=4. then
return 19
elseif PNV>=3.75 then
return 18
elseif PNV>=3.5 then
return 17
elseif PNV>=3.25 then
return 16
elseif PNV>=3 then
return $F
elseif PNV>=2.75 then
return $E
elseif PNV>=2.5 then
return $D
elseif PNV>=2.25 then
return $C
elseif PNV>=2 then
return $B
elseif PNV>=1.8 then
return $A
elseif PNV>=1.75 then
return 9
elseif PNV>=1.65 then
return 8
elseif PNV>=1.5 then
return 7
elseif PNV>=1.25 then
return 6
elseif PNV>=1.2 then
return 5
elseif PNV>=1 then
return 4
elseif PNV>=.75 then
return 3
elseif PNV>=.5 then
return 2
elseif PNV>=.25 then
return 1
endif
return 1
endfunction
function QBV takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit u=DHV(tm,'u')
local integer i=DTV(tm,'i')
call UnitRemoveAbility(u,i)
if GetUnitAbilityLevel(u,i)==0 then
call FIV()
endif
set tm=null
set u=null
endfunction
function QCV takes unit u,integer i returns nothing
local timer tm=null
call UnitRemoveAbility(u,i)
if GetUnitAbilityLevel(u,i)>0 then
set tm=CreateTimer()
call TimerStart(tm,.1,true,function QBV)
call DFV(tm,'u',u)
call DPV(tm,'i',i)
set tm=null
endif
endfunction
function StunFunc takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=DHV(t,'u')
if ITV-DWV(u,'!Stu')>0 then
call UnitRemoveAbility(u,'BPSE')
call UnitRemoveAbility(u,'B0BM')
endif
if GetUnitAbilityLevel(u,'BPSE')+GetUnitAbilityLevel(u,'B0BM')==0 then
call DUV(u,'!Stu',0)
call FIV()
endif
set t=null
set u=null
endfunction
function QDV takes unit u,real r,boolean b returns nothing
local unit f=null
local real d=0
local integer i=0
local integer l=0
if(IsUnitType(u,UNIT_TYPE_MAGIC_IMMUNE)==false or b)and GetWidgetLife(u)>.5 and(GetUnitAbilityLevel(u,'AB36')+GetUnitAbilityLevel(u,'AB37')+GetUnitAbilityLevel(u,'AB38'))==0 and GetUnitTypeId(u)!='n909'then
set f=CreateUnit(GetOwningPlayer(u),'e00E',GetUnitX(u),GetUnitY(u),0)
set i=R2I((r-.05)/.2)
set l=R2I((r-i*.2)/.05)+1
loop
exitwhen OCV[i]!=0
set i=i-1
endloop
call UnitAddAbility(f,OCV[i])
call SetUnitAbilityLevel(f,OCV[i],l)
call IssueTargetOrderById(f,$D007F,u)
call UnitApplyTimedLife(f,'BTLF',1)
set f=null
endif
endfunction
