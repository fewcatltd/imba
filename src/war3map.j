local integer i=DTV(tm,'i')
local integer l=DTV(tm,'l')
if i>$A then
set i=$A
endif
if R3V[i]!=null and i>0 then
if R3V[i]=="%%" then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F,R[p]+lt[p]+"|r"+R3V['d'+i])
else
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F,R3V[i]+R[p]+lt[p]+"|r"+R3V['d'+i])
endif
endif
call FIV()
set tm=null
endfunction
function AA39 takes nothing returns nothing
