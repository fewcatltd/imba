call D1V(u,'A03P',AddSpecialEffectTarget("SandAura2.MDX",u,"origin"))
set t=null
loop
exitwhen i==0
call G6V(u,GetRandomInt(8,$A))
call HEV(u)
set i=i-1
endloop
