function GWX takes unit GYX returns integer
local real r=GetRandomReal(0,'d')
local integer JFV=GetUnitAbilityLevel(GYX,'A088')
local boolean GZX=F5(GYX,Ac[QG])!=null
local integer G_X=0
local integer id=GetPlayerId(GetOwningPlayer(GYX))
local real i=0
set i=30+$A*JFV
set G_X=1
loop
set r=GetRandomReal(0,'d'-B8V(GYX,true)*.045)-CQV(GYX)*GetRandomReal(5,$A)
exitwhen r>i or G_X>500
set G_X=G_X+1
endloop
return G_X
if JFV==1 then
set b4[id]=b4[id]+1
if GZX then
if r<30 then
set X4[id]=X4[id]+1
set G_X=3
elseif r<60 then
set E4[id]=E4[id]+1
set G_X=2
endif
else
if r<25 then
set G_X=2
set E4[id]=E4[id]+1
endif
if H3V(GYX)then
if r<3.125 then
set G_X=5
elseif r<6.25 then
set G_X=4
elseif r<12.5 then
set G_X=3
endif
endif
endif
elseif JFV==2 then
set b4[id]=b4[id]+1
if GZX then
if r<17.5 then
set G_X=4
set A4[id]=A4[id]+1
elseif r<35 then
set G_X=3
set X4[id]=X4[id]+1
elseif r<70 then
set G_X=2
set E4[id]=E4[id]+1
endif
else
if r<20 then
set G_X=3
set X4[id]=X4[id]+1
elseif r<40 then
set G_X=2
set E4[id]=E4[id]+1
endif
if H3V(GYX)then
if r<1.25 then
set G_X=7
elseif r<2.5 then
set G_X=6
elseif r<5 then
set G_X=5
elseif r<$A then
set G_X=4
endif
endif
endif
elseif JFV==3 then
set b4[id]=b4[id]+1
if GZX then
if r<$A then
set G_X=5
set N4[id]=N4[id]+1
elseif r<20 then
set G_X=4
set A4[id]=A4[id]+1
elseif r<40 then
set G_X=3
set X4[id]=X4[id]+1
elseif r<80 then
set G_X=2
set E4[id]=E4[id]+1
endif
else
if r<12.5 then
set G_X=4
set A4[id]=A4[id]+1
elseif r<25 then
set G_X=3
set X4[id]=X4[id]+1
elseif r<50 then
set G_X=2
set E4[id]=E4[id]+1
endif
if H3V(GYX)then
if r<.25 then
set G_X=$B
elseif r<.5 then
set G_X=$A
elseif r<1 then
set G_X=9
elseif r<2 then
set G_X=8
elseif r<4 then
set G_X=7
elseif r<6.5 then
set G_X=6
elseif r<9.5 then
set G_X=5
endif
endif
endif
endif
return G_X
endfunction
function G0X takes nothing returns boolean
local unit m5=GetFilterUnit()
local unit K8V=GetTriggerUnit()
if IsUnitAlly(m5,GetOwningPlayer(K8V))and GetUnitState(m5,UNIT_STATE_LIFE)>0 and GetUnitAbilityLevel(m5,'Bblo')==0 then
if(GetOwningPlayer(m5)==A7V[0]or GetOwningPlayer(m5)==A8V[0])then
if(GetUnitTypeId(m5)=='ugho' or GetUnitTypeId(m5)=='u001' or GetUnitTypeId(m5)=='unec' or GetUnitTypeId(m5)=='u002')then
return true
endif
if(GetUnitTypeId(m5)=='esen' or GetUnitTypeId(m5)=='e00V' or GetUnitTypeId(m5)=='edry' or GetUnitTypeId(m5)=='e00W')then
return true
endif
return false
elseif IsUnitType(m5,UNIT_TYPE_HERO) then
return true
endif
endif
return false
endfunction
function G1X takes integer r returns nothing
local unit K8V=GetTriggerUnit()
local integer JFV=r
local group S8V=KHV()
local unit QJV
local unit T6V
local integer G2X=GetSpellAbilityId()
local integer T8=1
if r==2 then
call MGV(GetObjectName('n0K7'),5,GetTriggerUnit(),$FF,0,0)
elseif r==3 then
call MGV(GetObjectName('n0JT'),5,GetTriggerUnit(),$FF,0,0)
elseif r==4 then
call MGV(GetObjectName('n0K8'),5,GetTriggerUnit(),$FF,0,0)
elseif r==5 then
call MGV(GetObjectName('n0JO'),5,GetTriggerUnit(),$FF,0,0)
else
call MGV(I2S(r)+GetObjectName('n0HI'),5,GetTriggerUnit(),$FF,0,0)
endif
set r=r-1
call GroupEnumUnitsInRange(S8V,GetUnitX(K8V),GetUnitY(K8V),600,Condition(function G0X))
if K8V!=GetSpellTargetUnit()then
call GroupAddUnit(S8V,K8V)
endif
loop
exitwhen T8>JFV
set T8=T8+1
set QJV=CreateUnit(GetOwningPlayer(K8V),'e00C',GetUnitX(K8V),GetUnitY(K8V),270)
call UnitAddAbility(QJV,G2X)
call SetUnitAbilityLevel(QJV,G2X,GetUnitAbilityLevel(K8V,G2X))
call UnitApplyTimedLife(QJV,'BTLF',1.)
set T6V=GroupPickRandomUnit(S8V)
call IssueTargetOrderById(QJV,$D0085,T6V)
call SetUnitPathing(QJV,false)
call SetUnitInvulnerable(QJV,true)
call UnitAddAbility(QJV,'Aloc')
call GroupRemoveUnit(S8V,T6V)
endloop
call KGV(S8V)
endfunction
function G3X takes nothing returns boolean
local integer r
if GetUnitAbilityLevel(HMV(GetTriggerUnit()),'A088')>0 and GetUnitTypeId(GetTriggerUnit())!='e00C' and(GetSpellAbilityId()=='A083' or GetSpellAbilityId()=='A08I' or GetSpellAbilityId()=='A08G' or GetSpellAbilityId()=='A08F')then
set r=GWX(HMV(GetTriggerUnit()))
if r>1 then
call G1X(r)
endif
endif
return false
endfunction
function U9V takes nothing returns nothing
local trigger t=CreateTrigger()
