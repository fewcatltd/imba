function A2R takes nothing returns nothing
local unit u=GetSoldUnit()
local player p=GetOwningPlayer(u)
local integer DRE=KSV(u)
local real x
local real y
if AUR(GetSellingUnit(),u)then
call LYV(p,(GetObjectName(('n02G'))))
if IsUnitAlly(u,A7V[0])then
set p=A8V[0]
else
set p=A7V[0]
endif
set x=A0R(GetSellingUnit(),u)
set y=A1R(GetSellingUnit(),u)
call RTR(Oc[NIV],x,y,p,true,2)
else
call ATR(p,DOE(DRE))
if Ac[DRE]==0 then
call LYV(p,(GetObjectName(('n02H'))))
else
set x=AYR(GetSellingUnit(),u)
set y=A_R(GetSellingUnit(),u)
if DRE==NCV then
call ACR(p,u,GetSellingUnit(),DOE(DRE),x,y,2,0)
else
call ACR(p,u,GetSellingUnit(),DOE(DRE),x,y,0,0)
endif
endif
endif
call UnitAddAbility(u,'Aloc')
call ShowUnit(u,false)
call KillUnit(u)
call RemoveUnit(u)
set u=null
set p=null
endfunction
