function MQV takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit u=DHV(tm,'s')
local real a=DWV(tm,'a')
local real p=DWV(tm,'p')
local integer i=DTV(tm,'i')
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if i>0 then
call DQV(tm,'i',-1)
set x=x+Cos(a)*p
set y=y+Sin(a)*p
call MPV(u,x,y,true)
call DUV(tm,'p',p*.98)
call MMV(x,y,$96)
if i-i/6*6==0 then
call DestroyEffect(AddSpecialEffect(C4V("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl"),x,y))
endif
else
call FIV()
endif
set tm=null
set u=null
endfunction
function MSV takes unit u,real a,real d,real t returns nothing
local timer tm=null
local integer i=R2I(t/.025)
local real p=d*.02/(1-Pow(.98,i))
if(GetUnitAbilityLevel(u,'AB36')+GetUnitAbilityLevel(u,'AB37')+GetUnitAbilityLevel(u,'AB38'))>0 then
return
endif
set tm=CreateTimer()
call DFV(tm,'s',u)
call DUV(tm,'a',a)
call DUV(tm,'p',p)
call DPV(tm,'i',i)
call TimerStart(tm,.025,true,function MQV)
set tm=null
endfunction
