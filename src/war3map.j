function EIX takes integer i returns nothing
local unit u=null
local integer id=0
local real x=-7000
local real y=6875
local real a
local integer l=0
set a=bj_PI/11.*i
loop
set l=GetRandomInt(1,Wt)
set id=qt[l]
exitwhen id>0 and v[l]==false and IT[l]>0
endloop
call s8(id)
set v[l]=true
set u=CreateUnit(Player($C),IT[l],x+Cos(a)*450,y+Sin(a)*450,a*bj_RADTODEG+$B4)
call SetUnitX(u,x+Cos(a)*450)
call SetUnitY(u,y+Sin(a)*450)
call UnitAddAbility(u,'Ane2')
call UnitAddAbility(u,'Asud')
call UnitAddAbility(u,'Avul')
set u=null
endfunction
function EAX takes nothing returns nothing
local integer i=DTV(GetExpiredTimer(),'i')
if i<22 then
call EIX(i)
call DQV(GetExpiredTimer(),'i',1)
else
call FIV()
endif
endfunction
function ENX takes player p returns nothing
local integer i=1
if p==null then
return
endif
call FHV(p,"canSelect",true)
if GetLocalPlayer()==p then
call ClearTextMessages()
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F,GetObjectName('RDSS'))
endif
call LWV(p,"Sound\\Interface\\Rescue.wav")
endfunction
function EBX takes nothing returns nothing
if GetOwningPlayer(GetFilterUnit())==Player($C)then
call RemoveUnit(GetFilterUnit())
endif
endfunction
function ECX takes nothing returns nothing
local unit s=GetSellingUnit()
local unit u=GetSoldUnit()
local integer id=GetUnitTypeId(s)
local integer i=1
local player p=GetOwningPlayer(u)
local real d=0
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SELL then
if GetUnitTypeId(u)=='h06N' then
call KillUnit(u)
call RemoveUnit(u)
if F1V(p,"canSelect")==false or ie[GetPlayerId(p)]!=null then
if GetLocalPlayer()==p then
call ClearTextMessages()
endif
call DisplayTimedTextToPlayer(p,0,0,$F,GetObjectName('RDNS'))
set p=null
set s=null
set u=null
return
endif
loop
exitwhen IT[i]==id or i>Wt
set i=i+1
endloop
if i<=Wt then
call UnitRemoveAbility(s,'Asud')
call UnitRemoveAbility(s,'Ane2')
call FHV(p,"canSelect",false)
call PauseUnit(s,true)
set id=DTV(p,'rdpp')
set d=RMaxBJ(Jl[i]-.3,.5)
call SetUnitScale(s,d,d,d)
call SetUnitOwner(s,p,true)
if IsPlayerAlly(p,A7V[0])then
call SetUnitPosition(s,-7000+75*(-3+ODV),6875+'}')
call SetUnitFacing(s,270)
call CreateUnit(p,qt[i],-7000,-6850,0)
set ODV=ODV+1
else
call SetUnitPosition(s,-7000+75*(-3+OFV),6875-'}')
call SetUnitFacing(s,90)
call CreateUnit(p,qt[i],6550,6150,0)
set OFV=OFV+1
endif
endif
endif
endif
set p=null
set s=null
set u=null
endfunction
function EDX takes integer i returns player
local integer l=0
local integer x=0
if i==0 then
loop
set l=GetRandomInt(1,5)
exitwhen(ie[GetPlayerId(A7V[l])]==null and F1V(A7V[l],"HasSelected")==false and GetPlayerSlotState(A7V[l])==PLAYER_SLOT_STATE_PLAYING)or x>$3E8
set x=x+1
endloop
if x>$3E8 then
return null
endif
call FHV(A7V[l],"HasSelected",true)
else
loop
set l=GetRandomInt(1,5)
exitwhen(ie[GetPlayerId(A8V[l])]==null and F1V(A8V[l],"HasSelected")==false and GetPlayerSlotState(A8V[l])==PLAYER_SLOT_STATE_PLAYING)or x>$3E8
set x=x+1
endloop
if x>$3E8 then
return null
endif
call FHV(A8V[l],"HasSelected",true)
endif
return Player(l)
endfunction
function EFX takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer i=DTV(t,'i')
local integer p=DTV(t,'p')
local group g=null
local boolexpr b=null
local player pl=null
local player x=null
if ITV-DWV(t,'t')>0 then
if i>0 then
set i=i-1
else
set i=$F
if ICV>p then
set i=0
call ERX()
