function VLX takes nothing returns nothing
local group g=KHV()
local boolexpr b=Condition(function PGV)
local unit f=null
call GroupEnumUnitsOfPlayer(g,A7V[0],b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call G6V(f,99999)
call G5V(f,99999)
call G7V(f,99999)
call G8V(f,99999)
call HEV(f)
call GroupRemoveUnit(g,f)
endloop
call GroupEnumUnitsOfPlayer(g,A8V[0],b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call G6V(f,99999)
call G5V(f,99999)
call G7V(f,99999)
call G8V(f,99999)
call HEV(f)
call GroupRemoveUnit(g,f)
endloop
call GroupEnumUnitsOfPlayer(g,Player($C),b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call G6V(f,99999)
call G5V(f,99999)
call G7V(f,99999)
call G8V(f,99999)
call HEV(f)
call GroupRemoveUnit(g,f)
endloop
call DestroyBoolExpr(b)
call KGV(g)
if ITV>$961 then
set f=CreateUnit(Player(0),'e00E',0,0,0)
call UnitAddAbility(f,'ANeg')
endif
set g=null
set b=null
endfunction
