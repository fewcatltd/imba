endfunction
function FJE takes nothing returns nothing
local integer i=1
local unit K8V
local integer id
local real r=20
if EH>0 or AH>0 then
loop
exitwhen i>5
set id=GetPlayerId(A7V[i])
set K8V=ie[id]
if NZ[id]>0 and K8V!=null and GetUnitTypeId(K8V)>1 and GetWidgetLife(K8V)>r and FNE(K8V)then
call FBE(K8V)
endif
if CZ[id]>0 and K8V!=null and GetUnitTypeId(K8V)>1 and GetWidgetLife(K8V)>r and FNE(K8V)then
call FFE(K8V)
endif
set id=GetPlayerId(A8V[i])
set K8V=ie[id]
if NZ[id]>0 and K8V!=null and GetUnitTypeId(K8V)>1 and GetWidgetLife(K8V)>r and FNE(K8V)then
call FBE(K8V)
endif
if CZ[id]>0 and K8V!=null and GetUnitTypeId(K8V)>1 and GetWidgetLife(K8V)>r and FNE(K8V)then
call FFE(K8V)
endif
set i=i+1
endloop
endif
set K8V=null
endfunction
function FKE takes nothing returns nothing
local unit K8V=GetFilterUnit()
local integer i=0
local item OVE
local integer DRE
loop
exitwhen i>5
set OVE=UnitItemInSlot(K8V,i)
set DRE=CUV(OVE)
if(DRE==ed or DRE==od or DRE==ad)and GetItemUserData(OVE)>0 then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl",K8V,"overhead"))
call LWV(GetOwningPlayer(K8V),"Abilities\\Spells\\Human\\Heal\\HealTarget.wav")
set nL=GetItemPlayer(OVE)
call CTV(OVE)
set cj=X8E(K8V,Ac[Vd],i)
call SetItemPlayer(cj,nL,false)
call SetItemUserData(cj,1)
endif
set i=i+1
endloop
set K8V=null
set OVE=null
endfunction
