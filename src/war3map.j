set g=null
endfunction
function RGR takes nothing returns nothing
local integer pickedItemId
local itemtype RHR
local integer RJR=0
local integer RKR=0
local integer RFR
set RFR=1
loop
if(bj_stockAllowedPermanent[RFR])then
set RKR=RKR+1
if(GetRandomInt(1,RKR)==1)then
set RHR=ITEM_TYPE_PERMANENT
set RJR=RFR
endif
endif
if(bj_stockAllowedCharged[RFR])then
set RKR=RKR+1
if(GetRandomInt(1,RKR)==1)then
set RHR=ITEM_TYPE_CHARGED
set RJR=RFR
endif
endif
if(bj_stockAllowedArtifact[RFR])then
set RKR=RKR+1
if(GetRandomInt(1,RKR)==1)then
set RHR=ITEM_TYPE_ARTIFACT
set RJR=RFR
endif
endif
set RFR=RFR+1
exitwhen RFR>$A
endloop
if(RKR==0)then
set RHR=null
return
endif
call RCR(RHR,RJR)
set RHR=null
endfunction
