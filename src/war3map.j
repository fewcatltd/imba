function V1I takes integer i returns integer
local integer l=StringHash(GetPlayerName(Player(i)))
local integer x=0
local integer y=0
local integer n=$A
set x=l/$2710
set y=l-x*$2710
if x>0 then
loop
exitwhen x<n
set n=n*$A
endloop
set l=y*n+x
else
set l=y
endif
return IAbsBJ(l)
endfunction
