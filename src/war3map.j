if IVV then
set i=$41A
endif
set xL=K8V
call GroupEnumUnitsInRange(g,GetUnitX(K8V),GetUnitY(K8V),i,Condition(function jM))
set xL=GroupPickRandomUnit(g)
if xL!=null then
call To(K8V,xL)
endif
call KGV(g)
set g=null
endfunction
function TP takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit K8V=Y7(K3V,"Hero")
local integer Tq=E8(K3V,"Limit")
local integer TQ=E8(K3V,"BFLevel")
local integer Rd=E8(K3V,"Counter")
local unit Tr
if Rd>Tq then
call DestroyEffect(r8(K3V,"FX"))
call a7(K3V)
call KJV(t)
call SetPlayerAbilityAvailable(GetOwningPlayer(K8V),'A05G',true)
call SetUnitPathing(K8V,true)
call SetUnitInvulnerable(K8V,false)
call K_V(K8V,"Omnislashing")
call SetUnitVertexColor(K8V,$FF,$FF,$FF,$FF)
else
call n7(K3V,"Counter",Rd+1)
call Tp(K8V)
if xL==null then
call DestroyEffect(r8(K3V,"FX"))
call a7(K3V)
call KJV(t)
call SetPlayerAbilityAvailable(GetOwningPlayer(K8V),'A05G',true)
call SetUnitPathing(K8V,true)
call SetUnitInvulnerable(K8V,false)
call K_V(K8V,"Omnislashing")
call SetUnitVertexColor(K8V,$FF,$FF,$FF,$FF)
endif
endif
set t=null
set K8V=null
set Tr=null
return false
endfunction
function Ts takes nothing returns nothing  // jugger ulti with links
local unit K8V=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer JFV=GetUnitAbilityLevel(K8V,'A0M1')
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local integer TQ=GetUnitAbilityLevel(K8V,'A05G')
local player p=GetOwningPlayer(K8V)
local integer Tq=3
if JFV==0 then
set JFV=GetUnitAbilityLevel(K8V,'A1AX')
if JFV==1 then
set Tq=5
elseif JFV==2 then
set Tq=7
elseif JFV==3 then
set Tq=$A
endif
elseif JFV==2 then
set Tq=5
elseif JFV==3 then
set Tq=8
endif
if GetUnitAbilityLevel(m5,'B0BI')>0 then
set m5=GetTriggerUnit()
set K8V=GetSpellTargetUnit()
set p=GetOwningPlayer(K8V)
endif
if IVV then
if EMV then
set Tq=(Tq*2)-2
else
set Tq=Tq*3
endif
else
call SetPlayerAbilityAvailable(p,'A05G',false)
endif
call SetUnitVertexColor(K8V,$FF,$FF,$FF,'}')
call SetUnitPathing(K8V,false)
call SetUnitInvulnerable(K8V,true)
call KYV(K8V,"Omnislashing")
call A7(K3V,"Hero",K8V)
call A7(K3V,"Target",m5)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function TO))
set t=CreateTrigger()
set K3V=GetHandleId(t)
call A7(K3V,"Hero",K8V)
call n7(K3V,"Limit",Tq)
call n7(K3V,"BFLevel",TQ)
call n7(K3V,"Counter",2)
call b7(K3V,"FX",AddSpecialEffectTarget("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile_mini.mdl",K8V,"weapon"))
call TriggerRegisterTimerEvent(t,.4,true)
call TriggerAddCondition(t,Condition(function TP))
set K8V=null
set m5=null
set t=null
set p=null
endfunction
