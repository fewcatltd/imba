function R2R takes nothing returns nothing
local item OVE=GetEnumItem()
if GetWidgetLife(OVE)>0 and GetItemPlayer(OVE)==wh and C4==0 then
set C4=C4+1
call UnitAddItem(Wh,OVE)
endif
set OVE=null
endfunction
function R3R takes nothing returns nothing
local item OVE=GetEnumItem()
if GetWidgetLife(OVE)>0 and GetItemPlayer(OVE)==wh then
call UnitAddItem(zh,OVE)
endif
set OVE=null
endfunction
function R4R takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local unit J6E=Y7(K3V,"Courier")
local player p=v8(K3V,"p")
local real x=X8(K3V,"x")
local real y=X8(K3V,"y")
local rect r=Rect(x-300,y-300,x+300,y+300)
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call a7(K3V)
call KJV(t)
set wh=p
set Wh=p5
set zh=J6E
call EnumItemsInRect(r,Condition(function j6),function R3R)
else
if GetTriggerEvalCount(t)>9 then
call a7(K3V)
call KJV(t)
set wh=p
set Wh=p5
set zh=J6E
call EnumItemsInRect(r,Condition(function j6),function R3R)
else
set wh=p
set Wh=p5
set C4=0
call EnumItemsInRect(r,Condition(function j6),function R2R)
endif
endif
call RemoveRect(r)
set t=null
set p5=null
set J6E=null
set r=null
return false
endfunction
function R5R takes unit J6E,unit p5 returns nothing
local player p=GetOwningPlayer(p5)
local integer i
local item OVE
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local real x=GetUnitX(J6E)
local real y=GetUnitY(J6E)
local integer DRE
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.01,true)
call TriggerAddCondition(t,Condition(function R4R))
call A7(K3V,"Source",p5)
call A7(K3V,"Courier",J6E)
call D7(K3V,"p",p)
call E7(K3V,"x",x*1.)
call E7(K3V,"y",y*1.)
set i=0
loop
exitwhen i>5
set OVE=UnitItemInSlot(J6E,i)
set DRE=CUV(OVE)
if OVE!=null and GetItemPlayer(OVE)==p and LJE(OVE)==false and(DRE!=Ed and DRE!=Xd and DRE!=Od and DRE!=Ad and DRE!=bd)then
call UnitRemoveItem(J6E,OVE)
endif
set i=i+1
endloop
set t=null
set OVE=null
endfunction
function R6R takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit J6E=Y7(K3V,"Courier")
local unit p5=Y7(K3V,"Source")
local real x
local real y
local integer i
local player p=GetOwningPlayer(p5)
local item OVE
if GetTriggerEventId()==EVENT_UNIT_DEATH then
if GetTriggerUnit()==p5 then
call R1R(J6E)
endif
call a7(K3V)
call KJV(t)
elseif GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER or GetTriggerEventId()==EVENT_UNIT_ISSUED_TARGET_ORDER or GetTriggerEventId()==EVENT_UNIT_ISSUED_POINT_ORDER then
if GetIssuedOrderId()!=$D0084 and GetIssuedOrderId()!=$D007A then
call KJV(t)
endif
else
if M5(J6E,p5)<$96 then
call a7(K3V)
call KJV(t)
call R5R(J6E,p5)
call R1R(J6E)
endif
endif
set t=null
set J6E=null
set p5=null
set OVE=null
return false
endfunction
function R7R takes unit K8V returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit J6E=GetSellingUnit()
call IssueTargetOrderById(J6E,$D0012,K8V)
call TriggerRegisterUnitEvent(t,J6E,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,K8V,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,J6E,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,J6E,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(t,J6E,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerAddCondition(t,Condition(function R6R))
call A7(K3V,"Source",K8V)
call A7(K3V,"Courier",J6E)
set t=null
set J6E=null
endfunction
function R8R takes nothing returns nothing
if GetUnitTypeId(GetSoldUnit())=='h085' then
if ie[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]!=null and LAV(ie[GetPlayerId(GetOwningPlayer(GetSoldUnit()))])==false then
call R7R(ie[GetPlayerId(GetOwningPlayer(GetSoldUnit()))])
endif
call KillUnit(GetSoldUnit())
elseif SOV(GetUnitTypeId(GetSoldUnit()))then
if ie[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]!=null then
if LAV(ie[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]) and GetOwningPlayer(GetSoldUnit())==GetOwningPlayer(GetSellingUnit())then
call N3E(ie[GetPlayerId(GetOwningPlayer(GetSoldUnit()))])
call ReviveHero(ie[GetPlayerId(GetOwningPlayer(GetSoldUnit()))],GetUnitX(GetSoldUnit()),GetUnitY(GetSoldUnit()),true)
call SetUnitState(ie[GetPlayerId(GetOwningPlayer(GetSoldUnit()))],UNIT_STATE_MANA,$2710)
else
call SetPlayerState(GetOwningPlayer(GetSoldUnit()),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(GetSoldUnit()),PLAYER_STATE_RESOURCE_GOLD)+No[SIV(GetHeroLevel(ie[GetPlayerId(GetOwningPlayer(GetSellingUnit()))]))])
endif
endif
call KillUnit(GetSoldUnit())
endif
endfunction
function R9R takes player p4,unit S4,integer IVR,integer IER,integer GCX,integer GDX,integer GFX,integer IXR,integer IOR returns nothing
local item OVE
call DisableTrigger(T2)
if IER>0 then
set OVE=UnitItemInSlot(S4,0)
call CTV(OVE)
endif
if GCX>0 then
set OVE=UnitItemInSlot(S4,1)
call CTV(OVE)
endif
if GDX>0 then
set OVE=UnitItemInSlot(S4,2)
call CTV(OVE)
endif
if GFX>0 then
set OVE=UnitItemInSlot(S4,3)
call CTV(OVE)
endif
if IXR>0 then
set OVE=UnitItemInSlot(S4,4)
call CTV(OVE)
endif
if IOR>0 then
set OVE=UnitItemInSlot(S4,5)
call CTV(OVE)
endif
set OVE=UnitAddItemById(S4,Ac[IVR])
call SetItemPlayer(OVE,p4,true)
call SetItemUserData(OVE,0)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl",S4,"origin"))
call EnableTrigger(T2)
set OVE=null
endfunction
function IRR takes player p,unit S4,integer DRE returns boolean
local integer i
local integer x
local integer y
local integer array IIR
local boolean array IAR
local integer array INR
local boolean array IBR
local boolean array ICR
local integer array IDR
local player IFR
local integer IGR=1
local integer k
local player array IHR
local integer m
local item IJR
local item IKR
local item ILR
local item IMR
local item IPR
local item IQR
local player ISR
local player ITR
local player IUR
local player IWR
local player IYR
local player IZR
local integer I_R
local integer I0R
local integer I1R
local integer I3R
local integer I4R
local integer I5R
local integer I6R
local integer I7R
local integer I8R
local integer I9R
local integer AVR
local integer AER
local boolean AXR=false
local boolean AOR=true
set IJR=UnitItemInSlot(S4,0)
set IKR=UnitItemInSlot(S4,1)
set ILR=UnitItemInSlot(S4,2)
set IMR=UnitItemInSlot(S4,3)
set IPR=UnitItemInSlot(S4,4)
set IQR=UnitItemInSlot(S4,5)
set ISR=GetItemPlayer(IJR)
set ITR=GetItemPlayer(IKR)
set IUR=GetItemPlayer(ILR)
set IWR=GetItemPlayer(IMR)
set IYR=GetItemPlayer(IPR)
set IZR=GetItemPlayer(IQR)
set I_R=GetItemUserData(IJR)
set I0R=GetItemUserData(IKR)
set I1R=GetItemUserData(ILR)
set I3R=GetItemUserData(IMR)
set I4R=GetItemUserData(IPR)
set I5R=GetItemUserData(IQR)
set I6R=CUV(IJR)
set I7R=CUV(IKR)
set I8R=CUV(ILR)
set I9R=CUV(IMR)
set AVR=CUV(IPR)
set AER=CUV(IQR)
if(GetPlayerSlotState((p))==PLAYER_SLOT_STATE_LEFT)then
set IGR=5
set AXR=true
endif
set IHR[1]=p
if AXR then
set k=2
set m=1
loop
exitwhen k>IGR
if C8(p)then
if p!=A7V[m]then
set IHR[k]=A7V[m]
set k=k+1
endif
else
if p!=A8V[m]then
set IHR[k]=A8V[m]
set k=k+1
endif
endif
set m=m+1
endloop
endif
set k=1
loop
exitwhen k>IGR
set IFR=IHR[k]
set i=0
if IJR!=null and I_R==1 and(ISR==IFR or by or(GetPlayerSlotState((ISR))==PLAYER_SLOT_STATE_LEFT))then
set IIR[i+1]=I6R
else
set IIR[i+1]=0
endif
set i=1
if IKR!=null and I0R==1 and(ITR==IFR or by or(GetPlayerSlotState((ITR))==PLAYER_SLOT_STATE_LEFT))then
set IIR[i+1]=I7R
else
set IIR[i+1]=0
endif
set i=2
if ILR!=null and I1R==1 and(IUR==IFR or by or(GetPlayerSlotState((IUR))==PLAYER_SLOT_STATE_LEFT))then
set IIR[i+1]=I8R
else
set IIR[i+1]=0
endif
set i=3
if IMR!=null and I3R==1 and(IWR==IFR or by or(GetPlayerSlotState((IWR))==PLAYER_SLOT_STATE_LEFT))then
set IIR[i+1]=I9R
else
set IIR[i+1]=0
endif
set i=4
if IPR!=null and I4R==1 and(IYR==IFR or by or(GetPlayerSlotState((IYR))==PLAYER_SLOT_STATE_LEFT))then
set IIR[i+1]=AVR
else
set IIR[i+1]=0
endif
set i=5
if IQR!=null and I5R==1 and(IZR==IFR or by or(GetPlayerSlotState((IZR))==PLAYER_SLOT_STATE_LEFT))then
set IIR[i+1]=AER
else
set IIR[i+1]=0
endif
set IIR[0]=DRE
set i=1
loop
exitwhen i>(fG)
set INR[0]=AG[i]
set INR[1]=bG[i]
set INR[2]=BG[i]
set INR[3]=cG[i]
set INR[4]=CG[i]
if AOR then
set IBR[0]=true
set IBR[1]=true
set IBR[2]=true
set IBR[3]=true
set IBR[4]=true
set IBR[5]=true
set IBR[6]=true
set IAR[0]=true
set IAR[1]=true
set IAR[2]=true
set IAR[3]=true
set IAR[4]=true
set IAR[5]=true
set IAR[6]=true
set IDR[0]=0
set IDR[1]=0
set IDR[2]=0
set IDR[3]=0
set IDR[4]=0
set IDR[5]=0
set IDR[6]=0
set AOR=false
endif
set ICR[0]=false
set ICR[1]=false
set ICR[2]=false
set ICR[3]=false
set ICR[4]=false
set x=0
loop
exitwhen x==5
if INR[x]==0 then
set ICR[x]=true
else
set y=0
loop
exitwhen y==7
if IIR[y]==INR[x]and IAR[y]and IBR[x]then
set IAR[y]=false
set IBR[x]=false
set ICR[x]=true
set IDR[y]=1
set y=7
set AOR=true
else
set y=y+1
endif
endloop
endif
if ICR[x] then
set x=x+1
else
set x=5
endif
endloop
if ICR[0]and ICR[1]and ICR[2]and ICR[3]and ICR[4]then
call R9R(IFR,S4,dG[i],IDR[1],IDR[2],IDR[3],IDR[4],IDR[5],IDR[6])
set i=fG+2
else
set i=i+1
endif
endloop
set EL=IDR[0]==1
if i==(fG+2)then
set IJR=null
set IKR=null
set ILR=null
set IMR=null
set IPR=null
set IQR=null
return true
endif
set k=k+1
endloop
set IJR=null
set IKR=null
set ILR=null
set IMR=null
set IPR=null
set IQR=null
return false
endfunction
function ARR takes player p4,unit S4,integer DRE returns boolean
local boolean D7E
set EL=false
set D7E=IRR(p4,S4,DRE)
return D7E
endfunction
function AIR takes nothing returns boolean
if IsUnitAlly(GetFilterUnit(),GetOwningPlayer(xL)) and GetUnitAbilityLevel(GetFilterUnit(),'Aloc')==0 and UnitInventorySize(GetFilterUnit())>1 and GetUnitTypeId(GetFilterUnit())!='ncop' and GetPlayerAlliance(GetOwningPlayer(GetFilterUnit()),GetOwningPlayer(xL),ALLIANCE_SHARED_CONTROL)and GetOwningPlayer(xL)!=GetOwningPlayer(GetFilterUnit())and IsUnitIllusion(GetFilterUnit())==false and LAV(GetFilterUnit())==false then
if P4(GetFilterUnit()) then
set Sl=Sl+1
set oL=GetFilterUnit()
endif
