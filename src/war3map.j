function YYO takes nothing returns nothing
local integer YZO
local integer Q_O
local integer J7O
local integer Y_O=1
local location Y0O=null
local location Y1O=null
local string Y2O=""
local string Y3O=""
if(Bz<150.)then
set YZO=0
elseif(Bz<1200.)then
set YZO=GetRandomInt(1,2)
else
set YZO=GetRandomInt(1,3)
endif
if(YZO==0)then
return
elseif(YZO==1)then
set Q_O='n003'
set Y2O="Siege Golems"
elseif(YZO==2)then
set Q_O='n00E'
set Y2O="Scary Fish"
else
set Q_O='n00D'
set Y2O="Ancient Hydras"
endif
if(Bz>2400.)then
set Y_O=Y_O+1
endif
if xy then
set J7O=3
else
set J7O=GetRandomInt(2,4)
endif
if(J7O==2)then
set Y0O=Wv
set Y1O=qv
set Y3O="west"
elseif(J7O==3)then
set Y0O=Tv
set Y1O=mv
set Y3O="middle"
elseif(J7O==4)then
set Y0O=Uv
set Y1O=pv
set Y3O="east"
endif
call CreateNUnitsAtLoc(Y_O,Q_O,A7V[0],Y0O,bj_UNIT_FACING)
call G4E(bj_lastCreatedGroup,J7O)
call CreateNUnitsAtLoc(Y_O,Q_O,A8V[0],Y1O,bj_UNIT_FACING)
call G4E(bj_lastCreatedGroup,J7O)
call KAV(bj_FORCE_ALL_PLAYERS,10.,"|c000000ff"+Y2O+"|r spawned in the "+Y3O+" path!")
set Y0O=null
set Y1O=null
endfunction
function Y4O takes boolean O6,string VH,integer UP returns nothing
local integer Y5O=0
local integer Y6O=0
local boolean Y7O=false
local boolean Y8O=false
local integer O5=1
local integer i1
local player pl
loop
set pl=Jz(O5,not O6)
if((m8(pl))and(ie[GetPlayerId(pl)]!=null))then
set i1=GetUnitTypeId(ie[GetPlayerId(pl)])
if((i1=='H00K')or(i1=='HC92'))then
set Y8O=true
elseif((i1=='Naka')or(i1=='E004')or(i1=='U000')or(i1=='Ogrh')or(i1=='N01V')or(i1=='U006')or(i1=='Hamg'))then
set Y7O=true
endif
if(IsUnitType(ie[GetPlayerId(pl)],UNIT_TYPE_MELEE_ATTACKER))then
set Y5O=Y5O+1
endif
if(kp(i1))then
set Y6O=Y6O+1
endif
endif
set O5=O5+1
exitwhen O5>5
endloop
if(Y8O)then
call O7(tz,VH+"|G",true)
call O7(tz,VH+"|W",true)
elseif(Y7O)then
call O7(tz,VH+"|W",true)
endif
if((Y5O==UP)or((UP>3)and(Y5O>=3)))then
call O7(tz,VH+"|M",true)
endif
if((Y6O==UP)or((UP>3)and(Y6O>=3)))then
call O7(tz,VH+"|X",true)
endif
set pl=null
endfunction
