set s=null
endfunction
function WVR takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'s')
local unit u=DHV(tm,'u')
local real r=DWV(tm,'r')-GetUnitState(s,UNIT_STATE_MANA)
local group g=null
local boolexpr b=null
local unit f=null
local real a=0
local integer i=0
local trigger t=null
call U8R(s,r)
if r>64.5 and C7V(s,'I00Z')>0 then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,3,true)
call DFV(t,'s',s)
call TriggerAddCondition(t,Condition(function U9R))
set t=null
endif
if r>5 then
if GetUnitAbilityLevel(s,'B948')>0 then
call HGV(s,false,-r)
endif
set AUV=s
set g=CreateGroup()
set b=Condition(function PQV)
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),525,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if GetUnitAbilityLevel(f,'A09D')>0 then
call H0V(f,s,.4,"MFPB",false)
set a=r*.5*GetUnitAbilityLevel(f,'A09D')
call HPV(f,s,1,a)
call H1V(C_V(a),$FF,$FF,0,s)
endif
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
if r>90 and C7V(s,'I600')>0 and GetRandomInt(0,99)<27 and GetUnitLifePercent(u)<50 and u!=null then
call DestroyEffect(AddSpecialEffectTarget("Units\\NightElf\\Wisp\\WispExplode.mdl",u,"origin"))
if IsUnitAlly(s,GetOwningPlayer(u))then
call HGV(u,true,350)
else
call HPV(s,u,1,350)
endif
endif
if C7V(s,'I72B')>0 then
call DPV(s,'AB88',IMinBJ($9C4,DTV(s,'AB88')+R2I(r)))
call H2V("Saved:"+I2S(DTV(s,'AB88')),'d','d',$FF,s,GetOwningPlayer(s))
else
call DPV(s,'AB88',0)
endif
if GetUnitAbilityLevel(s,'AA64')>0 then
call DUV(s,'AA64',DWV(s,'AA64')+.3)
endif
set i=GetUnitAbilityLevel(s,'A07C')+GetUnitAbilityLevel(s,'A06L')
if i>0 and u!=null and IsUnitAlly(u,GetOwningPlayer(s))==false and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false then
if IVV then
if GetRandomInt(0,99)<$A+$A*i and GetUnitAbilityLevel(s,'A020')>0 then
set tm=CreateTimer()
call TimerStart(tm,.4,false,function U7R)
call DFV(tm,'s',s)
call DFV(tm,'u',u)
set tm=null
endif
endif
endif
endif
set tm=null
set s=null
set u=null
endfunction
function WER takes nothing returns nothing
local integer x=UnitCountBuffsEx(AFV,true,false,false,false,false,true,false)
local integer y=UnitCountBuffsEx(AFV,false,true,false,false,false,true,false)
local integer i=C0V(H3V(ADV))
local real d=GetUnitState(AFV,UNIT_STATE_MAX_LIFE)*(.1+(.01+.01*i)*AHV*y)+($A+$A*i)*AHV*x
call HPV(ADV,AFV,3,d)
endfunction
