function DTX takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit K8V=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real RK=Atan2(GetLocationY(l)-GetUnitY(K8V),GetLocationX(l)-GetUnitX(K8V))
local real x
local real y
local unit oA
local unit DQX
local boolean DPX=false
if GetLocationY(l)==GetUnitY(K8V)and GetLocationX(l)==GetUnitX(K8V)then
set RK=GetUnitFacing(K8V)*bj_DEGTORAD
endif
set x=GetUnitX(K8V)+$96*Cos(RK)
set y=GetUnitY(K8V)+$96*Sin(RK)
set oA=CreateUnit(GetOwningPlayer(K8V),'u00J',x,y,RK*bj_RADTODEG)
call RemoveLocation(l)
if GetUnitTypeId(K8V)!='Hblm' and GetUnitPointValue(K8V)!=500 then
set DPX=true
endif
call O7(K3V,"SpiritCast",DPX)
call A7(K3V,"Hero",K8V)
call A7(K3V,"Caster",oA)
call n7(K3V,"Count",1)
call n7(K3V,"Level",GetUnitAbilityLevel(K8V,'A085'))
call E7(K3V,"Angle",RK)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerRegisterUnitEvent(t,K8V,EVENT_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(t,Condition(function DLX))
if DPX then
set DQX=CreateUnit(GetOwningPlayer(K8V),'h06Z',GetUnitX(K8V),GetUnitY(K8V),RK*bj_RADTODEG)
call SetUnitX(DQX,GetUnitX(K8V))
call SetUnitY(DQX,GetUnitY(K8V))
call SetUnitAnimation(DQX,"spell")
call QueueUnitAnimation(DQX,"spell")
call QueueUnitAnimation(DQX,"spell")
call SetUnitVertexColor(DQX,$FF,$FF,$FF,75)
call A7(K3V,"Dummy",DQX)
set t=CreateTrigger()
set K3V=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function DSX))
call A7(K3V,"Hero",K8V)
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(K8V),'A085',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(K8V),'A121',true)
call PXV(K8V,'A121',1,6)
set t=null
set K8V=null
set oA=null
set DQX=null
set l=null
endfunction
