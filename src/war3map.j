local integer i=GetIssuedOrderId()
local group g=null
local boolexpr b=null
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call GDV()
set t=null
set u=null
return
endif
if GetOrderTargetUnit()==u and IsUnitAlly(GetTriggerUnit(),GetOwningPlayer(u))==false and GetRandomInt(0,99)<20*GetUnitAbilityLevel(u,'A00J')then
set AUV=GetTriggerUnit()
set g=CreateGroup()
