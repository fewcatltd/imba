call O7(GetHandleId(K8V),"JinadaActive",true)
call UnitAddAbility(K8V,'A1IS')
if JFV==1 then
call UnitAddAbility(K8V,'A1J4')
elseif JFV==2 then
call UnitAddAbility(K8V,'A1J3')
elseif JFV==3 then
call UnitAddAbility(K8V,'A1J5')
elseif JFV==4 then
call UnitAddAbility(K8V,'A1IU')
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(K8V),'A1J4',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(K8V),'A1J3',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(K8V),'A1J5',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(K8V),'A1IU',false)
elseif ADX==false then
call UnitRemoveAbility(K8V,'A1IS')
call UnitRemoveAbility(K8V,'A1J4')
call UnitRemoveAbility(K8V,'A1J3')
call UnitRemoveAbility(K8V,'A1J5')
call UnitRemoveAbility(K8V,'A1IU')
endif
set t=null
set K8V=null
return false
endfunction
