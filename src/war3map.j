function UNR takes nothing returns nothing
local timer tm=GetExpiredTimer()
local timer t=null
local boolexpr b=null
local integer i=DTV(tm,'Loop')
local group g=null
local unit u=null
local integer n=0
if i>0 then
call DQV(tm,'Loop',-1)
set b=Condition(function PJV)
set AUV=DHV(tm,'Sour')
set u=DHV(tm,'Targ')
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),475,b)
call GroupRemoveUnit(g,u)
call DestroyBoolExpr(b)
set b=null
set u=GroupPickRandomUnit(g)
if u==null then
call FIV()
else
call HXV(AUV,'A04W',DTV(tm,'Levl'),"thunderbolt",u)
call DFV(tm,'Targ',u)
endif
else
call FIV()
endif
set tm=null
endfunction
function UBR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'Sour')
local unit u=DHV(t,'Targ')
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local group g=null
local boolexpr b=null
local unit i=null
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamageSource()==s then
if IVV then
set g=CreateGroup()
set AUV=s
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,x,y,600,b)
call DestroyBoolExpr(b)
set b=null
call GroupRemoveUnit(g,u)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set i=CreateUnit(GetOwningPlayer(s),'e00E',x,y,0)
call UnitAddAbility(i,'AHtb')
call SetUnitAbilityLevel(i,'AHtb',DTV(t,'Levl'))
call IssueTargetOrderById(i,$D007F,u)
call UnitApplyTimedLife(i,'BTLF',1)
set i=null
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
else
set i=CreateUnit(GetOwningPlayer(s),'e00E',x,y,0)
call UnitAddAbility(i,'AHtb')
call SetUnitAbilityLevel(i,'AHtb',DTV(t,'Levl'))
call IssueTargetOrderById(i,$D007F,u)
call UnitApplyTimedLife(i,'BTLF',1)
set i=null
endif
set g=null
call GDV()
endif
else
call GDV()
endif
set t=null
set s=null
set u=null
endfunction
function A06M takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'Sour')
local real x=DWV(tm,'x')
local real y=DWV(tm,'y')
local real x1=0
local real y1=0
local real a=0
local integer n=0
loop
exitwhen n>$B
set a=bj_PI/6*n
set x1=x+Cos(a)*350
set y1=y+Sin(a)*350
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",x1,y1))
call Q_V(s,x1,y1,375,B6V(s,true),1)
set n=n+1
endloop
call FIV()
set tm=null
set s=null
endfunction
function UCR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local unit f=null
local real x=0
local real y=0
local real a=0
local real d=0
local real r=0
local integer i=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or ITV-DWV(t,'t')>0 then
loop
exitwhen i>9
call KillUnit(DHV(t,i))
set i=i+1
endloop
call GDV()
else
set a=HYV(u,s)
set d=RMinBJ(C3V(s,u)*.4,522)*.03
set x=GetUnitX(u)+Cos(a)*d
set y=GetUnitY(u)+Sin(a)*d
call SetUnitX(u,x)
call SetUnitY(u,y)
set a=HYV(s,u)
set d=C3V(s,u)
set r=d/$B
set x=GetUnitX(s)
set y=GetUnitY(s)
loop
exitwhen i>9
set f=DHV(t,i)
call SetUnitFacing(f,a*bj_RADTODEG)
call SetUnitX(f,x+Cos(a)*r*(i+1))
call SetUnitY(f,y+Sin(a)*r*(i+1))
set i=i+1
endloop
endif
set s=null
set u=null
set f=null
set t=null
endfunction
function UDR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local integer i=DTV(t,'i')
local real d='d'
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamageSource()==s then
call GDV()
if i==2 then
set d=$C8
elseif i==3 then
set d=$FA
elseif i==4 then
set d=325
endif
call HPV(s,u,1,d)
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerAddCondition(t,Condition(function UCR))
call DFV(t,'s',s)
call DFV(t,'u',u)
call DUV(t,'t',ITV+1.75+(i*.25))
set d=HYV(s,u)*bj_RADTODEG
call DFV(t,0,CreateUnit(GetOwningPlayer(s),'u00H',0,0,d))
call DFV(t,1,CreateUnit(GetOwningPlayer(s),'u00H',0,0,d))
call DFV(t,2,CreateUnit(GetOwningPlayer(s),'u00H',0,0,d))
call DFV(t,3,CreateUnit(GetOwningPlayer(s),'u00H',0,0,d))
call DFV(t,4,CreateUnit(GetOwningPlayer(s),'u00H',0,0,d))
call DFV(t,5,CreateUnit(GetOwningPlayer(s),'u00H',0,0,d))
call DFV(t,6,CreateUnit(GetOwningPlayer(s),'u00H',0,0,d))
call DFV(t,7,CreateUnit(GetOwningPlayer(s),'u00H',0,0,d))
call DFV(t,8,CreateUnit(GetOwningPlayer(s),'u00H',0,0,d))
call DFV(t,9,CreateUnit(GetOwningPlayer(s),'u00H',0,0,d))
call TriggerEvaluate(t)
endif
else
call GDV()
endif
set t=null
set s=null
set u=null
endfunction
function UFR takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit u=DHV(tm,'Sour')
local integer i=DTV(tm,'Loop')
local integer n=DTV(tm,'Levl')
local integer d=DTV(tm,'i')
local unit t=null
local real a=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if i>0 then
call DQV(tm,'Loop',-1)
set t=CreateUnit(GetOwningPlayer(u),'e00E',x,y,a-30)
call UnitAddAbility(t,d)
call SetUnitAbilityLevel(t,d,n)
call IssuePointOrderById(t,$D00FA,x+Cos((a-30)*bj_DEGTORAD)*'d',y+Sin((a-30)*bj_DEGTORAD)*'d')
call UnitApplyTimedLife(t,'BTLF',1)
set t=CreateUnit(GetOwningPlayer(u),'e00E',x,y,a+30)
call UnitAddAbility(t,d)
call SetUnitAbilityLevel(t,d,n)
call IssuePointOrderById(t,$D00FA,x+Cos((a+30)*bj_DEGTORAD)*'d',y+Sin((a+30)*bj_DEGTORAD)*'d')
call UnitApplyTimedLife(t,'BTLF',1)
set t=CreateUnit(GetOwningPlayer(u),'e00E',x,y,a)
call UnitAddAbility(t,d)
call SetUnitAbilityLevel(t,d,n)
call IssuePointOrderById(t,$D00FA,x+Cos((a)*bj_DEGTORAD)*'d',y+Sin((a)*bj_DEGTORAD)*'d')
call UnitApplyTimedLife(t,'BTLF',1)
set t=null
else
call FIV()
endif
set tm=null
set u=null
endfunction
