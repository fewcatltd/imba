function DWO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local integer R3X=GetTriggerEvalCount(t)
local unit p5=Y7(K3V,"Source")
local unit m5=Y7(K3V,"Target")
local lightning DYO=i8(K3V,"Lightning")
local integer JFV=E8(K3V,"Level")
local real t5=X8(K3V,"SourceX")
local real w5=X8(K3V,"SourceY")
local real Y5=GetUnitX(m5)
local real Z5=GetUnitY(m5)
local real DZO
local real D_O
local real X4O=X8(K3V,"LastX")
local real X5O=X8(K3V,"LastY")
local real l4
local real Y0X=v6(X4O,X5O,Y5,Z5)
local integer i='d'
local real n=3.5/.03
if H3V(p5)then
set i=$F4240
endif
call E7(K3V,"LastX",Y5)
call E7(K3V,"LastY",Z5)
if Y0X>i or R3X>n or K1V(m5) or GetTriggerEventId()==EVENT_UNIT_DEATH then
call DestroyLightning(DYO)
call a7(K3V)
call KJV(t)
else
call MoveLightning(DYO,true,t5,w5,Y5,Z5)
if v6(t5,w5,Y5,Z5)>325 then
set l4=Atan2(Z5-w5,Y5-t5)
set DZO=t5+(325)*Cos(l4)
set D_O=w5+(325)*Sin(l4)
call SetUnitX(m5,DZO)
call SetUnitY(m5,D_O)
endif
endif
set t=null
set p5=null
set m5=null
set DYO=null
return false
endfunction
