function OCI takes player p,unit s returns nothing
local integer i=0
local item it=null
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local integer r=0
local boolean X1I=false
if DZV(p,'I71M')then
call LYV(p,GetObjectName('s71m'))
else
set i=OBI()
if i=='okod'then
call KCV(p,'okod')
call KDV(p,'CJ30')
set X1I=true
elseif i=='AB81'then
call UnitAddAbility(s,'AB81')
call SetPlayerHandicapXP(p,GetPlayerHandicapXP(p)*1.5)
call KDV(p,'CJ31')
elseif i=='CJ32'then
call KDV(p,'CJ32')
elseif i=='GOLD'then
set r=GetRandomInt(400,800)
call BIE(p,r,s)
elseif i>0 then
set it=CreateItem(i,x,y)
call SetItemPlayer(it,p,false)
call UnitAddItem(s,it)
endif
if IsPlayerObserver(GetLocalPlayer())or IsPlayerAlly(p,GetLocalPlayer())then
if it!=null then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,20,GetPlayerName(p)+GetObjectName('1000')+GetItemName(it))
elseif X1I==false then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,20,GetPlayerName(p)+GetObjectName('1000')+I2S(r)+GetObjectName('1001'))
else
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,20,GetPlayerName(p)+GetObjectName('1002'))
endif
endif
set it=null
call DYV(p,'I71M',true)
endif
set it=null
endfunction
