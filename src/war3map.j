loop
set f=FirstOfGroup(g)
exitwhen f==null
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function INX))
call DFV(t,'f',f)
call DUV(t,'t',ITV+1.1+.4*i)
call DUV(t,'d',GetUnitState(f,UNIT_STATE_MANA))
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g1)
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g1=null
set g=null
set b=null
set t=null
endif
set x=GetUnitX(K8V)
set y=GetUnitY(K8V)
call RemoveLocation(l)
call SetUnitPathing(K8V,false)
call UnitAddAbility(K8V,'Aeth')
set QJV=CreateUnit(GetOwningPlayer(K8V),'h06K',GetUnitX(K8V),GetUnitY(K8V),a)
