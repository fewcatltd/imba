call HPV(LZ,GetEnumUnit(),1,mZ*(JZ*4+4)/ 'd'+H4V(LZ,1))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBoltImpact.mdl",GetEnumUnit(),"origin"))
