function KAX takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit m5=Y7(K3V,"Target")
local real RK=0
local real x=0
local real y=0
local integer JFV=E8(K3V,"Level")
local real KNX=0
local real KBX=0
local unit s=DHV(t,'s')
local unit f=DHV(t,'f')
set RK=HYV(s,m5)
set x=GetUnitX(m5)-5*Cos(RK)
set y=GetUnitY(m5)-5*Sin(RK)
set KNX=GetUnitX(s)
set KBX=GetUnitY(s)
call SetUnitX(f,KNX)
call SetUnitY(f,KBX)
set s=null
set f=null
if((KNX-x)*(KNX-x))+((KBX-y)*(KBX-y))<'d' then
set x=KNX
set y=KBX
endif
call SetUnitX(m5,x)
call SetUnitY(m5,y)
if GetTriggerEvalCount(t)==($A+$A*JFV)then
call a7(K3V)
call KJV(t)
endif
set t=null
set m5=null
return false
endfunction
function KCX takes unit p5,unit s,unit m5,unit f returns nothing
local unit oA=CreateUnit(GetOwningPlayer(p5),'u00X',GetUnitX(s),GetUnitY(s),GetUnitFacing(s))
local integer JFV=GetUnitAbilityLevel(p5,'A14R')
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
if GUV(m5)then
call KillUnit(oA)
call DestroyTrigger(t)
set p5=null
set m5=null
set t=null
set oA=null
return
endif
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerAddCondition(t,Condition(function KAX))
call A7(K3V,"Target",m5)
call E7(K3V,"Angle",Atan2(GetUnitY(m5)-GetUnitY(p5),GetUnitX(m5)-GetUnitX(p5)))
call n7(K3V,"Level",JFV)
call E7(K3V,"x",GetUnitX(p5))
call E7(K3V,"y",GetUnitY(p5))
call DFV(t,'f',oA)
call DFV(t,'s',s)
call UnitAddAbility(oA,'A14Q')
call SetUnitAbilityLevel(oA,'A14Q',JFV)
call IssueTargetOrderById(oA,$D0200,m5)
call UnitApplyTimedLife(oA,'BTLF',.5+.5*JFV)
if f!=null then
set oA=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(p5),GetUnitY(p5),GetUnitFacing(p5))
call UnitAddAbility(oA,'A14S')
call IssueTargetOrderById(oA,$D006B,f)
endif
set oA=null
set t=null
endfunction
function KDX takes group g,unit s returns unit
local unit u=null
local unit f=null
local real d=0
local real r=0
set u=FirstOfGroup(g)
set d=C3V(s,u)
call GroupRemoveUnit(g,u)
loop
set f=FirstOfGroup(g)
exitwhen f==null
set r=C3V(s,f)
if r<d then
set u=f
endif
call GroupRemoveUnit(g,f)
endloop
set bj_lastCreatedUnit=u
set u=null
set f=null
return bj_lastCreatedUnit
endfunction
function KFX takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local group g=CreateGroup()
local boolexpr b=Condition(function PKV)
local group g1=CreateGroup()
local unit f=null
set AUV=p5
call KCX(p5,p5,m5,p5)
call GroupAddUnit(g1,m5)
loop
call GroupEnumUnitsInRange(g,GetUnitX(m5),GetUnitY(m5),375,b)
call GroupRemoveGroup(g1,g)
set f=KDX(g,m5)
exitwhen f==null
call KCX(p5,m5,f,p5)
call GroupAddUnit(g1,f)
set m5=f
endloop
call DestroyGroup(g1)
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set g1=null
set b=null
set p5=null
set m5=null
endfunction
