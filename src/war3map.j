call ju(BAV(bj_mapInitialPlayableArea,Condition(function KT)),function YAO)
endif
if(JDO==1)then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"All ally AI will push at left")
elseif(JDO==2)then
