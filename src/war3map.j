function ZQO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local unit QJV=Y7(K3V,"Caster")
local group IUX=o8(K3V,"AlreadyDamaged")
local real d
local real x
local real x0=GetUnitX(p5)
local real y
local real y0=GetUnitY(p5)
local group g=KHV()
local integer R3X=GetTriggerEvalCount(t)
local integer i
call SetUnitX(QJV,GetUnitX(p5))
call SetUnitY(QJV,GetUnitY(p5))
set pw=IUX
set qw=p5
set Qw=Y7(K3V,"Nuker")
if GetTriggerEvalCount(t)>33 then
call KillUnit(QJV)
call KGV(IUX)
call a7(K3V)
call KJV(t)
else
set d=R3X*18
set i=0
loop
exitwhen i>36
set x=x0+d*Cos(360*i/ 36*bj_DEGTORAD)
set y=y0+d*Sin(360*i/ 36*bj_DEGTORAD)
set xL=p5
call GroupEnumUnitsInRange(g,x,y,$96,Condition(function P_V))
call ForGroup(g,function ZPO)
set i=i+1
endloop
endif
call KGV(g)
set t=null
set QJV=null
set IUX=null
set p5=null
set g=null
return false
endfunction
