local real x=GetUnitX(u)
local real y=GetUnitY(u)
local unit s=DHV(tm,'Sour')
local real a=HYV(u,s)
if i>0 then
call DQV(tm,'Loop',-1)
set r=CreateUnit(GetOwningPlayer(s),'e00E',x+Cos(a)*80,y+Sin(a)*80,0)
call UnitAddAbility(r,'A0G4')
call SetUnitAbilityLevel(r,'A0G4',n)
call IssueTargetOrderById(r,$D0118,u)
call UnitApplyTimedLife(r,'BTLF',5)
set r=null
else
call FIV()
endif
set tm=null
set u=null
