function HZV takes lightning l,unit u1,unit u2 returns lightning
local real h1=$80*(GetTerrainCliffLevel(GetUnitX(u1),GetUnitY(u1))-2)+GetUnitFlyHeight(u1)+30
local real h2=$80*(GetTerrainCliffLevel(GetUnitX(u2),GetUnitY(u2))-2)+GetUnitFlyHeight(u2)+30
call MoveLightningEx(l,true,GetUnitX(u1),GetUnitY(u1),h1,GetUnitX(u2),GetUnitY(u2),h2)
