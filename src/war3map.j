function DMv takes nothing returns nothing
local unit sE=GetTriggerUnit()
local unit IYE=GetEventDamageSource()
local real sf=MCV(IYE,sE)
local real sF=GetUnitFacing(sE)
local real sg
local real HSV=GetEventDamage()
local real sG
local real RK
local real i=.1
if(HSV>5)and GetUnitState(sE,UNIT_STATE_LIFE)>1 then
if((sF-sf)<(-180.))then
set sg=(sF-sf+360)
else
if((sF-sf)>180.)then
set sg=(sF-sf-360)
else
set sg=(sF-sf)
endif
endif
set RK=RAbsBJ(sg)
if RK<=70 then
set sG=GetUnitAbilityLevel(sE,'A0M3')*i*HSV
call sd(sE,HSV-sG)
call SetUnitState(sE,UNIT_STATE_LIFE,GetUnitState(sE,UNIT_STATE_LIFE)+sG)
elseif RK<=90 then
set sG=GetUnitAbilityLevel(sE,'A0M3')*i*.5*HSV
call SetUnitState(sE,UNIT_STATE_LIFE,GetUnitState(sE,UNIT_STATE_LIFE)+sG)
endif
endif
endfunction
function NVX takes unit u,integer i returns nothing
local integer array x
local integer l=0
set x[0]='AB19'
set x[1]='AB20'
set x[2]='AB21'
set x[3]='AB22'
