function UQR takes unit u,real a,integer i returns nothing
local timer tm=CreateTimer()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call DFV(tm,'Sour',u)
call DUV(tm,'x',x)
call DUV(tm,'y',y)
call DUV(tm,'a',a)
call DPV(tm,'Levl',i)
call DPV(tm,'Loop',24)
call DJV(tm,'g',CreateGroup())
call TimerStart(tm,.025,true,function UPR)
set tm=null
call TerrainDeformWave(x,y,Cos(a),Sin(a),600,$3E8,275,96,600,1)
endfunction
function USR takes nothing returns nothing
if PJV()and IsUnitType(GetFilterUnit(),UNIT_TYPE_MAGIC_IMMUNE)==false then
call QHV(null,GetFilterUnit(),1)
endif
endfunction
