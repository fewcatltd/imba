function VBR takes integer NAE,unit p5,unit m5 returns nothing
local unit QJV=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
if NAE==0 then
call UnitAddAbility(QJV,'A0TH')
call SetUnitAbilityLevel(QJV,'A0TH',1)
call IssueTargetOrderById(QJV,$D006B,m5)
elseif NAE==1 then
call UnitAddAbility(QJV,'A0TH')
call SetUnitAbilityLevel(QJV,'A0TH',1)
call IssueTargetOrderById(QJV,$D006B,m5)
elseif NAE==2 then
call UnitAddAbility(QJV,'A0TH')
call SetUnitAbilityLevel(QJV,'A0TH',2)
call IssueTargetOrderById(QJV,$D006B,m5)
elseif NAE==3 then
call UnitAddAbility(QJV,'A0TH')
call SetUnitAbilityLevel(QJV,'A0TH',3)
call IssueTargetOrderById(QJV,$D006B,m5)
elseif NAE==4 then
call UnitAddAbility(QJV,'A0TH')
call SetUnitAbilityLevel(QJV,'A0TH',4)
call IssueTargetOrderById(QJV,$D006B,m5)
elseif NAE==5 then
call UnitAddAbility(QJV,'A0TH')
call SetUnitAbilityLevel(QJV,'A0TH',5)
call IssueTargetOrderById(QJV,$D006B,m5)
endif
set QJV=null
endfunction
function VCR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local integer JFV=E8(K3V,"Level")
local integer NAE=E8(K3V,"Count")
local unit p5=Y7(K3V,"Source")
local integer Q4V=E8(K3V,"TargetIndex")
local unit m5=B8(Q4V)
local real CEX=(5.+JFV*5.)/ 100.
if H3V(p5)then
set CEX=CEX*4
endif
if GetTriggerEventId()!=EVENT_UNIT_DAMAGED then
set NAE=NAE+1
call VBR(NAE,p5,m5)
if NAE==8 then
call b8(Q4V)
call a7(K3V)
call KJV(t)
else
call n7(K3V,"Count",NAE)
endif
elseif SKV(GetEventDamage())and IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(GetEventDamageSource()))and IsUnitType(GetEventDamageSource(),UNIT_TYPE_STRUCTURE)==false then
if IsUnitType(GetEventDamageSource(),UNIT_TYPE_HERO)or GetUnitAbilityLevel(GetEventDamageSource(),'A04R')==0 then
call SetUnitState(GetEventDamageSource(),UNIT_STATE_LIFE,GetUnitState(GetEventDamageSource(),UNIT_STATE_LIFE)+GetEventDamage()*CEX)
else
call SetUnitState(ie[GetPlayerId(GetOwningPlayer(GetEventDamageSource()))],UNIT_STATE_LIFE,GetUnitState(ie[GetPlayerId(GetOwningPlayer(GetEventDamageSource()))],UNIT_STATE_LIFE)+GetEventDamage()*CEX)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",GetEventDamageSource(),"origin"))
endif
set t=null
set p5=null
set m5=null
return false
endfunction
function hackersfire takes nothing returns nothing
local unit p5=GetTriggerUnit()
local player hackp=GetTriggerPlayer()
if IsUnitVisible(p5,hackp)==false then 
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,(""))
endif
if IsUnitFogged (p5,hackp)==true then 
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,(""))
endif
set p5=null
set hackp=null
endfunction
function VDR takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
call VBR(0,p5,m5)
call n7(K3V,"Count",0)
call n7(K3V,"Level",GetUnitAbilityLevel(p5,'A194'))
call A7(K3V,"Source",p5)
call n7(K3V,"TargetIndex",c8(m5))
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function VCR))
call TriggerSleepAction(.1)
call IssueTargetOrderById(p5,$D000F,m5)
set p5=null
set m5=null
endfunction
function VFR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local integer i=DTV(t,'i')
local integer l=DTV(t,'l')
local real d=0
local real r=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or l==8 then
call GDV()
elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set s=GetEventDamageSource()
set u=GetTriggerUnit()
set d=GetEventDamage()
if IsUnitAlly(s,GetOwningPlayer(u))==false then
set r=('d'-GetUnitLifePercent(u))*.5
call DisableTrigger(t)
call HPV(s,u,5,r)
call EnableTrigger(t)
set d=d+r
endif
if IsUnitAlly(s,GetOwningPlayer(u))==false then
call HGV(s,true,d*(.2+.2*i))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",s,"origin"))
endif
else
set l=l+1
call VBR(l,s,u)
call DPV(t,'l',l)
endif
set t=null
set s=null
set u=null
endfunction
function VGR takes nothing returns nothing
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local trigger t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DAMAGED)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function VFR))
call DFV(t,'s',s)
call DFV(t,'u',u)
call DPV(t,'i',GetUnitAbilityLevel(s,'A194'))
call DPV(t,'l',0)
call VBR(0,s,u)
set s=null
set u=null
set t=null
endfunction
