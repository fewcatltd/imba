function VJX takes nothing returns nothing
local integer i=0
local integer l=0
loop
exitwhen i>$B
set l=i
loop
exitwhen l>$B
if i!=0 and i!=6 and l!=0 and l!=6 then
if IsPlayerAlly(Player(i),Player(l))then
call SetPlayerAllianceStateBJ(Player(i),Player(l),1)
call SetPlayerAllianceStateBJ(Player(l),Player(i),1)
else
call SetPlayerAllianceStateBJ(Player(i),Player(l),0)
call SetPlayerAllianceStateBJ(Player(l),Player(i),0)
endif
endif
set l=l+1
endloop
set i=i+1
endloop
endfunction
function VQX takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer i=F_V(u,"SALevel")
local real r=0
local integer l=0
local real x1=0
if GetHeroLevel(u)!=i and OBV then
set i=GetHeroLevel(u)-i
call FSV(u,"SALevel",GetHeroLevel(u))
set r=6.2*i
set l=GetRandomInt(0,2)
if l==0 then
set x1=GetRandomReal(0,r)
call FUV(u,"SABonusStr",F0V(u,"SABonusStr")+x1)
set r=r-x1
set x1=GetRandomReal(0,r)
call FUV(u,"SABonusAgi",F0V(u,"SABonusAgi")+x1)
call FUV(u,"SABonusInt",F0V(u,"SABonusInt")+r-x1)
elseif l==1 then
set x1=GetRandomReal(0,r)
call FUV(u,"SABonusAgi",F0V(u,"SABonusAgi")+x1)
set r=r-x1
set x1=GetRandomReal(0,r)
call FUV(u,"SABonusInt",F0V(u,"SABonusInt")+x1)
call FUV(u,"SABonusStr",F0V(u,"SABonusStr")+r-x1)
else
set x1=GetRandomReal(0,r)
call FUV(u,"SABonusInt",F0V(u,"SABonusInt")+x1)
set r=r-x1
set x1=GetRandomReal(0,r)
call FUV(u,"SABonusStr",F0V(u,"SABonusStr")+x1)
call FUV(u,"SABonusAgi",F0V(u,"SABonusAgi")+r-x1)
endif
call SetHeroStr(u,R2I(F0V(u,"SAStr")+F0V(u,"SABonusStr")),false)
call SetHeroAgi(u,R2I(F0V(u,"SAAgi")+F0V(u,"SABonusAgi")),false)
call SetHeroInt(u,R2I(F0V(u,"SAInt")+F0V(u,"SABonusInt")),false)
endif
set u=null
endfunction
