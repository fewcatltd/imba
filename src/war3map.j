function LSR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
local integer i=0
local integer l=DTV(t,'l')
local group g=null
local boolexpr b=null
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DestroyEffect(D2V(t,'e'))
call GDV()
elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if DZV(t,'b')==false then
set i=GetPlayerId(GetOwningPlayer(GetEventDamageSource()))
if GetEventDamage()>1 and i!=0 and i!=6 and i<$C then
call CPV(u,false)
call DestroyEffect(D2V(t,'e'))
call DYV(t,'b',true)
endif
endif
elseif GetTriggerEvalCount(t)==1 then
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DAMAGED)
call DYV(t,'b',false)
else
if DZV(t,'t')==false then
call DYV(t,'t',true)
if DZV(t,'b')==false then
call DYV(t,'b',true)
call CPV(u,false)
call DestroyEffect(D2V(t,'e'))
endif
else
set i=DTV(t,'i')
set AUV=DHV(t,'s')
set b=Condition(function PJV)
set g=KHV()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),325,b)
set u=CreateUnit(GetOwningPlayer(AUV),'h07Z',GetUnitX(u),GetUnitY(u),0)
call SetUnitTimeScale(u,2.5)
call UnitApplyTimedLife(u,'BTLF',2)
call SetUnitScale(u,.75,.75,.75)
call GDV()
loop
set u=FirstOfGroup(g)
exitwhen u==null
call QDV(u,1+C0V(i>2),false)
if l==1 or l==2 then
call HPV(AUV,u,2,40)
endif
if l==1 or l==3 then
call HPV(AUV,u,1,40)
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyBoolExpr(b)
call KGV(g)
set b=null
set g=null
endif
endif
set t=null
set u=null
endfunction
function LTR takes unit s,unit u,integer i,real r,integer l returns nothing
