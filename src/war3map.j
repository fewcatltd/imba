local integer l=GetTriggerEvalCount(t)
local group g=null
local unit f=null
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local real a=HYV(s,u)
local real d=0
local integer OCE=40
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call SetUnitTimeScale(s,1)
call SetUnitFlyHeight(s,GetUnitDefaultFlyHeight(s),0)
call UnitRemoveAbility(s,'Avul')
call SetUnitPathing(s,true)
call PauseUnit(s,false)
call GDV()
else
if l==OCE then
call SetUnitTimeScale(s,1)
call SetUnitFlyHeight(s,GetUnitDefaultFlyHeight(s),0)
call UnitRemoveAbility(s,'Avul')
call SetUnitPathing(s,true)
call PauseUnit(s,false)
call DestroyEffect(AddSpecialEffect("LightningWrath.mdx",x,y))
