function sd takes unit K8V,real HSV returns nothing
local integer K3V=GetHandleId(K8V)
local real sD=X8(K3V,"Bristleback_DamageStack")
if sD>$FA then
call E7(K3V,"Bristleback_DamageStack",0)
call sC(K8V)
else
call E7(K3V,"Bristleback_DamageStack",sD+HSV)
endif
