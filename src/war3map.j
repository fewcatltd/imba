if IsUnitType(BQO,UNIT_TYPE_HERO)==false then
call ND(p5,BQO,1,50+25*JFV+H4V(p5,1),.4)
else
call ND(p5,BQO,1,50+H4V(p5,1),.4)
endif
if BSO then
return((GetUnitX(BQO)-GetUnitX(NY))*(GetUnitX(BQO)-GetUnitX(NY))+(GetUnitY(BQO)-GetUnitY(NY))*(GetUnitY(BQO)-GetUnitY(NY)))/$F4240
endif
return((GetUnitX(BQO)-GetUnitX(NY))*(GetUnitX(BQO)-GetUnitX(NY))+(GetUnitY(BQO)-GetUnitY(NY))*(GetUnitY(BQO)-GetUnitY(NY)))/$57E40
endfunction
