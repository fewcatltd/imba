function KUX takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local integer JFV=E8(K3V,"Level")
local unit oA=Y7(K3V,"Caster")
local unit p5=Y7(K3V,"Source")
local unit KWX=Y7(K3V,"Fake")
local integer u3=E8(K3V,"Remaining")
local real hN=X8(K3V,"x")
local real ho=X8(K3V,"y")
local real u4=GetUnitX(p5)
local real u5=GetUnitY(p5)
local real RK=Atan2(ho-u5,hN-u4)
local real Il=u4+(25+25*JFV)*Cos(RK)
local real IL=u5+(25+25*JFV)*Sin(RK)
local lightning WIE=i8(K3V,"Light")
local real KYX=X8(K3V,"lx")
local real KZX=X8(K3V,"ly")
local real I5E=GetUnitState(p5,UNIT_STATE_MANA)
local real K_X=(25+25*JFV)*($A+.01*GetUnitState(p5,UNIT_STATE_MAX_MANA))/ 'd'
local group g=KHV()
local real K0X=X8(K3V,"Traveled")
if GetTriggerEventId()!=EVENT_UNIT_DEATH then
set K0X=K0X+25+25*JFV
call E7(K3V,"Traveled",K0X)
if GetTriggerEvalCount(t)>25 then
set KYX=KYX+(25+25*JFV)*Cos(RK)
set KZX=KZX+(25+25*JFV)*Sin(RK)
call E7(K3V,"lx",KYX)
call E7(K3V,"ly",KZX)
endif
call MoveLightning(WIE,true,KYX,KZX,Il,IL)
call SetUnitX(p5,Il)
call SetUnitY(p5,IL)
call SetUnitPosition(oA,Il,IL)
call SetUnitPosition(KWX,Il,IL)
set u3=u3-1
call n7(K3V,"Remaining",u3)
call SetUnitVertexColor(p5,$FF,$FF,$FF,0)
if K3V==DTV(p5,'A14O')and GetTriggerEvalCount(t)==25 then
call SetUnitInvulnerable(p5,false)
endif
endif
if u3==0 or GetUnitState(p5,UNIT_STATE_MANA)<1 or GetTriggerEventId()==EVENT_UNIT_DEATH then
if K3V==DTV(p5,'A14O')then
call SetUnitInvulnerable(p5,false)
set xL=p5
set LZ=p5
set jZ=K3V
set JZ=JFV
set mZ=K0X
call GroupEnumUnitsInRange(g,Il,IL,75+75*JFV,Condition(function P0V))
call ForGroup(g,function KTX)
call KGV(g)
endif
call DestroyLightning(WIE)
call MMV(Il,IL,75)
call DestroyEffect(r8(K3V,"FX"))
call RemoveUnit(oA)
call RemoveUnit(KWX)
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF)
call SetUnitPathing(p5,true)
call a7(K3V)
call KJV(t)
else
call MMV(Il,IL,75)
endif
set t=null
set oA=null
set p5=null
set WIE=null
set g=null
set KWX=null
return false
endfunction
function K1X takes nothing returns nothing
local unit p5=GetTriggerUnit()
local real iN=GetUnitX(p5)
local real io=GetUnitY(p5)
local unit oA
local unit KWX
local location l
local real x
local real y
local trigger t
local integer K3V
local lightning WIE
local integer JFV=GetUnitAbilityLevel(p5,'A14O')
local real I5E=GetUnitState(p5,UNIT_STATE_MANA)
local real K_X=$F+.07*GetUnitState(p5,UNIT_STATE_MAX_MANA)
call SetUnitState(p5,UNIT_STATE_MANA,RMaxBJ(I5E-K_X,0))
if GetUnitState(p5,UNIT_STATE_MANA)>$A then
set t=CreateTrigger()
set K3V=GetHandleId(t)
call DPV(p5,'A14O',K3V)
set oA=CreateUnit(GetOwningPlayer(p5),'o010',iN,io,0)
set KWX=CreateUnit(GetOwningPlayer(p5),'H07G',iN,io,0)
set WIE=AddLightning("FORK",true,iN,io,iN,io)
if GetSpellTargetUnit()==null then
set l=GetSpellTargetLoc()
set x=GetLocationX(l)
set y=GetLocationY(l)
call RemoveLocation(l)
else
set x=GetUnitX(GetSpellTargetUnit())
set y=GetUnitY(GetSpellTargetUnit())
endif
call SetUnitVertexColor(p5,$FF,$FF,$FF,0)
call SetUnitVertexColor(KWX,$FF,$FF,$FF,0)
call SetUnitPathing(p5,false)
call SetUnitPathing(oA,false)
call SetUnitInvulnerable(p5,true)
call A7(K3V,"Caster",oA)
call A7(K3V,"Source",p5)
call A7(K3V,"Fake",KWX)
call c7(K3V,"Light",WIE)
call n7(K3V,"Level",JFV)
call E7(K3V,"x",x)
call E7(K3V,"y",y)
call E7(K3V,"lx",iN)
call E7(K3V,"ly",io)
call E7(K3V,"Traveled",0)
call n7(K3V,"Remaining",MVV(R2I(SquareRoot((x-iN)*(x-iN)+(y-io)*(y-io))/(25+25*JFV)),1)) //storm req mana for fly
call b7(K3V,"FX",AddSpecialEffectTarget("effects\\Lightning_Ball_Tail_FX.mdx",KWX,"origin"))
call TriggerRegisterTimerEvent(t,.04,true)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function KUX))
endif
set p5=null
set oA=null
set KWX=null
set l=null
set t=null
set WIE=null
endfunction
