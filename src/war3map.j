function E1X takes integer x1,integer x2,integer x3,integer x4,integer x5,integer x6,integer y1,integer y2,integer y3,integer y4,integer x,integer y returns nothing
local integer i=LoadInteger(HV,IZV,0)
local integer l=0
set I_V[0]=x1
set I_V[1]=x2
set I_V[2]=x3
set I_V[3]=x4
set I_V[4]=x5
set I_V[5]=x6
set I_V[6]=y1
set I_V[7]=y2
set I_V[8]=y3
set I_V[9]=y4
set I_V[$A]=x
set I_V[$B]=y
loop
set i=i+1
exitwhen I_V[l]==0 or l>$B
call SaveInteger(HV,IZV,i,I_V[l])
call SaveInteger(HV,I_V[l],0,IZV)
call SaveInteger(HV,IZV,0,i)
set l=l+1
endloop
set l=0
loop
exitwhen l>$B
set I_V[l]=0
set l=l+1
endloop
endfunction
