endfunction
function Q_R takes unit QKR,integer Q0R returns nothing
call UnitRemoveAbility(QKR,'A559')
call UnitRemoveAbility(QKR,'A55A')
call UnitRemoveAbility(QKR,'A55B')
call UnitRemoveAbility(QKR,'A55C')
call UnitRemoveAbility(QKR,'A55D')
if Q0R>=16 then
call UnitAddAbility(QKR,'A55D')
set Q0R=Q0R-16
endif
if Q0R>=8 then
call UnitAddAbility(QKR,'A55C')
set Q0R=Q0R-8
endif
if Q0R>=4 then
call UnitAddAbility(QKR,'A55B')
set Q0R=Q0R-4
endif
if Q0R>=2 then
call UnitAddAbility(QKR,'A55A')
set Q0R=Q0R-2
endif
if Q0R>=1 then
call UnitAddAbility(QKR,'A559')
set Q0R=Q0R-1
endif
endfunction
function Q1R takes nothing returns boolean
return GetSpellAbilityId()=='A551'
endfunction
function Q2R takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit m5=Y7(GetHandleId(t),"SFluxTarget")
call UnitRemoveAbility(m5,'A55J')
call UnitRemoveAbility(m5,'A55N')
call UnitRemoveAbility(m5,'A55O')
call UnitRemoveAbility(m5,'A55P')
call UnitRemoveAbility(m5,'B55J')
call UnitRemoveAbility(m5,'B55N')
call UnitRemoveAbility(m5,'B55O')
call UnitRemoveAbility(m5,'B55P')
call KLV(t)
set t=null
set m5=null
endfunction
function Q3R takes nothing returns nothing
local unit QKR=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local real Q4R=.25*B7V(QKR,true)
local integer Q5R=E8(GetHandleId(QKR),"iSFCount")+1
local integer Q0R=E8(GetHandleId(QKR),"iSFAgility")
local integer Q6R=Q0R
local trigger t=CreateTrigger()
local integer JFV=GetUnitAbilityLevel(QKR,'A551')
if Q5R>9 then
set Q5R=0
set Q6R=L9V(5*JFV,Q0R+1)
if Q6R!=Q0R then
call Q_R(QKR,Q6R)
if m5!=QKR then
call MHV("+1 Agility",3,QKR,.023,0,$FF,0,$FF)
endif
endif
endif
call KLV(x8(GetHandleId(m5),"SFluxEndTrig"))
call UnitRemoveAbility(m5,'A55J')
call UnitRemoveAbility(m5,'A55N')
call UnitRemoveAbility(m5,'A55O')
call UnitRemoveAbility(m5,'A55P')
call UnitRemoveAbility(m5,'B55J')
call UnitRemoveAbility(m5,'B55N')
call UnitRemoveAbility(m5,'B55O')
call UnitRemoveAbility(m5,'B55P')
if JFV==1 then
call UnitAddAbility(m5,'A55J')
elseif JFV==2 then
call UnitAddAbility(m5,'A55N')
elseif JFV==3 then
call UnitAddAbility(m5,'A55O')
elseif JFV==4 then
call UnitAddAbility(m5,'A55P')
endif
call TriggerRegisterTimerEvent(t,Q4R,false)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddAction(t,function Q2R)
call A7(GetHandleId(t),"SFluxTarget",m5)
call B7(GetHandleId(m5),"SFluxEndTrig",t)
if Q5R!=0 or m5!=QKR or Q6R==Q0R then
call MHV(R2S(Q4R)+" s",3,m5,.023,0,$FF,0,$FF)
else
call MHV(R2S(Q4R)+" s
+1 Agility",3,QKR,.023,0,$FF,0,$FF)
endif
call n7(GetHandleId(QKR),"iSFCount",Q5R)
call n7(GetHandleId(QKR),"iSFAgility",Q6R)
set QKR=null
set m5=null
set t=null
endfunction
function Q7R takes nothing returns boolean
return SKV(GetEventDamage())
endfunction
function Q8R takes nothing returns nothing
local unit QKR=GetTriggerUnit()
local integer Q9R=E8(GetHandleId(QKR),"iSFHit")+1
local integer Q0R=E8(GetHandleId(QKR),"iSFAgility")
local integer Q6R=Q0R
if Q9R>=20 then
set Q9R=0
set Q6R=L9V(5*GetUnitAbilityLevel(QKR,'A551'),Q0R+1)
if Q6R!=Q0R then
call Q_R(QKR,Q6R)
call MHV("+1 Agility",3,QKR,.023,0,$FF,0,$FF)
endif
endif
call n7(GetHandleId(QKR),"iSFHit",Q9R)
call n7(GetHandleId(QKR),"iSFAgility",Q6R)
set QKR=null
endfunction
