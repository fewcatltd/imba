local real y=DWV(t,'y')
local group g=null
local boolexpr b=null
if GetUnitAbilityLevel(s,'A086')+GetUnitAbilityLevel(s,'A08E')==0 then
call DYV(s,'A08E',false)
call KillUnit(f)
call UnitRemoveAbility(s,'S00A')
call UnitRemoveAbility(s,'A08C')
call UnitRemoveAbility(s,'B02L')
call UnitRemoveAbility(s,'A116')
call UnitRemoveAbility(s,'A117')
call FIV()
elseif GetWidgetLife(s)>0 then
