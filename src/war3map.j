call LKV(qt[71],1,IT[71])
set cT[i]="Use your attack range to help gauge how far opponents need to be for Plasma Field to deal the most damage."
set CT[i]="Unstable Current will slow opponents who cast spells on you and could be useful to help prevent yourself from being killed."
set DT[i]="Static Link is powerful if you can stay within the range of opponents - getting Unstable Current can sometimes help with that."
set fT[i]="Storm Seeker strikes the target with the lowest health, so use it after creeps have died or when chasing a solitary target."
set FT[i]="Consider increasing your HP along with damage when purchasing items."
set i=i+1
