if i>20 or GetTriggerEventId()==EVENT_UNIT_DEATH then
call DestroyEffect(D2V(t,'e'))
if DZV(t,'b')then
call UnitRemoveAbility(u,'AB18')
call UnitRemoveAbility(u,'B918')
endif
call GDV()
else
set l=IMaxBJ(B6V(u,true),B7V(u,true))
set l=IMaxBJ(l,B8V(u,true))
call HPV(s,u,1,l*.35*.25)
endif
set t=null
