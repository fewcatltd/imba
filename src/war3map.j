function W2E takes nothing returns nothing
local integer p=GetPlayerId(GetTriggerPlayer())
local integer id=GetSpellAbilityId()
local real d=0
local real i=2.5
if p>$B or p==0 or p==6 or AKV==null or LoadBoolean(OV,id,0)==false then
return
endif
if GetSpellTargetUnit()==AKV then
call DSV(AKV,p,LoadReal(OV,id,1)*i)
endif
if C3V(AKV,GetTriggerUnit())<$3E8 then
call DSV(AKV,p,LoadReal(OV,id,2)*i)
endif
endfunction
function W3E takes real r returns string
if r>85 then
return"|cffffffff"
elseif r>65 then
return"|cff00ff00"
elseif r>40 then
return"|cffffff00"
elseif r>$A then
return"|cffff5050"
endif
return"|cffff0000"
endfunction
function W4E takes nothing returns nothing
local timer tm=GetExpiredTimer()
local integer i=0
local integer l=DTV(tm,'l')
local integer n=0
local multiboarditem k=null
local real r=GetUnitState(AKV,UNIT_STATE_LIFE)*'d'/GetUnitState(AKV,UNIT_STATE_MAX_LIFE)
local string s=W3E(r)+C_V(r)+"%"
if IsUnitType(AKV,UNIT_TYPE_DEAD)or AKV==null then
set s="|cffff3535Dead|r"
else
if r<1 then
set s="<|cffff00001|r%"
endif
endif
call MultiboardSetTitleText(q,"|cffff70ff"+GetUnitName(AKV)+"|r: "+s)
set i=1
loop
exitwhen i>l
set n=DTV(tm,i-1)
set k=MultiboardGetItem(q,i,1)
call MultiboardSetItemValue(k,C_V(DWV(AKV,n)))
call MultiboardReleaseItem(k)
set i=i+1
endloop
set tm=null
set k=null
endfunction
function W5E takes nothing returns nothing
local multiboarditem k=null
local integer i=0
local integer l=0
local integer n=0
local real r=0
local timer tm=CreateTimer()
local integer array p
set q=CreateMultiboard()
call MultiboardDisplay(q,false)
set r=GetUnitState(AKV,UNIT_STATE_LIFE)*'d'/GetUnitState(AKV,UNIT_STATE_MAX_LIFE)
call MultiboardSetTitleText(q,"|cffff70ff"+GetUnitName(AKV)+"|r: "+C_V(r)+"%")
set i=1
set l=1
set n=0
loop
exitwhen i>$B
if GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and i!=6 then
set p[n]=i
call DPV(tm,n,i)
set l=l+1
set n=n+1
endif
set i=i+1
endloop
call DPV(tm,'l',l)
call MultiboardSetRowCount(q,l)
call MultiboardSetColumnCount(q,2)
call MultiboardSetItemsWidth(q,.085)
call MultiboardSetItemsStyle(q,true,false)
set k=MultiboardGetItem(q,0,0)
call MultiboardSetItemValue(k,GetObjectName('ANso'))
call MultiboardReleaseItem(k)
set k=MultiboardGetItem(q,0,1)
call MultiboardSetItemValue(k,GetObjectName('ANlm'))
call MultiboardReleaseItem(k)
set i=1
loop
exitwhen i>l
set k=MultiboardGetItem(q,i,0)
call MultiboardSetItemValue(k,GetPlayerName(Player(p[i-1])))
call MultiboardReleaseItem(k)
set k=MultiboardGetItem(q,i,1)
call MultiboardSetItemValue(k,"0")
call MultiboardReleaseItem(k)
set i=i+1
endloop
call MultiboardDisplay(q,true)
call MultiboardMinimize(q,true)
call TimerStart(tm,.25,true,function W4E)
set tm=null
set k=null
endfunction
function W6E takes nothing returns nothing
set I6V=I6V+.025
endfunction
function XiwaUsed takes nothing returns nothing
local unit u=GetTriggerUnit()
if GetItemTypeId(GetManipulatedItem())=='I00Z' then
if ITV-DWV(u,'XIWA')>0 or DWV(u,'XIWA')==0 then
call DUV(u,'XIWA',ITV+30)
call ExecuteFunc("W7E")
else
call DAV(GetTriggerPlayer(),GetObjectName('DSTJ'))
endif
endif
set u=null
endfunction
function BuffOfTeam takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer i=GetPlayerId(p)
local integer l=GetSpellAbilityId()
local integer d=0
local integer s=0
call UnitRemoveAbility(u,'AA41')
if p==A7V[1]or p==A8V[1]then
if i<6 then
set i=0
set RSV=true
else
set i=6
set RTV=true
endif
set u=CreateUnit(Player(i),'ewsp',-500,-500,0)
if l=='AA42' then
set d='AA3Y'
set s='DSTG'
elseif l=='AA43' then
set d='AA3Z'
set s='DSTH'
elseif l=='AA44' then
set d='AA40'
set s='DSTI'
elseif l=='AA45' then
set d='AA4B'
set s='DSTJ'
elseif l=='AA46' then
set d='AA4C'
set s='DSTK'
elseif l=='AA47' then
set d='AA4D'
set s='DSTL'
call DYV(Player(i),'AA47',true)
elseif l=='AA48' then
set d='AA4E'
set s='DSTM'
elseif l=='AA49' then
set d='AA4F'
set s='DSTN'
endif
call UnitAddAbility(u,d)
call UnitAddAbility(u,'Aloc')
call CPV(u,true)
call SetUnitPathing(u,false)
call SetUnitScale(u,.01,.01,.01)
call ShowUnit(u,false)
call SetUnitVertexColor(u,0,0,0,0)
if IsPlayerAlly(GetLocalPlayer(),p)then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F,GetObjectName('DSTE')+GetObjectName(s))
endif
else
if GetLocalPlayer()==p then
call ClearTextMessages()
endif
call DisplayTimedTextToPlayer(p,.5,0,1,"|cffffff00"+GetObjectName('DSTC')+"|r")
endif
set u=null
set p=null
endfunction
function W8E takes nothing returns nothing
local integer id=GetItemTypeId(GetSoldItem())
local unit u=GetBuyingUnit()
local player p=GetOwningPlayer(u)
local unit s=GetSellingUnit()
local integer x=0
local integer y=0
if GetItemTypeId(GetSoldItem())=='I900' or GetItemTypeId(GetSoldItem())=='I901' or GetItemTypeId(GetSoldItem())=='I902'  or GetItemTypeId(GetSoldItem())=='I903'  or GetItemTypeId(GetSoldItem())=='I904'  or GetItemTypeId(GetSoldItem())=='I905' or GetItemTypeId(GetSoldItem())=='I906'  or GetItemTypeId(GetSoldItem())=='I907' and GetOwningPlayer(u)==GetOwningPlayer(s) then
call UnitRemoveAbility(s,'Asid')
call UnitRemoveAbility(s,'Aneu')
set p=GetOwningPlayer(s)
set u=CreateUnit(p,'ewsp',-500,-500,0)
call UnitAddAbility(u,'Aloc')
call CPV(u,true)
call SetUnitPathing(u,false)
call SetUnitScale(u,.01,.01,.01)
call ShowUnit(u,false)
call SetUnitVertexColor(u,0,0,0,0)
if id=='I900' then
set x='AA3Y'
set y='DSTG'
elseif id=='I901' then
set x='AA3Z'
set y='DSTH'
elseif id=='I902' then
set x='AA40'
set y='DSTI'
elseif id=='I903' then
set x='AA4B'
set y='DSTJ'
elseif id=='I904' then
set x='AA4C'
set y='DSTK'
elseif id=='I905' then
set x='AA4D'
set y='DSTL'
call DYV(p,'AA47',true)
elseif id=='I906' then
set x='AA4E'
set y='DSTM'
elseif id=='I907' then
set x='AA4F'
set y='DSTN'
endif
call UnitAddAbility(u,x)
call KillUnit(s)
if IsPlayerAlly(GetLocalPlayer(),p)then
call ClearTextMessages()
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F,GetPlayerName(p)+GetObjectName('DSTE')+GetObjectName(y))
endif
call GDV()
else
if GetLocalPlayer()==p then
call ClearTextMessages()
endif
call DisplayTimedTextToPlayer(p,.5,0,1,"|cffffff00"+GetObjectName('DSTC')+"|r")
endif
set u=null
set s=null
set p=null
endfunction
