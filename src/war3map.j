function ENI takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local real r=DWV(t,'r')
local real d=0
local group g=DKV(t,'g')
local group g1=null
local group g2=null
local boolexpr b=null
local unit f=null
local real a=0
local real x=0
local real y=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or IsUnitInRange(s,u,930)==false or(GetTriggerEventId()==EVENT_UNIT_SPELL_CAST and GetSpellAbilityId()=='AA5I')then
call J2V(s,'AB66')
call J2V(u,'AB66')
call J2V(u,'AB67')
call FPV(s,"TetherTarget",null)
call DestroyLightning(D0V(t,'l'))
call DestroyGroup(g)
call GDV()
elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set d=(GetEventDamage()*(0.10+(0.10*GetUnitAbilityLevel(s,'AA5I')))) //tether damage return
if d<GetUnitState(s,UNIT_STATE_MAX_LIFE)then
if GetWidgetLife(u)-d<1 then
set O9V=true
call SetWidgetLife(u,1)
call HPV(s,u,5,GetUnitState(u,UNIT_STATE_MAX_LIFE)+1)
set O9V=false
else
call SetWidgetLife(u,RMaxBJ(1,GetWidgetLife(u)-d))
endif
endif
else
if r>0 then
set d=GetWidgetLife(s)
if d>r then
call HGV(u,true,(d-r))
endif
call DUV(t,'r',d)
endif
call HZV(D0V(t,'l'),s,u)
set a=HYV(s,u)
set x=GetUnitX(s)
set y=GetUnitY(s)
set AUV=s
set g1=CreateGroup()
set g2=CreateGroup()
set b=Condition(function PJV)
set d=C3V(s,u)
set r=24
loop
set r=RMinBJ(24,d)
exitwhen r<1
set d=d-r
set x=x+Cos(a)*r
set y=y+Sin(a)*r
call GroupEnumUnitsInRange(g2,x,y,72,b)
call GroupAddGroup(g2,g1)
call GroupClear(g2)
endloop
set r=DWV(t,'t')
loop
set f=FirstOfGroup(g1)
exitwhen f==null
if IsUnitInGroup(f,g)==false and f!=u then
call GroupAddUnit(g,f)
call QHV(s,f,r)
endif
call GroupRemoveUnit(g1,f)
endloop
call DestroyGroup(g1)
call DestroyGroup(g2)
call DestroyBoolExpr(b)
set g1=null
set g2=null
set b=null
endif
set t=null
set s=null
set u=null
endfunction
function EBI takes nothing returns nothing
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local integer i=GetUnitAbilityLevel(s,'AA5I')
local trigger t=CreateTrigger()
local real a=HYV(u,s)
local real r=0
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local lightning l=AddLightning("CHIM",true,GetUnitX(s),GetUnitY(s),GetUnitX(u),GetUnitY(u))
if IsUnitInRange(s,u,900)==false then
loop
set r=GetRandomReal($96,550)
set x1=x+Cos(a)*r
set y1=y+Sin(a)*r
exitwhen IsTerrainPathable(x1,y1,PATHING_TYPE_WALKABILITY)==false
endloop
call SetUnitX(s,x1)
call SetUnitY(s,y1)
call MMV(x1,y1,300)
endif
call D_V(t,'l',HZV(l,s,u))
call DFV(t,'s',s)
call FPV(s,"TetherTarget",u)
call DFV(t,'u',u)
call DUV(t,'t',0.5*i+1)//tether stun
call DJV(t,'g',CreateGroup())
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_SPELL_CAST)
call SetLightningColor(l,130,50,240,1)
call J6V(s,'AB66','B966',$E10,0,0,0,0,0,0,GEV(s)*(.30+.05*i))
call TriggerAddCondition(t,Condition(function ENI))
if IsUnitAlly(s,GetOwningPlayer(u))then
call J6V(u,'AB66','B966',$E10,0,0,0,0,0,0,GEV(u)*(.30+.05*i))
call DUV(t,'r',GetWidgetLife(s))
else
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DAMAGED)
call DUV(t,'r',-1)
endif
set s=null
set u=null
set l=null
set t=null
endfunction
function ECI takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local real x=DWV(t,'x')
local real y=DWV(t,'y')
if GetWidgetLife(s)-GetEventDamage()<1 or GetTriggerEventId()!=EVENT_UNIT_DAMAGED then
call DestroyEffect(D2V(t,'e'))
if GetTriggerEventId()==EVENT_UNIT_DAMAGED and GetUnitAbilityLevel(s,'AB66')+GetUnitAbilityLevel(s,'AB67')>0 then
call SetWidgetLife(s,1)
call HWV(GetTriggerUnit(),.1)
if GetLocalPlayer()==GetOwningPlayer(s)then
call PanCameraToTimed(x,y,0)
endif
call SetUnitPosition(s,x,y)
else
if GetUnitAbilityLevel(s,'AA5L')+GetUnitAbilityLevel(s,'AB66')+GetUnitAbilityLevel(s,'AB67')>0 then
if GetLocalPlayer()==GetOwningPlayer(s)then
call PanCameraToTimed(x,y,0)
endif
call SetUnitPosition(s,x,y)
endif
endif
call GDV()
endif
set t=null
set s=null
endfunction
function AA5LA takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local real x1=DWV(t,'x')
local real y1=DWV(t,'y')
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local real a=0
local real d=0
local unit f=null
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DestroyEffect(D2V(t,'e'))
call GDV()
elseif ITV-DWV(t,'t')>0 then
call DestroyEffect(D2V(t,'e'))
call GDV()
set t=CreateTrigger()
