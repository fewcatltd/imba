function A02S takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'s')
local unit f=DHV(tm,'f')
local real a=DWV(tm,'a')
local integer i=DTV(tm,'i')
local integer l=DTV(tm,'l')
local real x=GetUnitX(f)
local real y=GetUnitY(f)
local group g=CreateGroup()
local boolexpr b=Condition(function PJV)
local unit u=null
local trigger t=null
set AUV=s
set x=x+Cos(a)*26.25
set y=y+Sin(a)*26.25
call SetUnitX(f,x)
call SetUnitY(f,y)
call GroupEnumUnitsInRange(g,x,y,275,b)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if GetUnitAbilityLevel(u,'AB05')==0 then
call J6V(u,'AB05','B905',3,0,0,0,0,0,0,-$F-$F*i)
call HPV(s,u,1,75*i)
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
if l==0 then
call KillUnit(f)
call FIV()
else
call DQV(tm,'l',-1)
endif
set tm=null
set s=null
set f=null
set g=null
set b=null
endfunction
function U4R takes nothing returns nothing
local real r=GetDestructableLife(GetEnumDestructable())
local real d=RMinBJ(r,RMaxBJ(AQV-RMinBJ(AQV,$A),0))
if r>1 then
if r<=d then
call KillDestructable(GetEnumDestructable())
else
call SetDestructableLife(GetEnumDestructable(),r-d)
endif
call HGV(AUV,true,d)
set AQV=AQV-d
endif
endfunction
function U5R takes nothing returns boolean
return true
endfunction
function U6R takes nothing returns nothing
