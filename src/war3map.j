function ZVR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local integer i=DTV(t,'i')
local real d=DWV(t,'d')
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DestroyEffect(D2V(t,'e'))
call GDV()
elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set d=d+GetEventDamage()
if d>300*i then
call DestroyEffect(D2V(t,'e'))
call GDV()
call DestroyEffect(AddSpecialEffect("FireNova2.mdx",GetUnitX(u),GetUnitY(u)))
call Q_V(s,GetUnitX(u),GetUnitY(u),$BE+35*i,60+75*i+H4V(s,1)*.3,1)
else
call DUV(t,'d',d)
endif
else
call DestroyEffect(D2V(t,'e'))
call GDV()
call DestroyEffect(AddSpecialEffect("FireNova2.mdx",GetUnitX(u),GetUnitY(u)))
call Q_V(s,GetUnitX(u),GetUnitY(u),$BE+35*i,(60+75*i+H4V(s,1)*.3)*.5,1)
endif
set t=null
set s=null
set u=null
endfunction
function ZER takes unit s,unit u,real d returns nothing
local trigger t=null
call HPV(s,u,5,d)
if GetUnitAbilityLevel(s,'BA53')>0 and(IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and GetWidgetLife(u)>1)and GetUnitState(s,UNIT_STATE_MANA)>=6 then
call HGV(s,false,-6)
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DAMAGED)
call TriggerRegisterTimerEvent(t,$F,false)
call TriggerAddCondition(t,Condition(function ZVR))
call DFV(t,'u',u)
call DFV(t,'s',s)
call DPV(t,'i',GetUnitAbilityLevel(s,'AA53'))
call DUV(t,'d',0)
call D1V(t,'e',AddSpecialEffectTarget("FireHands.mdx",u,"overhead"))
set t=null
endif
endfunction
function ZXR takes unit s,unit u returns nothing
local integer i=GetUnitAbilityLevel(s,'ANic')
