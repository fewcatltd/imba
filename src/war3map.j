function E5I takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local unit f=DHV(t,'f')
if GetTriggerEventId()==EVENT_UNIT_DEATH or(GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER and GetIssuedOrderId()!=852178and GetIssuedOrderId()!=852139and GetIssuedOrderId()!=852138and GetIssuedOrderId()!=$D00D1)or GetTriggerEventId()==EVENT_UNIT_ISSUED_POINT_ORDER or(GetTriggerEventId()==EVENT_UNIT_ISSUED_TARGET_ORDER and(GetIssuedOrderId()!=851983or GetOrderTarget()!=u))or IsUnitVisible(u,GetOwningPlayer(s))==false then
call UnitRemoveAbility(s,'AB36')
call UnitRemoveAbility(s,'AB37')
call UnitRemoveAbility(s,'AB38')
call UnitRemoveAbility(s,'B936')
call UnitRemoveAbility(s,'B937')
call UnitRemoveAbility(s,'B938')
call KillUnit(f)
call GDV()
else
call CDV(s,false,true,true,true,true,false,true)
call UnitRemoveAbility(s,'BPSE')
if(GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER and(GetIssuedOrderId()==852138or GetIssuedOrderId()==852177or GetIssuedOrderId()==852178or GetIssuedOrderId()==$D00AB))==false then
call DisableTrigger(t)
call IssueTargetOrderById(s,$D000F,u)
call EnableTrigger(t)
endif
call SetUnitX(f,GetUnitX(u))
call SetUnitY(f,GetUnitY(u))
endif
set f=null
set s=null
set u=null
set t=null
endfunction
function E0I takes nothing returns nothing
local trigger t=CreateTrigger()
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local integer i=GetUnitAbilityLevel(s,'AA3V')
if i==1 then
call UnitAddAbility(s,'AB36')
call UnitMakeAbilityPermanent(s,true,'AB36')
elseif i==2 then
call UnitAddAbility(s,'AB37')
call UnitMakeAbilityPermanent(s,true,'AB37')
else
call UnitAddAbility(s,'AB38')
call UnitMakeAbilityPermanent(s,true,'AB38')
endif
call IssueTargetOrderById(s,$D000F,u)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DAMAGED)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function E5I))
call DFV(t,'s',s)
call DFV(t,'u',u)
set u=CreateUnit(GetOwningPlayer(s),'h088',GetUnitX(u),GetUnitY(u),0)
call SetUnitVertexColor(u,0,0,0,0)
call DFV(t,'f',u)
set s=null
set u=null
set t=null
endfunction
