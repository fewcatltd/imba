function WWR takes unit s,unit u,integer i returns nothing
local real d=90*i
local trigger t=null
if GetUnitAbilityLevel(u,'AB52')>0 then
set i=XLE(QYV(u)*.2*i)
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,5,false)
call TriggerAddCondition(t,Condition(function WUR))
call DFV(t,'u',u)
call DPV(t,'d',i)
set t=null
call G5V(u,-i)
call HEV(u)
endif
if GetUnitAbilityLevel(s,'AB49')>0 or GetUnitAbilityLevel(s,'AB53')>0 or GetUnitAbilityLevel(s,'AB54')>0 or GetUnitAbilityLevel(s,'AB55')>0 then
call KRV(GetTriggerUnit(),'AB49','B949')
call KRV(GetTriggerUnit(),'AB53','B953')
call KRV(GetTriggerUnit(),'AB54','B954')
call KRV(GetTriggerUnit(),'AB55','B955')
call UnitRemoveAbility(GetTriggerUnit(),'AA3B')
set d=d*(1+.1*GetUnitAbilityLevel(s,'AA4V'))
endif
call HPV(s,u,2,d)
if GetUnitAbilityLevel(u,'AB50')>0 then
call KRV(u,'AB50','B950')
set d=DWV(u,'aa4X')-ITV
set d=RMaxBJ(3,d/3)
set d=d*GetUnitState(u,UNIT_STATE_MAX_LIFE)*(.01+.01*DTV(u,'Aa4X'))
call HPV(s,u,1,d)
endif
if GetUnitAbilityLevel(u,'AB51')>0 then
call DUV(u,'AA4Y',ITV+(.6+.4)*GetUnitAbilityLevel(s,'AA4X')*(1+.5*i))
endif
endfunction
function WYR takes nothing returns nothing
local timer tm=GetExpiredTimer()
local group g1=CreateGroup()
local boolexpr b=Condition(function PJV)
local group g=DKV(tm,'g')
local unit s=DHV(tm,'s')
local unit f=DHV(tm,'f')
local integer i=DTV(tm,'i')
local real a=DWV(tm,'a')
local integer l=DTV(tm,'l')
local real x=GetUnitX(f)
local real y=GetUnitY(f)
local unit u=null
set AUV=s
set x=FXV(x+Cos(a)*22.5)
set y=FOV(y+Sin(a)*22.5)
call SetUnitX(f,x)
call SetUnitY(f,y)
call GroupEnumUnitsInRange(g1,x,y,$E1,b)
loop
set u=FirstOfGroup(g1)
exitwhen u==null
if IsUnitInGroup(u,g)==false then
call GroupAddUnit(g,u)
call HPV(s,u,1,80+20*i+H4V(s,1)*.3)
call J6V(u,'AB59','B959',1+i,0,0,0,0,0,0,0)
endif
call GroupRemoveUnit(g1,u)
endloop
if l==1 then
call GroupClear(g1)
call GroupEnumUnitsInRange(g1,x,y,875,b)
loop
set u=FirstOfGroup(g1)
exitwhen u==null
if IsUnitType(u,UNIT_TYPE_MAGIC_IMMUNE)==false then
if IsUnitInRange(u,f,375)then
call HPV(s,u,1,80+20*i+H4V(s,1)*.3)
call QHV(s,u,.75)
else
set i=GetUnitAbilityLevel(s,'AA5B')
if i>0 then
call GYV('eA05',s,f,u,750,"WZR",i,0)
endif
endif
endif
call GroupRemoveUnit(g1,u)
endloop
call KillUnit(f)
call DestroyGroup(g)
call FIV()
else
call DPV(tm,'l',l-1)
endif
call DestroyGroup(g1)
call DestroyBoolExpr(b)
set tm=null
set s=null
set f=null
set g=null
set g1=null
set b=null
endfunction
function WZR takes nothing returns nothing
call HPV(ADV,AFV,1,20+40*AHV+H4V(ADV,1)*.1)
call J6V(AFV,'AB63','B963',2+AHV,0,0,0,0,0,0,0)
endfunction
function W_R takes unit s,integer i,real a,real x,real y returns nothing
local timer tm=CreateTimer()
local unit f=CreateUnit(GetOwningPlayer(s),'eA05',x,y,a*bj_RADTODEG)
call TimerStart(tm,.025,true,function WYR)
call UnitAddAbility(f,'Aloc')
call UnitAddAbility(f,'Arav')
call UnitRemoveAbility(f,'Arav')
call SetUnitFlyHeight(f,$C8,0)
call SetUnitScale(f,2,2,2)
call SetUnitX(f,x)
call SetUnitY(f,y)
call DFV(tm,'s',s)
call DJV(tm,'g',CreateGroup())
call DFV(tm,'f',f)
call DPV(tm,'i',i)
call DUV(tm,'a',a)
call DPV(tm,'l',67)
set tm=null
set f=null
endfunction
function W0R takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
local integer i=DTV(t,'i')
local unit s=DHV(t,'s')
if GetTriggerEventId()==EVENT_UNIT_DEATH or i==0 then
call GDV()
else
call J6V(u,'AB60','B960',1.2,0,0,0,0,0,0,-'d'*i)
call DPV(t,'i',i-1)
set i=GetUnitAbilityLevel(s,'AA5B')
if i>0 then
call HPV(s,u,1,20+$A*i)
endif
endif
set t=null
set s=null
set u=null
endfunction
function W1R takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'f')
local integer i=DTV(t,'i')
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DestroyEffect(D2V(t,'e'))
call CPV(u,false)
call GDV()
else
call HPV(s,u,1,25+H4V(s,1)*.12)
call CPV(u,true)
if ITV-DWV(t,'t')>0 then
call DestroyEffect(D2V(t,'e'))
call CPV(u,false)
call GDV()
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function W0R))
call DFV(t,'u',u)
call J6V(u,'AB60','B960',1.2,0,0,0,0,0,0,-500)
call DPV(t,'i',i)
call DFV(t,'s',s)
set i=GetUnitAbilityLevel(s,'AA5B')
if i>0 then
call HPV(s,u,1,20+$A*i)
endif
set t=null
endif
endif
set t=null
set s=null
set u=null
endfunction
function W2R takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'s')
local integer i=DTV(tm,'i')
local integer l=DTV(tm,'l')
local real x=0
local real y=0
local group g=null
local group g1=null
local boolexpr b=null
local integer r=0
local destructable d=null
local trigger t=null
local unit f=null
local region W3R=null
local rect W4R=null
if l==0 then
set r=0
loop
exitwhen r>40
call RemoveDestructable(F2V(tm,"Dest"+I2S(r)))
set r=r+1
endloop
call FIV()
else
set g=CreateGroup()
set g1=CreateGroup()
set b=Condition(function PJV)
set AUV=s
set r=0
set W3R=CreateRegion()
loop
exitwhen r>40
set d=F2V(tm,"Dest"+I2S(r))
set x=GetDestructableX(d)
set y=GetDestructableY(d)
set W4R=Rect(x+$AF,y+$AF,x-$AF,y-$AF)
call RegionAddRect(W3R,W4R)
call RemoveRect(W4R)
call GroupEnumUnitsInRange(g1,x,y,375,b)
call GroupAddGroup(g1,g)
call GroupClear(g1)
if l==1 then
if r-r/4*4==0 then
call DestroyEffect(AddSpecialEffect("IceNova.mdx",x,y))
endif
call KillDestructable(d)
endif
set r=r+1
endloop
call DestroyGroup(g1)
call DestroyBoolExpr(b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if l==1 then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.25,true)
call TriggerAddCondition(t,Condition(function W1R))
call DFV(t,'s',s)
call DFV(t,'f',f)
call CPV(f,true)
call DUV(t,'t',ITV+.5+.25*i-.1)
call DPV(t,'i',i)
call D1V(t,'e',AddSpecialEffectTarget("Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl",f,"origin"))
set t=null
else
if IsUnitInRegion(W3R,f)then
call J6V(f,'AB59','B959',1,0,0,0,0,0,0,0)
endif
endif
call GroupRemoveUnit(g,f)
endloop
call RemoveRegion(W3R)
set W3R=null
set W4R=null
call DestroyGroup(g)
set g=null
set g1=null
set b=null
call DPV(tm,'l',l-1)
endif
set d=null
set tm=null
set s=null
endfunction
function W5R takes unit s,integer i,real a,real x,real y,real x1 returns nothing
local timer tm=CreateTimer()
local real d=a-bj_PI*.5
local integer l=0
local real r=0
set x=x+Cos(a)*x1
set y=y+Sin(a)*x1
loop
exitwhen l>40
set r=40*(-20+l)
call FPV(tm,"Dest"+I2S(l),CreateDestructable('B004',FXV(x+Cos(d)*r),FOV(y+Sin(d)*r),0,1,0))
set l=l+1
endloop
call TimerStart(tm,.5,true,function W2R)
call DFV(tm,'s',s)
call DPV(tm,'l',6)
call DPV(tm,'i',i)
set tm=null
endfunction
function W6R takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'s')
local unit u=DHV(tm,'u')
local integer i=GetUnitAbilityLevel(s,'A03S')
local integer l=GetUnitAbilityLevel(s,'A04P')
if IVV then
if GetUnitAbilityLevel(s,'A03U')>0 then
call GYV('eA12',s,s,u,$4B0,"W7R",0,0)
endif
if IsUnitInRange(s,u,$3E8)==false and i>0 then
call QDV(u,1.5+.5*i+.5*C0V(i==4),true)
endif
endif
call HPV(s,u,1,$CD+$96*l)
call FIV()
set s=null
set tm=null
set u=null
endfunction
function W8R takes nothing returns nothing
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local integer id=GetSpellAbilityId()
local real d=400
if id=='A08Y'then
set d=500
elseif id=='A08Z'then
set d=600
elseif id=='A090'then
set d=700
elseif id=='A092'then
set d=800
endif
call QQV(s,u,1,d,.1)
set s=null
set u=null
endfunction
function W9R takes nothing returns nothing
local timer t=GetExpiredTimer()
call AddHeroXP(DHV(t,'s'),DTV(t,'i')*5/2,true)
call FIV()
set t=null
endfunction
function YVR takes nothing returns nothing
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local integer i=GetUnitLevel(u)
local timer t=null
if ITV-DWV(s,'ANtm')<0 or(IsUnitAlly(s,A7V[0])and EZV>ITV)or(IsUnitAlly(s,A8V[0])and E_V>ITV)then
set s=null
set u=null
return
endif
call DUV(s,'ANtm',ITV+'d')
set t=CreateTimer()
if i==1 then
set i=25
elseif i==2 then
set i=41
elseif i==3 then
set i=62
elseif i==4 then
set i=88
elseif i==5 then
set i='w'
elseif i==6 then
set i=$9B
elseif i>6 then
set i=$9B+(i-6)*40
endif
call TimerStart(t,DNV(s,u)/700.,false,function W9R)
call DFV(t,'s',s)
call DPV(t,'i',i)
set t=null
set u=null
set s=null
endfunction
function YER takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local integer i=DTV(t,'i')
local unit u=GetTriggerUnit()
if GetTriggerEventId()!=EVENT_UNIT_DAMAGED or GetEventDamageSource()==s then
call GDV()
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
call HPV(s,u,1,25+75*i)
call QDV(u,1.75,false)
endif
endif
set t=null
set s=null
set u=null
endfunction
function YXR takes nothing returns nothing
local unit s=DHV(GetTriggeringTrigger(),'s')
local unit u=GetTriggerUnit()
local integer i=GetUnitAbilityLevel(HMV(s),'A05J')
local group g=null
local boolexpr b=null
local real d=$C8+'d'*i// techies mines
local real minelife=1 
local real minelevel=GetUnitAbilityLevel(HMV(s),'A05J')
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call GDV()
call DestroyEffect(AddSpecialEffect("war3mapImported\\NewGroundEX.mdx",GetUnitX(u),GetUnitY(u)))
set AUV=u
set g=KHV()
set b=Condition(function PMV)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),524,b)
set s=HMV(u)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInRange(u,GetTriggerUnit(),$C8)then
set minelife=GetUnitState(u,UNIT_STATE_LIFE)
set minelevel=1-(minelevel*0.05)
set minelife=minelife*minelevel
call SetUnitLifeBJ(u,minelife)      //newmine percentage
call GetUnitState(u,UNIT_STATE_LIFE)
call HPV(s,u,2,d)
else
call HPV(s,u,2,d*.5)
endif
call GroupRemoveUnit(g,u)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
elseif IsUnitAlly(u,GetOwningPlayer(s))==false and IsUnitType(u,UNIT_TYPE_FLYING)==false then
call KillUnit(s)
endif
set s=null
set u=null
endfunction
function YOR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
if GetUnitAbilityLevel(s,'aa83')==0 then
call SetUnitPathing(s,true)
call SetUnitFlyHeight(s,GetUnitDefaultFlyHeight(s),0)
call GKV(s)
call FIV()
endif
set t=null
set s=null
endfunction
function YRR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
if GetUnitAbilityLevel(s,'aa82')==0 and GetUnitAbilityLevel(s,'aa84')==0 then
call GKV(s)
call SetUnitFlyHeight(s,GetUnitDefaultFlyHeight(s),0)
call FIV()
endif
set t=null
set s=null
endfunction
function YIR takes integer i returns integer
if i==1 then
return'I808'
elseif i==2 then
return'I80B'
elseif i==3 then
return'I80E'
elseif i==4 then
return'I80H'
endif
return 0
endfunction
function YAR takes unit s,integer i returns nothing
local integer l=0
local item it=null
loop
exitwhen l>5
set it=UnitItemInSlot(s,l)
if GetItemTypeId(it)==YIR(i)then
set l=GetItemCharges(it)
if l==1 then
call RemoveItem(it)
else
call SetItemCharges(it,l-1)
endif
exitwhen true
endif
set l=l+1
endloop
endfunction
function YNR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
if GetUnitAbilityLevel(s,'aa85')==0 then
call FIV()
call G5V(s,-50)
call HEV(s)
call GKV(s)
call SetUnitFlyHeight(s,GetUnitDefaultFlyHeight(s),0)
else
call SetUnitVertexColor(s,0,0,0,$9B)
endif
set t=null
set s=null
endfunction
function YBR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
if GetUnitAbilityLevel(s,'B068')==0 then
call FHV(s,"A07A|Active",false)
call FIV()
endif
set t=null
set s=null
endfunction
function YCR takes nothing returns nothing
call HPV(ADV,AFV,1,AHV*30+60)
endfunction
function YDR takes nothing returns nothing
local unit s=DHV(GetExpiredTimer(),'s')
call DYV(s,'a1NA',false)
call FIV()
set s=null
endfunction
function YFR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local integer i=DTV(t,'i')
local integer l=DTV(t,'l')
local real r=DWV(t,'r')
if GetWidgetLife(u)<1 or i==l then
call FIV()
else
call HGV(s,true,-r/i)
call HGV(u,true,r/i)
set l=l+1
call DPV(t,'l',l)
endif
set t=null
set s=null
set u=null
endfunction
function YGR takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'s')
local integer i=DTV(tm,'i')
local integer l=DTV(tm,'l')
local real r=DWV(tm,'r')
if GetWidgetLife(s)<1 or i==l then
call FIV()
else
call HGV(s,true,-r/i)
set l=l+1
call DPV(tm,'l',l)
endif
set tm=null
set s=null
endfunction
function YHR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=DHV(t,'u')
call HVV(u,0)
if FRV(u)==false then
call FIV()
endif
set u=null
set t=null
endfunction
function YJR takes unit u,integer id,integer i returns nothing
local timer t=CreateTimer()
call TimerStart(t,.1,true,function YHR)
call DFV(t,'u',u)
call HVV(u,0)
set t=null
endfunction
function vacum1 takes nothing returns nothing
