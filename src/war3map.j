function TestFunc takes nothing returns nothing
call HPV(GetTriggerUnit(),GetTriggerUnit(),1,$A)
endfunction
function X5I takes integer z returns integer
if z=='Cdrt'then
return'Cdrt'
elseif z=='Cdrd'then
return'Iice'
elseif z=='Cvin'then
return'Isnw'
elseif z=='Cgrs'then
return'Isnw'
elseif z=='Clvg'then
return'Isnw'
elseif z=='Zvin'then
return'Idki'
elseif z=='Zbks'then
return'Ibsq'
elseif z=='Ndrd'then
return'Ibsq'
endif
return 0
endfunction
function X6I takes nothing returns nothing
local integer a=$80
local integer z=0
local real x
local real y
loop
exitwhen XHV>XJV
loop
exitwhen z>8192
set x=XHV
set y=z
if IsPointBlighted(x,y)==false then
call SetTerrainType(x,y,X5I(GetTerrainType(x,y)),GetTerrainVariance(x,y),1,0)
endif
set x=-XHV
set y=z
if IsPointBlighted(x,y)==false then
call SetTerrainType(x,y,X5I(GetTerrainType(x,y)),GetTerrainVariance(x,y),1,0)
endif
set x=-XHV
set y=-z
if IsPointBlighted(x,y)==false then
call SetTerrainType(x,y,X5I(GetTerrainType(x,y)),GetTerrainVariance(x,y),1,0)
endif
set x=XHV
set y=-z
if IsPointBlighted(x,y)==false then
call SetTerrainType(x,y,X5I(GetTerrainType(x,y)),GetTerrainVariance(x,y),1,0)
endif
set z=z+a
endloop
set z=0
set XHV=XHV+a
endloop
set XJV=XJV+256
if XJV>8192 then
call DestroyTimer(GetExpiredTimer())
endif
endfunction
function X7I takes nothing returns nothing
local real x=GetDestructableX(GetFilterDestructable())
local real y=GetDestructableY(GetFilterDestructable())
if GetDestructableTypeId(GetFilterDestructable())=='ATtr' or GetDestructableTypeId(GetFilterDestructable())=='NTtw' then
call RemoveDestructable(GetFilterDestructable())
call CreateDestructable('WTst',x,y,GetRandomReal(0,360),GetRandomReal(.8,1.1),GetRandomInt(0,9))
endif
endfunction
function ChristmasDay takes nothing returns nothing
call TimerStart(CreateTimer(),.01,true,function X6I)
call EnumDestructablesInRect(bj_mapInitialPlayableArea,Condition(function X7I),null)
endfunction
function FixOBBug takes nothing returns nothing
endfunction
function X8I takes nothing returns nothing
local unit s=GetTriggerUnit()
local integer id=GetSpellAbilityId()
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local real a=Atan2(y1-y,x1-x)
local real d=0
local unit f=null
call DYV(s,'iATK',true)
if id=='A19O' then
call LKR ()
endif
if id=='A01F' and IsUnitType(s,UNIT_TYPE_HERO)then
set f=CreateUnit(GetOwningPlayer(s),'eA22',x+Cos(a)*'d',y+Sin(a)*'d',a*bj_RADTODEG)
call UnitAddAbility(f,'Aloc')
call SetUnitX(f,x+Cos(a)*30)
call SetUnitY(f,y+Sin(a)*30)
call SetUnitScale(f,.75,.75,.75)
call SetUnitTimeScale(f,1.7)
call UnitAddAbility(f,'Arav')
call SetUnitFlyHeight(f,85,0)
call SetUnitAnimation(f,"birth")
call UnitApplyTimedLife(f,'BTLF',4)
set f=null
endif
set f=GetSpellTargetUnit()
if f!=null and C7V(f,'I00Z')>0 and ITV-DWV(f,'I00Z')>0 and IsUnitAlly(s,GetOwningPlayer(f))==false then
call DUV(f,'I00Z',ITV+$A)
call J6V(s,'AB24','B924',2,0,0,0,0,0,0,0)
endif
set f=null
set s=null
endfunction
function X9I takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local real a=DWV(t,'a')
local real x=DWV(t,'x')
local real y=DWV(t,'y')
local group g1=KHV()
local group g2=KHV()
local boolexpr b=Condition(function PJV)
local integer i=DTV(t,'i')
local real x1=0
local real y1=0
local integer l=1
local unit f=null
set x=x+Cos(a)*'x'*i
set y=y+Sin(a)*'x'*i
set AUV=s
call GroupEnumUnitsInRange(g2,x,y,$AF,b)
call GroupAddGroup(g2,g1)
call DestroyEffect(AddSpecialEffect("Frost Missile.mdx",x,y))
set a=a+bj_PI*.67
loop
exitwhen l>5
set x1=x+Cos(a)*60
set y1=y+Sin(a)*60
call GroupEnumUnitsInRange(g2,x1,y1,'x',b)
call GroupAddGroup(g2,g1)
call DestroyEffect(AddSpecialEffect("Frost Missile.mdx",x1,y1))
set x1=x-Cos(a)*60
set y1=y-Sin(a)*60
call GroupEnumUnitsInRange(g2,x1,y1,'x',b)
call GroupAddGroup(g2,g1)
call DestroyEffect(AddSpecialEffect("Frost Missile.mdx",x1,y1))
set l=l+1
endloop
loop
set f=FirstOfGroup(g1)
exitwhen f==null
call HPV(s,f,1,'x')
call GroupRemoveUnit(g1,f)
endloop
set i=DTV(t,'i')+1
call DPV(t,'i',i)
if i==$D2 then
call FIV()
endif
call KGV(g1)
call KGV(g2)
call DestroyBoolExpr(b)
set s=null
set g2=null
set g1=null
set b=null
set t=null
endfunction
function OVI takes unit s,unit u returns nothing
local real a=0
local timer t=CreateTimer()
if u==null then
set a=GetRandomReal(0,bj_PI*2)
else
set a=HYV(s,u)
endif
call TimerStart(t,.15,true,function X9I)
call DFV(t,'s',s)
call DUV(t,'a',a)
call DUV(t,'x',GetUnitX(s))
call DUV(t,'y',GetUnitY(s))
call DPV(t,'i',1)
set t=null
endfunction
function OEI takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local integer i=0
local group g=null
local boolexpr b=null
local unit f=null
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call GDV()
elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamage()>999.5 then
call HWV(s,0)
endif
else
if ITV-DWV(t,'t')>0 then
call DUV(t,'t',ITV+60)
set i=GetRandomInt(1,3)
if i==1 then
call SetUnitPosition(s,-600,-550)
elseif i==2 then
call SetUnitPosition(s,-6300,4300)
else
call SetUnitPosition(s,6000,-4800)
endif
else
if GetUnitLifePercent(s)<75 then
call UnitUseItem(s,UnitItemInSlot(s,4))
endif
if GetRandomInt(0,99)<8 then
set AUV=s
set g=KHV()
set b=Condition(function PQV)
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),725,b)
set f=GroupPickRandomUnit(g)
call OVI(s,f)
set f=null
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
endif
endif
set t=null
set s=null
endfunction
function NewHero_Freezer takes nothing returns nothing
local trigger t=CreateTrigger()
local unit s=null
call FIV()
call DisableTrigger(xu)
set s=CreateUnit(Player($C),'H908',-500,-500,GetRandomReal(0,360))
call EnableTrigger(xu)
call SetHeroLevel(s,25,false)
call SetHeroStr(s,B6V(s,false)*45,false)
call SetHeroAgi(s,B7V(s,false)*$A,false)
call SetHeroInt(s,B8V(s,false)*$A,false)
call DYV(s,'boss',true)
call DisableTrigger(rH)
call UnitAddItemById(s,'I60I')
call UnitAddItemById(s,'I04D')
call UnitAddItemById(s,'I0A3')
call UnitAddItemById(s,'I0AB')
call UnitAddItemById(s,'I09F')
call UnitAddItemById(s,'I0BJ')
call EnableTrigger(rH)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DAMAGED)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function OEI))
call DFV(t,'s',s)
call DUV(t,'t',ITV+60)
set t=null
set s=null
endfunction
function OXI takes unit s,boolean b,real r returns nothing
