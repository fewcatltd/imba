function X2R takes unit hn returns nothing
local integer K3V=GetHandleId(hn)
local integer X3R=E8(K3V,"Invoker|Wex")
local integer X4R=E8(K3V,"Invoker|Quas")
local integer X5R=E8(K3V,"Invoker|Exort")
local integer VQR=GetUnitAbilityLevel(hn,'A0VA')
