function GPV takes nothing returns nothing
local timer t=GetExpiredTimer()
set bj_lastCreatedFogModifier=D6V(t,'f')
call FogModifierStop(bj_lastCreatedFogModifier)
call DestroyFogModifier(bj_lastCreatedFogModifier)
call FIV()
set t=null
endfunction
function GQV takes player p,real x,real y,real r,real GSV returns nothing
local timer t=CreateTimer()
call TimerStart(t,GSV,false,function GPV)
set bj_lastCreatedFogModifier=CreateFogModifierRadius(p,FOG_OF_WAR_VISIBLE,x,y,r,true,false)
call FogModifierStart(bj_lastCreatedFogModifier)
call D5V(t,'f',bj_lastCreatedFogModifier)
set t=null
endfunction
function GTV takes unit u,integer i returns nothing
local integer x=i
local integer y=0
local integer n=0
if GetUnitTypeId(u)=='n00L'and i<0 then
set i=0
set x=0
endif
set y=0
loop
exitwhen y>8
call UnitRemoveAbility(u,A1V[y])
call UnitRemoveAbility(u,A1V[y+$A])
set y=y+1
endloop
if i==0 then
return
endif
if x>511 then
set x=511
elseif x<-511 then
set x=-511
endif
call DPV(u,'aias',x)
if i<0 then
set x=-i
set n=$A
endif
set y=0
loop
exitwhen x<1 or y>8
if x-x/2*2==1 then
call UnitAddAbility(u,A1V[y+n])
call UnitMakeAbilityPermanent(u,true,A1V[y+n])
else
call UnitRemoveAbility(u,A1V[y+n])
endif
set x=x/2
set y=y+1
endloop
endfunction
function GUV takes unit u returns boolean
return DZV(u,'boss')
endfunction
function GWV takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit f=DHV(t,'f')
local unit u=DHV(t,'u')
local real x=GetUnitX(f)
local real y=GetUnitY(f)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=Atan2(y1-y,x1-x)
local real d=DWV(t,'d')
local boolean b=SquareRoot((x1-x)*(x1-x)+(y1-y)*(y1-y))<d
local real x2=DWV(t,'x')
local real y2=DWV(t,'y')
if b or GetTriggerEventId()==EVENT_UNIT_DEATH then
set ADV=DHV(t,'s')
set AFV=u
set AHV=DWV(t,'a')
set AJV=DWV(t,'b')
set AGV=f
if D4V(t,'n')!=null and D4V(t,'n')!="" then
call ExecuteFunc(D4V(t,'n'))
endif
call KillUnit(f)
call GDV()
else
if IsUnitVisible(f,Player(0))and IsUnitVisible(f,Player(6))then
call UnitRemoveAbility(f,'AA3B')
else
call UnitAddAbility(f,'AA3B')
endif
set x=x+Cos(a)*d
set y=y+Sin(a)*d
call SetUnitFacing(f,a*bj_RADTODEG)
call SetUnitX(f,x)
call SetUnitY(f,y)
set d=GetUnitFlyHeight(u)+GetUnitFlyHeight(f)
set d=d*.5
set d=RMaxBJ(d,DWV(t,'h'))
call SetUnitFlyHeight(f,d,0)
endif
set t=null
set f=null
set u=null
endfunction
function GYV takes integer i,unit s,unit u,unit r,real d,string n,real GZV,real G_V returns nothing
local trigger t=CreateTrigger()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(r)
local real y1=GetUnitY(r)
local unit f=CreateUnit(Player($F),i,x,y,Atan2(y1-y,x1-x)*bj_RADTODEG)
local integer IMBA131_GYV_i=50
if IHV then
set IHV=false
set IMBA131_GYV_i='x'
endif
call UnitAddAbility(f,'Aloc')
call CPV(f,true)
call UnitAddAbility(f,'Arav')
call UnitRemoveAbility(f,'Arav')
call SetUnitFlyHeight(f,IMBA131_GYV_i,0)
call SetUnitPathing(f,false)
call DUV(t,'h',IMBA131_GYV_i)
call DFV(t,'s',s)
call DFV(t,'u',r)
call DFV(t,'f',f)
call DUV(t,'d',d*.025)
call D3V(t,'n',n)
call DUV(t,'a',GZV)
call DUV(t,'b',G_V)
call DUV(t,'x',0)
call DUV(t,'y',0)
call DYV(t,'B',false)
call TriggerRegisterUnitEvent(t,r,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function GWV))
set bj_lastCreatedUnit=f
set t=null
set f=null
endfunction
function G0V takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit f=DHV(t,'f')
local unit s=DHV(f,'s')
local unit u=DHV(f,'u')
local string y=D4V(f,'m')
if GetTriggerEventId()==EVENT_UNIT_DAMAGED and GetEventDamageSource()==f then
call GDV()
set ADV=s
set AFV=u
set AGV=f
call ExecuteFunc(y)
call KillUnit(f)
elseif GetTriggerEventId()!=EVENT_UNIT_DAMAGED then
call KillUnit(f)
call GDV()
endif
set t=null
set s=null
set u=null
set f=null
endfunction
function G1V takes string s returns nothing
if IsPlayerObserver(GetLocalPlayer())then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,20,s)
endif
endfunction
function G2V takes unit u,integer i returns integer
local integer l=0
if i<0 then
set l=-IMinBJ(B6V(u,true)-1,-i)
else
set l=i
endif
call DQV(u,'aStr',l)
return l
endfunction
function G3V takes unit u,integer i returns nothing
call DQV(u,'aAgi',i)
endfunction
function G4V takes unit u,integer i returns nothing
call DQV(u,'aInt',i)
endfunction
function G5V takes unit u,integer i returns nothing
call DQV(u,'aDef',i)
endfunction
function G6V takes unit u,integer i returns nothing
call DQV(u,'aAtk',i)
endfunction
function G7V takes unit u,integer i returns nothing
if i<0 and GetUnitTypeId(u)=='n909'then
return
endif
call DQV(u,'aIas',i)
endfunction
function G8V takes unit u,integer i returns integer
if i<0 and GetUnitTypeId(u)=='n909'then
return 0
endif
if i<0 and i<-GetUnitState(u,UNIT_STATE_MAX_LIFE)+1 then
set i=-R2I(GetUnitState(u,UNIT_STATE_MAX_LIFE))+1
endif
call DQV(u,'aLfe',i)
return i
endfunction
function G9V takes unit u returns integer
return DTV(u,'aLfe')
endfunction
function HVV takes unit u,real i returns nothing
local integer l=0
local integer x=0
local integer y=0
local integer h=0
if GetUnitTypeId(u)=='n909'and i<0 then
else
call DSV(u,'move',i)
endif
if FRV(u)and GetUnitAbilityLevel(u,'aa85')==0 then
set l='d'
else
if GetUnitAbilityLevel(u,'aa85')>0 then
set l=300
else
set l=GEV(u)
endif
set l=R2I(DWV(u,'move'))+l
if C7V(u,'I06B')>0 then
set l=l+95
elseif C7V(u,'I0GJ')>0 then
set l=l+70
elseif C7V(u,'I70Y')>0 then
set l=l+65
elseif C7V(u,'I05Z')+C7V(u,'I05Y')+C7V(u,'I02T')>0 then
set l=l+60
elseif C7V(u,'I02O')>0 then
set l=l+50
endif
if C7V(u,'I08Z')>0 then
set l=l+25
endif
if l>522 then //move
endif
endif
set l=l-2
if DTV(u,'MOVE')==l and GetUnitMoveSpeed(u)>$A then
return
endif
call DPV(u,'MOVE',l)
if l>0 then
set x=l/4
set y=l-x*4
call UnitAddAbility(u,VOV[x-1])
call UnitRemoveAbility(u,VOV[x])
call UnitAddAbility(u,VOV[x])
call UnitMakeAbilityPermanent(u,true,VOV[x])
call SetUnitAbilityLevel(u,VOV[x],y+1)
set h=x+1
loop
exitwhen h>VVV
call UnitRemoveAbility(u,VOV[h])
set h=h+1
endloop
else
set h=0
loop
exitwhen h>VVV
call UnitRemoveAbility(u,VOV[h])
set h=h+1
endloop
endif
endfunction
function HEV takes unit u returns nothing
local integer i=0
call DVV(u,DTV(u,'aAtk'))
call C9V(u,DTV(u,'aDef'))
call GTV(u,DTV(u,'aIas'))
set i=DTV(u,'ALFE')
if i!=DTV(u,'aLfe')then
set i=DTV(u,'aLfe')
call DRV(u,i)
call DPV(u,'ALFE',i)
endif
if IsUnitType(u,UNIT_TYPE_HERO)then
set i=DTV(u,'ASTR')
if i!=DTV(u,'aStr')then
set i=DTV(u,'aStr')
call DOV(u,i)
call DPV(u,'ASTR',i)
endif
set i=DTV(u,'AAGI')
if i!=DTV(u,'aAgi')then
set i=DTV(u,'aAgi')
call DXV(u,i)
call DPV(u,'AAGI',i)
endif
set i=DTV(u,'AINT')
if i!=DTV(u,'aInt')then
set i=DTV(u,'aInt')
call DEV(u,i)
call DPV(u,'AINT',i)
endif
endif
call HVV(u,0)
endfunction
function HXV takes unit u,integer id,integer i,string s,unit HOV returns nothing
local unit x=CreateUnit(GetOwningPlayer(u),'e00E',GetUnitX(HOV),GetUnitY(HOV),0)
call UnitAddAbility(x,id)
call SetUnitAbilityLevel(x,id,i)
call IssueTargetOrder(x,s,HOV)
set x=null
endfunction
function HRV takes unit u,integer id,integer i,string s,real x,real y returns nothing
local unit n=CreateUnit(GetOwningPlayer(u),'e00E',x,y,0)
call UnitAddAbility(n,id)
call SetUnitAbilityLevel(n,id,i)
call IssuePointOrder(n,s,x,y)
call UnitApplyTimedLife(n,'BTLF',1)
set n=null
endfunction
function HIV takes nothing returns nothing
call DestroyEffect(D2V(GetExpiredTimer(),'e'))
call FIV()
endfunction
function HAV takes string s,unit u,real i returns nothing
local timer tm=CreateTimer()
call D1V(tm,'e',AddSpecialEffectTarget(s,u,"origin"))
call TimerStart(tm,i,false,function HIV)
set tm=null
endfunction
function HNV takes string s,unit u,string p,real i returns nothing
local timer tm=CreateTimer()
call D1V(tm,'e',AddSpecialEffectTarget(s,u,p))
call TimerStart(tm,i,false,function HIV)
set tm=null
endfunction
function HBV takes string s,real x,real y,real i returns nothing
local timer tm=CreateTimer()
call D1V(tm,'e',AddSpecialEffect(s,x,y))
call TimerStart(tm,i,false,function HIV)
set tm=null
endfunction
function HCV takes unit u,real r,boolexpr HDV returns nothing
call GroupEnumUnitsInRange(AMV,GetUnitX(u),GetUnitY(u),r,HDV)
endfunction
function HFV takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=DHV(t,'u')
call SetWidgetLife(u,GetWidgetLife(u)+DWV(t,'d'))
call FIV()
set t=null
set u=null
endfunction
function HGV takes unit u,boolean b,real r returns nothing
local real d=0
local timer t=null
local real i=0
if r==0 then
set E3V=-1
return
endif
if b then
set d=GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetUnitState(u,UNIT_STATE_LIFE)
set d=d-r
if r>0 then
if d>=0 then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+r)
else
set d=-d
set i=GetWidgetLife(u)+r
call SetWidgetLife(u,i)
set t=CreateTimer()
call DFV(t,'u',u)
call DUV(t,'d',d)
call TimerStart(t,0,false,function HFV)
set t=null
endif
else
set r=RMaxBJ(GetUnitState(u,UNIT_STATE_LIFE)+r,1)
call SetWidgetLife(u,r)
endif
else
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+r)
endif
set E3V=-1
endfunction
function HHV takes nothing returns nothing
local timer tm=GetExpiredTimer()
call HGV(DHV(tm,'u'),true,DWV(tm,'r'))
call FIV()
set tm=null
endfunction
function HJV takes unit u,real r returns nothing
local timer tm=null
local real d=GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetWidgetLife(u)
if d-r>0 then
call HGV(u,true,r)
else
if GetWidgetLife(u)-r<1 then
call HGV(u,true,d)
set r=r-d
endif
set tm=CreateTimer()
call DFV(tm,'u',u)
call DUV(tm,'r',r)
call TimerStart(tm,0,false,function HHV)
set tm=null
endif
endfunction
function HKV takes nothing returns nothing
local timer tm=GetExpiredTimer()
call HGV(DHV(tm,'u'),true,DWV(tm,'d'))
call FIV()
set tm=null
endfunction
function HLV takes nothing returns nothing
local unit u=GetTriggerUnit()
local real d=GetEventDamage()
local timer tm=null
set ASV=d/'d'
if GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetUnitState(u,UNIT_STATE_LIFE)-d<1 then
set tm=CreateTimer()
call DFV(tm,'u',u)
call DUV(tm,'d',d)
call TimerStart(tm,0,false,function HKV)
set tm=null
else
call HGV(u,true,d)
endif
set d=1-d*.01
set ATV=50*d/(3-3*d)
call GDV()
set u=null
endfunction
function HMV takes unit u returns unit
local integer i=GetPlayerId(GetOwningPlayer(u))
if(i==0 or i==6 or i>$B)then
return u
endif
return ie[i]
endfunction
function HPV takes unit p5,unit m5,integer HQV,real HSV returns nothing
local real r=HSV
if HQV==0 or p5==null or m5==null then
return
endif
if HSV<0 then
return
endif
set E2V=HQV
if GetUnitAbilityLevel(HMV(p5),'BB00')>0 and HQV==1 then
set HSV=HSV*1.2
endif
if GetUnitAbilityLevel(HMV(p5),'BB04')>0 and GetRandomInt(0,99)<35 and HQV==1 then
set HQV=5
set O9V=true
endif
set R8V=true
if HQV==1 then
call UnitDamageTarget(p5,m5,r,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_FIRE,WEAPON_TYPE_WHOKNOWS)
elseif HQV==2 then
call UnitDamageTarget(p5,m5,r,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
elseif HQV==3 then
call UnitDamageTarget(p5,m5,r,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif HQV==4 then
call UnitDamageTarget(p5,m5,r,true,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
elseif HQV==5 then
call UnitDamageTarget(p5,m5,r,false,false,null,null,null)
elseif HQV==6 then
call UnitDamageTarget(p5,m5,r,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
elseif HQV==7 then
