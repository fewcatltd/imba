function JTX takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local integer i=DTV(t,'i')
local real x=DWV(t,'x')
local real y=DWV(t,'y')
local group g=null
local unit f=null
local unit u=null
local boolexpr b=null
local real d=$A+$A*i
if ITV-DWV(t,'d')>=0 then
set u=CreateUnit(GetOwningPlayer(s),'e00E',x,y,0)
call UnitAddAbility(u,'A19F')
call SetUnitAbilityLevel(u,'A19F',i)
set AUV=s
set b=Condition(function PMV)
set g=KHV()
set x=x+GetRandomReal(-$E1,$E1)
set y=y+GetRandomReal(-$E1,$E1)
call DestroyEffect(AddSpecialEffect("Artillery.mdx",x,y))
call GroupEnumUnitsInRange(g,x,y,$96+24,b)
call DestroyBoolExpr(b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if IsUnitType(f,UNIT_TYPE_STRUCTURE)then
call HPV(s,f,2,d*.3)
else
call HPV(s,f,2,d)
call IssueTargetOrderById(u,$D006B,f)
endif
call GroupRemoveUnit(g,f)
endloop
call KillUnit(u)
call KGV(g)
if ITV-DWV(t,'t')>=0 then
call FIV()
endif
endif
set t=null
set s=null
set g=null
set u=null
set b=null
endfunction
function JUX takes nothing returns nothing
