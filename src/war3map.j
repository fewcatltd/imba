local real ho=X8(K3V,"TargetY")
local real RK=X8(K3V,"Angle")
local real iN=GetUnitX(IJ)
local real io=GetUnitY(IJ)
local real Il=L1V(GetUnitX(IJ)+30*Cos(RK))
local real IL=L2V(GetUnitY(IJ)+30*Sin(RK))
local boolexpr hP=Condition(function uj)
