call KJV(t)
else
call SetUnitAnimation(K8V,"spell")
set QJV=CreateUnit(p,'e00E',x,y,0)
call UnitAddAbility(QJV,'A0OC')
call SetUnitAbilityLevel(QJV,'A0OC',JFV)
call IssuePointOrderById(QJV,$D0250,Y5,Z5)
call UnitApplyTimedLife(QJV,'BTLF',1)
endif
set t=null
set p=null
set K8V=null
set QJV=null
return false
endfunction
function C3X takes unit u,player p,integer JFV,location l,real x,real y returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
call D7(K3V,"p",p)
call E7(K3V,"x",(x)*1.)
call E7(K3V,"y",(y)*1.)
call E7(K3V,"TargetX",GetLocationX(l)*1.)
call E7(K3V,"TargetY",GetLocationY(l)*1.)
call n7(K3V,"Level",JFV)
call A7(K3V,"Hero",u)
call TriggerRegisterTimerEvent(t,.3,true)
call TriggerAddCondition(t,Condition(function C2X))
set t=null
endfunction
function C4X takes nothing returns nothing
local unit K8V=GetTriggerUnit()
local integer JFV=GetUnitAbilityLevel(K8V,'A0O7')
local real x=GetUnitX(K8V)
local real y=GetUnitY(K8V)
local location l
local unit QJV
local group g=KHV()
if GetSpellTargetUnit()==null then
set l=GetSpellTargetLoc()
else
set l=GetUnitLoc(GetSpellTargetUnit())
endif
call CWX(bj_RADTODEG*Atan2(GetLocationY(l)-y,GetLocationX(l)-x),x,y)
call GroupEnumUnitsInRange(g,x,y,$7D0,Condition(function CLX))
call ForGroup(g,function C1X)
call KGV(g)
set QJV=CreateUnit(GetOwningPlayer(K8V),'e00E',x,y,0)
call UnitAddAbility(QJV,'A0OB')
call SetUnitAbilityLevel(QJV,'A0OB',JFV)
call IssuePointOrderById(QJV,$D0264,GetLocationX(l),GetLocationY(l))
call UnitApplyTimedLife(QJV,'BTLF',1)
call C3X(K8V,GetOwningPlayer(K8V),JFV,l,x+50*Cos(Atan2(GetLocationY(l)-y,GetLocationX(l)-x)),y+50*Sin(Atan2(GetLocationY(l)-y,GetLocationX(l)-x)))
call RemoveLocation(l)
set K8V=null
set l=null
set g=null
endfunction
function FQv takes nothing returns boolean
if GetSpellAbilityId()=='A0O7' then
call C4X()
endif
return false
endfunction
function C5X takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local integer i=DTV(t,'i')
local real x=DWV(t,'x')
local real y=DWV(t,'y')
local real a=DWV(t,'a')
local unit f=DHV(t,'f')
local real d=DWV(t,'d')
local real r=DWV(t,'r')
local group g1=CreateGroup()
local group g=DKV(t,'g')
local boolexpr b=Condition(function PJV)
local unit k=DHV(t,'k')
local real x1=DWV(t,'h')
if x1>='}' then
call DUV(t,'m',-DWV(t,'m'))
endif
set x1=x1+DWV(t,'m')
call SetUnitFlyHeight(f,x1,0)
call SetUnitFlyHeight(f,$96-x1,0)
set AUV=s
set x=FXV(x+Cos(a)*30)
set y=FOV(y+Sin(a)*30)
call DUV(t,'x',x)
call DUV(t,'y',y)
set r=r+d
call DUV(t,'r',r)
call SetUnitX(f,FXV(x+Cos(r)*55))
call SetUnitY(f,FOV(y+Sin(r)*55))
call SetUnitX(k,FXV(x+Cos(r-bj_PI)*55))
call SetUnitY(k,FOV(y+Sin(r-bj_PI)*55))
call GroupEnumUnitsInRange(g1,GetUnitX(f),GetUnitY(f),'}',b)
loop
set f=FirstOfGroup(g1)
exitwhen f==null
if IsUnitInGroup(f,g)==false then
call GroupAddUnit(g,f)
call HPV(s,f,1,$A+60*i)
endif
call GroupRemoveUnit(g1,f)
endloop
call GroupEnumUnitsInRange(g1,GetUnitX(k),GetUnitY(k),'}',b)
loop
set f=FirstOfGroup(g1)
exitwhen f==null
if IsUnitInGroup(f,g)==false then
call GroupAddUnit(g,f)
call HPV(s,f,1,$A+60*i)
endif
call GroupRemoveUnit(g1,f)
endloop
call DestroyGroup(g1)
call DestroyBoolExpr(b)
if GetTriggerEvalCount(t)==60 then
call DestroyGroup(g)
call KillUnit(DHV(t,'f'))
call KillUnit(k)
call GDV()
endif
set t=null
set s=null
set f=null
set k=null
set g=null
set g1=null
set b=null
endfunction
function C6X takes nothing returns nothing
local trigger t=CreateTrigger()
local unit s=GetTriggerUnit()
local integer i=GetUnitAbilityLevel(s,'A0O7')
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call DUV(t,'x',x)
call DUV(t,'y',y)
call DUV(t,'a',a)
call DFV(t,'s',s)
call DFV(t,'f',CreateUnit(GetOwningPlayer(s),'eA10',x,y,a*bj_RADTODEG))
call DFV(t,'k',CreateUnit(GetOwningPlayer(s),'eA11',x,y,a*bj_RADTODEG))
call DPV(t,'i',i)
call DUV(t,'r',a)
call DJV(t,'g',CreateGroup())
call DUV(t,'d',bj_PI/5.5)
call DUV(t,'h',75)
call DUV(t,'m',5)
call TriggerRegisterTimerEvent(t,1./30,true)
call TriggerAddCondition(t,Condition(function C5X))
set t=null
set s=null
endfunction
