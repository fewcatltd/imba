if LAV(K8V)==false and m5!=null and D3X(m5)==false then
call SaveInteger(le,tl,GetHandleId(m5),LoadInteger(le,tl,GetHandleId(m5))+1)
call MNV("effects\\Eclipse.mdx",m5,"origin",3)
if GetPlayerController(GetOwningPlayer(K8V))==MAP_CONTROL_COMPUTER then
call HPV(K8V,m5,1,300)
else
call HPV(K8V,m5,1,D6X*75)
endif
elseif LAV(K8V)==false then
set x=x+GetRandomInt(-350,350)
set y=y+GetRandomInt(-350,350)
call MBV("effects\\Eclipse.mdx",x,y,1.5)
endif
if(GetTriggerEvalCount(t)+1)==Tq then
call a7(K3V)
