local unit K8V=Y7(K3V,"Hero")
local unit RSX=Y7(K3V,"Projectile")
local integer Q4V=E8(K3V,"TargetIndex")
local unit m5=B8(Q4V)
local real Y5=GetUnitX(m5)
local real Z5=GetUnitY(m5)
local real t5=GetUnitX(RSX)
local real w5=GetUnitY(RSX)
local real l4=Atan2(Z5-w5,Y5-t5)
local real C9X=L1V(GetUnitX(RSX)+30*Cos(l4))
local real DVX=L2V(GetUnitY(RSX)+30*Sin(l4))
local unit QJV
local integer JFV=GetUnitAbilityLevel(K8V,('A0HW'))
if O8(K3V,"TrailNext")then
call O7(K3V,"TrailNext",false)
set QJV=CreateUnit(GetOwningPlayer(K8V),('h002'),t5,w5,0)
call SetUnitAbilityLevel(QJV,('A0I2'),JFV)
call SetUnitAbilityLevel(QJV,('A0HY'),JFV)
call UnitApplyTimedLife(QJV,'BTLF',$C)
else
call O7(K3V,"TrailNext",true)
endif
call SetUnitX(RSX,C9X)
call SetUnitY(RSX,DVX)
call SetUnitFacing(RSX,l4*bj_RADTODEG)
set ax=IUX
set Me=K8V
set Pe=50*GetUnitAbilityLevel(K8V,('A0HW'))
if IVV then
set Pe=Pe*2
endif
call GroupEnumUnitsInRange(S8V,C9X,DVX,$96,LIX)
call ForGroup(S8V,function OKO)
call KGV(S8V)
if(C9X-Y5)*(C9X-Y5)+(DVX-Z5)*(DVX-Z5)<$640 then
call PauseTimer(t)
call b8(Q4V)
call a7(K3V)
call KillUnit(RSX)
call KGV(IUX)
endif
