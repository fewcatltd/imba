call SetUnitState(s,UNIT_STATE_MAX_MANA,GetUnitState(s,UNIT_STATE_MAX_MANA)*1.10)
set u=CreateUnit(GetOwningPlayer(s),'n00L',GetUnitX(s),GetUnitY(s),0)
set ROSHT=s
set ROSHF=u
