function OOI takes nothing returns nothing
local unit s=DHV(GetTriggeringTrigger(),'s')
local player p=GetOwningPlayer(s)
if GetTriggerEventId()==EVENT_UNIT_DEATH then
if IsUnitType(s,UNIT_TYPE_HERO)==false or IsUnitIllusion(s)or J then
call GDV()
endif
else
if GetAIDifficulty(p)==AI_DIFFICULTY_NEWBIE then
call OXI(s,true,GetUnitState(s,UNIT_STATE_MAX_LIFE)*.005)
call OXI(s,false,GetUnitState(s,UNIT_STATE_MAX_MANA)*.005)
elseif GetAIDifficulty(p)==AI_DIFFICULTY_NORMAL then
call OXI(s,true,GetUnitState(s,UNIT_STATE_MAX_LIFE)*.01)
call OXI(s,false,GetUnitState(s,UNIT_STATE_MAX_MANA)*.01)
else
call OXI(s,true,GetUnitState(s,UNIT_STATE_MAX_LIFE)*.015)
call OXI(s,false,GetUnitState(s,UNIT_STATE_MAX_MANA)*.015)
endif
if(IsPlayerAlly(p,Player(0))and IsUnitVisible(s,Player(6)))or(IsPlayerAlly(p,Player(6))and IsUnitVisible(s,Player(0)))then
if GetAIDifficulty(p)==AI_DIFFICULTY_NEWBIE then
call OXI(s,true,GetUnitState(s,UNIT_STATE_MAX_LIFE)*.005)
call OXI(s,false,GetUnitState(s,UNIT_STATE_MAX_MANA)*.005)
elseif GetAIDifficulty(p)==AI_DIFFICULTY_NORMAL then
call OXI(s,true,GetUnitState(s,UNIT_STATE_MAX_LIFE)*.01)
call OXI(s,false,GetUnitState(s,UNIT_STATE_MAX_MANA)*.01)
else
call OXI(s,true,GetUnitState(s,UNIT_STATE_MAX_LIFE)*.015)
call OXI(s,false,GetUnitState(s,UNIT_STATE_MAX_MANA)*.015)
endif
endif
endif
set p=null
set s=null
endfunction
function ORI takes nothing returns nothing
local group g=KHV()
local boolexpr b=Condition(function j6)
local unit s=null
local trigger t=null
call FIV()
set s=Q
if F1V(s,"HasRegisterDmgTrigger")==false then
call FHV(s,"HasRegisterDmgTrigger",true)
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DAMAGED)
if IsUnitType(s,UNIT_TYPE_HERO)==false or IsUnitIllusion(s)==false or J then
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
endif
call TriggerAddCondition(t,Condition(function ZMR))
set t=null
endif
call GroupEnumUnitsOfPlayer(g,A7V[0],b)
loop
set s=FirstOfGroup(g)
exitwhen s==null
if F1V(s,"HasRegisterDmgTrigger")==false and GetUnitAbilityLevel(s,'Aloc')==0 then
call FHV(s,"HasRegisterDmgTrigger",true)
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DAMAGED)
if IsUnitType(s,UNIT_TYPE_HERO)==false or IsUnitIllusion(s)==false or J then
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
endif
call TriggerAddCondition(t,Condition(function ZMR))
set t=null
endif
call GroupRemoveUnit(g,s)
endloop
call GroupEnumUnitsOfPlayer(g,A8V[0],b)
loop
set s=FirstOfGroup(g)
exitwhen s==null
if F1V(s,"HasRegisterDmgTrigger")==false and GetUnitAbilityLevel(s,'Aloc')==0 then
call FHV(s,"HasRegisterDmgTrigger",true)
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DAMAGED)
if IsUnitType(s,UNIT_TYPE_HERO)==false or IsUnitIllusion(s)==false or J then
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
endif
call TriggerAddCondition(t,Condition(function ZMR))
set t=null
endif
call GroupRemoveUnit(g,s)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
function OII takes nothing returns nothing
local trigger t=null
local unit s=GetTriggerUnit()
local integer id=GetUnitTypeId(s)
local integer FMX=GetPlayerId(GetOwningPlayer(s))
if IsHeroUnitId(GetUnitTypeId(s))or id=='n004' or id=='n018' or id=='n01C' or id=='n01G'then
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.25,true)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function XSE))
call DFV(t,'Sour',s)
set t=null
endif
if IsUnitType(s,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(s,'Aloc')==0 then
call HVV(s,0)
endif
if F1V(s,"HasRegisterDmgTrigger")==false and GetUnitAbilityLevel(s,'Aloc')==0 then
call FHV(s,"HasRegisterDmgTrigger",true)
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DAMAGED)
if IsUnitType(s,UNIT_TYPE_HERO)==false or IsUnitIllusion(s)or J then
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
endif
call TriggerAddCondition(t,Condition(function ZMR))
set t=null
endif
if XPV and GetPlayerController(GetOwningPlayer(s))==MAP_CONTROL_COMPUTER and IsUnitOwnedByPlayer(s,A7V[0])==false and IsUnitOwnedByPlayer(s,A8V[0])==false then
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function OOI))
call DFV(t,'s',s)
set t=null
endif
if IsUnitIllusion(s)then
call XZI()
endif
set s=null
endfunction
function OAI takes nothing returns boolean
if GetUnitTypeId(GetTriggerUnit())=='efon' then
call UnitAddAbility(GetTriggerUnit(),'Amim')
endif
if GetUnitAbilityLevel(GetTriggerUnit(),'A0BF')>0 then
call UnitRemoveAbility(GetTriggerUnit(),'Aloc')
call ShowUnit(GetTriggerUnit(),false)
call ShowUnit(GetTriggerUnit(),true)
call UnitAddAbility(GetTriggerUnit(),'Aloc')
endif
call OII()
if IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) and IsUnitIllusion(GetTriggerUnit())==false and O8(GetHandleId(GetTriggerUnit()),"EnteredAlready")==false and E_E(GetTriggerUnit())and GetUnitAbilityLevel(GetTriggerUnit(),'Aloc')==0 then
call OLE()
endif
return false
endfunction
