loop
exitwhen i>$A
if id==Ac[IPV[4+i]]then
return true
endif
set i=i+1
endloop
return false
endfunction
function VEI takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'s')
local item it=CreateItem(DTV(tm,'d'),0,0)
local integer i=0
call SetItemPlayer(it,GetOwningPlayer(s),false)
call UnitAddItem(s,it)
loop
exitwhen i>5
if it==UnitItemInSlot(s,i)then
if UnitItemInSlot(s,DTV(tm,'i'))==null then
call UnitDropItemSlot(s,it,DTV(tm,'i'))
endif
set tm=null
set s=null
set it=null
call FIV()
return
endif
set i=i+1
endloop
call RemoveItem(it)
if DZV(tm,'b')==false then
call DYV(tm,'b',true)
call TimerStart(tm,.25,true,function VEI)
endif
set tm=null
set s=null
set it=null
endfunction
function VXI takes unit s,integer id,integer i returns nothing
