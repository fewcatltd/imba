function LJR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local unit m5=Y7(K3V,"Target")
local unit QJV=Y7(K3V,"Caster")
local real d=v6(GetUnitX(p5),GetUnitY(p5),GetUnitX(m5),GetUnitY(m5))
local real a
local real PNV=X8(K3V,"Duration")
local real EQO=X8(K3V,"rRealX0")
local real ESO=X8(K3V,"rRealY0")
local real QIX
local real QAX
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetTriggerEvalCount(t)>R2I(20*PNV)then
call DestroyEffect(r8(K3V,"FX"))
call a7(K3V)
call KJV(t)
call KillUnit(QJV)
call SetUnitPathing(m5,true)
call MMV(GetUnitX(m5),GetUnitY(m5),$AF)
else
call SetUnitX(QJV,GetUnitX(p5))
call SetUnitY(QJV,GetUnitY(p5))
if v6(EQO,ESO,GetUnitX(p5),GetUnitY(p5))>400+99999*C0V(H3V(p5))then
call DestroyEffect(r8(K3V,"FX"))
call a7(K3V)
call KJV(t)
call KillUnit(QJV)
call SetUnitPathing(m5,true)
call MMV(GetUnitX(m5),GetUnitY(m5),$AF)
else
call E7(K3V,"rRealX0",GetUnitX(p5))
call E7(K3V,"rRealY0",GetUnitY(p5))
if d>100 then
set a=Atan2(GetUnitY(m5)-GetUnitY(p5),GetUnitX(m5)-GetUnitX(p5))
set QIX=GetUnitX(p5)+100*Cos(a)
set QAX=GetUnitY(p5)+100*Sin(a)
if(IsPointInRegion(AL,((QIX)*1.),((QAX)*1.)))==false then
call SetUnitX(m5,QIX)
