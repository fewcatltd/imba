local real G7R=X8(K3V,"SourceX")
local real G8R=X8(K3V,"SourceY")
local real G9R=L1V(G7R+30*Cos(G6R))
local real HVR=L2V(G8R+30*Sin(G6R))
local group g=null
local boolexpr b=null
if H3V(Y7(K3V,"Hero"))then
set G6R=Atan2(G5R-G8R,G4R-G7R)
set G9R=L1V(G7R+30*Cos(G6R))
set HVR=L2V(G8R+30*Sin(G6R))
