function GEX takes nothing returns nothing
local unit K8V=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer JFV=GetUnitAbilityLevel(K8V,'A0G6')
local unit QJV
local location CFE
local real l4
local integer FDX=B7V(K8V,true)
local integer FFX=B6V(K8V,true)
local real GXX=I2R(FDX)/ I2R(FFX)
local real GOX=I2R(FFX)/ I2R(FDX)
local real GRX
local real GIX
local real GAX
local real GNX
local real HSV
local real GBX
local integer GCX
local integer GDX
local integer GFX
local string GGX
local string GHX
local string GJX
if GXX<.5 then
set GRX=.25
set GIX=0
elseif GXX>1.5 then
set GRX=.75*JFV
set GIX=0
else
set GRX=.25+(GXX-.5)*(.75*JFV-.25)
set GIX=0
endif
if GOX<.5 then
set GAX=.25
set GNX='d'
elseif GOX>1.5 then
set GAX=.75*JFV
set GNX=300
else
set GNX='d'+(GOX-.5)*$C8
set GAX=.25+(GOX-.5)*(.75*JFV-.25)
endif
if IVV then
set GRX=.75*JFV
set GIX=0
set GNX=300
set GAX=.75*JFV
endif
set HSV=GIX+GRX*FDX
set GBX=GAX
set GCX=R2I(GBX)
set GDX=R2I($A*GBX-GCX*$A)
set GFX=R2I('d'*GBX-GDX*$A-GCX*'d')
set GGX=I2S(GCX)
set GHX=I2S(GDX)
set GJX=I2S(GFX)
set l4=Atan2(GetUnitY(m5)-GetUnitY(K8V),GetUnitX(m5)-GetUnitX(K8V))
set CFE=Location(GetUnitX(m5)+GNX*Cos(l4),GetUnitY(m5)+GNX*Sin(l4))
call SetUnitPositionLoc(m5,CFE)
call MMV(GetLocationX(CFE),GetLocationY(CFE),$C8)
call RemoveLocation(CFE)
call MHV("|c001ce6b9+"+I2S(R2I(HSV))+"|r |c00ff0303+"+GGX+"."+GHX+GJX+"|r",1,m5,.023,$FF,$FF,$FF,$D8)
call HPV(K8V,m5,2,HSV)
call QHV(K8V,m5,GBX)
set K8V=null
set m5=null
set QJV=null
set CFE=null
endfunction
function GKX takes nothing returns nothing
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local integer i=GetUnitAbilityLevel(s,'A0G6')
local integer x=B6V(s,true)
local integer y=B7V(s,true)
local real r=x*1./(x+y)
local real d=y*RMaxBJ(1.5*i*(1-r),.25)
local real t=RMaxBJ(1.5*i*r,.25)
local real l=$C8*r+'d'
local real a=HYV(s,u)
local real x1=GetUnitX(u)+Cos(a)*l
local real y1=GetUnitY(u)+Sin(a)*l
call SetUnitPosition(u,x1,y1)
call QDV(u,t,false)
call HPV(s,u,2,d)
call MHV("|c001ce6b9+"+I2S(R2I(d))+"|r |c00ff0303+"+R2S(t)+"|r",1,u,.023,$FF,$FF,$FF,$D8)
set s=null
set u=null
endfunction
