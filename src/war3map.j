local real io=GetUnitY(p5)
local real IN=GetUnitFacing(p5)
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerAddCondition(t,Condition(function Ii))
call E7(K3V,"Speed",Ij)
call A7(K3V,"Target",m5)
call X7(K3V,"Callback",In)
call A7(K3V,"Source",p5)
call A7(K3V,"Projectile",CreateUnit(GetOwningPlayer(p5),IM,iN,io,IN))
set eC=t
set t=null
return eC
endfunction
