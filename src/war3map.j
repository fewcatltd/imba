function PGE takes boolean PHE,integer PJE,real tempogaga returns nothing
local integer i=0
if EDV[PJE]==false then
set EFV=EFV+1
set EDV[PJE]=true
loop
exitwhen i>$B
set EBV[i]=false
set ECV[i]=false
set i=i+1
endloop
if PHE then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,"Switch expired!")
endif
endif
endfunction
function PKE takes nothing returns nothing
local integer i=0
set EFV=EFV+1
loop
exitwhen i>$B
set EBV[i]=false
set ECV[i]=false
set i=i+1
endloop
endfunction
function PLE takes nothing returns boolean
local string PME=GetEventPlayerChatString()
local player p=GetTriggerPlayer()
local integer PJE=(1+GetPlayerId(p))
local boolean PPE=false
local string array PQE
local integer i=1
local player array PSE
local integer PTE=0
local integer PUE
local integer PWE
local boolean PYE=false
local player PZE
local player P_E
local integer P0E=0
local player P1E
local integer P2E=0
local boolean P3E=false
local boolean P4E=false
local string array P5E
loop
exitwhen i>$B
if ECV[i] then
if P3E==false then
set P3E=true
set PZE=Player(i-1)
set P2E=P2E+1
elseif P4E==false then
set P4E=true
set P_E=Player(i-1)
set P2E=P2E+1
endif
endif
if GetPlayerController(Player(i))==MAP_CONTROL_USER and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and Player(i)!=null then
set PTE=PTE+1
endif
set i=i+1
endloop
if P2E>0 then
set PYE=true
endif
set PTE=1
set P0E=PTE
set i=0
loop
exitwhen i>5
if A7V[i]==p then
set PPE=true
endif
set i=i+1
endloop
set i=1
if PPE then
loop
exitwhen i>5
if A8V[i]!=null then
set PSE[PTE]=A8V[i]
set PTE=PTE+1
endif
set i=i+1
endloop
else
loop
exitwhen i>5
if A7V[i]!=null then
set PSE[PTE]=A7V[i]
set PTE=PTE+1
endif
set i=i+1
endloop
endif
if PSE[1]==Player(7)then
set P5E[1]="|cffff59ff"
set P5E[2]="|cff808080"
set P5E[3]="|cff6c6cb7"
set P5E[4]="|cff003700"
set P5E[5]="|cff3c0000"
else
set P5E[1]="|cff0000dd"
set P5E[2]="|cff408080"
set P5E[3]="|cff400080"
set P5E[4]="|cffffff00"
set P5E[5]="|cffff8000"
endif
set i=1
loop
exitwhen i>5
if PSE[i]!=null then
set PQE[i]="Type |cff8080c0-kickquit "+I2S(i)+"|r "+"to switch with player "+P5E[i]+GetPlayerName(PSE[i])+"|r"
endif
set i=i+1
endloop
if PME=="-wedrwertw" then
set i=1
loop
exitwhen i>5
if PQE[i]!=null then
call DisplayTextToForce(BLV(p),PQE[i])
else
call DisplayTextToForce(BLV(p),"")
endif
set i=i+1
endloop
endif
