set d=RMaxBJ(d,d-$C8)
set d=d/(OCE-l)
set x=FXV(x+Cos(a)*d)
set y=FOV(y+Sin(a)*d)
call SetUnitX(s,x)
call SetUnitY(s,y)
set OCE=OCE/2
call SetUnitFlyHeight(s,(400-(OCE-l)*(OCE-l)),0)
endif
endif
set t=null
set s=null
set u=null
endfunction
