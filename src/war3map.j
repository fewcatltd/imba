function D9X takes unit u,real x1,real y1,integer i returns nothing
local group g=null
local boolexpr b=null
local unit f=null
local trigger t=null
local integer n=0
set g=CreateGroup()
set b=Condition(function PTV)
set AUV=u
call GroupEnumUnitsInRange(g,x1,y1,425,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerAddCondition(t,Condition(function D8X))
set n=$A*i
call DFV(t,'u',f)
call DPV(t,'aatk',n)
call G6V(f,n)
call HEV(f)
call DUV(f,'A042',ITV+$A)
set t=null
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
function FVX takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local integer n=DTV(t,'Loop')
local integer l=DTV(t,'Levl')
local unit u=null
local group g=CreateGroup()
local boolexpr b=Condition(function PJV)
local real x=0
local real y=0
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call GDV()
call DestroyGroup(g)
call DestroyBoolExpr(b)
set t=null
set s=null
set g=null
set b=null
return
endif
set AUV=s
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),700,b)
set u=GroupPickRandomUnit(g)
if u!=null then
set x=GetUnitX(u)
set y=GetUnitY(u)
call HBV("effects\\Eclipse.mdx",x,y,3)
call D9X(s,x,y,l)
if IVV then
call Q_V(s,x,y,375,l*75+H4V(s,1.5),1)
endif
endif
call DestroyGroup(g)
call DestroyBoolExpr(b)
call DQV(t,'Loop',-1)
if DTV(t,'Loop')<1 then
call GDV()
endif
set t=null
set s=null
set u=null
set g=null
set b=null
endfunction
