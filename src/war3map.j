endif
call IssuePointOrderById(QJV,$D01F9,x,y)
call A7(K3V,"Caster",QJV)
call A7(K3V,"Shadow1",CreateUnit(GetOwningPlayer(p5),'h06R',x,y,0))
call A7(K3V,"Shadow2",CreateUnit(GetOwningPlayer(p5),'h06R',x,y,0))
call A7(K3V,"Shadow3",CreateUnit(GetOwningPlayer(p5),'h06R',x,y,0))
call A7(K3V,"Shadow4",CreateUnit(GetOwningPlayer(p5),'h06R',x,y,0))
