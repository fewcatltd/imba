return P0V()and GetUnitAbilityLevel(GetFilterUnit(),'B028')==0
endfunction
function PoisonNova_Iterate takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit K8V=Y7(K3V,"Hero")
local integer AJO=E8(K3V,"NovaLevel")
local real r=X8(K3V,"r")
local group g
local integer i=$D+C0V(H3V(K8V))*26
if GetTriggerEvalCount(t)>i then
call a7(K3V)
call KJV(t)
else
set r=r+53
call E7(K3V,"r",r)
set g=KHV()
set xL=K8V
set Sl=AJO
call GroupEnumUnitsInRange(g,GetUnitX(K8V),GetUnitY(K8V),r,Condition(function AHO))
call ForGroup(g,function AGO)
call KGV(g)
endif
set t=null
set K8V=null
set g=null
return false
endfunction
function AKO takes nothing returns nothing
local unit K8V=GetTriggerUnit()
local integer AJO
local integer i=1
local real x=GetUnitX(K8V)
local real y=GetUnitY(K8V)
local unit oA
set AJO=GetUnitAbilityLevel(K8V,'A013')
if AJO==0 then
set AJO=GetUnitAbilityLevel(K8V,'A0A6')+1
endif
loop
exitwhen i>18
set oA=CreateUnit(GetOwningPlayer(K8V),'e017',x,y,0)
if(GetPlayerController(GetOwningPlayer(K8V))==MAP_CONTROL_COMPUTER)then
call RemoveGuardPosition(oA)
endif
call UnitAddAbility(oA,'A057')
call SetUnitAbilityLevel(oA,'A057',AJO)
call IssuePointOrderById(oA,$D0012,x+(675+675*2*C0V(H3V(K8V)))*Cos(i*20*bj_DEGTORAD),y+(675+675*2*C0V(H3V(K8V)))*Sin(i*20*bj_DEGTORAD))
call UnitApplyTimedLife(oA,'BTLF',1.15+2.35*C0V(H3V(K8V)))
set i=i+1
endloop
set K8V=null
set oA=null
endfunction
function ALO takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetTriggerEvalCount(t)>48 then
call DestroyEffect(D2V(t,'e'))
call GDV()
else
call HPV(DHV(t,'s'),DHV(t,'u'),1+C0V(IsUnitType(DHV(t,'u'),UNIT_TYPE_MAGIC_IMMUNE)),DWV(t,'d')*.25+H4V(DHV(t,'s'),$A))
endif
set t=null
endfunction
function AMO takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local trigger z=null
local unit s=DHV(t,'Sour')
local integer i=DTV(t,'Levl')
local group g=DKV(t,'have')
local group g1=null
local group g2=null
local integer l=0
local real r=0
local real x=0
local real y=0
local unit f=null
local unit u=null
local boolexpr b=null
if GetTriggerEvalCount(t)>46 then
loop
exitwhen l>17
call KillUnit(DHV(t,l))
set l=l+1
endloop
call DestroyGroup(g)
call GDV()
else
set g1=CreateGroup()
set g2=CreateGroup()
set b=Condition(function PJV)
set AUV=s
loop
exitwhen l>17
set u=DHV(t,l)
set r=GetUnitFacing(u)*bj_DEGTORAD
set x=L1V(GetUnitX(u)+Cos(r)*13.05)
set y=L2V(GetUnitY(u)+Sin(r)*13.05)
call SetUnitX(u,x)
call SetUnitY(u,y)
call GroupEnumUnitsInRange(g2,x,y,$AF,b)
call GroupAddGroup(g2,g1)
call GroupClear(g2)
set l=l+1
endloop
loop
set f=FirstOfGroup(g1)
exitwhen f==null
if IsUnitInGroup(f,g)==false and GUV(f)==null then
set z=CreateTrigger()
call TriggerRegisterUnitEvent(z,f,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(z,.25,true)
call TriggerAddCondition(z,Condition(function ALO))
call DFV(z,'s',s)
call DFV(z,'u',f)
call D1V(z,'e',AddSpecialEffectTarget("effects\\PoisonHands.mdx",f,"overhead"))
call DUV(z,'d',GetUnitState(f,UNIT_STATE_MAX_LIFE)*.04+20*i)
call GroupAddUnit(g,f)
endif
call GroupRemoveUnit(g1,f)
endloop
call DestroyGroup(g1)
call DestroyGroup(g2)
call DestroyBoolExpr(b)
set g1=null
set g2=null
set b=null
set z=null
endif
set t=null
set s=null
set g=null
endfunction
function APO takes integer i returns nothing
local unit s=GetTriggerUnit()
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local unit f=null
local trigger t=CreateTrigger()
local integer l=0
set i=i+GetUnitAbilityLevel(s,GetSpellAbilityId())
loop
exitwhen l>17
set f=CreateUnit(GetOwningPlayer(s),'e017',x,y,20*l)
call CPV(f,true)
call DFV(t,l,f)
set l=l+1
endloop
call DFV(t,'Sour',s)
call DPV(t,'Levl',i)
call DJV(t,'have',CreateGroup())
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function AMO))
set t=null
set s=null
set f=null
endfunction
