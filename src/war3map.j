call DFV(tm,'u',f)
if l==1 then
call DestroyGroup(g)
call FIV()
else
call DPV(tm,'l',l-1)
endif
set f=null
endif
set tm=null
set s=null
set u=null
set g=null
set g1=null
endfunction
