function VSI takes nothing returns nothing
local unit s=GetSummoningUnit()
local unit u=GetSummonedUnit()
local trigger t=null
local integer i=0
if s==IUV then
set IWV=u
endif
if GetUnitTypeId(u)==qt[21]then
call VQI(u)
endif
if GetUnitAbilityLevel(s,'AIil')>0 then
call DUV(u,'BIil',.35)
elseif GetUnitAbilityLevel(s,'A08Q')>0 then
call DUV(u,'BIil',.15+.1*GetUnitAbilityLevel(s,'A08Q'))
elseif GetUnitAbilityLevel(s,'A0DD')>0 then
call DUV(u,'BIil',.25)
elseif GetUnitAbilityLevel(s,'A0GR')>0 then
call DUV(u,'BIil',.35)
elseif GetUnitAbilityLevel(s,'A1ML')>0 then
call DUV(u,'BIil',.4)
elseif GetUnitAbilityLevel(s,'A968')>0 then
call DUV(u,'BIil',1)
elseif GetUnitAbilityLevel(s,'AA70')+GetUnitAbilityLevel(s,'AA71')+GetUnitAbilityLevel(s,'AA72')>0 then
call DUV(u,'BIil',.25)
elseif GetUnitAbilityLevel(s,'AA7D')>0 then
call DUV(u,'BIil',.5)
endif
set i=GetUnitTypeId(u)
if i=='osp4' or i=='o008' or i=='o009' or i=='o01C' or i=='o01D' or i=='o01E' then
call DUV(u,'A0A1',ITV+45)
endif
set s=null
set u=null
endfunction
