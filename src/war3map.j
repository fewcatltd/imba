function R7O takes unit s,unit u,boolean x returns nothing
local integer i=GetUnitAbilityLevel(s,'A046')
local group g=CreateGroup()
local boolexpr b=Condition(function PJV)
set AUV=s
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",u,"chest"))
call HPV(s,u,1,60+50*i)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),$E1,b)
call GroupRemoveUnit(g,u)
if x then
call J6V(u,'AB72','B972',4,0,-2-2*C0V(i>2),0,0,0,0,0)
call HPV(s,u,1,60+50*i)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",u,"chest"))
endif
if IVV then
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitAlly(u,GetOwningPlayer(s))==false then
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",u,"chest"))
call J6V(u,'AB72','B972',4,0,-1-C0V(i>2),0,0,0,0,0)
call HPV(s,u,1,30+25*i)
endif
call GroupRemoveUnit(g,u)
endloop
endif
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
