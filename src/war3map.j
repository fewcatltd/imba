local integer i=GetUnitAbilityLevel(s,'AA6Y')
local integer l=2+2*i
local real r=60+40*i
local boolexpr b=Condition(function E6I)
local unit f=s
loop
exitwhen u==null
if IsUnitAlly(u,GetOwningPlayer(s))then
call H0V(f,u,.45,"HWPB",false)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl",u,"origin"))
call HGV(u,true,r)
else
call H0V(f,u,.45,"ETHE",false)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\ForkedLightningOrange.mdx",u,"origin"))
call HPV(s,u,1,r)
endif
set l=l-1
exitwhen l<1
call N8V(.4)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),425,b)
call GroupRemoveUnit(g,u)
set f=u
set u=GroupPickRandomUnit(g)
set r=r*1.1
endloop
call KGV(g)
set f=null
set u=null
set s=null
endfunction
