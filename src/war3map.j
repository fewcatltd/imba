function K7V takes unit K8V returns integer
local integer x
local integer id=GetUnitTypeId(K8V)
if id=='H904' or id=='H905' then
return 1
endif
if id=='H908' then
return 2
endif
set x=1
loop
exitwhen x>vT
if id==Zt[x]then
return 2
endif
set x=x+1
endloop
set x=1
loop
exitwhen x>xT
if id==eT[x]then
return 3
endif
set x=x+1
endloop
set x=1
loop
exitwhen x>rT
if id==oT[x]then
return 1
endif
set x=x+1
endloop
if id=='Eevm' or id=='N02B' or id=='N017' or id=='N013' or id=='N014' or id=='N015' then
return 2
endif
if id=='N01H' or id=='N01T' or id=='N01J' or id=='H00E' or id=='H00G' or id=='H00F' or id=='H07I' or id=='E015' then
return 3
endif
if id=='H06X' or id=='H06Y' or id=='H06W' or id=='H0BC' or id=='H08D' or id=='H08C' or id=='H084' or id=='H08B' or id=='O017'or id=='L005' then
return 1
endif
return 0
endfunction
function Ld takes unit K8V returns integer
local integer Hm=K7V(K8V)
if Hm==1 then
return B8V(K8V,true)
endif
if Hm==2 then
return B7V(K8V,true)
endif
if Hm==3 then
return B6V(K8V,true)
endif
return 0
endfunction
function K9V takes unit s returns integer
local integer id=GetUnitTypeId(s)
return(F_V(Player(0),"Nim&Kc^atta>,<ESaBTinu"+I2S(id))+F_V(Player(0),"Xamk%%Catta??esAbt%&inU"+I2S(id)))/2
endfunction
