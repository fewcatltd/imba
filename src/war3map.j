function A1O takes nothing returns nothing
local integer JFV
local unit p5=GetTriggerUnit()
local unit QJV
if GetUnitTypeId(p5)=='u017' or GetUnitTypeId(p5)=='u019' or GetUnitTypeId(p5)=='u018' or GetUnitTypeId(p5)=='u01A' or GetUnitTypeId(p5)=='u01B' or GetUnitTypeId(p5)=='u01C' then
return
endif
set QJV=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(p5),GetUnitY(p5),0)
if GetUnitTypeId(p5)=='u014' or GetUnitTypeId(p5)=='u01D' then
set JFV=1
elseif GetUnitTypeId(p5)=='u015' or GetUnitTypeId(p5)=='u01E' then
set JFV=2
else
set JFV=3
endif
call UnitAddAbility(QJV,'A1NF')
call SetUnitAbilityLevel(QJV,'A1NF',JFV)
call IssueImmediateOrderById(QJV,$D009F)
set p5=null
set QJV=null
endfunction
function PPv takes nothing returns boolean
local integer MLE
local integer K3V
local integer JFV
local unit A2O=null
if GetUnitTypeId(GetAttacker())=='u014' or GetUnitTypeId(GetAttacker())=='u015' or GetUnitTypeId(GetAttacker())=='u016' or GetUnitTypeId(GetAttacker())=='u01D' or GetUnitTypeId(GetAttacker())=='u01E' or GetUnitTypeId(GetAttacker())=='u01F' then
set A2O=GetAttacker()
set K3V=GetHandleId(GetAttacker())
set JFV=E8(K3V,"Level")
set MLE=E8(K3V,"Remaining")
set MLE=IMaxBJ(MLE-1,0)
call n7(K3V,"Remaining",MLE)
call Q6V(A2O,MLE*(9+3*JFV))
set A2O=null
endif
return false
endfunction
function A3O takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit A2O=Y7(K3V,"Source")
local unit p5=A2O
local integer JFV=E8(K3V,"Level")
local integer T8=E8(K3V,"Counter")
local integer MLE=E8(GetHandleId(A2O),"Remaining")
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call a7(K3V)
call KJV(t)
else
set T8=T8+1
call n7(K3V,"Counter",T8)
if ModuloInteger(T8,$F)==0 then
set MLE=IMinBJ(MLE+1,7)
call n7(GetHandleId(A2O),"Remaining",MLE)
endif
if GetUnitTypeId(p5)=='u017' or GetUnitTypeId(p5)=='u019' or GetUnitTypeId(p5)=='u018' or GetUnitTypeId(p5)=='u01A' or GetUnitTypeId(p5)=='u01B' or GetUnitTypeId(p5)=='u01C' then
set MLE=7
call n7(GetHandleId(A2O),"Remaining",MLE)
endif
call Q6V(A2O,MLE*(9+3*JFV))
if GetUnitTypeId(A2O)=='u017' or GetUnitTypeId(A2O)=='u019' or GetUnitTypeId(A2O)=='u018' or GetUnitTypeId(A2O)=='u01A' or GetUnitTypeId(A2O)=='u01B' or GetUnitTypeId(A2O)=='u01C' then
call SetUnitState(A2O,UNIT_STATE_LIFE,GetUnitState(A2O,UNIT_STATE_LIFE)+31.25+18.75*JFV)
call UnitAddAbility(A2O,'Avul')
else
call UnitRemoveAbility(A2O,'Avul')
endif
endif
set t=null
set A2O=null
return false
endfunction
function A4O takes nothing returns boolean
if GetUnitTypeId(GetFilterUnit())=='u014' or GetUnitTypeId(GetFilterUnit())=='u015' or GetUnitTypeId(GetFilterUnit())=='u016' or GetUnitTypeId(GetFilterUnit())=='u01D' or GetUnitTypeId(GetFilterUnit())=='u01E' or GetUnitTypeId(GetFilterUnit())=='u01F' or GetUnitTypeId(GetFilterUnit())=='u017' or GetUnitTypeId(GetFilterUnit())=='u019' or GetUnitTypeId(GetFilterUnit())=='u018' or GetUnitTypeId(GetFilterUnit())=='u01A' or GetUnitTypeId(GetFilterUnit())=='u01B' or GetUnitTypeId(GetFilterUnit())=='u01C' then
call KillUnit(GetFilterUnit())
endif
return false
endfunction
function A5O takes nothing returns nothing
local group g=KHV()
local unit p5=GetTriggerUnit()
local real x=GetUnitX(p5)
local real y=GetUnitY(p5)
local integer JFV=GetUnitAbilityLevel(p5,'A1NE')
local unit A6O
local unit A7O
local trigger t
local integer K3V
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(p5),Condition(function A4O))
call KGV(g)
if JFV==1 then
set A6O=CreateUnit(GetOwningPlayer(p5),'u014',x+75,y+75,GetUnitFacing(p5))
set A7O=CreateUnit(GetOwningPlayer(p5),'u01D',x-75,y-75,GetUnitFacing(p5))
elseif JFV==2 then
set A6O=CreateUnit(GetOwningPlayer(p5),'u015',x+75,y+75,GetUnitFacing(p5))
set A7O=CreateUnit(GetOwningPlayer(p5),'u01E',x-75,y-75,GetUnitFacing(p5))
elseif JFV==3 then
set A6O=CreateUnit(GetOwningPlayer(p5),'u016',x+75,y+75,GetUnitFacing(p5))
set A7O=CreateUnit(GetOwningPlayer(p5),'u01F',x-75,y-75,GetUnitFacing(p5))
endif
call SelectUnitAddForPlayer(A6O,GetOwningPlayer(p5))
call SelectUnitAddForPlayer(A7O,GetOwningPlayer(p5))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",A6O,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",A7O,"origin"))
set t=CreateTrigger()
set K3V=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterUnitEvent(t,A6O,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function A3O))
call A7(K3V,"Source",A6O)
call n7(K3V,"Level",JFV)
call n7(K3V,"Counter",0)
call n7(GetHandleId(A6O),"Remaining",7)
call n7(GetHandleId(A6O),"Level",JFV)
call Q6V(A6O,7*(9+3*JFV))
call G6V(A6O,50*JFV)
call G5V(A6O,-$A+20*JFV)
call HEV(A6O)
set t=CreateTrigger()
set K3V=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterUnitEvent(t,A7O,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function A3O))
call A7(K3V,"Source",A7O)
call n7(K3V,"Level",JFV)
call n7(K3V,"Counter",0)
call n7(GetHandleId(A7O),"Remaining",7)
call n7(GetHandleId(A7O),"Level",JFV)
call Q6V(A7O,7*(9+3*JFV))
call G6V(A7O,50*JFV)
call G5V(A7O,-$A+20*JFV)
call HEV(A7O)
set g=null
set p5=null
set A6O=null
set A7O=null
endfunction
function A8O takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local integer i=DTV(t,'i')
local integer l=DTV(t,'l')
local integer r=0
if GetWidgetLife(s)<1 then
call FIV()
else
if GetUnitTypeId(s)=='u017' or GetUnitTypeId(s)=='u019' or GetUnitTypeId(s)=='u018' or GetUnitTypeId(s)=='u01A' or GetUnitTypeId(s)=='u01B' or GetUnitTypeId(s)=='u01C' then
call SetUnitState(s,UNIT_STATE_LIFE,GetUnitState(s,UNIT_STATE_LIFE)+(31.25+18.75*i)*.5)
call UnitAddAbility(s,'Avul')
set r=DTV(s,'A1NE')
call G6V(s,-r)
set r=7*(9+3*i)
call G6V(s,r)
call DPV(s,'A1NE',r)
call HEV(s)
else
call UnitRemoveAbility(s,'Avul')
endif
set l=l+1
if l==$E then
set l=0
set r=DTV(s,'A1NE')
call G6V(s,-r)
set r=IMinBJ(r+7,7*(9+3*i))
call G6V(s,r)
call DPV(s,'A1NE',r)
call HEV(s)
endif
call DPV(t,'l',l)
endif
set t=null
set s=null
endfunction
function A9O takes nothing returns nothing
local group g=KHV()
local boolexpr b=Condition(function A4O)
local unit s=GetTriggerUnit()
local timer t=null
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local unit f=null
local integer i=GetUnitAbilityLevel(s,'A1NE')
local integer id='u014'+i-1
local real a=GetUnitFacing(s)
local integer l='AA8N'+i-1
local integer r=7*(9+3*i)
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(s),b)
call KGV(g)
call DestroyBoolExpr(b)
set f=CreateUnit(GetOwningPlayer(s),id,x+75,y+75,a)
set t=CreateTimer()
call TimerStart(t,.5,true,function A8O)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",f,"origin"))
if GetLocalPlayer()==GetOwningPlayer(s)then
call SelectUnit(f,true)
endif
call UnitAddAbility(f,l)
call UnitMakeAbilityPermanent(f,true,l)
call DFV(t,'s',f)
call DPV(t,'i',i)
call DPV(t,'l',0)
call DPV(f,'A1NE',r)
call G6V(f,r)
call HEV(f)
set id='u01D'+i-1
set f=CreateUnit(GetOwningPlayer(s),id,x-75,y-75,a)
set t=CreateTimer()
call TimerStart(t,.5,true,function A8O)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",f,"origin"))
if GetLocalPlayer()==GetOwningPlayer(s)then
call SelectUnit(f,true)
endif
call UnitAddAbility(f,l)
call UnitMakeAbilityPermanent(f,true,l)
call DFV(t,'s',f)
call DPV(t,'i',i)
call DPV(t,'l',0)
call DPV(f,'A1NE',r)
call G6V(f,r)
call HEV(f)
set t=null
set s=null
set f=null
set g=null
set b=null
endfunction
function Puv takes nothing returns boolean
if GetSpellAbilityId()=='A1NE' then
call A5O()
elseif GetSpellAbilityId()=='A1NB' or GetSpellAbilityId()=='A1NC' or GetSpellAbilityId()=='A1ND' or GetSpellAbilityId()=='A1NL' or GetSpellAbilityId()=='A1NM' or GetSpellAbilityId()=='A1NN' then
call A1O()
endif
return false
endfunction
function Y3V takes nothing returns nothing
call CZV('A1NE',"A9O")
call CZV('A1NB',"A1O")
call CZV('A1NC',"A1O")
call CZV('A1ND',"A1O")
call CZV('A1NL',"A1O")
call CZV('A1NM',"A1O")
call CZV('A1NN',"A1O")
endfunction
function PUv takes nothing returns boolean
return GetSpellAbilityId()=='A08X'
endfunction
function Pwv takes nothing returns nothing
local location CFE=GetUnitLoc(GetSpellAbilityUnit())
call CreateNUnitsAtLocFacingLocBJ(1,'e00E',GetOwningPlayer(GetSpellAbilityUnit()),CFE,CFE)
call RemoveLocation(CFE)
call UnitAddAbility(bj_lastCreatedUnit,'A09C')
call SetUnitAbilityLevelSwapped('A09C',bj_lastCreatedUnit,GetUnitAbilityLevelSwapped('A08X',GetSpellAbilityUnit()))
call IssueTargetOrderById(bj_lastCreatedUnit,$D0085,GetSpellAbilityUnit())
endfunction
function NVO takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local real r=DWV(t,'r')
local real l=GetWidgetLife(u)
if GetUnitAbilityLevel(u,'Bcri')==0 or GetUnitAbilityLevel(s,'Bcrs')==0 then
call UnitRemoveAbility(s,'Bcrs')
call FIV()
else
if l>r then
call SetWidgetLife(u,r)
set r=l-r
set r=r*.25
call HGV(s,true,r)
else
set r=r-l
set r=r*.25
call HGV(s,true,r)
endif
call DUV(t,'r',GetWidgetLife(u))
endif
set t=null
set s=null
set u=null
endfunction
function NEO takes nothing returns nothing
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local integer i=GetUnitAbilityLevel(s,'A08X')
local unit f=CreateUnit(GetOwningPlayer(s),'e00E',GetUnitX(s),GetUnitY(s),0)
local timer t=CreateTimer()
call UnitAddAbility(f,'A09C')
call SetUnitAbilityLevel(f,'A09C',i)
call IssueTargetOrderById(f,$D0085,s)
call TimerStart(t,.03,true,function NVO)
call DFV(t,'s',s)
call DFV(t,'u',u)
