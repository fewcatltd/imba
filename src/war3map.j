call FUV(p,"SAStr",F0V(p,"SAStr")-i)
call FUV(u,"SAStr",F0V(u,"SAStr")+i)
call FIV()
set tm=null
set p=null
set u=null
endfunction
function VAI takes nothing returns boolean
