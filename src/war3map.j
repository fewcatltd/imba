call LXV('H00F',$FF,$FF,$C8)
call LXV('H00G',$FF,$C8,$C8)
set cT[i]="Breath Fire is a strong nuke and farming ability. However, against difficult opponents, Dragon's Blood is very useful."
set CT[i]="Dragon Tail is the longest duration level 1 stun in the game. One point is usually sufficient until later on."
set DT[i]="Thanks to the defensive bonuses on Dragon's Blood, IsRealPlayer can often focus on other damage items instead of increasing armor and regeneration."
set fT[i]="Level 1 of Elder Dragon Form has a special passive called Corrosive Attack, which deals significant damage over time against towers."
set FT[i]="The ranged splash damage and slow of his Level 3 ultimate makes him extremely powerful; getting to level 16 is very important for DK."
set i=i+1
set qt[34]='Edem'
set IT[34]='h04T'
set Qt[34]='n0AR'
set RT[34]="ReplaceableTextures\\CommandButtons\\BTNHeroDemonHunter.blp"
call LQV(qt[34],"stand channel")
call LKV(qt[34],1,IT[34])
set cT[i]="Blink is very versatile, allowing you to chase, escape and even avoid certain spells. It is definitely worth at least one point in the beginning."
set CT[i]="You can also use Mana Break to prevent enemy heroes from casting spells on you, but be careful since it forces you to get in melee range to attack."
set DT[i]="Spell Shield might be useful for reducing magic damage, but it does not prevent you from being disabled or status effects (slow, poison, etc.)."
set fT[i]="Offensive items without orb effects such as a Battlefury, Monkey King Bar or Butterfly are usually desired over items that would override your Mana Break."
set FT[i]="Sometimes survivability is just as important as damage, items such as Linken's Sphere or Manta Style offer a good mix of both offense and defense."
set i=i+1
set qt[35]='Nbrn'
set IT[35]='h055'
set Qt[35]='n0AL'
set RT[35]="ReplaceableTextures\\CommandButtons\\BTNBansheeRanger.tga"
call LQV(qt[35],"spell")
call LKV(qt[35],1,IT[35])
set cT[i]="Frost Arrows make Drow an excellent chaser early game and allow her to harass opponents safely by manually casting them (clicking 'R' and the target)."
set CT[i]="An early level of Silence is great for preventing opponents from using multiple spells on you or your allies."
set DT[i]="Trueshot Aura and Marksmanship provide Traxex with plenty of damage even with just a few Wraith Bands and Power Treads."
set fT[i]="Lothar's Edge provides damage and an escape mechanism, the latter of which can help Traxex survive."
set FT[i]="Stay out of danger in major battles, only close in on your enemies when you are chasing and finishing off heroes near the end."
set i=i+1
set qt[36]='Harf'
set IT[36]='h04Z'
set Qt[36]='n0AS'
set RT[36]="ReplaceableTextures\\CommandButtons\\BTNArthas.blp"
call LQV(qt[36],"stand victory")
call LKV(qt[36],1.1,IT[36])
set cT[i]="Omniknight is a powerful support hero, items that provide mana such as Arcane Ring help make sure that you can use all your spells."
set CT[i]="Purification can be used offensively and defensively: The unit you cast it on will deal damage around it, making it a powerful heal and nuke."
set DT[i]="Degen Aura is a very strong passive slow that is useful both to chase down enemy heroes and help you and your allies escape as well."
set fT[i]="Repel is used to remove buffs from allies and enemies, and to prevent heroes with spells from being interrupted or damage dealers from being disabled."
set FT[i]="Guardian Angel makes a team nearly impervious to physical damage and provides 25/sec HP regeneration, use this time wisely to survive or attack."
set i=i+1
set qt[37]='H00D'
set IT[37]='h04S'
set Qt[37]='n0AK'
set RT[37]="ReplaceableTextures\\CommandButtons\\BTNBeastMaster.blp"
call LQV(qt[37],"spell slam")
call LKV(qt[37],1,IT[37])
set cT[i]="Endurance Aura is usually more useful later in the game when your team is fighting together, so get your other skills first."
set CT[i]="Call of the Wild is very powerful: The boar gives damage and slow, while the hawk can provide vision over runes, neutral creeps and other key locations."
set DT[i]="Wild Axes are more useful early game and against heroes with less armor. Destroy trees with Wild Axes to surprise your opponents and for escaping."
set fT[i]="Try casting Wild Axes behind the target to compensate for their movement. You can also manipulate their return path by moving Rexxar."
set FT[i]="Find opportunities to use Roar whenever it is available. It is useful on heroes who have an escape mechanism or are immune to magic."
set i=i+1
set qt[38]='E00P'
set IT[38]='h04R'
set Qt[38]='n0AJ'
set RT[38]="ReplaceableTextures\\CommandButtons\\BTNChimaera.blp"
call LQV(qt[38],"stand 3")
call LKV(qt[38],1,IT[38])
set cT[i]="Dual Breath and Ice Path help to make Jakiro a strong offensive and defensive support hero. "
set CT[i]="Jakiro can cast his spells immediately by clicking the nearby ground in the desired direction, sometimes this is more effective than clicking on the target."
set DT[i]="A level of Liquid Fire early on can be useful for deterring physical attacks "
set fT[i]="Macropyre is a slow but powerful spell, combine it with other spells (yours or a teammate) to make sure the opponent is standing in the area of effect."
set FT[i]="It is often a good idea to purchase useful support items like Mekansm or Shiva's Guard, two items that also increase his low armor significantly."
set i=i+1
set qt[39]='N01I'
set IT[39]='h054'
set Qt[39]='n0AI'
set RT[39]="ReplaceableTextures\\CommandButtons\\BTNHeroAlchemist.blp"
