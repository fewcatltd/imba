function B939 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=null
local unit u=DHV(t,'u')
local real Y3R=DWV(t,'dDef')
local real Y4R=DWV(t,'dAtk')
local integer iDef=DTV(t,'iDef')
local integer iAtk=DTV(t,'iAtk')
local group g=null
local boolexpr b=null
local unit f=null
local trigger tm=null
local boolean x=false
local integer i=DTV(t,'s')
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetUnitAbilityLevel(u,'B939')==0 then
call HEV(u)
call GDV()
else
set AUV=ie[i]
set s=AUV
set g=CreateGroup()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),DWV(u,'b939'),b)
call GroupRemoveUnit(g,u)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if IsUnitAlly(f,GetOwningPlayer(s))==false then
set x=true
if GetUnitAbilityLevel(f,'B939')==0 then
call J6V(f,'AB39','B939',1,0,0,0,0,0,0,0)
set tm=CreateTrigger()
call TriggerRegisterUnitEvent(tm,f,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(tm,.5,true)
call TriggerAddCondition(tm,RPV)
call DFV(tm,'u',f)
call DFV(tm,'s',s)
call DPV(t,'s',i)
call DUV(tm,'dDef',0)
call DUV(tm,'dAtk',0)
set tm=null
endif
call DUV(f,'b939',DWV(u,'b939'))
endif
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
set Y3R=Y3R+.5
set Y4R=Y4R+1
if x then
call J6V(u,'AB39','B939',1,-R2I(Y4R),-R2I(Y3R),0,0,0,0,0)
endif
call HPV(s,u,2,$C)
call DUV(t,'dDef',Y3R)
call DUV(t,'dAtk',Y4R)
call HEV(u)
endif
set t=null
set s=null
set u=null
endfunction
