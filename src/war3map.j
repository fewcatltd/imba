if u!=null then
call DisableTrigger(t)
call IssueTargetOrderById(GetTriggerUnit(),i,u)
call EnableTrigger(t)
call H1V("Missed!",$FF,75,75,GetTriggerUnit())
endif
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set t=null
set u=null
