if GetSpellAbilityId()=='A14O' then
call K1X()
endif
return false
endfunction
function K2X takes nothing returns boolean
if GetSpellAbilityId()=='A14O' then
if GetUnitState(GetTriggerUnit(),UNIT_STATE_MANA)<($F+.07*GetUnitState(GetTriggerUnit(),UNIT_STATE_MAX_MANA))then
call LZV(GetTriggerUnit())
call LYV(GetOwningPlayer(GetTriggerUnit()),GetObjectName('n0G8'))
endif
endif
