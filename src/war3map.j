call KRV(GetTriggerUnit(),'AB49','B949')
call KRV(GetTriggerUnit(),'AB53','B953')
call KRV(GetTriggerUnit(),'AB54','B954')
call KRV(GetTriggerUnit(),'AB55','B955')
call UnitRemoveAbility(GetTriggerUnit(),'AA3B')
endif
endfunction
function WUR takes nothing returns nothing
