call G6V(ADV,$A+l*$A)
call HEV(ADV)
set t=null
else
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,ADV,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,$F,false)
call TriggerAddCondition(t,Condition(function Z7R))
call DFV(t,'u',ADV)
call DPV(t,'a',0)
call DPV(t,'d',3+l*3)
call G5V(ADV,3+l*3)
call HEV(ADV)
set t=null
endif
endfunction
function Z9R takes nothing returns nothing
local unit f=GetFilterUnit()
local integer i=GetPlayerId(GetOwningPlayer(f))
local integer l=0
local integer r=0
if(i==0 or i==6)and IsUnitType(f,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(f,'Aloc')==0 and IsUnitIllusion(f)==false and IsUnitAlly(f,GetOwningPlayer(GetDyingUnit()))==false and IsUnitType(f,UNIT_TYPE_DEAD)==false then
set l=R2I((GetUnitLevel(GetDyingUnit())+DTV(f,'Levl'))*$F)
set i=DTV(f,'EXPR')
set i=i+l
call DPV(f,'EXPR',i)
set l=DTV(f,'Levl')+1
loop
exitwhen i<l*'d'+l*(l-1)*50
set r=r+1
set l=l+1
endloop
if r>0 then
call DPV(f,'Levl',l-1)
call DQV(f,'Poin',GetRandomInt(r*9,r*$D))
call G5V(f,r*2)
call G8V(f,$96*r)
call G7V(f,8*r)
call HEV(f)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Levelup\\LevelupCaster.mdl",f,"origin"))
endif
endif
set f=null
endfunction
function VVI takes integer id returns boolean
