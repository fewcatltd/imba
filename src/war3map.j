set X9R=7
elseif X3R==0 and X4R==2 and X5R==1 then
set X9R=8
elseif X3R==0 and X4R==0 and X5R==3 then
set X9R=9
elseif X3R==0 and X4R==3 and X5R==0 then
set X9R=$A
endif
if aN[X9R]==OVR or aN[X9R]==OER then
