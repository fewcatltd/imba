if GetTriggerEventId()!=EVENT_UNIT_DEATH then
call HPV(DHV(t,'s'),DHV(t,'u'),5,42)
endif
call GDV()
set t=null
endfunction
function Z2R takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local real x1=GetUnitX(s)
local real y1=GetUnitY(s)
local real x2=0
local real y2=0
local real a=0
local group g=null
local boolexpr b=null
local unit n=null
local integer l=0
local integer i=GetUnitAbilityLevel(s,'AA4I')
local integer id='eA00'
if GetTriggerEventId()==EVENT_UNIT_DEATH or(GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER or(GetTriggerEventId()==EVENT_UNIT_ISSUED_TARGET_ORDER and GetIssuedOrderId()!=$D000F)or GetTriggerEventId()==EVENT_UNIT_ISSUED_POINT_ORDER)then
call GDV()
else
if C7V(s,'I0AB')+C7V(s,'I08Y')+C7V(s,'I08T')+C7V(s,'I04K')>0 then
set id='eA01'
endif
set a=HYV(s,u)
set x2=x1+Cos(a)*375
set y2=y1+Sin(a)*375
set g=CreateGroup()
set b=Condition(function PPV)
set AUV=s
call GroupEnumUnitsInRange(g,x2,y2,425,b)
call GroupRemoveUnit(g,u)
set l=4
loop
set n=FirstOfGroup(g)
exitwhen n==null or l==0
call GYV(id,s,s,n,$4B0,"ZYR",i,0)
set l=l-1
call GroupRemoveUnit(g,n)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
call GDV()
endif
set t=null
set s=null
set u=null
endfunction
function Z3R takes nothing returns boolean
local unit s=GetAttacker()
local unit f=GetFilterUnit()
local boolean b=false
set b=(GetUnitTypeId(f)==GetUnitTypeId(s)and IsUnitType(f,UNIT_TYPE_HERO)and GetWidgetLife(f)>1 and IsUnitIllusion(f)and GetUnitAbilityLevel(f,'Aloc')==0 and GetUnitAbilityLevel(f,'A04R')==0)
set s=null
set f=null
return b
endfunction
function Z4R takes nothing returns nothing
