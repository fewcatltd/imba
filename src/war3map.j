function RQX takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local unit m5=Y7(K3V,"Target")
local unit RSX=Y7(K3V,"Projectile")
local real RPX=X8(K3V,"Elapsed")
local real RTX=X8(K3V,"OriginalTime")
local real l4=MDV(GetUnitX(RSX),GetUnitY(RSX),GetUnitX(m5),GetUnitY(m5))
local real x=GetUnitX(RSX)+18*Cos(l4*bj_DEGTORAD)
local real y=GetUnitY(RSX)+18*Sin(l4*bj_DEGTORAD)
call SetUnitX(RSX,x)
call SetUnitY(RSX,y)
if v6(x,y,GetUnitX(m5),GetUnitY(m5))<=18 then
call KillUnit(RSX)
call RMX(p5,m5,RPX)
call a7(K3V)
call KJV(t)
elseif(TimerGetElapsed(D))-RTX>(5.+2.)then
call KillUnit(RSX)
call RMX(p5,RSX,RPX)
call a7(K3V)
call KJV(t)
endif
set t=null
set p5=null
set m5=null
set RSX=null
return false
endfunction
