if LAV(GNR)or E8(GetHandleId(GNR),"PowerCogUsed")==1 then
set GBR=false
endif
call n7(GetHandleId(GNR),"PowerCogUsed",1)
call SetUnitVertexColor(GNR,25,25,25,$AF)
set GNR=null
return GBR
endfunction
function GCR takes nothing returns nothing
if GetUnitState(GetEnumUnit(),UNIT_STATE_MANA)>0 and IsUnitInGroup(GetEnumUnit(),rL)==false and KUV(GetEnumUnit(),"PowerCogShocked")==false and GAR(GetEnumUnit(),tl)then
call KYV(GetEnumUnit(),"PowerCogShocked")
call GroupAddUnit(aL,GetEnumUnit())
endif
endfunction
function GDR takes trigger t,unit K8V,real x,real y,real d,integer JFV returns nothing
local integer K3V=GetHandleId(t)
local real GFR=$C8
local rect r1=Rect(x-d,y-d,x+d,y+d)
local rect r2=Rect(x-d-GFR,y-d-GFR,x+d+GFR,y+d+GFR)
local group g1=KHV()
local group g2=KHV()
local group g3=KHV()
set xL=K8V
call GroupEnumUnitsInRect(g1,r1,Condition(function P0V))
call GroupEnumUnitsInRect(g2,r2,Condition(function P0V))
set rL=g1
set aL=g3
set wl=x
set Wl=y
set zl=d
set tl=K3V
call ForGroup(g2,function GCR)
set Sl=JFV
call ForGroup(g3,function GIR)
call KGV(g1)
call KGV(g2)
call KGV(g3)
call RemoveRect(r1)
call RemoveRect(r2)
set g1=null
set g2=null
set g3=null
set r1=null
set r2=null
endfunction
function GGR takes nothing returns boolean
