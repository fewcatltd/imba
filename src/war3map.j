function yO takes nothing returns nothing
local integer yp=GetHandleId(GetTriggeringTrigger())
local player j8=v8(yp,"PlayerVar")
local integer yP=GetHandleId(j8)
local unit JN=Y7(yP,"Kobold0")
local unit Jo=Y7(yP,"Kobold1")
local unit JO=Y7(yP,"Kobold2")
local unit Jp=Y7(yP,"Kobold3")
local integer yq=GetUnitAbilityLevel(JN,'A0NR')*2
local integer yQ=B7V(JN,false)
local integer yr=B7V(JN,true)-yQ-yq
local integer yR=B6V(JN,false)
local integer ys=B6V(JN,true)-yR-yq
local integer yS=B8V(JN,false)
local integer yt=B8V(JN,true)-yS-yq
local real yT=.25
local integer yu=R2I(yQ+yr*yT)
local integer yU=R2I(yR+ys*yT)
local integer yv=R2I(yS+yt*yT)
if GetUnitState(JN,UNIT_STATE_LIFE)>1 then
if Jo!=null then
call SetHeroAgi(Jo,yu,false)
call SetHeroStr(Jo,yU,false)
call SetHeroInt(Jo,yv,false)
endif
if JO!=null then
call SetHeroAgi(JO,yu,false)
call SetHeroStr(JO,yU,false)
call SetHeroInt(JO,yv,false)
endif
if Jp!=null then
call SetHeroAgi(Jp,yu,false)
call SetHeroStr(Jp,yU,false)
call SetHeroInt(Jp,yv,false)
endif
endif
endfunction
function yV takes nothing returns nothing
local integer yp=GetHandleId(GetTriggeringTrigger())
local player j8=v8(yp,"PlayerVar")
local integer yP=GetHandleId(j8)
local unit JN=Y7(yP,"Kobold0")
local unit Jo=Y7(yP,"Kobold1")
local unit JO=Y7(yP,"Kobold2")
local unit Jp=Y7(yP,"Kobold3")
local integer yw=GetHandleId(JN)
local integer yW=GetHandleId(Jo)
local integer yx=GetHandleId(JO)
local integer yX=GetHandleId(Jp)
local integer yy=E8(yw,"XPEarned")
local integer yY=E8(yw,"XPGiven")
local integer yz=E8(yW,"XPEarned")
local integer yZ=E8(yW,"XPGiven")
local integer y0=E8(yx,"XPEarned")
local integer y4=E8(yx,"XPGiven")
local integer y5=E8(yX,"XPEarned")
local integer y6=E8(yX,"XPGiven")
local integer y7=GetHeroXP(JN)
local integer y8=GetHeroXP(Jo)
local integer y9=GetHeroXP(JO)
local integer Ya=GetHeroXP(Jp)
local integer YA=y7-yy-yY
local integer Yb=y8-yz-yZ
local integer YB=y9-y0-y4
local integer Yc=Ya-y5-y6
if GetUnitState(JN,UNIT_STATE_LIFE)>1 then
set yy=yy+YA
set yz=yz+Yb
set y0=y0+YB
set y5=y5+Yc
if JN!=null then
call AddHeroXP(Jo,YA,false)
if GetHeroXP(Jo)!=y8 then
set yZ=yZ+YA
endif
call AddHeroXP(JO,YA,false)
if GetHeroXP(JO)!=y9 then
set y4=y4+YA
endif
call AddHeroXP(Jp,YA,false)
if GetHeroXP(Jp)!=Ya then
set y6=y6+YA
endif
endif
if Jo!=null then
call AddHeroXP(JN,Yb,false)
if GetHeroXP(JN)!=y7 then
set yY=yY+Yb
endif
call AddHeroXP(JO,Yb,false)
if GetHeroXP(JO)!=y9 then
set y4=y4+Yb
endif
call AddHeroXP(Jp,Yb,false)
if GetHeroXP(Jp)!=Ya then
set y6=y6+Yb
endif
endif
if JO!=null then
call AddHeroXP(Jo,YB,false)
if GetHeroXP(Jo)!=y8 then
set yZ=yZ+YB
endif
call AddHeroXP(JN,YB,false)
if GetHeroXP(JN)!=y7 then
set yY=yY+YB
endif
call AddHeroXP(Jp,YB,false)
if GetHeroXP(Jp)!=Ya then
set y6=y6+YB
endif
endif
if Jp!=null then
call AddHeroXP(Jo,Yc,false)
if GetHeroXP(Jo)!=y8 then
set yZ=yZ+Yc
endif
call AddHeroXP(JO,Yc,false)
if GetHeroXP(JO)!=y9 then
set y4=y4+Yc
endif
call AddHeroXP(JN,Yc,false)
if GetHeroXP(JN)!=y7 then
set yY=yY+Yc
endif
endif
call n7(yw,"XPEarned",yy)
call n7(yw,"XPGiven",yY)
call n7(yW,"XPEarned",yz)
call n7(yW,"XPGiven",yZ)
call n7(yx,"XPEarned",y0)
call n7(yx,"XPGiven",y4)
call n7(yX,"XPEarned",y5)
call n7(yX,"XPGiven",y6)
endif
endfunction
