function K3X takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local unit f=DHV(t,'f')
local unit e=DHV(t,'e')
local lightning l=D0V(t,'l')
local integer i=DTV(t,'i')
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local real x1=DWV(t,'x')
local real y1=DWV(t,'y')
local real d=SquareRoot((x-x1)*(x-x1)+(y-y1)*(y-y1))
local real r=(625+625*i)*.02   //storm speed (lvl 1)
local real a=Atan2(y1-y,x1-x)
local group g=null
local boolexpr b=null
local real PJE=.0020833
local real K4X=0
local real K5X=0
set K5X=-(((5*i)+K4X)+GetUnitState(s,UNIT_STATE_MAX_MANA)*PJE)
if IVV then
if EMV then
set K5X=-(GetUnitState(s,UNIT_STATE_MAX_MANA)*PJE)
endif
endif
if ITV-DWV(t,'t')>0 then
call UnitRemoveAbility(s,'Avul')
endif
if GetWidgetLife(s)>1 and d>r and GetUnitState(s,UNIT_STATE_MANA)>(-1*K5X)then
set x=x+Cos(a)*r
set y=y+Sin(a)*r
call MMV(x,y,75)
call SetUnitX(s,x)
call SetUnitY(s,y)
call SetUnitPosition(u,x,y)
call SetUnitPosition(f,x,y)
if IVV then
if EMV then
call HGV(s,false,K5X)
endif
else
call HGV(s,false,K5X)
endif
call HZV(l,s,e)
else
if GetWidgetLife(s)>1 then
call SetUnitPosition(s,x,y)
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(s),'A14O',true)
call UnitRemoveAbility(s,'Avul')
call SetUnitPathing(s,true)
set d=DNV(s,e)
set d=d*.01*(4+4*i)
call GKV(s)
call DestroyEffect(D2V(t,'00fx'))
call RemoveUnit(u)
call RemoveUnit(f)
call KillUnit(e)
call DestroyLightning(l)
set g=KHV()
set b=Condition(function PJV)
set AUV=s
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),75+75*i,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call HPV(s,f,1,d+H4V(s,1))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBoltImpact.mdl",f,"origin"))
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
call FIV()
endif
set t=null
set s=null
set u=null
set f=null
set e=null
set l=null
endfunction
