call E7(K3V,"y1",y1)
call E7(K3V,"x2",x2)
call E7(K3V,"y2",y2)
call E7(K3V,"w",w)
call D3V(t,'s',X8V)
set X8V=null
if XPO==null then
set g=KHV()
