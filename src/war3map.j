function UUO takes nothing returns nothing
if(GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)then
call MoveLocation(HC[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))],GetUnitX(GetOrderTargetUnit()),GetUnitY(GetOrderTargetUnit()))
if((GetIssuedOrderId()>=$D0028)and(GetIssuedOrderId()<=$D002D)and(GetPlayerController(GetOwningPlayer(GetTriggerUnit()))==MAP_CONTROL_NONE)and(IsUnitInForce(GetTriggerUnit(),fz)))then
if((ko(GetTriggerUnit())==Ac[LD])or(ko(GetTriggerUnit())==Ac[NHV]))then
call IssueTargetOrderById(GetTriggerUnit(),$D000F,GetOrderTargetUnit())
endif
endif
else
call MoveLocation(HC[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))],GetOrderPointX(),GetOrderPointY())
endif
endfunction
