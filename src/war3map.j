call SetUnitAbilityLevel(s,'S00A',GetUnitAbilityLevel(s,'A086'))
call SetUnitAbilityLevel(s,'A08C',GetUnitAbilityLevel(s,'A08E'))
if GetUnitAbilityLevel(s,'A1B0')>0 then
call SetUnitPosition(f,GetUnitX(s),GetUnitY(s))
else
call SetUnitPosition(f,x,y)
endif
set AUV=s
set g=KHV()
set b=Condition(function PQV)
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),$C8+$C8*GetUnitAbilityLevel(s,'A086'),b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call J6V(f,'AA8A','AA8A',1,0,0,0,0,0,0,0)
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
else
call SetUnitPosition(f,x,y)
endif
set s=null
set t=null
set f=null
endfunction
function ZSX takes nothing returns boolean
