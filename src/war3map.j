loop
call TriggerSleepAction(.0)
set kg=kh(VH)
if(kg>=0)then
set pl=i3(S2I(SubString(VH,0,kg)))
set VH=SubString(VH,kg+1,StringLength(VH))
else
set pl=i3(S2I(SubString(VH,0,StringLength(VH))))
endif
if((pl!=null)and(m8(pl))and(GetPlayerController(pl)==MAP_CONTROL_COMPUTER)and(IsPlayerAlly(pl,GetTriggerPlayer())))then
set UP=GetPlayerId(pl)
if((ie[UP]!=null)and(A5(ie[UP]))and(i0(ie[UP]))and(not N5(ie[UP])))then
set eY[UP]=$B
set h8[48+UP]=h7[$FA]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,R[UP]+GetPlayerName(pl)+"|r will attack Roshan")
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,R[UP]+GetPlayerName(pl)+"|r |cffffcc00cannot attack Roshan|r")
endif
endif
exitwhen kg<0
endloop
elseif(xy)then
elseif(VH=="auto")then
if(GetTriggerPlayer()==dz)then
call O7(tz,"Sent|LCT",not O8(tz,"Sent|LCT"))
call YBO(O8(tz,"Sent|LCT"))
else
call O7(tz,"Scrg|LCT",not O8(tz,"Scrg|LCT"))
call YBO(O8(tz,"Scrg|LCT"))
endif
elseif(VH=="p")then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Commands:
Type \"-o\",\"-c\" or \" c\" before any of these:
 pn - let AI choose where to push
 pl - all AI ally pushes left
 pr - all AI ally pushes right
 pm - all AI ally pushes middle")
elseif(VH=="pn")then
if(GetTriggerPlayer()==dz)then
set G4=-1
else
