if IsUnitType(m5,UNIT_TYPE_HERO) then
set E2[GetPlayerId(GetOwningPlayer(K8V))]=E2[GetPlayerId(GetOwningPlayer(K8V))]+1
endif
set uk=X8(K3V,"OriginalX")
set uK=X8(K3V,"OriginalY")
set oA=null
call QDV(m5,SquareRoot((iN-uk)*(iN-uk)+(io-uK)*(io-uK))/300,false)
set i=SquareRoot((iN-uk)*(iN-uk)+(io-uK)*(io-uK))*.01*.15+1
call HPV(K8V,m5,1,90*GetUnitAbilityLevel(K8V,'A0L8')*i+H4V(K8V,1))
call KillUnit(IJ)
call Mv(t)
elseif(Il-hN)*(Il-hN)+(IL-ho)*(IL-ho)<PJE then
call KillUnit(IJ)
call Mv(t)
endif
set t=null
set K8V=null
set IJ=null
set hP=null
set S8V=null
set oA=null
set m5=null
endfunction
