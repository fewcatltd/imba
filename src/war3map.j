call TriggerAddCondition(t,Condition(function E7I))
call DFV(t,'s',s)
call DFV(t,'u',u)
call DPV(t,'i',i)
call G6V(s,i)
call G6V(u,-i)
call HEV(s)
call HEV(u)
endif
else
call SetUnitFacing(s,HYV(s,u)*bj_RADTODEG)
call HPV(s,u,1,1+2*i)
endif
set t=null
set u=null
set s=null
endfunction
function EYI takes nothing returns nothing
