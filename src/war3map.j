loop
set f=FirstOfGroup(g)
exitwhen f==null
call HPV(s,f,1,d)
call J6V(f,'AB74','B974',1,0,0,-R2I(r*$A),0,0,0,-GEV(f)*r*.1)
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
if XLR then
call FIV()
endif
set t=null
set s=null
set g=null
set g1=null
set f=null
set b=null
endfunction
function XMR takes nothing returns nothing
local unit p5=GetTriggerUnit()
local real a=GetUnitFacing(p5)
local integer i=1
local unit oA
local real x
local real y
local real iN=GetUnitX(p5)+$E1*Cos(a*bj_DEGTORAD)
local real io=GetUnitY(p5)+$E1*Sin(a*bj_DEGTORAD)
local integer V2R=GetUnitAbilityLevel(p5,'A0VB')
local integer VSR=GetUnitAbilityLevel(p5,'A0V9')
local real BTX=1.5+1.5*V2R
local integer n=7*3
local timer t=CreateTimer()
local integer l=0
loop
exitwhen i>n
set x=iN+80*i*Cos((a+90)*bj_DEGTORAD)
set y=io+80*i*Sin((a+90)*bj_DEGTORAD)
set oA=CreateUnit(GetOwningPlayer(p5),'u00O',x,y,GetRandomReal(0,360))
call SetUnitAnimation(oA,"birth")
call QueueUnitAnimation(oA,"stand")
call UnitApplyTimedLife(oA,'BTLF',BTX)
call DFV(t,l,oA)
set l=l+1
set x=iN+80*i*Cos((a-90)*bj_DEGTORAD)
set y=io+80*i*Sin((a-90)*bj_DEGTORAD)
set oA=CreateUnit(GetOwningPlayer(p5),'u00O',x,y,GetRandomReal(0,360))
call SetUnitAnimation(oA,"birth")
call QueueUnitAnimation(oA,"stand")
call UnitApplyTimedLife(oA,'BTLF',BTX)
call DFV(t,l,oA)
set l=l+1
set i=i+1
endloop
call DFV(t,'d',p5)
call DPV(t,'e',6*VSR)
call DPV(t,'f',1+V2R)
call DUV(t,'g',ITV+BTX)
call TimerStart(t,.1,true,function XKR)
set t=null
set oA=null
set p5=null
endfunction
