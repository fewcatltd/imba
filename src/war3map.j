function VTR takes unit u returns nothing
local real QZV=0
local real WPX=0
if GetUnitAbilityLevel(u,'AB75')==0 then
call DUV(u,'A0VA',0)
call DUV(u,'A0V9',0)
call FIV()
else
set QZV=DWV(u,'A0VA')
set WPX=DWV(u,'A0V9')
if QZV<1 then
call DUV(u,'A0VA',GetWidgetLife(u))
else
set QZV=GetWidgetLife(u)-QZV
if QZV>0 then
set QZV=QZV*(.3+.2*DTV(u,'a0v9'))
call HGV(u,true,QZV)
endif
endif
if WPX<1 then
call DUV(u,'A0V9',GetUnitState(u,UNIT_STATE_MANA))
else
set WPX=GetUnitState(u,UNIT_STATE_MANA)-WPX
if WPX>0 then
set WPX=WPX*(.3+.2*DTV(u,'a0va'))
call HGV(u,false,WPX)
endif
endif
call DUV(u,'A0VA',GetWidgetLife(u))
call DUV(u,'A0V9',GetUnitState(u,UNIT_STATE_MANA))
endif
endfunction
function VUR takes nothing returns nothing
call VTR(DHV(GetExpiredTimer(),'s'))
endfunction
function VWR takes nothing returns boolean
local unit K8V=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local integer VQR=GetUnitAbilityLevel(K8V,'A0VA')
local integer VSR=GetUnitAbilityLevel(K8V,'A0V9')
local timer t=null
if GetUnitAbilityLevel(u,'AB75')==0 then
set t=CreateTimer()
call TimerStart(t,.1,true,function VUR)
call DFV(t,'s',u)
set t=null
endif
call J6V(u,'AB75','B975',9,20+$A*VSR,0,20+$A*VQR,0,0,0,0)
call DPV(u,'a0va',VQR)
call DPV(u,'a0v9',VSR)
set K8V=null
return false
endfunction
function VYR takes nothing returns nothing
call CZV('A0VQ',"VWR")
return
call L6V('A0VJ',GetRandomReal(1,25))
call L6V('A109',GetRandomReal(1,25))
endfunction
function VZR takes unit p5 returns real
return 400+400.*GetUnitAbilityLevel(p5,'A0VA')
endfunction
function V_R takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local real d=DWV(t,'d')
local integer i=GetTriggerEvalCount(t)
local integer l=DTV(t,'i')
local real r=0
local unit f=DHV(t,'f')
if GetTriggerEventId()==EVENT_UNIT_DEATH or ITV-DWV(t,'r')>0 then
call KillUnit(f)
if DZV(t,'b')then
call SetWidgetLife(u,1)
set O9V=true
call HPV(s,u,5,99999)
endif
call GDV()
elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set r=GetEventDamage()
if GetWidgetLife(u)-r<1 then
call DYV(t,'b',true)
call DFV(t,'s',HMV(GetEventDamageSource()))
else
call HGV(u,true,-r)
endif
else
if i==1 then
call UnitRemoveAbility(u,'Avul')
endif
call SetUnitFlyHeight(f,GetUnitFlyHeight(u),0)
set r=d*(1-C0V(IsUnitType(u,UNIT_TYPE_HERO))*.25)
if GetWidgetLife(u)-r<1 then
call DYV(t,'b',true)
else
call HGV(u,true,-r)
endif
if DZV(t,'b')then
call SetWidgetLife(u,1)
set O9V=true
call HPV(s,u,5,99999)
endif
endif
set t=null
set s=null
set f=null
set u=null
endfunction
function V0R takes unit s,unit u,real r,real d returns nothing
local trigger t=CreateTrigger()
local unit f=CreateUnit(GetOwningPlayer(u),'eA19',GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function V_R))
call DFV(t,'s',s)
call DFV(t,'u',u)
call DUV(t,'r',ITV+r)
call DUV(t,'d',d/(r/.025))
call DPV(t,'i',R2I(r/.025))
call DFV(t,'f',f)
call SetUnitPathing(f,false)
call SetUnitX(f,GetUnitX(u))
call SetUnitY(f,GetUnitY(u))
set f=null
set t=null
endfunction
function V1R takes unit p5,unit m5,integer VQR,integer V2R returns nothing
local unit oA=null
local unit V3R=null
local real V4R=.5+.3*V2R
call V0R(p5,m5,V4R,77.5+(VQR+V2R)*23+H4V(p5,1)*.33)
set oA=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
set V3R=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
if V2R==7 then
set V4R=2.5
endif
call UnitApplyTimedLife(oA,'BTLF',1)
call UnitApplyTimedLife(V3R,'BTLF',1)
call UnitAddAbility(oA,'X000'-1+V2R)
call IssueTargetOrderById(oA,$D00B0,m5)
set oA=null
set V3R=null
endfunction
function V5R takes nothing returns nothing
if IsUnitInGroup(GetEnumUnit(),rL)==false and GetUnitTypeId(GetEnumUnit())!='eA19' then
call GroupAddUnit(rL,GetEnumUnit())
call V1R(xL,GetEnumUnit(),Sl,tl)
endif
endfunction
function V6R takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit oA=Y7(K3V,"Caster")
local real x2=X8(K3V,"x2")
local real y2=X8(K3V,"y2")
local real a=X8(K3V,"a")
local integer VQR=E8(K3V,"WexLevel")
local integer V2R=E8(K3V,"QuasLevel")
local group g=o8(K3V,"g")
local real x=GetUnitX(oA)+25*Cos(a)
local real y=GetUnitY(oA)+25*Sin(a)
local group V7R=KHV()
local real V8R=v6(x,y,x2,y2)
local integer i='}'
if H3V(oA)then
set i=i*4
endif
if V8R<=30 then
set x=x2
set y=y2
endif
call SetUnitX(oA,L1V(x))
