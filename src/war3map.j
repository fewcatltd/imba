function GDV takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
call DisableTrigger(t)
call FlushChildHashtable(VV,GetHandleId(t))
call DestroyTrigger(t)
set t=null
endfunction
function GFV takes integer id,integer GGV,integer GHV,integer GJV returns nothing
local player p=Player(0)
call FSV(p,"DefaultRed"+I2S(id),GGV)
call FSV(p,"DefaultBlue"+I2S(id),GHV)
call FSV(p,"DefaultGreen"+I2S(id),GJV)
set p=null
endfunction
function GKV takes unit u returns nothing
local integer id=GetUnitTypeId(u)
local integer GLV=$FF
local integer i=0
set i=GetUnitAbilityLevel(u,'AA0D')
if i>0 then
if IsUnitAlly(u,GetLocalPlayer())==false then
set GLV=GLV*(4-i)/4
elseif IsUnitOwnedByPlayer(u,GetLocalPlayer())then
set GLV=GLV*(8-i)/8
else
set GLV=GLV*($C-i)/$C
endif
endif
call SetUnitVertexColor(u,F_V(Player(0),"DefaultRed"+I2S(id)),F_V(Player(0),"DefaultBlue"+I2S(id)),F_V(Player(0),"DefaultGreen"+I2S(id)),GLV)
endfunction
