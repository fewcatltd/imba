call IssueTargetOrderById(f,$D0132,s)
call KillUnit(f)
set f=null
call IssueTargetOrderById(IWV,$D000F,u)
set l=GetUnitAbilityLevel(IWV,'A0YK')
if l==0 then
set l=GetUnitAbilityLevel(s,'A0YK')
