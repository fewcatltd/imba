function REI takes nothing returns nothing
local unit s=GetBuyingUnit()
local unit c=GetBuyingUnit()
local unit d
local unit u=GetSoldUnit()
local integer id=GetUnitTypeId(u)
local group g=null
local boolexpr b=null
local unit f=null
local player p=GetOwningPlayer(s)
local integer l=GetPlayerId(GetOwningPlayer(s))
local integer i=0
local location TOV=GetRectCenter(pr)
local integer PJE=(1+GetPlayerId(p))

if GetUnitTypeId(u)=='C001' then
call RemoveUnit(u)
set AP=true
call O7I()

elseif GetUnitTypeId(u)=='nwe3' then  //SD with EM
call RemoveUnit(u)
call O7I()

elseif GetUnitTypeId(u)=='C002' then
call RemoveUnit(u)
set SD=true
call O7I()

set EKV=true
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Items Drop"))
call RVI()


set EJV=true
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Fast Neutrals"))
call RVI()


set SC=true
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Super Creeps"))
call RVI()


set ST=true
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Super Towers"))
call RVI()


set ELV=true
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Ban Backdoor"))
call RVI()


set FR=true
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Fast Respawm"))
call RVI()


set EM=true
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Easy Mode"))
call RVI()


set VGV=true
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Extra Ultimate"))
call RVI()


set IVV=true
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Imba"))
call RVI()

elseif GetUnitTypeId(u)=='C013' then
call RemoveUnit(u)
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Imba again = balanced removed = Imba"))
call RVI()
else
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Unit sold"))
endif
if VFV[PJE]==false and OSE()then
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("It's hero and the player has not selected all spells"))
endif
call AdjustPlayerStateBJ($FA,p,PLAYER_STATE_RESOURCE_GOLD)
set c=CreateUnitAtLoc(p,'n00C',TOV,bj_UNIT_FACING)
call SetPlayerAbilityAvailable(p,'AHds',false)
call SetPlayerAbilityAvailable(p,'AHad',false)
call SetPlayerAbilityAvailable(p,'AHhb',false)
call SetPlayerAbilityAvailable(p,'AHre',false)
if F7V(GetUnitTypeId(u),1)!='A0BE' then
call UnitAddAbility(c,F7V(GetUnitTypeId(u),1))
endif
set VRV[PJE]=F7V(GetUnitTypeId(u),1)
call UnitAddAbility(c,F7V(GetUnitTypeId(u),2))
set VIV[PJE]=F7V(GetUnitTypeId(u),2)
if F7V(GetUnitTypeId(u),3)!='A02C' and F7V(GetUnitTypeId(u),3)!='A0A8' then
call UnitAddAbility(c,F7V(GetUnitTypeId(u),3))
endif
set VAV[PJE]=F7V(GetUnitTypeId(u),3)
if F7V(GetUnitTypeId(u),4)!='A088' then
call UnitAddAbility(c,F7V(GetUnitTypeId(u),4))
endif
set VNV[PJE]=F7V(GetUnitTypeId(u),4)
set MU=MU+1
if F7V(GetUnitTypeId(u),1)!='A0DW' and F7V(GetUnitTypeId(u),1)!='A078' and F7V(GetUnitTypeId(u),1)!='A0BE' then     //  banned skills
call UnitAddAbility(c,'B000')
endif
if F7V(GetUnitTypeId(u),2)!='1234' and F7V(GetUnitTypeId(u),2)!='AA5J' then
call UnitAddAbility(c,'B001')
endif
if F7V(GetUnitTypeId(u),3)!='A01B' and F7V(GetUnitTypeId(u),3)!='AA5J' and F7V(GetUnitTypeId(u),3)!='A02C' and F7V(GetUnitTypeId(u),3)!='A0A8' and F7V(GetUnitTypeId(u),3)!='AA5K' and F7V(GetUnitTypeId(u),3)!='A232' then
call UnitAddAbility(c,'B002')
endif
