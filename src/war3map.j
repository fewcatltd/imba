function VTX takes nothing returns nothing
local timer tm=GetExpiredTimer()
local real t=DWV(tm,'t')
local integer i=1
if(RDV==0 and RFV==0)or(ITV-t>0)then
loop
exitwhen i>5
call SetPlayerState(A7V[i],PLAYER_STATE_RESOURCE_GOLD,$3E8)
call SetPlayerState(A8V[i],PLAYER_STATE_RESOURCE_GOLD,$3E8)
set i=i+1
endloop
if ITV-t>0 then
loop
exitwhen RDV==0
call VSX()
set RDV=RDV-1
endloop
loop
exitwhen RFV==0
call VSX()
set RFV=RFV-1
endloop
endif
call EnableTrigger(xu)
call EnableTrigger(ru)
set ROV=false
call DestroyTrigger(DMV(tm,'Trgg'))
call FIV()
endif
set tm=null
endfunction
function VUX takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer id=GetUnitTypeId(u)
local integer i=GetUnitPointValue(u)
if false then
if ROV then
call ShowUnit(u,false)
call RemoveUnit(u)
endif
if(p==A7V[1]or p==A7V[2]or p==A7V[3]or p==A7V[4]or p==A7V[5])and RDV>0 then
call s8(id)
call OIE(i)
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,$FA)
set RDV=RDV-1
return
endif
if(p==A8V[1]or p==A8V[2]or p==A8V[3]or p==A8V[4]or p==A8V[5])and RFV>0 then
call s8(id)
call OIE(i)
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,$FA)
set RFV=RFV-1
return
endif
endif
set u=null
set p=null
endfunction
function VDX takes nothing returns nothing
local timer tm=CreateTimer()
local integer i=2
local trigger t=CreateTrigger()
set ROV=true
call TriggerRegisterEnterRectSimple(t,bj_mapInitialPlayableArea)
call TriggerAddCondition(t,Condition(function VUX))
call DisableTrigger(xu)
call DisableTrigger(ru)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F,GetObjectName('CMMS'))
loop
exitwhen i>5
call SetPlayerState(A7V[i],PLAYER_STATE_RESOURCE_GOLD,0)
call SetPlayerState(A8V[i],PLAYER_STATE_RESOURCE_GOLD,0)
set i=i+1
endloop
call SetPlayerState(A7V[1],PLAYER_STATE_RESOURCE_GOLD,$FA)
call SetPlayerState(A8V[1],PLAYER_STATE_RESOURCE_GOLD,$FA)
set RCV=true
set RDV=4
set RFV=4
set Nz='y'
call TimerStart(tm,1,true,function VTX)
call DUV(tm,'t',ITV+60)
call DLV(tm,'Trgg',t)
set tm=null
set t=null
endfunction
function VCX takes nothing returns nothing
local integer i=8
loop
exitwhen i<1
call ExecuteFunc("VSX")
set i=i-1
endloop
endfunction
function VWX takes nothing returns boolean
return(IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_DEAD)==false and IsUnitAlly(GetFilterUnit(),GetOwningPlayer(AUV))==false)!=null
endfunction
function VYX takes nothing returns boolean
local integer i=GetUnitTypeId(GetFilterUnit())
return((i=='u00D' or i=='u00M' or i=='u00N' or i=='u00T' or i=='e011' or i=='e00R' or i=='e00S' or i=='e019')and IsUnitAlly(GetFilterUnit(),GetOwningPlayer(AUV))==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_DEAD)==false)!=null
endfunction
function VZX takes nothing returns boolean
return(AUV!=GetFilterUnit()and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_DEAD)==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)==false and GetOwningPlayer(GetFilterUnit())==GetOwningPlayer(AUV)and(GetUnitLifePercent(GetFilterUnit())<$A or GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)<70))!=null
endfunction
function V_X takes unit u,integer i returns nothing
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer l=GetPlayerId(GetOwningPlayer(u))
call DPV(u,'STAT',0)
if i==0 then
if l==0 then
if x<-5000 and x>-7500 and y<5000 then
call IssuePointOrderById(u,$D000F,-6000,5600)
elseif y<-5500 and y>-7500 and x<4600 then
call IssuePointOrderById(u,$D000F,5700,-6300)
elseif(x>-7600 and x<-4400 and y>$DAC and y<8000)or(x>4100 and x<6300 and y>-7900 and y<-4700)or(x<y+$7D0 and x>y-$7D0)or(y<x+$7D0 and y>x-$7D0)then
call IssuePointOrderById(u,$D000F,6500,6000)
else
call IssuePointOrderById(u,$D000F,0,0)
endif
elseif l==6 then
if y>$FA0 and y<7500 and x>-5000 then
call IssuePointOrderById(u,$D000F,-6000,5600)
elseif x>5000 and x<7500 and y>-5500 then
call IssuePointOrderById(u,$D000F,5700,-6300)
elseif(x>-7600 and x<-4400 and y>$DAC and y<8000)or(x>4600 and x<6800 and y>-7400 and y<-5200)or(x<y+$7D0 and x>y-$7D0)or(y<x+$7D0 and y>x-$7D0)then
call IssuePointOrderById(u,$D000F,-7000,-7000)
else
call IssuePointOrderById(u,$D000F,0,0)
endif
endif
endif
endfunction
function V0X takes unit f returns nothing
local integer i=DTV(f,'STAT')
local real QZV=GetUnitState(f,UNIT_STATE_LIFE)
local real p=GetUnitLifePercent(f)
local group g=null
local boolexpr b=null
local unit u=null
local real x=GetUnitX(f)
local real y=GetUnitY(f)
local integer l=GetPlayerId(GetOwningPlayer(f))
local real a=0
local player V1X=null
local integer x1=0
set AUV=f
if GetTriggerEventId()==EVENT_UNIT_ATTACKED then
if GetTriggerUnit()!=f or IsUnitAlly(GetAttacker(),GetOwningPlayer(f))then
return
endif
set u=GetAttacker()
if IsUnitType(u,UNIT_TYPE_STRUCTURE)then
set g=CreateGroup()
set b=Condition(function VWX)
call GroupEnumUnitsInRange(g,x,y,450,b)
if FirstOfGroup(g)==null and GetUnitAbilityLevel(u,'Avul')==0 then
if i!=1 then
call DFV(f,'STRU',u)
call IssueTargetOrderById(f,$D000F,u)
call DPV(f,'STAT',1)
if DZV(f,'1BUF')==false then
call DYV(f,'1BUF',true)
call G6V(f,$F)
call G5V(f,20)
call HVV(f,-'d')
call HEV(f)
endif
endif
elseif i!=3 then
if DZV(f,'1BUF')then
call DYV(f,'1BUF',false)
call G6V(f,-$F)
call G5V(f,-20)
call HVV(f,'d')
call HEV(f)
endif
call DPV(f,'STAT',3)
call DUV(f,'MOD3',ITV+2)
if y<-6300 then
call IssuePointOrderById(f,$D0012,x+$3E8,-6700)
elseif x<-5000 then
call IssuePointOrderById(f,$D0012,-6200,y+$3E8)
elseif x>5500 then
call IssuePointOrderById(f,$D0012,6305,y-$3E8)
elseif y>5000 then
call IssuePointOrderById(f,$D0012,x-$3E8,$400)
else
if l==0 then
set a=bj_PI*5/4
else
set a=bj_PI/4
endif
call IssuePointOrderById(f,$D0012,x+Cos(a)*$3E8,y+Sin(a)*$3E8)
endif
endif
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
elseif IsUnitType(u,UNIT_TYPE_HERO)then
set g=CreateGroup()
set b=Condition(function VYX)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),700,b)
if FirstOfGroup(g)==null then
call DFV(f,'HERO',u)
call IssueTargetOrderById(f,$D000F,u)
call DPV(f,'STAT',2)
endif
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
else
if p<50 then
call HGV(f,true,.5)
if l==0 then
set V1X=Player(6)
else
set V1X=Player(0)
endif
if IsUnitVisible(f,V1X)==false then
call HGV(f,true,2.5)
endif
set V1X=null
endif
set x1=DTV(f,'Poin')
if x1!=0 then
call G6V(f,x1)
call HEV(f)
call DPV(f,'Poin',0)
endif
if i==0 then
set g=CreateGroup()
set b=Condition(function VZX)
call GroupEnumUnitsInRange(g,x,y,475,b)
set u=FirstOfGroup(g)
if u!=null then
call DUV(f,'Mod4',ITV+1)
call DPV(f,'STAT',4)
call DFV(f,'tArg',u)
call IssueTargetOrderById(f,$D000F,u)
else
call GroupClear(g)
call DestroyBoolExpr(b)
set b=Condition(function VYX)
call GroupEnumUnitsInRange(g,x,y,700,b)
set u=FirstOfGroup(g)
if u!=null and GetUnitAbilityLevel(u,'Avul')==0 then
call DestroyBoolExpr(b)
set b=Condition(function VWX)
call GroupClear(g)
call GroupEnumUnitsInRange(g,x,y,450,b)
if FirstOfGroup(g)==null then
if i!=1 then
call DFV(f,'STRU',u)
call IssueTargetOrderById(f,$D000F,u)
call DPV(f,'STAT',1)
if DZV(f,'1BUF')==false then
call DYV(f,'1BUF',true)
call G6V(f,$F)
call G5V(f,20)
call HVV(f,-'d')
call HEV(f)
endif
endif
endif
endif
endif
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
elseif i==1 then
set u=DHV(f,'STRU')
if IsUnitType(u,UNIT_TYPE_DEAD)or u==null then
if DZV(f,'1BUF')then
call DYV(f,'1BUF',false)
call G6V(f,-$F)
call G5V(f,-20)
call HVV(f,'d')
call HEV(f)
endif
call V_X(f,0)
endif
elseif i==2 then
set u=DHV(f,'HERO')
if IsUnitVisible(u,GetOwningPlayer(f))and C3V(u,f)<700 then
call IssueTargetOrderById(f,$D000F,u)
else
call V_X(f,0)
endif
set u=null
elseif i==3 then
if ITV-DWV(f,'MOD3')>0 then
call V_X(f,0)
endif
elseif i==4 then
if ITV-DWV(f,'Mod4')>0 then
call V_X(f,0)
endif
else
call V_X(f,0)
endif
endif
endfunction
function V2X takes nothing returns nothing
call V0X(GetEnumUnit())
endfunction
function V3X takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local group g=DKV(t,'g')
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call GroupRemoveUnit(g,GetTriggerUnit())
elseif GetTriggerEventId()==EVENT_UNIT_ATTACKED then
call ForGroup(g,function V2X)
else
if CountUnitsInGroup(g)<1 then
call GDV()
else
call ForGroup(g,function V2X)
endif
endif
endfunction
function V4X takes nothing returns nothing
local trigger t=null
local unit f=GetFilterUnit()
if IsUnitType(f,UNIT_TYPE_STRUCTURE)==false and IsUnitIllusion(f)==false and DZV(f,'WCRE')==false and GetUnitAbilityLevel(f,'Aloc')==0 then
call DYV(f,'WCRE',true)
if CountUnitsInGroup(R0V)>=$A then
set R0V=CreateGroup()
set R1V=CreateTrigger()
call TriggerRegisterTimerEvent(R1V,.25,true)
call TriggerAddCondition(R1V,Condition(function V3X))
endif
call GroupAddUnit(R0V,f)
call TriggerRegisterUnitEvent(R1V,f,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(R1V,f,EVENT_UNIT_ATTACKED)
call DJV(R1V,'g',R0V)
endif
set f=null
endfunction
function V5X takes nothing returns nothing
local unit f=GetFilterUnit()
local integer i=GetPlayerId(GetOwningPlayer(f))
if IsUnitType(f,UNIT_TYPE_STRUCTURE)==false and IsUnitIllusion(f)==false and GetUnitAbilityLevel(f,'Aloc')==0 and(i==0 or i==6)then
set i=DTV(f,'STAT')
if i!=1 and i!=2 then
call V_X(f,0)
endif
endif
set f=null
endfunction
function V6X takes nothing returns nothing
local group g=CreateGroup()
local boolexpr b=Condition(function V4X)
call GroupEnumUnitsOfPlayer(g,Player(0),b)
call GroupEnumUnitsOfPlayer(g,Player(6),b)
call DestroyBoolExpr(b)
set b=Condition(function V5X)
call GroupEnumUnitsInRange(g,0,0,$3E8,b)
call DestroyGroup(g)
call DestroyBoolExpr(b)
set b=null
set b=null
endfunction
function ZEE takes nothing returns nothing
set R6V=true
call TriggerRegisterTimerEvent(R1V,.25,true)
call TriggerAddCondition(R1V,Condition(function V3X))
call TimerStart(CreateTimer(),5,true,function V6X)
endfunction
function V7X takes integer l returns integer
local integer i=0
loop
if OWV[l]+OWV[l+1]+OWV[l+2]+OWV[l+3]+OWV[l+4]==0 then
return $C
endif
set i=GetRandomInt(0,4)
if RMV[i+l]then
set OWV[i+l]=0
endif
if RMV[i+l]==false and OWV[i+l]!=0 then
set OWV[i+l]=0
return i+l
endif
endloop
return $C
endfunction
