call F7(K3V,"g",g)
call O7(K3V,"destroyGroup",XQO)
else
call F7(K3V,"g",XPO)
call O7(K3V,"destroyGroup",XQO)
endif
call E7(K3V,"FX_Interval",XGO)
call E7(K3V,"LastFX_x",x1)
call E7(K3V,"LastFX_y",y1)
call TriggerRegisterTimerEvent(t,.0625,true)
call TriggerAddCondition(t,Condition(function XBO))
set t=null
set g=null
endfunction
