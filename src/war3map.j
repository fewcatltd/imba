call SetLightningColor(DYO,1,1,1,1)
call SaveLightningHandle(le,(K3V),StringHash("Lightning"),(DYO))
call A7(K3V,"Source",p5)
call A7(K3V,"Target",m5)
call n7(K3V,"Level",JFV)
call E7(K3V,"SourceX",GetUnitX(p5)*1.)
call E7(K3V,"SourceY",GetUnitY(p5)*1.)
call E7(K3V,"LastX",GetUnitX(m5)*1.)
call E7(K3V,"LastY",GetUnitY(m5)*1.)
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function DWO))
call HPV(p5,m5,1,25+25*JFV)
if H3V(p5)then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DAMAGED)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,3.5,false)
call DFV(t,'s',p5)
call DFV(t,'u',m5)
call TriggerAddCondition(t,Condition(function D0O))
set t=null
endif
set t=null
set DYO=null
endfunction
function D2O takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local integer R3X=GetTriggerEvalCount(t)
local integer JFV=E8(K3V,"Level")
local unit p5=Y7(K3V,"Source")
local real l4=X8(K3V,"Angle")
local real D3O=X8(K3V,"SourceX")
local real D4O=X8(K3V,"SourceY")
local real Y5=X8(K3V,"TargetX")
local real Z5=X8(K3V,"TargetY")
local real DZO=D3O+(30*(20+JFV*2)/ 30)*R3X*Cos(l4*bj_DEGTORAD)
local real D_O=D4O+(30*(20+JFV*2)/ 30)*R3X*Sin(l4*bj_DEGTORAD)
local real D5O=SquareRoot((DZO-Y5)*(DZO-Y5)+(D_O-Z5)*(D_O-Z5))
local real D6O=300+'d'*JFV
local real D7O=$AF
local real D8O=(1-D5O/ D6O)*D7O*2
local group g=KHV()
local unit m5
if R3X==1 then
call SetUnitAnimationByIndex(p5,5)
call SetUnitTimeScale(p5,1.5)
endif
if D8O>D7O then
call SetUnitAnimationByIndex(p5,5)
set D8O=D7O*2-D8O
endif
call SetUnitFlyHeight(p5,MXV(D8O,0),0)
call SetUnitX(p5,L1V(DZO))
call SetUnitY(p5,L2V(D_O))
call SetUnitFacing(p5,l4)
set xL=p5
call GroupEnumUnitsInRange(g,DZO,D_O,'n',Condition(function P0V))
set m5=FirstOfGroup(g)
call KGV(g)
if D5O<30 or m5!=null or GetTriggerEvalCount(t)>75 then
call SetUnitFlyHeight(p5,0,0)
call SetUnitFacing(p5,l4)
call SetUnitTimeScale(p5,1)
call SetUnitAnimation(p5,"stand")
call SetUnitPathing(p5,true)
call UnitRemoveAbility(p5,'A1J6')
call MMV(GetUnitX(p5),GetUnitY(p5),'d')
if m5!=null and K1V(m5)==false then
call D1O(p5,m5,JFV)
endif
call a7(K3V)
call KJV(t)
endif
set t=null
set p5=null
set m5=null
return false
endfunction
