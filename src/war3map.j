set cT[i]="High costs and cooldowns give Atropos limited ability use: Cast spells intelligently and get items like Null Talismans and/or Magic Stick for your mana pool."
set CT[i]="Brain Sap is a powerful nuke and heal and deals exact unreduced damage so get it early and always try to use it on enemy heroes when using the spell."
set DT[i]="Use Nightmare to help teammates to aim their spells and remove an opponent from battles temporarily while you fight their allies."
set fT[i]="Enfeeble is usually a skill to get after Brain Sap and Nightmare to use on enemy heroes with high damage to reduce their damage capabilities severely."
set FT[i]="Fiend's Grip will work on Magic Immune units such as those under the active effect of Black King Bar, holding them in place but dealing no damage."
set i=i+1
set qt[76]='U00E'
set IT[76]='h05Z'
set Qt[76]='n0B8'
set RT[76]="ReplaceableTextures\\CommandButtons\\BTNGhostOfKelThuzad.blp"
call LQV(qt[76],"stand victory")
call LKV(qt[76],1.3,IT[76])
set cT[i]="Death Pulse lets you kill creeps and harass heroes simultaneously, great for pushing and healing allied units because of its low cooldown."
set CT[i]="Sadist will provide you with some early regeneration for killing creeps, while Heartstopper Aura becomes effective as the game goes on."
set DT[i]="Reaper's Scythe is known for its ability to kill heroes outright, allowing you to bring down even high-HP Strength heroes with ease."
set fT[i]="Your ultimate can also be used to stun opponents in certain situations, such as interrupting channeling spells and teleports."
set FT[i]="Items like Bloodstone or Heart of Tarrasque allow you to survive long enough in team battles to make your spells more effective."
set i=i+1
set qt[77]='U00F'
set IT[77]='h060'
set Qt[77]='n0C5'
set RT[77]="ReplaceableTextures\\CommandButtons\\BTNAbomination.blp"
call LQV(qt[77],"stand 3")
call LKV(qt[77],1.1,IT[77])
set cT[i]="Pudge can known for his ability to isolate enemies with Meat Hook and using Rot and Dismember afterward, killing them outright. "
set CT[i]="Early regeneration and movement speed items such as Bottle and Phase Boots help provide Pudge with the means to cast spells and chase his opponents."
set DT[i]="Use Meat Hook from a location where you are not obstructed by any allied or enemy units other than your target to ensure a better chance of landing it."
set fT[i]="A Hood of Defiance will improve your magic resistance to reduce damage from using Rot and getting hit by spells; The massive regeneration is also good."
set FT[i]="Use your spells defensively: Rot can be used to commit suicide if necessary and Meat Hook can be used to rescue an ally from one or more enemies."
set i=i+1
set qt[78]='O00J'
set IT[78]='h061'
set Qt[78]='n0C3'
set RT[78]="ReplaceableTextures\\CommandButtons\\BTNSpiritWalker.blp"
call LQV(qt[78],"stand ready")
call LKV(qt[78],1.2,IT[78])
set cT[i]="Empowering Haste is a smart skill to level first, it gives Barathrum movement speed and significant damage for killing creeps and heroes."
set CT[i]="A level of Greater Bash early game can be useful as an extra disable, since the 17% chance is the same for all levels.A level of Greater Bash early game can be useful as an extra disable, since the 17% chance is the same for all levels."
set DT[i]="Get Strength Power Treads because the attack and movement speed benefits your other skills and the boost in HP helps you survive."
set fT[i]="Charge of Darkness gives Barathrum spell immunity after 12 seconds and provides vision of the target for you and your allies."
set FT[i]="Nether Strike puts you from the opposite side of where you were facing, push opponents backwards and into your allies."
set i=i+1
set qt[79]='Ubal'
set IT[79]='h062'
set Qt[79]='n0BX'
set RT[79]="ReplaceableTextures\\CommandButtons\\BTNNerubianQueen.blp"
call LQV(qt[79],"attack")
call LKV(qt[79],1.,IT[79])
call LXV(qt[79],$FF,$C8,$C8)
set cT[i]="Take care of Weaver's HP/damage problems with Bracers or Wraith Bands and get regeneration so IsRealPlayer can use his spells freely."
set CT[i]="An early level of Watchers can be used to provide vision over the rune powerups. Patrol them to increase their area of detection."
set DT[i]="Shukuchi is used for harassing and chasing opponents offensively, and escaping and avoiding certain projectile spells defensively."
set fT[i]="If your Geminate Attack is not working, make sure that you input an attack command ('A' or right-click) and are not simply auto-attacking."
set FT[i]="Use Time Lapse after taking a lot of recent damage to heal yourself, allowing you to pull off some dangerous moves like diving into towers."
set i=i+1
set qt[80]='Nfir'
set IT[80]='h063'
set Qt[80]='n0BN'
set RT[80]="ReplaceableTextures\\CommandButtons\\BTNShade.blp"
call LQV(qt[80],"stand channel")
call LKV(qt[80],1.15,IT[80])
call LXV(qt[80],0,0,0)
set cT[i]="Necromastery is important because of its massive damage gain and because your ultimate deals damage based on the number of souls."
set CT[i]="Shadow Raze gives you three powerful nuke spells that should be maxed out first. Gauge the distance correctly and hit multiple times."
set DT[i]="Requiem of Souls deals more damage the closer you are: Placement items like Lothar's Edge and Kelen's Dagger can help you land it."
set fT[i]="After maxing your other two spells, Presence of the Dark Lord will be useful by then, good for pushing and dealing more physical damage."
set FT[i]="If you die, remember to fill up on souls again before major fights when you respawn or you will be much less effective in battles."
set i=i+1
set qt[81]='U00K'
set IT[81]='h064'
set Qt[81]='n0C4'
set RT[81]="ReplaceableTextures\\CommandButtons\\BTNArachnathidGreen.blp"
call LQV(qt[81],"attack 3")
call LKV(qt[81],1,IT[81])
set cT[i]="Burrowstrike is both versatile and powerful: It deals damage, stuns and provides you with a useful escape or chasing mechanism."
set CT[i]="Using Sandstorm at the right time will dodge certain projectile spells and can protect you temporarily if it is necessary."
set DT[i]="Getting Kelen's Dagger will give him increased mobility and reach, and also the ability to Blink into battle right after channeling Epicenter."
set fT[i]="While you cannot move while Epicenter is channeling, once the pulses begin you can freely move around (mostly to chase your opponent)."
set FT[i]="Caustic Finale might be an orb effect but it is extremely useful for killing multiple units quickly for fighting neutrals, pushing and defending."
set i=i+1
set qt[82]='Opgh'
set IT[82]='h065'
set Qt[82]='n0BM'
set RT[82]="ReplaceableTextures\\CommandButtons\\BTNChaosGrom.blp"
call LQV(qt[82],"stand victory")
call LKV(qt[82],1,IT[82])
set cT[i]="Counter Helix gives Axe the flexibility to both lane and jungle. A Stout Shield will help reduce the damage from taking attacks in order to activate Helix."
set CT[i]="A Vanguard or a Hood of Defiance offers survivability and regeneration, which are usually more useful to Axe than increasing his attack speed or damage."
set DT[i]="Berserker's Call is used to initiate fights and draw focus fire. Using it when there are more enemy units increases the chance of activating Counter Helix."
set fT[i]="Monitor your opponent's HP for the perfect Culling Blade opportunity to finish them off. However, if your enemy has too much HP, it will hardly do anything."
set FT[i]="Kelen's Dagger and/or Phase Boots can help you enter the fight first and get close enough for a Berserker's Call."
set i=i+1
set qt[83]='Hvsh'
set IT[83]='h066'
set Qt[83]='n0BZ'
set RT[83]="ReplaceableTextures\\CommandButtons\\BTNShaman.blp"
call LQV(qt[83],"stand victory")
call LKV(qt[83],1.25,IT[83])
call LXV(qt[83],$FA,$96,$96)
set cT[i]="Getting Blood Bath will allow you to take a few hits as you are killing creeps because you will recover your health immediately afterwards."
set CT[i]="An early level of Bloodrage can be useful for silencing enemies temporarily and for dealing a little bit of damage."
set DT[i]="Phase Boots and HP can be just as useful as damage items because they increase his survivability for chasing enemies and other longer battles."
set fT[i]="Use Rupture when your enemy has to either run away or to prevent them from moving, such as when an ally is about to use a powerful spell."
set FT[i]="Both allies and enemies gain the massive damage increase and are silenced from Bloodrage, which can be disastrous if used incorrectly."
set i=i+1
set qt[84]='Udea'
set IT[84]='h067'
set Qt[84]='n0BL'
set RT[84]="ReplaceableTextures\\CommandButtons\\BTNHeroDeathKnight.blp"
call LQV(qt[84],"stand ready")
call LKV(qt[84],1,IT[84])
set cT[i]="Abbadon's spells can save allies while dealing damage, so support and regeneration items like Vladmir's Offering can be more useful than damage items."
set CT[i]="Death Coil can be used both as a nuke and a heal, just remember that it deals damage to you unless you are using Aphotic Shield or Borrowed Time."
set DT[i]="Aphotic Shield prevents damage but can also be used to remove certain debuffs, such as removing the stun duration effect on an ally."
set fT[i]="Frostmourne is usually gotten later but it is very useful for chasing and helping your allies outrun your opponents."
set FT[i]="Borrowed Time can be cast manually as well. If you know you are going to receive a lot of damage sometimes it can be wiser to use it then."
set i=i+1
set qt[85]='E01B'
set IT[85]='h068'
set Qt[85]='n0B9'
set RT[85]="ReplaceableTextures\\CommandButtons\\BTNvengeanceincarnate.blp"
call LQV(qt[85],"stand ready")
call LKV(qt[85],.8,IT[85])
set cT[i]="Spectral Dagger is your utility spell. You can use it for chasing people down, scouting dangerous areas and escaping. "
set CT[i]="You also walk through units, trees, even cliffs while you are walking on Spectral Dagger's black path, making it very handy when used properly."
set DT[i]="Desolate is great for dealing target to isolated targets but Dispersion helps you to survive in the lane: Chose whatever combination suits you best."
set fT[i]="Haunt lets you jump into a fight directly from anywhere in the map; just make sure that you pay attention to the actions of your team."
set FT[i]="Getting HP will allow you to withstand and dish out more Dispersion damage, which is extremely powerful in team fights."
set i=i+1
set qt[86]='E01A'
set IT[86]='h069'
set Qt[86]='n0BK'
set RT[86]="ReplaceableTextures\\CommandButtons\\BTNWitchDoctor.blp"
call LQV(qt[86],"stand victory")
call LKV(qt[86],1.25,IT[86])
set cT[i]="Paralyzing Cask is your initiating spell for your other skills and can effectively keep two nearby units stun-locked at higher levels."
set CT[i]="Maledict drastically reduces the damage needed to kill opponents and is an important spell to land in every fight."
set DT[i]="An early level of Voodoo Restoration can provide a relatively cheap heal if you are forced to play defensively."
set fT[i]="Damaging your opponent immediately after using Maledict is wise because it will deal more bonus damage overall at the 3 ticks."
set FT[i]="Death Ward is a powerful channeling spell if not interrupted. A Black King Bar will help to prevent enemies from disabling you."
set i=i+1
set qt[87]='U00P'
set IT[87]='h06A'
set Qt[87]='n0BA'
set RT[87]="ReplaceableTextures\\CommandButtons\\BTNDestroyer.blp"
call LQV(qt[87],"stand alternate 2")
call LKV(qt[87],.85,IT[87])
set cT[i]="Getting Intelligence and mana items is extremely important for Harbringer as the power of Arcane Orb and Sanity's Eclipse rely on this."
set CT[i]="Use Astral Imprisonment to control your opponents' mana, for escaping/chasing, or on yourself and allies to avoid spells."
set DT[i]="Cast Arcane Orb manually early on because you will have a greater chance of activating Essence Aura to use it endlessly."
set fT[i]="Guinsoo's Scythe of Vyse is a great choice because it offers Intelligence, balanced stats and provides Harbringer with a powerful disable."
set FT[i]="Use Sanity's Eclipse early in fights so that you drain casters with high Intelligence of their mana and cripple their ability to cast spells."
set i=i+1
set qt[88]='E01C'
set IT[88]='h06C'
set Qt[88]='n0BB'
set RT[88]="ReplaceableTextures\\CommandButtons\\BTNGuldan.blp"
call LQV(qt[88],"spell")
call LKV(qt[88],1.5,IT[88])
set cT[i]="Shadow Word is either a heal or damage over time, definitely the most powerful early game spell to have."
set CT[i]="The affordable Mekansm is a good support item for Warlock, who is not a hero who is reliant on gold and items to be effective."
set DT[i]="Rain of Chaos creates a powerful Infernal that can take on heroes and is also great for killing creeps and pushing buildings."
set fT[i]="Fatal Bonds can deal huge damage if you and your teammates have other area of effect (AoE) spells that would hurt multiple linked units."
set FT[i]="The stun when using Rain of Chaos along with its huge casting range (1200) is great for interrupting spells and initiating battles."
set i=i+1
set qt[89]='H00I'
set IT[89]='h06D'
set Qt[89]='n0BJ'
set RT[89]="ReplaceableTextures\\CommandButtons\\BTNKoboldGeomancer.blp"
call LQV(qt[89],"spell")
call LKV(qt[89],1.4,IT[89])
call LKV('H00J',1.4,IT[89])
set cT[i]="Vladmir's Offering and/or Mekansm provides valuable auras and useful heals that can help support your team and keep your Meepos alive."
set CT[i]="Poof is both a teleport and damage spell and is great against neutrals. Poof to yourself to deal double the damage (from departure and arrival).Poof is both a teleport and damage spell and is great against neutrals. Poof to yourself to deal double the damage (from departure and arrival)."
set DT[i]="Geomancer is an advanced hero: Be sure to monitor their individual health because if one dies, they all will."
set fT[i]="Strength Power Treads are suggested since clones will receive all of the Strength from footwear along with a 2.5 bonus (12.5 total)."
set FT[i]="Time Earthbind with each of your clones. With 4 Meepos and Level 4 Earthbind, you can almost permanently immobilize them."
set i=i+1
set qt[90]='N01W'
set IT[90]='h06E'
set Qt[90]='n0BI'
set RT[90]="ReplaceableTextures\\CommandButtons\\BTNDarkTrollShadowPriest.blp"
call LQV(qt[90],"spell")
call LKV(qt[90],1.2,IT[90])
set cT[i]="An early level of both Shadow Wave and Shallow Grave provides a lot of support before getting Poison Touch to level 3 for its added stun."
set CT[i]="Try to use Shadow Wave to heal and damage opponents at the same time. Surround an enemy with multiple allied units for more damage."
set DT[i]="In addition to slowing and damaging opponents, Poison Touch will allow you to interrupt channeling spells and teleports"
set fT[i]="Dazzle generally does not need many items and can sometimes focus on increasing his spell use with regeneration and support items like Mekansm."
set FT[i]="Weave is a powerful spell, try to hit both allies and enemies with it, and it can also be used to provide vision before major battles occur."
set i=i+1
set qt[91]='N00R'
set IT[91]='h06F'
set Qt[91]='n0BC'
set RT[91]="ReplaceableTextures\\CommandButtons\\BTNPitLord.blp"
call LQV(qt[91],"stand channel")
call LKV(qt[91],1,IT[91])
set cT[i]="Firestorm will be your main ability for killing creeps but it can deal a lot of damage to heroes if you combine it with disables or slows."
set CT[i]="The Pit of Malice is a useful disable that lasts for 10 seconds so it will both ensnare opponents and deter opponents from entering the circle."
set DT[i]="Expulsion is usually used after some creeps have died so the spell lasts longer and will deal damage and mini-stun enemies."
set fT[i]="Pit Lord is played more as a caster, increase his team presence and spell use by obtaining expensive Intelligence items like Shiva's Guard."
set FT[i]="Dark Rift is a great spell for transporting multiple allies to surprise opponents, and more importantly to defend and attack the base."
set i=i+1
set qt[92]='H00R'
set IT[92]='h06G'
set Qt[92]='n0BH'
set RT[92]="ReplaceableTextures\\CommandButtons\\BTNZombie.blp"
call LQV(qt[92],"stand")
call LKV(qt[92],2,IT[92])
call LKV('H07I',1.3,IT[92])
set cT[i]="Decay is used to deal damage and make opponents more vulnerable, while increasing the survivability of Dirge temporarily."
set CT[i]="Make sure Dirge is a presence who can cast his spells in fights by buying regeneration items like Vladmir's Offering and Void Stone."
set DT[i]="Soul Rip is a powerful heal or nuke but remember that it will have almost no effect without nearby units. Cast it in crowds."
set fT[i]="Use Tombstone when engaging the enemy because the zombies have a slowing capability and may also help block your opponents."
set FT[i]="Tombstone Zombies become extremely powerful when your opponents have low health and attack and move much faster."
set i=i+1
set qt[93]='H00N'
set IT[93]='h06H'
set Qt[93]='n0BG'
set RT[93]="ReplaceableTextures\\CommandButtons\\BTNDranaiMage.blp"
call LQV(qt[93],"spell")
call LKV(qt[93],1.15,IT[93])
set cT[i]="Ion shell is great for killing creeps and dealing damage to heroes, but it will not damage an enemy target if you cast it on them directly."
set CT[i]="A level of Surge early game can help you and allies escape and chase enemies, and works nicely to help you close in on opponents with Ion Shell."
set DT[i]="Vacuum is an extremely powerful skill that can be used for initiating and combining with other spells. It can also interrupt channeling and teleport spells."
set fT[i]="Make sure they are standing closer to the edge of your targeting circle when casting Vacuum to pull your opponents further."
set FT[i]="Use Wall of Replica where multiple heroes will touch it; try using it with Vacuum. Get your allies to run through the wall too."
set i=i+1
set qt[94]='H00U'
set IT[94]='h06B'
set Qt[94]='n0BF'
set RT[94]="ReplaceableTextures\\CommandButtons\\BTNHeroBloodElfPrince.blp"
call LQV(qt[94],"spell")
call LKV(qt[94],1.25,IT[94])
set cT[i]="Having at least one level in Quas, Wex and Exort will give you a larger repertoire of spells. Type -invokelist to obtain a full list of combinations."
set CT[i]="Ghost Walk (QQW) can be used to get yourself out of a tight situation, and also for slowing opponents so that your allies can chase/escape."
set DT[i]="Sunstrike (EEE) is a global-ranged nuke that deals damage based on the level of Exort. When using it, you have to factor in the 1.7 casting time."
set fT[i]="Forge Spirit (EEQ) and Cold Snap (QQQ) can be effective for pushing towers and against heroes with low armor. "
set FT[i]="EMP (WWW) and Tornado (WWQ) can completely drain off heroes with low mana pools and have a impressive casting range."
set i=i+1
set qt[95]='Uktl'
set IT[95]='h04D'
set Qt[95]='n0A6'
set RT[95]="ReplaceableTextures\\CommandButtons\\BTNSpell_Shadow_SummonVoidWalker.blp"
call LQV(qt[95],"stand")
call LKV(qt[95],1.5,IT[95])
set cT[i]="Conversion allows Enigma to neutral creep effectively. Target the highest level creep possible and move your low HP Eidolons out of the way to save them."
set CT[i]="In the lane, Conversion can be used on allied creeps to deny your opponents of experience and gold, and for making sure you last hit enemy creeps."
set DT[i]="The multiple stuns on higher levels of Malefice make it useful for preventing an opponent from channeling spells or help you chase/escape them."
set fT[i]="Use Midnight Pulse in conjunction with Black Hole to deal massive damage to enemies. Just make sure that you cast it before Black Hole."
set FT[i]="Kelen's Dagger is great for Black Hole placement, and a Black King Bar will prevent most spells from stopping the channeling effect of the spell."
set i=i+1
