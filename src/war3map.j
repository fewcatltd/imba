call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function D0R))
else
call A7(K3V,"Target",m5)
call A7(K3V,"Source",p5)
call b7(K3V,"FX",AddSpecialEffectTarget("war3mapImported\\ShadowWordPurple.mdx",m5,"overhead"))
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function D_R))
endif
endif
set p5=null
set QJV=null
set m5=null
set t=null
endfunction
