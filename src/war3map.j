call SetHeroStr(K8V,d,false)
set l=l-d
set d=GetRandomInt(1,l-1)
call SetHeroAgi(K8V,d,false)
call FUV(K8V,"SAAgi",d)
call SetHeroInt(K8V,l-d,false)
call FUV(K8V,"SAInt",l-d)
elseif d==1 then
