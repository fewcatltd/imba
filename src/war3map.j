function SetStrucBBActive takes nothing returns nothing
local unit f=GetFilterUnit()
local trigger t=null
if IsUnitType(f,UNIT_TYPE_STRUCTURE)then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DAMAGED)
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function VPX))
set t=null
endif
set f=null
endfunction
