call TriggerSleepAction(.01)
endif
endfunction
function G7O takes player G8O returns nothing
local unit G9O=Y7(GetHandleId(G8O),"MyBear")
local unit HVO=ie[GetPlayerId(G8O)]
if((G9O!=null)and(A5(G9O)))then
call SetUnitX(G9O,GetUnitX(HVO)+GetRandomReal(25.,50.)*Cos(GetRandomReal(.0,360.)))
call SetUnitY(G9O,GetUnitY(HVO)+GetRandomReal(25.,50.)*Sin(GetRandomReal(.0,360.)))
endif
call SetPlayerAbilityAvailable(G8O,'A0A7',false)
set G9O=null
set HVO=null
endfunction
function aFq takes nothing returns nothing
local unit HEO=Y7(GetHandleId(GetOwningPlayer(GetTriggerUnit())),"MyBear")
if((HEO!=null)and(A5(HEO)))then
call jW(HEO,$D0012,h9[GetPlayerId(GetOwningPlayer(HEO))])
if(GetUnitAbilityLevel(HEO,'A0A7')>0)then
call G7O(GetOwningPlayer(GetTriggerUnit()))
endif
if(PDV(HEO))then
set hG[272+GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]=0
call G4O(Fc,0)
call G4O(gc,1)
call G4O(mc,2)
call G4O(jC,3)
call G4O(Mg,4)
call G4O(vC,5)
call G4O(zC,6)
call G4O(lc,7)
call G4O(Og,8)
call G4O(AD,9)
call G4O(vC,$A)
endif
endif
set HEO=null
endfunction
function HXO takes unit HOO returns item
if F5(HOO,Ac[ZC])!=null then
return F5(HOO,Ac[ZC])
elseif F5(HOO,Ac[ed])!=null then
return F5(HOO,Ac[ed])
elseif F5(HOO,Ac[od])!=null then
return F5(HOO,Ac[od])
elseif F5(HOO,Ac[ad])!=null then
return F5(HOO,Ac[ad])
elseif F5(HOO,Ac[Vd])!=null then
return F5(HOO,Ac[Vd])
endif
return null
endfunction
function HRO takes unit HIO,integer HAO,integer HNO,integer HBO,integer HCO,integer HDO,integer HFO,integer HGO,boolean HHO returns nothing
local item HJO=null
local integer HKO=0
local integer HLO=GetPlayerId(GetOwningPlayer(HIO))
local integer HMO=dH[HLO]
local integer HPO=GetPlayerState(GetOwningPlayer(HIO),PLAYER_STATE_RESOURCE_GOLD)
local item HQO=null
local item HSO=null
local item HTO=null
local item HUO=null
if PDV(HIO)then
set HMO=hG[256+GetPlayerId(GetOwningPlayer(HIO))]
endif
if HMO==HAO then
if HDO!=ZC and HFO!=ZC and HGO!=ZC then
set HUO=HXO(HIO)
if HUO!=null then
call t4()
call UnitRemoveItem(HIO,HUO)
call RemoveItem(HUO)
set HUO=CreateItem(Ac[Vd],9999,-9999)
call SetItemPlayer(HUO,GetOwningPlayer(HIO),false)
call T4()
endif
endif
set HKO=HKO+fH[HNO]
if HBO!=-1 then
set HKO=HKO+fH[HBO]
endif
if HCO!=-1 then
set HKO=HKO+fH[HCO]
endif
if HPO>HKO then
if HDO!=-1 then
if HDO==ZC or HDO==od or HDO==ad or HDO==Vd then
set HQO=HXO(HIO)
else
set HQO=F5(HIO,Ac[HDO])
endif
call t4()
call UnitRemoveItem(HIO,HQO)
call SetItemPosition(HQO,9999,-9999)
call T4()
endif
if HFO!=-1 then
if HFO==ZC or HFO==od or HFO==ad or HFO==Vd then
set HSO=HXO(HIO)
else
set HSO=F5(HIO,Ac[HFO])
endif
call t4()
call UnitRemoveItem(HIO,HSO)
call SetItemPosition(HSO,9999,-9999)
call T4()
endif
if HGO!=-1 then
if HGO==ZC or HGO==od or HGO==ad or HGO==Vd then
set HTO=HXO(HIO)
else
set HTO=F5(HIO,Ac[HGO])
endif
call t4()
call UnitRemoveItem(HIO,HTO)
call SetItemPosition(HTO,9999,-9999)
call T4()
endif
if HNO!=NNV then
if HNO==ZC then
set HNO=Vd
endif
set hG[32+GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]=HKO+$96
set HJO=CreateItem(Oc[HNO],GetUnitX(HIO),GetUnitY(HIO))
call SetItemPlayer(HJO,GetOwningPlayer(HIO),false)
call UnitAddItem(HIO,HJO)
call TriggerSleepAction(.01)
endif
if HBO!=-1 and HBO!=NNV then
if HBO==ZC then
set HBO=Vd
endif
set HJO=CreateItem(Oc[HBO],GetUnitX(HIO),GetUnitY(HIO))
call SetItemPlayer(HJO,GetOwningPlayer(HIO),false)
call UnitAddItem(HIO,HJO)
call TriggerSleepAction(.01)
endif
if HCO!=-1 and HCO!=NNV then
if HCO==ZC then
set HCO=Vd
endif
set HJO=CreateItem(Oc[HCO],GetUnitX(HIO),GetUnitY(HIO))
call SetItemPlayer(HJO,GetOwningPlayer(HIO),false)
call UnitAddItem(HIO,HJO)
call TriggerSleepAction(.01)
endif
call SetPlayerState(GetOwningPlayer(HIO),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(HIO),PLAYER_STATE_RESOURCE_GOLD)-HKO)
if PDV(HIO)then
set hG[256+GetPlayerId(GetOwningPlayer(HIO))]=hG[256+GetPlayerId(GetOwningPlayer(HIO))]+1
else
set dH[HLO]=dH[HLO]+1
set hG[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]=(hG[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]+1)
endif
if HHO==false then
if HQO!=null then
call t4()
call UnitAddItem(HIO,HQO)
call T4()
endif
if HSO!=null then
call t4()
call UnitAddItem(HIO,HSO)
call T4()
endif
if HTO!=null then
call t4()
call UnitAddItem(HIO,HTO)
call T4()
endif
else
if HDO!=-1 then
call SetPlayerState(GetOwningPlayer(HIO),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(HIO),PLAYER_STATE_RESOURCE_GOLD)+R2I(.5*fH[HDO]))
call RemoveItem(HQO)
endif
if HFO!=-2 then
call SetPlayerState(GetOwningPlayer(HIO),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(HIO),PLAYER_STATE_RESOURCE_GOLD)+R2I(.5*fH[HFO]))
call RemoveItem(HSO)
endif
if HGO!=-3 then
call SetPlayerState(GetOwningPlayer(HIO),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(HIO),PLAYER_STATE_RESOURCE_GOLD)+R2I(.5*fH[HGO]))
call RemoveItem(HTO)
endif
endif
endif
if HUO!=null then
call t4()
call UnitAddItem(HIO,HUO)
call T4()
endif
endif
endfunction
