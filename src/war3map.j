local real d=DWV(t,'r')
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local rect r=null
if GetUnitAbilityLevel(u,'B020')==0 or GetTriggerEventId()==EVENT_UNIT_DEATH then
call DYV(u,'A01U',false)
call GDV()
return
endif
if IVV then
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set r=Rect(x-d,y-d,x+d,y+d)
set AUV=u
set AQV=GetEventDamage()
call EnumDestructablesInRect(r,Condition(function U5R),function U4R)
call RemoveRect(r)
set r=null
endif
endif
set u=null
set t=null
endfunction
