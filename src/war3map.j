call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,XGV)
call DFV(t,'Sour',s)
call DFV(t,'Targ',u)
call DUV(t,'t',ITV+'d')
set t=null
endfunction
