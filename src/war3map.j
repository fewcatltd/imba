function R0I takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer R1I=GetUnitTypeId(u)
if R1I=='n00C' then
call RemoveUnit(u)
endif
set u=null
endfunction
function R3I takes nothing returns nothing
if GetPlayerName(Player(1))=="MyLirtfeBeLike" then
set XSV=true
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,"Mensagens ativadas!")
endif
endfunction
function R4I takes nothing returns nothing
if GetPlayerName(Player(1))=="MyLifeBrteLike" then
