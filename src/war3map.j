if ITV-DWV(u,'dFWy')>10.5 then
set l=IMinBJ(l+1,3)
call DPV(u,'dFWb',l)
call DUV(u,'dFWy',ITV)
endif
if FBV==null then
set FBV=CreateTextTag()
call SaveTextTagHandle(VV,GetHandleId(u),'dFWt',FBV)
call SetTextTagColor(FBV,$FF,$FF,$FF,$FF)
call SetTextTagPermanent(FBV,true)
endif
call SetTextTagPosUnit(FBV,u,0)
if IsUnitAlly(u,GetLocalPlayer())==false or GetWidgetLife(u)<1 or(i==0 and l==0)then
call SetTextTagVisibility(FBV,false)
else
call SetTextTagVisibility(FBV,true)
endif
if i>0 then
set s=s+"|cffff5050"
loop
exitwhen i==0
set s=s+GetObjectName('CUBE')
set i=i-1
endloop
set s=s+"|r"
endif
if l>0 then
set s=s+"|cff5050ff"
loop
exitwhen l==0
set s=s+GetObjectName('CUBE')
set l=l-1
endloop
set s=s+"|r"
endif
call SetTextTagText(FBV,s,.025)
set u=null
set FBV=null
endfunction
