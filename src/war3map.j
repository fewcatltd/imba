endif
set t=null
set p5=null
set QJV=null
set g=null
return false
endfunction
function JQX takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local integer JFV=GetUnitAbilityLevel(p5,'A064')
local real x1=X8(K3V,"x")
local real y1=X8(K3V,"y")
local unit QJV=CreateUnit(GetOwningPlayer(p5),'e00E',x1,y1,0)
local real x2
local real y2
local real d
local real a
local integer i
call UnitAddAbility(QJV,'A19F')
call SetUnitAbilityLevel(QJV,'A19F',JFV)
if GetTriggerEvalCount(t)==1 then
set i=1
loop
exitwhen i>$A
set d=GetRandomReal(0,450)
set a=GetRandomReal(0,360)
set x2=x1+d*Cos(a*bj_DEGTORAD)
set y2=y1+d*Sin(a*bj_DEGTORAD)
set QJV=CreateUnit(GetOwningPlayer(p5),'e00J',GetUnitX(p5),GetUnitY(p5),90)
call IssuePointOrderById(QJV,$D0010,x2,y2)
call UnitApplyTimedLife(QJV,'BTLF',.5)
set i=i+1
endloop
else
call a7(K3V)
call KJV(t)
set t=CreateTrigger()
set K3V=GetHandleId(t)
call A7(K3V,"Source",p5)
call A7(K3V,"Caster",QJV)
call E7(K3V,"x",(x1)*1.)
call E7(K3V,"y",(y1)*1.)
call n7(K3V,"Level",JFV)
call DFV(t,'f',CreateUnit(GetOwningPlayer(p5),'eA18',x1,y1,0))
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function JPX))
call TriggerEvaluate(t)
endif
set p5=null
set QJV=null
set t=null
return false
endfunction
