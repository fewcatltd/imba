call TriggerRegisterPlayerChatEvent(t,A6(O6)," ",true)
if(IsTriggerEnabled(jz))then
call TriggerRegisterPlayerChatEvent(jz,A6(O6),"-pa",true)
call TriggerRegisterPlayerChatEvent(jz,A6(O6),"-px",true)

if((A6(not O6)==null)and(ZRO))then
if(ZOO)then
// call DisplayTimedTextToPlayer(A6(O6),0,0,10.,"You can choose your AI allies'/opponents' heroes using -pa/-pe")
else
// call DisplayTimedTextToPlayer(A6(O6),0,0,10.,"You can choose your AI opponents' heroes using -pe") 
endif
call TriggerRegisterPlayerChatEvent(jz,A6(O6),"-pe",true)
elseif(ZOO)then
// call DisplayTimedTextToPlayer(A6(O6),0,0,10.,"You can choose your AI allies' heroes using -pa")
endif
endif
endif
endfunction
