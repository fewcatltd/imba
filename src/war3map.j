function RAR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local group g=DKV(t,'g')
local group g1=CreateGroup()
local boolexpr b=Condition(function PJV)
local real x=DWV(t,'x')
local real y=DWV(t,'y')
local integer i=DTV(t,'i')
local unit f=null
local real a=0
local real d=0
local real r='}'+25*i
set AUV=s
call GroupEnumUnitsInRange(g1,x,y,r+24,b)
loop
set f=FirstOfGroup(g1)
exitwhen f==null
set a=Atan2(GetUnitY(f)-y,GetUnitX(f)-x)
set d=DDV(f,x,y)
if IsUnitInGroup(f,g)then
if d>r then
call SetUnitX(f,x+Cos(a)*r)
call SetUnitY(f,y+Sin(a)*r)
endif
else
if d<r then
call SetUnitX(f,x+Cos(a)*r)
call SetUnitY(f,y+Sin(a)*r)
endif
endif
call GroupRemoveUnit(g1,f)
endloop
call DestroyGroup(g1)
call DestroyBoolExpr(b)
if ITV-DWV(t,'t')>0 then
call DestroyGroup(g)
call FIV()
endif
set t=null
set s=null
set g=null
set g1=null
set b=null
endfunction
function RNR takes nothing returns nothing
