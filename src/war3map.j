local unit f=null
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call GDV()
else
set AUV=s
set g=KHV()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),274,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call HPV(s,f,1,d)
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set s=null
endfunction
function U0R takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local integer i=DTV(t,'i')
local real x=DWV(t,'x')
local real y=DWV(t,'y')
local integer id='n00U'
local group g=KHV()
local boolexpr b=Condition(function PJV)
local unit f=null
local trigger U1R=CreateTrigger()
call MMV(x,y,600)
if i==2 then
set id='n00Y'
elseif i==3 then
set id='n00Z'
endif
set AUV=s
call GroupEnumUnitsInRange(g,x,y,624,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call QDV(f,1,true)
call HPV(s,f,1,'d')
call GroupRemoveUnit(g,f)
endloop
set f=CreateUnit(GetOwningPlayer(s),id,x,y,0)
call TriggerRegisterTimerEvent(U1R,1,true)
call TriggerRegisterUnitEvent(U1R,f,EVENT_UNIT_DEATH)
call TriggerAddCondition(U1R,Condition(function U_R))
call DFV(U1R,'s',f)
call DPV(U1R,'i',i)
set U1R=null
call UnitApplyTimedLife(f,'BTLF',60)
call DestroyBoolExpr(b)
call KGV(g)
call FIV()
set t=null
set g=null
set b=null
set f=null
set s=null
endfunction
function U2R takes unit s,integer i,real x,real y returns nothing
local timer t=CreateTimer()
