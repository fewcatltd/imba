function E4I takes nothing returns nothing
local unit s=GetTriggerUnit()
local group g=KHV()
local real a=GetUnitFacing(s)*bj_DEGTORAD
local real x=GetUnitX(s)+$C8*Cos(a)
local real y=GetUnitY(s)+$C8*Sin(a)
local boolexpr b=Condition(function PJV)
local integer i=9
local unit f=null
set AUV=s
loop
call GroupEnumUnitsInRange(g,x,y,325,b)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(s),'e006',x,y,0),'BTLF',2)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call HPV(s,f,1,300)
call GroupRemoveUnit(g,f)
endloop
set i=i-1
exitwhen i<1
set x=x+$FA*Cos(a)
set y=y+$FA*Sin(a)
call N8V(.1)
endloop
call DestroyBoolExpr(b)
call KGV(g)
set g=null
set b=null
set s=null
endfunction
function E3I takes nothing returns nothing
