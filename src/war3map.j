function G4O takes integer i,integer G5O returns nothing
local item G6O=null
if((hG[256+GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]==G5O)and(GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)>=fH[i])and((GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)>=fH[i]+$9C4)or(hG[272+GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]<2)))then
set G6O=CreateItem(Oc[i],9999,-9999)
call SetItemPlayer(G6O,GetOwningPlayer(GetTriggerUnit()),false)
call UnitAddItem(Y7(GetHandleId(GetOwningPlayer(GetTriggerUnit())),"MyBear"),G6O)
call SetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD,(GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)-fH[i]))
set hG[256+GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]=hG[256+GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]+1
set hG[272+GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]=hG[272+GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]+1
