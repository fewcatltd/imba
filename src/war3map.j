endfunction
function AZO takes nothing returns boolean
return((GetUnitAbilityLevel(GetTriggerUnit(),'A0MM')>0)and(GetUnitAbilityLevel(GetAttacker(),'A04R')==0)and(not IsUnitType(GetAttacker(),UNIT_TYPE_STRUCTURE))and(IsUnitEnemy(GetAttacker(),GetTriggerPlayer())))!=null
endfunction
function A_O takes nothing returns nothing
local location Mk=GetUnitLoc(GetAttacker())
call CreateNUnitsAtLoc(1,'o00S',GetOwningPlayer(GetTriggerUnit()),Mk,bj_UNIT_FACING)
call UnitAddAbility(bj_lastCreatedUnit,'A0KI')
call SetUnitAbilityLevelSwapped('A0KI',bj_lastCreatedUnit,GetUnitAbilityLevelSwapped('A0MM',GetTriggerUnit()))
call UnitApplyTimedLifeBJ(1.,'BTLF',bj_lastCreatedUnit)
call IssueTargetOrderById(bj_lastCreatedUnit,$D000F,GetAttacker())
call SetUnitPathing(bj_lastCreatedUnit,false)
call SetUnitInvulnerable(bj_lastCreatedUnit,true)
call UnitAddAbility(bj_lastCreatedUnit,'Aloc')
call RemoveLocation(Mk)
endfunction
