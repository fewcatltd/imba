call DUV(t,'00y2',y+Sin(a)*$FA)
else
set a=GetUnitFacing(s)*bj_DEGTORAD
set x=x+Cos(a)*700
set y=y+Sin(a)*700
call DestroyEffect(AddSpecialEffect("ShadowRazeTarget.mdx",x,y))
