function FIV takes nothing returns nothing
local timer tm=GetExpiredTimer()
call PauseTimer(tm)
call FlushChildHashtable(VV,GetHandleId(tm))
call DestroyTimer(tm)
set tm=null
endfunction
function FAV takes nothing returns nothing
local timer t=GetExpiredTimer()
call UnitRemoveAbility(DHV(t,'s'),DTV(t,'i'))
call FIV()
set t=null
endfunction
function FNV takes nothing returns nothing
local timer t=GetExpiredTimer()
local texttag FBV=D9V(t,'s')
local string s=D4V(t,'t')
local real r=ITV-DWV(t,'u')
local integer l=$FF
if r<=.25 then
call SetTextTagText(FBV,s,.025*3*r/.25)
elseif r<=.5 then
call SetTextTagText(FBV,s,.075-.05*(r-.25)/.25)
elseif r>=3 then
call FIV()
endif
set t=null
set FBV=null
endfunction
function FCV takes string FDV,unit FFV,boolean FGV returns texttag
local texttag FBV=CreateTextTag()
local timer t=CreateTimer()
set NZV=FBV
call SetTextTagText(FBV,FDV,.025)
call SetTextTagLifespan(FBV,3)
if FGV then
if ERV then
call SetTextTagColor(FBV,40,$8C,40,$FF)
set ERV=false
else
call SetTextTagColor(FBV,$FF,48,48,$FF)
endif
else
call SetTextTagColor(FBV,$FF,$FF,$FF,$FF)
endif
call SetTextTagPos(FBV,GetUnitX(FFV),GetUnitY(FFV),0)
call SetTextTagVelocity(FBV,0,.03)
call SetTextTagPermanent(FBV,false)
call SetTextTagVisibility(FBV,true)
call SetTextTagFadepoint(FBV,2)
if IsUnitVisible(FFV,GetLocalPlayer())==false then
call SetTextTagVisibility(FBV,false)
endif
call TimerStart(t,.025,true,function FNV)
call D8V(t,'s',FBV)
call D3V(t,'t',FDV)
call DUV(t,'u',ITV)
set t=null
set FBV=null
return NZV
endfunction
