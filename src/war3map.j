call E7(K3V,"SourceX",t5*1.)
call E7(K3V,"SourceY",w5*1.)
call E7(K3V,"TargetX",Y5*1.)
call E7(K3V,"TargetY",Z5*1.)
set p5=null
set t=null
endfunction
