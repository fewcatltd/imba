call SetHeroStr(s,R2I(GetHeroStr(s,true)*1.15),false)
call SetHeroAgi(s,R2I(GetHeroAgi(s,true)*1.15),false)
call SetHeroInt(s,R2I(GetHeroInt(s,true)*1.15),false)
