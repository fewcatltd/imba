set i=CountUnitsInGroup(g)
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
if GetRandomInt(0,99)<r then
if i<PJE then
set f=CreateUnit(GetOwningPlayer(s),'e00E',GetUnitX(s),GetUnitY(s),0)
set IUV=f
if l==0 then
set l='A0DD'
elseif l==1 then
set l='AA70'
elseif l==2 then
set l='AA71'
else
set l='AA72'
endif
if IVV==false then
set l='A0DD'
elseif EMV then
set l='AA70'
endif
