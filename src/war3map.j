function LHDownDateA takes nothing returns nothing
local item it=null
local integer i=0
local integer d=0
local unit s=ie[GetPlayerId(GetOwningPlayer(DHV(GetExpiredTimer(),'s')))]
if GetWidgetLife(s)<1 then
return
endif
set i=0
loop
exitwhen i>5
set it=UnitItemInSlot(s,i)
set d=GetItemTypeId(it)
if VVI(d)then
call RemoveItem(it)
call VXI(s,Ac[IPV[4]],i)
endif
set i=i+1
endloop
set it=null
call FIV()
endfunction
function VRI takes unit s returns nothing
local integer i=0
local integer l=0
local item t=null
if C7V(s,Ac[IPV[4]])>0 then
loop
exitwhen i>5
set t=UnitItemInSlot(s,i)
if GetItemTypeId(t)==Ac[IPV[4]]then
set l=(GetHeroLevel(s)-GetHeroLevel(HMV(GetKillingUnit())))
set l=IMaxBJ(l,0)
set l=GetItemCharges(t)-R2I(RMaxBJ(1,(l*1.34)))
call SetItemCharges(t,l)
endif
set i=i+1
endloop
set t=null
endif
endfunction
function VII takes nothing returns nothing
