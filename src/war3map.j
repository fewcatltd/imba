function HCX takes unit p5,unit m5,integer JFV returns nothing
local unit oA=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitX(m5),0)
local integer HDX
call A7(GetHandleId(oA),"SpiritTarget",m5)
if JFV==1 then
set HDX='A10H'
elseif JFV==2 then
set HDX='A10G'
elseif JFV==3 then
set HDX='A10I'
else
set HDX='A10F'
endif
call UnitAddAbility(oA,HDX)
call IssueTargetOrderById(oA,$D0132,p5)
set oA=null
endfunction
function HFX takes unit p5,unit m5,integer JFV,boolean HGX,boolean HHX returns nothing
local real HJX=50+50*JFV
local unit oA
local integer i=1
if HHX then
if IsUnitIllusion(p5) then
set i=0
if IVV then
set i=1
if EMV then
set i=GetRandomInt(1,5)
endif
endif
endif
if i==1 then
set oA=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
call UnitAddAbility(oA,'A10C')
call SetUnitAbilityLevel(oA,'A10C',JFV)
call IssueTargetOrderById(oA,$D00DD,m5)
call HPV(oA,m5,1,HJX*(1-C0V(IsUnitIllusion(p5))*.5))
if HGX then
call HCX(p5,m5,JFV)
endif
endif
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",m5,"origin"))
set oA=null
endfunction
function HKX takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local unit m5=Y7(K3V,"Target")
local integer JFV=E8(K3V,"Level")
local boolean HHX=O8(K3V,"damage")
local unit IJ=Y7(K3V,"Projectile")
local real x=GetUnitX(IJ)
local real y=GetUnitY(IJ)
local real hN=GetUnitX(m5)
local real ho=GetUnitY(m5)
local real Ik=$3E8*.035
local real IK=MDV(x,y,hN,ho)
local real Il=x+Ik*Cos(IK*bj_DEGTORAD)
local real IL=y+Ik*Sin(IK*bj_DEGTORAD)
call SetUnitX(IJ,Il)
call SetUnitY(IJ,IL)
call SetUnitFacing(IJ,IK)
if v6(hN,ho,Il,IL)<=Ik then
call HFX(p5,m5,JFV,true,HHX)
call KillUnit(IJ)
call a7(K3V)
call KJV(t)
endif
set t=null
set p5=null
set m5=null
set IJ=null
return false
endfunction
function HLX takes unit p5,integer JFV,unit m5,boolean HHX returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit IJ=CreateUnit(GetOwningPlayer(p5),'h06L',GetUnitX(p5),GetUnitY(p5),MDV(GetUnitX(p5),GetUnitY(p5),GetUnitX(m5),GetUnitY(m5)))
call A7(K3V,"Source",p5)
call A7(K3V,"Target",m5)
call O7(K3V,"damage",HHX)
call A7(K3V,"Projectile",IJ)
call n7(K3V,"Level",JFV)
call TriggerRegisterTimerEvent(t,.035,true)
call TriggerAddCondition(t,Condition(function HKX))
set t=null
endfunction
