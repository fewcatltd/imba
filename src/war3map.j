local unit K8V=Y7(K3V,"Hero")
local unit QJV=Y7(K3V,"Caster")
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call SetUnitPosition(K8V,GetUnitX(m5),GetUnitY(m5))
call CPV(K8V,false)
call ShowUnit(K8V,true)
call SetUnitPathing(K8V,true)
call ClearSelectionForPlayer(GetOwningPlayer(K8V))
call SelectUnitForPlayerSingle(K8V,GetOwningPlayer(K8V))
call SetUnitInvulnerable(K8V,false)
call DestroyEffect(r8(K3V,"FX"))
call DestroyEffect(r8(K3V,"FX3"))
call RemoveUnit(QJV)
call a7(K3V)
call KJV(t)
elseif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and GetSpellAbilityId()=='A0SX' then
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",GetUnitX(m5),GetUnitY(m5)))
if GetUnitAbilityLevel(K8V,'A0SW')==3 then
call SetUnitState(K8V,UNIT_STATE_LIFE,GetUnitState(K8V,UNIT_STATE_LIFE)+GetUnitState(m5,UNIT_STATE_MAX_LIFE))
else
call SetUnitState(K8V,UNIT_STATE_LIFE,GetUnitState(K8V,UNIT_STATE_LIFE)+GetUnitState(m5,UNIT_STATE_LIFE))
endif
call SetUnitPosition(K8V,GetUnitX(m5),GetUnitY(m5))
call CPV(K8V,false)
call ShowUnit(K8V,true)
call SetUnitPathing(K8V,true)
call SetUnitAnimation(K8V,"Stand Victory")
call M3V(K8V,1.5)
call ClearSelectionForPlayer(GetOwningPlayer(K8V))
call SelectUnitForPlayerSingle(K8V,GetOwningPlayer(K8V))
call SetUnitInvulnerable(K8V,false)
call DestroyEffect(r8(K3V,"FX"))
call DestroyEffect(r8(K3V,"FX3"))
call RemoveUnit(QJV)
call CCV(m5,true,true)
call a7(K3V)
call KJV(t)
call HPV(K8V,m5,1,$186A0)
call HPV(K8V,m5,2,$186A0)
call HPV(K8V,m5,3,$186A0)
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_SELECTED and GetTriggerUnit()==m5 then
call ClearSelectionForPlayer(GetOwningPlayer(K8V))
call SelectUnitAddForPlayer(QJV,GetOwningPlayer(K8V))
else
call SetUnitPosition(K8V,GetUnitX(m5),GetUnitY(m5))
endif
set t=null
set m5=null
set K8V=null
return false
endfunction
function VOR takes nothing returns nothing
local unit K8V=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit QJV=CreateUnit(GetOwningPlayer(K8V),'e010',7260,-7732,0)
local string VRR="Objects\\Spawnmodels\\Naga\\NagaBlood\\NagaBloodWindserpent.mdl"
local string VIR="Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBase.mdl"
local string VAR="Abilities\\Spells\\Other\\Aneu\\AneuTarget.mdl"
if IsPlayerEnemy(GetLocalPlayer(),GetOwningPlayer(K8V))then
set VRR=""
set VIR=""
set VAR=""
endif
call CCV(K8V,true,true)
call SetUnitInvulnerable(QJV,true)
call UnitAddAbility(QJV,'A0SX')
call ClearSelectionForPlayer(GetOwningPlayer(K8V))
call SelectUnitForPlayerSingle(QJV,GetOwningPlayer(K8V))
call UnitShareVision(m5,GetOwningPlayer(K8V),true)
call SetUnitInvulnerable(K8V,true)
call ShowUnit(K8V,false)
call CPV(K8V,true)
call SetUnitPathing(K8V,false)
call DestroyEffect(AddSpecialEffectTarget(VRR,m5,"overhead"))
call A7(K3V,"Target",m5)
call A7(K3V,"Hero",K8V)
call A7(K3V,"Caster",QJV)
call b7(K3V,"FX",AddSpecialEffectTarget(VIR,m5,"overhead"))
call b7(K3V,"FX3",AddSpecialEffectTarget(VAR,m5,"overhead"))
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerRegisterPlayerUnitEvent(t,GetOwningPlayer(K8V),EVENT_PLAYER_UNIT_SELECTED,Condition(function j6))
call TriggerRegisterUnitEvent(t,QJV,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerAddCondition(t,Condition(function VXR))
set t=null
set K8V=null
set m5=null
endfunction
