local integer K3V=GetHandleId(t)
local unit m5=Y7(K3V,"Target")
local real RK=X8(K3V,"Angle")
local real x=GetUnitX(m5)
local real y=GetUnitY(m5)
local integer iX=GetTriggerEvalCount(t)
local real MWX=X8(K3V,"Rate")
local integer Y0=E8(K3V,"MaxCount")
if iX>$E then
call E7(K3V,"Rate",MWX*.98)
endif
if GetTriggerEventId()==EVENT_UNIT_DEATH or iX>Y0 then
call a7(K3V)
call KJV(t)
else
if iX-iX/5*5==0 then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",x,y))
endif
call MMV(x,y,$96)
call SetUnitPosition(m5,x+MWX*Cos(RK),y+MWX*Sin(RK))
endif
set t=null
set m5=null
return false
endfunction
function RNO takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit p5=GetAttacker()
local unit m5=GetTriggerUnit()
local real RK=Atan2(GetUnitY(m5)-GetUnitY(p5),GetUnitX(m5)-GetUnitX(p5))
local integer JFV=GetUnitAbilityLevel(p5,'A0G5')
local group g=null
local unit u=null
local boolexpr b=null
if GUV(m5)then
set p5=null
set m5=null
call DestroyTrigger(t)
set t=null
return
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile_mini.mdl",p5,"weapon"))
call A7(K3V,"Target",m5)
call E7(K3V,"Angle",RK)
call E7(K3V,"Rate",5)
call n7(K3V,"MaxCount",30+8*JFV)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function RAO))
call IssueTargetOrderById(p5,$D000F,m5)
if H3V(p5)then
set g=CreateGroup()
set AUV=p5
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,GetUnitX(m5),GetUnitY(m5),325,b)
call GroupRemoveUnit(g,m5)
loop
set u=FirstOfGroup(g)
exitwhen u==null
set t=CreateTrigger()
set K3V=GetHandleId(t)
set RK=Atan2(GetUnitY(u)-GetUnitY(p5),GetUnitX(u)-GetUnitX(p5))
call A7(K3V,"Target",u)
call E7(K3V,"Angle",RK)
call E7(K3V,"Rate",5)
call n7(K3V,"MaxCount",30+8*JFV)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function RAO))
call HPV(p5,u,1,25*JFV)
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
call HPV(p5,m5,1,25*JFV)
call K5V(p5,"RNO",1.5-1.5)
set t=null
set p5=null
set m5=null
endfunction
