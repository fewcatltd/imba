function BOR takes unit K8V,item OVE,integer X9E returns item
local real x=X5E(K8V)
local real y=X7E(K8V)
local integer i=0
local boolean array BRR
local item Z4
loop
exitwhen i>(UnitInventorySize(K8V)-1)
if UnitItemInSlot(K8V,i)==null and i!=X9E then
set Z4=CreateItem('I02M',x,y)
call UnitAddItem(K8V,Z4)
set BRR[i]=true
else
set BRR[i]=false
endif
if i==X9E then
call UnitAddItem(K8V,OVE)
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>5
if BRR[i] then
call RemoveItem(UnitItemInSlot(K8V,i))
endif
set i=i+1
endloop
set cj=OVE
set Z4=null
return cj
endfunction
function BIR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit K8V=Y7(K3V,"Hero")
local integer i=0
local item BAR
local integer DRE
local unit QJV
local item BNR
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call O7(GetHandleId(K8V),"LinkenSphere|CD",false)
call a7(K3V)
call KJV(t)
elseif BER(K8V)==false then
call TriggerRegisterTimerEvent(t,5.5,false)
else
call O7(GetHandleId(K8V),"LinkenSphere|CD",false)
call DisableTrigger(rH)
if cZ[GetPlayerId(GetOwningPlayer(K8V))]>0 then
call SetItemVisible(UnitAddItemById(K8V,'I0HM'),false)
endif
loop
exitwhen i>5
set BAR=UnitItemInSlot(K8V,i)
set DRE=CWV(BAR)
if DRE==ff then
set nL=GetItemPlayer(BAR)
call RemoveItem(BAR)
set QJV=CreateUnit(GetOwningPlayer(K8V),'e00E',GetUnitX(K8V),GetUnitY(K8V),0)
call UnitAddAbility(QJV,'AInv')
set BNR=UnitAddItemById(QJV,Ac[NLV])
call UnitUseItem(QJV,BNR)
set cj=BOR(K8V,BNR,i)
call SetItemPlayer(BNR,nL,false)
call SetItemUserData(BNR,1)
call UnitRemoveAbility(QJV,'AInv')
set QJV=null
set BNR=null
endif
set BAR=null
set i=i+1
endloop
call EnableTrigger(rH)
call a7(K3V)
call KJV(t)
endif
set t=null
set K8V=null
return false
endfunction
function BBR takes unit K8V returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local integer i=0
local item BAR
local integer DRE
local unit QJV
local item BNR
call DisableTrigger(rH)
call O7(GetHandleId(K8V),"LinkenSphere|CD",true)
call TriggerRegisterTimerEvent(t,20,false)
call TriggerRegisterUnitEvent(t,K8V,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function BIR))
call A7(K3V,"Hero",K8V)
loop
exitwhen i>5
set BAR=UnitItemInSlot(K8V,i)
set DRE=CWV(BAR)
if DRE==NLV or DRE==ff then
set nL=GetItemPlayer(BAR)
call RemoveItem(BAR)
set QJV=CreateUnit(GetOwningPlayer(K8V),'e00E',GetUnitX(K8V),GetUnitY(K8V),0)
call UnitAddAbility(QJV,'AInv')
set BNR=UnitAddItemById(QJV,Ac[ff])
call UnitUseItem(QJV,BNR)
set cj=BOR(K8V,BNR,i)
call SetItemPlayer(BNR,nL,false)
call SetItemUserData(BNR,1)
call UnitRemoveAbility(QJV,'AInv')
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",K8V,"origin"))
set QJV=null
