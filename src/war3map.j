if F5(S4,Ac[NQV])!=null and GetUnitTypeId(S4)!='H00J' then
set T0V=R2I(GetItemCharges(F5(S4,Ac[NQV]))*.5)
if GetItemCharges(F5(S4,Ac[NQV]))==1 then
set T0V=0
endif
call SetItemCharges(F5(S4,Ac[NQV]),T0V)
call AddHeroXP(S4,GetHeroXP(aW[GetPlayerId(GetOwningPlayer(S4))]),true)
call RemoveUnit(aW[GetPlayerId(GetOwningPlayer(S4))])
endif
endfunction
