return SquareRoot((x1-x)*(x1-x)+(y1-y)*(y1-y))
endfunction
function C4V takes string s returns string
local integer i=GetPlayerId(GetLocalPlayer())
if I7V[i]then
return""
endif
return s
endfunction
function C5V takes unit u returns nothing
local integer i=0
local item it=null
local integer array l
call DisableTrigger(rH)
loop
exitwhen i>5
set it=UnitItemInSlot(u,i)
if GetItemTypeId(it)>0 then
set XZV[i]=it
set l[i]=GetItemCharges(it)
call UnitRemoveItem(u,it)
else
set XZV[i]=null
set l[i]=0
endif
set i=i+1
endloop
call UnitRemoveAbility(u,'AInv')
call UnitAddAbility(u,'AInv')
set i=0
loop
exitwhen i>5
if XZV[i]!=null then
call UnitAddItem(u,XZV[i])
call UnitDropItemSlot(u,XZV[i],i)
if l[i]>0 then
call SetItemCharges(XZV[i],l[i])
endif
endif
set i=i+1
endloop
call EnableTrigger(rH)
set it=null
endfunction
function C6V takes unit u returns nothing
local integer n=0
local integer l=0
local integer i=GetHandleId(u)
local boolean b=GetTriggerEventId()==EVENT_PLAYER_UNIT_DROP_ITEM
local item it=null
call FlushChildHashtable(LO,i)
loop
exitwhen n>5
set it=UnitItemInSlot(u,n)
set l=GetItemTypeId(it)
if b==false or it!=GetManipulatedItem()then
call SaveInteger(LO,i,l,LoadInteger(LO,i,l)+1)
endif
call SaveInteger(LO,i,n,l)
if it!=null and l==0 then
call C5V(u)
endif
set it=null
set n=n+1
endloop
endfunction
function C7V takes unit u,integer i returns integer
local integer l=0
local integer r=0
if IsUnitType(u,UNIT_TYPE_DEAD)and(J or IsUnitIllusion(u)or IsUnitType(u,UNIT_TYPE_HERO)==false)then
return 0
endif
if GetUnitAbilityLevel(u,'AInv')==0 then
return 0
endif
return LoadInteger(LO,GetHandleId(u),i)
endfunction
function C8V takes unit u returns integer
local integer l=0
set l=l+C7V(u,'I0GJ')*24+$F*C7V(u,'I06F')+$A*C7V(u,'I062')
set l=l+6*(C7V(u,'I067')+C7V(u,'I06A'))
set l=l+45*C7V(u,'I012')+$A*C7V(u,'I0HI')+(C7V(u,'I09M')+C7V(u,'I09P')+C7V(u,'I09N')+C7V(u,'I09O')+C7V(u,'I09L'))*9+C7V(u,'I0AJ')*40
set l=l+22*C7V(u,'I08O')
set l=l+$C*C7V(u,'I095')+24*C7V(u,'I0BE')+$A*C7V(u,'I08H')+20*C7V(u,'I08T')+C7V(u,'I08P')*24+60*C7V(u,'I097')
set l=l+$FA*C7V(u,'I0A1')+$FA*C7V(u,'I0BP')+80*(C7V(u,'I0A5')+C7V(u,'I0K7'))+60*(C7V(u,'I0A8')+C7V(u,'I0KP'))+30*C7V(u,'I0AI')+81*C7V(u,'I0A3')
set l=l+(C7V(u,'I08K')+C7V(u,'I08L'))*40+65*C7V(u,'I099')+35*C7V(u,'I09C')+40*C7V(u,'I00M')+C7V(u,'I00Q')*9+38*C7V(u,'I09H')
set l=l+9*C7V(u,'I045')+18*C7V(u,'I046')+$A*C7V(u,'I04S')+21*C7V(u,'I048')+21*C7V(u,'I055')+24*C7V(u,'I04M')
set l=l+46*C7V(u,'I049')+60*C7V(u,'I04X')
set l=l+60*C7V(u,'I60I')+$A*(C7V(u,'I712')+C7V(u,'I716')+C7V(u,'I719')+C7V(u,'I71C')+C7V(u,'I71F'))+C7V(u,'I700')*80+'x'*C7V(u,'I60S')
set l=l+C7V(u,'I603')*30
return l
endfunction
function C9V takes unit u,integer i returns nothing
local integer x=i
local integer y=0
local integer n=0
set y=0
loop
exitwhen y>8
call UnitRemoveAbility(u,A_V[y])
call UnitRemoveAbility(u,A_V[y+$A])
set y=y+1
endloop
if i==0 then
return
endif
if x>511 then
set x=511
elseif x<-511 then
set x=-511
endif
if i<0 then
set x=-i
set n=$A
endif
set y=0
loop
exitwhen x<1 or y>8
if x-x/2*2==1 then
call UnitAddAbility(u,A_V[y+n])
call UnitMakeAbilityPermanent(u,true,A_V[y+n])
else
call UnitRemoveAbility(u,A_V[y+n])
endif
set x=x/2
set y=y+1
endloop
endfunction
