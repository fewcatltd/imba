function RKI takes nothing returns nothing
local string s=null
local integer i=GetPlayerId(GetLocalPlayer())
local integer l=0
local integer x=0
local integer y=0
local item it=null
set s=I2S(i)+"/"+GetUnitName(ie[i])+"/|n"
set l=1
loop
exitwhen l>5
set i=GetPlayerId(A7V[l])
set s=s+"PlayerId:"+I2S(i)+"/ PlayerName:"+lt[i]+"/ Hero:"
if ie[i]==null then
set s=s+"null/|n"
else
set s=s+GetUnitName(ie[i])+"/ HeroId:"+B9V(GetUnitTypeId(ie[i]))+"/ Items: "
set x=0
loop
exitwhen x>5
set it=UnitItemInSlot(ie[i],x)
set y=GetItemTypeId(it)
set s=s+"|nSlot "+I2S(x+1)+": "
if y>1 then
set s=s+GetItemName(it)+"/"+B9V(y)
else
set s=s+"null"
endif
set x=x+1
endloop
set s=s+"|nis SS mode: "
if IRV then
set s=s+"true"
set s=s+"|nRandom Skills: "+B9V(DTV(ie[i],'SSS1'))+"/"+B9V(DTV(ie[i],'SSS2'))+"/"+B9V(DTV(ie[i],'SSS3'))+"/"+B9V(DTV(ie[i],'SSS4'))+"|n"
else
set s=s+"false"
endif
set s=s+"|nis AK mode: "
if IIV then
set s=s+"true|nSkill Addition: "
set s=s+B9V(F_V(ie[i],"UnitSkillAddition"))+"|n"
else
set s=s+"false"
endif
endif
set i=GetPlayerId(A8V[l])
set s=s+"PlayerId:"+I2S(i)+"/ PlayerName:"+lt[i]+"/ Hero:"
if ie[i]==null then
set s=s+"null/|n"
else
set s=s+GetUnitName(ie[i])+"/ HeroId:"+B9V(GetUnitTypeId(ie[i]))+"/ Items: "
set x=0
loop
exitwhen x>5
set it=UnitItemInSlot(ie[i],x)
set y=GetItemTypeId(it)
set s=s+"|nSlot "+I2S(x)+": "
if y>1 then
set s=s+GetItemName(it)+"/"+B9V(y)
else
set s=s+"null"
endif
set x=x+1
endloop
set s=s+"|nis SS mode: "
if IRV then
set s=s+"true"
set s=s+"|nRandom Skills: "+B9V(DTV(ie[i],'SSS1'))+"/"+B9V(DTV(ie[i],'SSS2'))+"/"+B9V(DTV(ie[i],'SSS3'))+"/"+B9V(DTV(ie[i],'SSS4'))
else
set s=s+"false"
endif
set s=s+"|nis AK mode: "
if IIV then
set s=s+"true|nSkill Addition: "
set s=s+B9V(F_V(ie[i],"UnitSkillAddition"))
else
set s=s+"false"
endif
endif
set l=l+1
endloop
set it=null
call CJV(s)
endfunction
