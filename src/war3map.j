if FCR!=null then
call QDV(FCR,.1,false)
call HPV(FBR,FCR,1,20*GetUnitAbilityLevel(FBR,'A0Z4')-$A)
if H3V(FBR)and B8V(FBR,true)*'d'/(B8V(FBR,true)+$87)>GetRandomInt(0,99)then
if EMV then
call QHV(null,FCR,2.0)
