call B7(GetHandleId(UE),"MorphStr",Ub)
call A7(GetHandleId(UE),"Morphling",u8)
if(GetPlayerController(GetOwningPlayer(u8))!=MAP_CONTROL_USER)then
call B7(GetHandleId(GetOwningPlayer(u8)),"MorphAgi",UB)
call B7(GetHandleId(GetOwningPlayer(u8)),"MorphStr",Ub)
endif
else
call SetUnitAbilityLevel(u8,'A0KW',GetUnitAbilityLevel(u8,'A0KX'))
