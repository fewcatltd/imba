function WGE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local real WHE=X8(K3V,"T_CurrentX")
local real WJE=X8(K3V,"T_CurrentY")
local real WKE=X8(K3V,"T_MaxX")
local real WLE=$80
local real x
local real y
loop
exitwhen WHE>WKE
loop
exitwhen WJE>8192
set dW=dW+1
set x=WHE
set y=WJE
if IsPointBlighted(x,y)==false then
set DW[dW]=GetTerrainType(x,y)
set LW[dW]=GetTerrainVariance(x,y)
endif
set x=-WHE
set y=WJE
if IsPointBlighted(x,y)==false then
set fW[dW]=GetTerrainType(x,y)
set mW[dW]=GetTerrainVariance(x,y)
endif
set x=-WHE
set y=-WJE
if IsPointBlighted(x,y)==false then
set FW[dW]=GetTerrainType(x,y)
set MW[dW]=GetTerrainVariance(x,y)
endif
set x=WHE
set y=-WJE
if IsPointBlighted(x,y)==false then
set hW[dW]=GetTerrainType(x,y)
set pW[dW]=GetTerrainVariance(x,y)
endif
set WJE=WJE+WLE
endloop
set WJE=0
set WHE=WHE+WLE
endloop
set WKE=WKE+256
call E7(K3V,"T_CurrentX",WHE*1.)
call E7(K3V,"T_CurrentY",WJE*1.)
call E7(K3V,"T_MaxX",WKE*1.)
if WKE>8192 then
call a7(K3V)
call KJV(t)
endif
set t=null
return false
endfunction
function WME takes string T7E returns boolean
if T7E=="-ma" or T7E=="-ms" or T7E=="-cs" or T7E=="-cson" or T7E=="-disablehelp" or T7E=="-enablehelp" or T7E=="-unstuck" or T7E=="-recreate" then
return true
elseif T7E=="-swaphero" or T7E=="-showmsg" or T7E=="-hidemsg" or T7E=="-showdeny" or T7E=="-hidedeny" or T7E=="-weather rain" or T7E=="-weather snow" or T7E=="-weather moonlight" or T7E=="-weather wind" or T7E=="-weather random" or T7E=="-weather off" or T7E=="-denyinfo" or T7E=="-di" or T7E=="-deathon" or T7E=="-don" or T7E=="-deathoff" or T7E=="-doff" or T7E=="-roll" or T7E=="-hideheronames" or T7E=="-hhn" or T7E=="-test" or T7E=="-mute" or T7E=="-wtf" or T7E=="-fun" or T7E=="-fleshstr" or T7E=="-fs" or T7E=="-kickquiton" then
return true
elseif T7E=="-override" or T7E=="-formless" then
return true
endif
return false
endfunction
function WPE takes string qQ returns nothing
if cx==""then
set cx="|c006699CC"+qQ+"|r"
else
set cx=cx+"/|c006699CC"+qQ+"|r"
endif
endfunction
function WQE takes string P7E returns string
local integer SZV=StringLength(P7E)
local string qT
local string M9=""
local integer i=0
loop
exitwhen(i==SZV)
set qT=StringCase(SubString(P7E,i,i+1),false)
if not(qT==StringCase(qT,true))then
set M9=M9+qT
endif
set i=i+1
endloop
return M9
endfunction
function WSE takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit f=DHV(t,'f')
local real a=DWV(t,'a')
local real x=GetUnitX(Q)
local real y=GetUnitY(Q)
local group g=null
local boolexpr b=null
local unit u=null
local real d=DWV(t,'d')
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call KillUnit(f)
call GDV()
else
if DZV(t,'b')then
if d<'d' then
call DYV(t,'b',false)
set x=GetUnitX(f)
set y=GetUnitY(f)
else
set d=d-60
set x=x+Cos(a)*d
set y=y+Sin(a)*d
call SetUnitX(f,x)
call SetUnitY(f,y)
call DUV(t,'d',d)
endif
else
if d>800 then
call DYV(t,'b',true)
set a=HYV(Q,f)+GetRandomReal(-bj_PI/4,bj_PI/4)
call DUV(t,'a',a)
set x=GetUnitX(f)
set y=GetUnitY(f)
else
set d=d+25
set x=x+Cos(a)*d
set y=y+Sin(a)*d
call SetUnitX(f,x)
call SetUnitY(f,y)
set a=a+bj_PI*(.02+.1*(800-d)/800)
call DUV(t,'a',a)
call DUV(t,'d',d)
endif
endif
call SetUnitFacing(f,a*bj_RADTODEG)
set AUV=Q
set g=CreateGroup()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,x,y,'}',b)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if GetWidgetLife(u)-5<1 then
call CCV(u,true,true)
call UnitRemoveAbility(u,'Avul')
call HPV(Q,u,5,$5F5E0FF)
else
call SetWidgetLife(u,GetWidgetLife(u)-5)
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set t=null
set f=null
endfunction
function Roshan_System takes nothing returns nothing
local real r='d'-GetUnitLifePercent(Q)
local unit s=null
local integer i=0
local trigger t=null
local unit f=null
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call GDV()
elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set s=GetEventDamageSource()
if IsUnitType(s,UNIT_TYPE_HERO)==false then
set s=HMV(s)
if IsUnitInRange(s,Q,450)then
call IssueTargetOrderById(Q,$D000F,s)
endif
endif
set s=null
if DZV(Q,'danm')==false then
call DYV(Q,'danm',true)
set i=0
loop
exitwhen i>17
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,Q,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerAddCondition(t,Condition(function WSE))
set f=CreateUnit(Player($C),'eA03',GetUnitX(Q),GetUnitY(Q),20*i)
call SetUnitScale(f,2,2,2)
call UnitAddAbility(f,'Arav')
call UnitRemoveAbility(f,'Arav')
call DYV(t,'b',false)
call DUV(t,'d',0)
call SetUnitFlyHeight(f,$96,0)
call UnitAddAbility(f,'Aloc')
call SetUnitX(f,GetUnitX(Q))
call SetUnitY(f,GetUnitY(Q))
call DFV(t,'f',f)
call DUV(t,'a',bj_PI*2/18*i)
set t=null
set i=i+1
endloop
endif
else
call DPV(Q,'aIas',R2I(r*2))
if DTV(Q,'aDef')<0 then
call DPV(Q,'aDef',0)
endif
if DTV(Q,'aAtk')<0 then
call DPV(Q,'aAtk',0)
endif
if GetUnitMoveSpeed(Q)<GEV(Q)then
call SetUnitMoveSpeed(Q,GEV(Q))
endif
endif
endfunction
function WTE takes nothing returns nothing
local trigger t=null
if Q!=null and IsUnitType(Q,UNIT_TYPE_DEAD)==false and DZV(Q,'n00L')==false then
call DYV(Q,'n00L',true)
call SetUnitVertexColor(Q,120,120,000,$9B)
call UnitAddAbility(Q,'A142')
call UnitAddAbility(Q,'A03P')   
call UnitAddAbility(Q,'A0ER')
call SetUnitAbilityLevel(Q,'A0ER',3)
call SetUnitAbilityLevel(Q,'A03P',4)
call UnitAddAbility(Q,'A0KY')
call SetUnitAbilityLevel(Q,'A0KY',4)
call SetUnitAbilityLevel(Q,'A0I6',4) //axe call 
call UnitAddAbility(Q,'A03Z')
call SetUnitAbilityLevel(Q,'A03Z',3)// tide ulti
call UnitAddAbility(Q,'A0G5')
call SetUnitAbilityLevel(Q,'A0G5',4) // bara bash

call UnitAddAbility(Q,'A142') // rosh get stronger
endif
endfunction
function WUE takes nothing returns nothing
local integer i=0
loop
exitwhen i>$B
call SetPlayerTechMaxAllowed(Player(i),'H901',-1)
call SetPlayerTechMaxAllowed(Player(i),'H902',-1)
set i=i+1
endloop
set IVV=true
call s8('H00I')
call s8('O016')
