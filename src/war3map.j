function OFI takes integer OGI,integer OHI returns boolean
local integer PJE=OHI
local integer array OJI
local integer i=1
local integer OKI
local boolean OLI=true
if EOV[PJE] then
set OJI[i]='A02A'
set i=i+1
set OJI[i]='A05E'
elseif OGI=='A065' then
set EOV[PJE]=true
endif
set OKI=i
set i=1
loop
exitwhen i>OKI
if OGI==OJI[i]then
set OLI=false
endif
set i=i+1
endloop
if OLI==false then
return false
else
return true
endif
endfunction
function OMI takes integer FMX,integer sn,integer OPI,integer OQI,integer OSI returns nothing
