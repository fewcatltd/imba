call UnitAddAbility(IWV,'A0YK')
call UnitAddAbility(IWV,'A0DB')
call UnitMakeAbilityPermanentBJ(true,'A0YK',IWV)
call UnitMakeAbilityPermanentBJ(true,'A0DB',IWV)
call SetUnitAbilityLevelSwapped('A0YK',IWV,l)
endif
endif
endif
endif
endif
if F1V(s,"A0CA_Active")and IsUnitAlly(s,GetOwningPlayer(u))==false then
set i=GetUnitAbilityLevel(s,'A0CA')
if i==1 then
set l='AA8G'
elseif i==2 then
set l='AA8H'
elseif i==3 then
set l='AA8I'
else
set l='AA8J'
endif
