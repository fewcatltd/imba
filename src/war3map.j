function YPR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'Sour')
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=DWV(t,'x')
local real y1=DWV(t,'y')
if GetTriggerEventId()==EVENT_UNIT_DEATH or J_V()-DWV(u,'u00g')>5 then
call DYV(u,'u00G',false)
call GDV()
else
if GetUnitState(u,UNIT_STATE_LIFE)>DWV(t,'h')then
call SetUnitState(u,UNIT_STATE_LIFE,DWV(t,'h'))
else
call DUV(t,'h',GetUnitState(u,UNIT_STATE_LIFE))
endif
if GetUnitState(u,UNIT_STATE_MANA)>DWV(t,'m')then
call SetUnitState(u,UNIT_STATE_MANA,DWV(t,'m'))
else
call DUV(t,'m',GetUnitState(u,UNIT_STATE_MANA))
endif
if SquareRoot((x-x1)*(x-x1)+(y-y1)*(y-y1))>50 then
call SetUnitPosition(u,x1,y1)
call QHV(null,u,2)
else
call DUV(t,'x',x)
call DUV(t,'y',y)
endif
endif
set t=null
set u=null
endfunction
function A0MG takes nothing returns nothing
