function TKV takes nothing returns nothing
local integer TXV=P8(ce)
local integer TEV=P8(Ce)
local integer T8
local integer U8
local string TLV
local string TMV
local unit K8V=ie[GetPlayerId(GetTriggerPlayer())]
if K8V==null then
set TMV=(GetObjectName(('n0EW')))
else
set TMV=GetUnitName(K8V)
endif
if(h<$A)then
set TLV=I2S(G)+":0"+I2S(h)
else
set TLV=I2S(G)+":"+I2S(h)
endif
if qx==false then
set Fo[GetPlayerId(GetTriggerPlayer())]="|c00555555"+TLV+"|r"
call KAV(bj_FORCE_ALL_PLAYERS,25.,R[GetPlayerId(GetTriggerPlayer())]+(lt[GetPlayerId((GetTriggerPlayer()))])+" ("+TMV+")|r|c00ff0303 "+(GetObjectName(('n02D')))+"|r")
if(C8(GetTriggerPlayer()))then
set T8=1
set U8=5
loop
exitwhen T8>U8
if(A7V[T8]!=GetTriggerPlayer())then
if(m8(A7V[T8]))then
call SetPlayerAllianceStateBJ(GetTriggerPlayer(),A7V[T8],4)
endif
endif
set T8=T8+1
endloop
else
set T8=1
set U8=5
loop
exitwhen T8>U8
if(A8V[T8]!=GetTriggerPlayer())then
if(m8(A8V[T8]))then
call SetPlayerAllianceStateBJ(GetTriggerPlayer(),A8V[T8],4)
endif
endif
set T8=T8+1
endloop
endif
if C8(GetTriggerPlayer())or D8(GetTriggerPlayer())then
set eu=eu+1
endif
call SSV("C"+"K"+I2S(Ae[GetPlayerId(GetTriggerPlayer())])+"D"+I2S(Ne[GetPlayerId(GetTriggerPlayer())])+"N"+I2S((LoadInteger(le,StringHash("Stats"+I2S(GetPlayerId(GetTriggerPlayer()))),StringHash("NumOfNeutrals")))),GetPlayerId(GetTriggerPlayer()))
set PU=GetTriggerPlayer()
set U2[GetPlayerId(GetTriggerPlayer())]=true
call THV(GetTriggerPlayer())
call TGV(GetTriggerPlayer())
if eu==2 and nx==false and Ny then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,60," ")
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,60," ")
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,60,"|c006699CC"+(GetObjectName(('n0FW')))+"|r")
endif
if eu==3 then
set mU=true
call ExecuteFunc("TPV")
set mU=false
endif
else
set Fo[GetPlayerId(GetTriggerPlayer())]="|c00555555End|r"
call ExecuteFunc("TQV")
endif
endfunction
function TSV takes unit s,unit u returns nothing
