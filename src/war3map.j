set OPI=0
endif
elseif FMX>=6 then
if GetPlayerId(GetLocalPlayer())<=5 then
set OPI=0
endif
endif
call MultiboardSetItemIcon(OTI,V2V[OPI])
call MultiboardSetItemIconBJ(q,OQI,OSI,V2V[OPI])
endfunction
function OUI takes nothing returns nothing
local integer a=GetSpellAbilityId()
local player p=GetOwningPlayer(GetSpellAbilityUnit())
local integer PJE=(1+GetPlayerId(p))
local integer OWI=4
local integer array OYI
local integer array OZI
local integer i=1
local integer g=0
local integer O_I=0
local unit c
local location TOV=GetRectCenter(pr)
local boolean NYX
local integer O0I=1
local integer k=0
local integer magie=0
local integer O1I=0
local integer O2I
local integer O3I=4
local integer O4I=0
local integer O5I=0
local multiboarditem OTI
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Skill started!"))
endif
if a=='B000' or a=='B001' or a=='B002' or a=='B003' then
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("It is a system of choosing spells"))
endif
if VGV then
set OWI=5
set O0I=2
set O3I=O3I+1
endif
if VFV[PJE]==false then
if a=='B000' then
set OYI[PJE]=VRV[PJE]
elseif a=='B001' then
set OYI[PJE]=VIV[PJE]
elseif a=='B002' then
set OYI[PJE]=VAV[PJE]
elseif a=='B003' then
set OYI[PJE]=VNV[PJE]
endif
set c=CreateUnitAtLoc(p,'n00C',TOV,bj_UNIT_FACING)
call UnitAddAbility(c,OYI[PJE])
call SetUnitAbilityLevelSwapped(OYI[PJE],c,4)
if GetUnitAbilityLevelSwapped(OYI[PJE],c)==3 then
set NYX=true
else
set NYX=false
endif
call RemoveUnit(c)
if NYX then
if VCV[PJE]==O0I then
set i=0
if GetLocalPlayer()==p then
call StartSound(N_V)
endif
call DisplayTextToForce(BLV(p),"You can't choose another ult!")
else
set VCV[PJE]=VCV[PJE]+1
endif
elseif NYX==false then
if VDV[PJE]==3 then
set i=0
if GetLocalPlayer()==p then
call StartSound(N_V)
endif
call DisplayTextToForce(BLV(p),"You can't choose more normal spells!")
else
set VDV[PJE]=VDV[PJE]+1
endif
endif
loop
exitwhen O1I>V0V
if OYI[PJE]==VZV[O1I]then
set OZI[PJE]=V_V[O1I]
set O2I=O1I
endif
set O1I=O1I+1
endloop
if OZI[PJE]==null then
set i=0
set O_I=1
if GetLocalPlayer()==p then
call StartSound(N_V)
endif
call DisplayTextToForce(BLV(p),"Skill is not available!")
endif
if OFI(OYI[PJE],PJE)==false then
set O5I=1
set i=0
set O_I=1
endif
if i==1 then
if PJE==1 then
if VHV[1]==OZI[PJE]or VHV[2]==OZI[PJE]or VHV[3]==OZI[PJE]or VHV[4]==OZI[PJE]or VHV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
elseif PJE==2 then
if VJV[1]==OZI[PJE]or VJV[2]==OZI[PJE]or VJV[3]==OZI[PJE]or VJV[4]==OZI[PJE]or VJV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
elseif PJE==3 then
if VKV[1]==OZI[PJE]or VKV[2]==OZI[PJE]or VKV[3]==OZI[PJE]or VKV[4]==OZI[PJE]or VKV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
elseif PJE==4 then
if VLV[1]==OZI[PJE]or VLV[2]==OZI[PJE]or VLV[3]==OZI[PJE]or VLV[4]==OZI[PJE]or VLV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
elseif PJE==5 then
if VMV[1]==OZI[PJE]or VMV[2]==OZI[PJE]or VMV[3]==OZI[PJE]or VMV[4]==OZI[PJE]or VMV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
elseif PJE==6 then
if VPV[1]==OZI[PJE]or VPV[2]==OZI[PJE]or VPV[3]==OZI[PJE]or VPV[4]==OZI[PJE]or VPV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
elseif PJE==7 then
if VQV[1]==OZI[PJE]or VQV[2]==OZI[PJE]or VQV[3]==OZI[PJE]or VQV[4]==OZI[PJE]or VQV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
elseif PJE==8 then
if VSV[1]==OZI[PJE]or VSV[2]==OZI[PJE]or VSV[3]==OZI[PJE]or VSV[4]==OZI[PJE]or VSV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
elseif PJE==9 then
if VTV[1]==OZI[PJE]or VTV[2]==OZI[PJE]or VTV[3]==OZI[PJE]or VTV[4]==OZI[PJE]or VTV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
elseif PJE==$A then
if VUV[1]==OZI[PJE]or VUV[2]==OZI[PJE]or VUV[3]==OZI[PJE]or VUV[4]==OZI[PJE]or VUV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
elseif PJE==$B then
if VWV[1]==OZI[PJE]or VWV[2]==OZI[PJE]or VWV[3]==OZI[PJE]or VWV[4]==OZI[PJE]or VWV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
elseif PJE==$C then
if VYV[1]==OZI[PJE]or VYV[2]==OZI[PJE]or VYV[3]==OZI[PJE]or VYV[4]==OZI[PJE]or VYV[5]==OZI[PJE]then
set i=0
set g=1
set O_I=1
endif
endif
endif
if O_I==1 then
if NYX then
set VCV[PJE]=VCV[PJE]-1
elseif NYX==false then
set VDV[PJE]=VDV[PJE]-1
endif
endif
if g==1 then
if GetLocalPlayer()==p then
call StartSound(N_V)
endif
call DisplayTextToForce(BLV(p),"You already have this skill!")
endif
if O5I==1 then
if GetLocalPlayer()==p then
call StartSound(N_V)
endif
call DisplayTextToForce(BLV(p),"You can't get this spell because it does not work with (a)")
endif
if i==1 then
call ClearSelectionForPlayer(p)
set VBV[PJE]=VBV[PJE]+1
if VBV[PJE]==OWI then
set VFV[PJE]=true
call SetPlayerTechMaxAllowed(p,'O00P',0)
endif
if PJE==1 then
set VHV[VBV[PJE]]=OZI[PJE]
elseif PJE==2 then
set VJV[VBV[PJE]]=OZI[PJE]
elseif PJE==3 then
set VKV[VBV[PJE]]=OZI[PJE]
elseif PJE==4 then
set VLV[VBV[PJE]]=OZI[PJE]
elseif PJE==5 then
set VMV[VBV[PJE]]=OZI[PJE]
elseif PJE==6 then
set VPV[VBV[PJE]]=OZI[PJE]
elseif PJE==7 then
set VQV[VBV[PJE]]=OZI[PJE]
elseif PJE==8 then
set VSV[VBV[PJE]]=OZI[PJE]
elseif PJE==9 then
set VTV[VBV[PJE]]=OZI[PJE]
elseif PJE==$A then
set VUV[VBV[PJE]]=OZI[PJE]
elseif PJE==$B then
set VWV[VBV[PJE]]=OZI[PJE]
elseif PJE==$C then
set VYV[VBV[PJE]]=OZI[PJE]
endif
set EAV[(((PJE*5)-4)+VBV[PJE])]=OYI[PJE]
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Skill successfully added"))
endif
loop
exitwhen O4I>400
if OYI[PJE]==V3V[O4I]then
set O2I=O4I
endif
set O4I=O4I+1
endloop
set EEV=V4V[PJE]
set EXV=O2I
call OMI(PJE,2,O2I,(MultiboardGetColumnCount(q)-O3I)+VBV[PJE],V4V[PJE])
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Multiboard changed successfully"))
endif
endif
else
if a=='B000' or a=='B001' or a=='B002' or a=='B003' then
if GetLocalPlayer()==p then
call StartSound(N_V)
endif
call DisplayTextToForce(BLV(p),"You already selected all spells, select a hero now!")
endif
endif
endif
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("End of scrip magic"))
endif
endfunction
