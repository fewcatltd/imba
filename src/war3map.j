if ADR==Mp or ADR==pp or ADR==Pp or ADR==qp or ADR==Qp or ADR==Sp or ADR==tp or ADR==Up or ADR==wp or ADR==Wp then
return Ft[GetPlayerId(GetOwningPlayer(AZR))]
