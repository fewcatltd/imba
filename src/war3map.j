function Fun_ReadySpell takes nothing returns nothing
local unit s=GetTriggerUnit()
local integer id=GetSpellAbilityId()
if GetUnitTypeId(GetSpellTargetUnit())=='n00L' then
if id=='AA5I' then
call IssueImmediateOrderById(s,$D0004)
if GetLocalPlayer()==GetOwningPlayer(s)then
call ClearTextMessages()
endif
call DisplayTimedTextToPlayer(GetOwningPlayer(s),.5,0,1,GetObjectName('CTRS'))
endif
endif
set s=null
endfunction
function InitIOSpellData takes nothing returns nothing
local integer i=0
set OXV[i]='AIA1'
set OOV[i]=$D02B6
set ORV[i]=3
set OAV[i]="J8R"
set i=i+1
set OXV[i]='A0O2'
set OOV[i]=$D007F
