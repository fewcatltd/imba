set p5=GroupPickRandomUnit(g)
call KGV(g)
set xL=p5
set p5=null
set g=null
return xL
endfunction
function MMX takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit u=DHV(tm,'Targ')
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=DWV(tm,'Angl')
local integer i=DTV(tm,'Loop')
local integer n=DTV(tm,'Limt')
local location l=null
local real d=DWV(tm,'Sped')
local unit f=null
if i<2*n then
call DQV(tm,'Loop',1)
set x=x+Cos(a)*d
set y=y+Sin(a)*d
call SetUnitPosition(u,x,y)
call SetUnitFlyHeight(u,n*n+n*4-(n-i)*(n-i),0)
else
call SetUnitFlyHeight(u,GetUnitDefaultFlyHeight(u),0)
call CPV(u,false)
call SetUnitPathing(u,true)
set l=Location(x,y)
call TerrainDeformationRippleBJ(.2,true,l,1.,300.,96.,1,64.)
call RemoveLocation(l)
set l=null
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y))
call MMV(x,y,300)
set f=u
set u=DHV(tm,'Sour')
call MJX(u,x,y,300,75*GetUnitAbilityLevel(u,'A0BZ'))
if n>5 and GetWidgetLife(f)>1 then
set AWV=u
set AYV=f
set A6V=a
set AZV=n-5
set A5V=d*.5
call ExecuteFunc("MPX")
endif
call FIV()
endif
set f=null
set tm=null
set u=null
endfunction
function MPX takes nothing returns nothing
local timer tm=CreateTimer()
call CPV(AYV,true)
call SetUnitPathing(AYV,false)
call DFV(tm,'Sour',AWV)
call DFV(tm,'Targ',AYV)
call DUV(tm,'Angl',A6V)
call DPV(tm,'Loop',0)
call DPV(tm,'Limt',AZV)
call DUV(tm,'Sped',A5V)
call TimerStart(tm,.02,true,function MMX)
set tm=null
endfunction
function MQX takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local integer iX=GetTriggerEvalCount(t)
local unit K8V=Y7(K3V,"Hero")
local unit p5=Y7(K3V,"Source")
local unit m5=Y7(K3V,"Target")
local real MSX=X8(K3V,"Tossx0")
local real MTX=X8(K3V,"Tossy0")
local real x1=GetUnitX(p5)
local real y1=GetUnitY(p5)
local real x2=GetUnitX(m5)
local real y2=GetUnitY(m5)
local real RK
local real MUX
local real MWX
local real MYX
local real Il
local real IL
local location l
local timer tm=null
if v6(MSX,MTX,x2,y2)>$3E8 then
set x2=MSX
set y2=MTX
endif
set RK=MDV(x1,y1,x2,y2)
set MUX=v6(x1,y1,x2,y2)
set MWX=MUX/(51-iX)
set MYX=(iX-25)*(iX-25)
set Il=x1+MWX*Cos(RK*bj_DEGTORAD)
set IL=y1+MWX*Sin(RK*bj_DEGTORAD)
if iX<51 then
if MGX(p5)==false then
call SetUnitFlyHeight(p5,775-MYX,0)
endif
call SetUnitPosition(p5,Il,IL)
else
if MGX(p5)==false then
call SetUnitFlyHeight(p5,GetUnitDefaultFlyHeight(p5),0)
endif
call CPV(p5,false)
call SetUnitPathing(p5,true)
call SetUnitPosition(p5,x2,y2)
call K_V(p5,"Tossed")
set l=Location(x2,y2)
call TerrainDeformationRippleBJ(.2,true,l,1.,300.,96.,1,64.)
call RemoveLocation(l)
call DestroyEffect(r8(K3V,"FX"))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",GetUnitX(p5),GetUnitY(p5)))
if IsUnitAlly(p5,GetOwningPlayer(K8V))then
call HPV(K8V,p5,1,.2*75*GetUnitAbilityLevel(K8V,'A0BZ'))
else
call HPV(K8V,p5,1,(.2+.15*GetUnitAbilityLevel(K8V,'A0CY'))*75*GetUnitAbilityLevel(K8V,'A0BZ'))
endif
call MMV(x2,y2,300)
call MJX(K8V,x2,y2,300,75*GetUnitAbilityLevel(K8V,'A0BZ'))
if H3V(K8V)then
set AWV=K8V
set AYV=p5
set A6V=Atan2(y2-GetUnitY(K8V),x2-GetUnitX(K8V))
set AZV=0
if IVV then
set AZV=5*GetUnitAbilityLevel(K8V,'A0BZ')
if EMV then
set AZV=5
endif
endif
set A5V=RMinBJ(SquareRoot((GetUnitX(K8V)-x2)*(GetUnitX(K8V)-x2)+(GetUnitY(K8V)-y2)*(GetUnitY(K8V)-y2)),$3E8)*.02*.85
call MPX()
endif
call a7(K3V)
call KJV(t)
endif
set t=null
set K8V=null
set p5=null
set m5=null
set l=null
return false
endfunction
function MZX takes nothing returns nothing
local unit K8V=GetTriggerUnit()
local unit p5=MLX(K8V)
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
call SetUnitAnimationByIndex(K8V,4)
call CPV(p5,true)
call SetUnitPathing(p5,false)
if MGX(p5)==false then
call UnitAddAbility(p5,'Amrf')
call UnitRemoveAbility(p5,'Amrf')
endif
call KYV(p5,"Tossed")
call A7(K3V,"Hero",K8V)
call A7(K3V,"Source",p5)
call A7(K3V,"Target",m5)
call b7(K3V,"FX",AddSpecialEffectTarget("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",p5,"origin"))
call E7(K3V,"Tossx0",GetUnitX(m5))
call E7(K3V,"Tossy0",GetUnitY(m5))
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function MQX))
set K8V=null
set p5=null
set m5=null
set t=null
endfunction
