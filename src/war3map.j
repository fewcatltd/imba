function WAR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
if GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER or GetTriggerEventId()==EVENT_UNIT_ISSUED_POINT_ORDER or GetTriggerEventId()==EVENT_UNIT_ISSUED_TARGET_ORDER then
call DisableTrigger(t)
call IssueImmediateOrderById(u,$D0004)
call IssuePointOrderById(u,$D0012,GetUnitX(u)+Cos(GetRandomReal(-bj_PI,bj_PI))*600,GetUnitY(u)+Sin(GetRandomReal(-bj_PI,bj_PI))*600)
call EnableTrigger(t)
elseif GetTriggerEventId()==EVENT_UNIT_DEATH or ITV>DWV(t,'t')then
if IsUnitType(u,UNIT_TYPE_HERO)==false then
call CPV(u,false)
endif
call KRV(u,'AB31','B931')
call DestroyEffect(D2V(t,'e'))
call GDV()
else
if IsUnitType(u,UNIT_TYPE_HERO)then
if ITV>=DWV(t,'m')then
call DUV(t,'m',ITV+.5)
call DisableTrigger(t)
call IssuePointOrderById(u,$D0012,GetUnitX(u)+Cos(GetRandomReal(-bj_PI,bj_PI))*600,GetUnitY(u)+Sin(GetRandomReal(-bj_PI,bj_PI))*600)
call EnableTrigger(t)
endif
else
call CPV(u,true)
endif
endif
set t=null
set u=null
endfunction
function WNR takes unit s,real x,real y,integer i returns nothing
local unit f=null
local trigger t=null
local group g=CreateGroup()
local boolexpr b=Condition(function PJV)
set AUV=s
call GroupEnumUnitsInRange(g,x,y,400,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if GetUnitAbilityLevel(f,'AB31')==0 then
call KOV(f,'AB31',.5)
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.1,true)
if IsUnitType(f,UNIT_TYPE_HERO)then
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_ISSUED_TARGET_ORDER)
endif
call D1V(t,'e',AddSpecialEffectTarget("Abilities\\Spells\\Other\\HowlOfTerror\\HowlTarget.mdl",f,"overhead"))
call DUV(t,'t',ITV+1.3+.7*i)
call DFV(t,'u',f)
call DUV(t,'m',ITV+.5)
call TriggerAddCondition(t,Condition(function WAR))
endif
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
function WBR takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,0)
local real x=DWV(tm,1)
local real y=DWV(tm,2)
local integer i=DTV(tm,3)
local integer l=DTV(tm,5)
local group g2=CreateGroup()
local group g3=CreateGroup()
local real x1=0
local real y1=0
local unit f=null
local boolexpr b=Condition(function PJV)
set AUV=s
set l=DTV(tm,$A)
loop
exitwhen l<1
call GroupEnumUnitsInRange(g2,DWV(tm,999+l),DWV(tm,$7CF+l),$E1,b)
call GroupAddGroup(g2,g3)
call GroupClear(g2)
set l=l-1
endloop
loop
set f=FirstOfGroup(g3)
exitwhen f==null
call HPV(s,f,1,('d'+H4V(s,$A))*.05)
call GroupRemoveUnit(g3,f)
endloop
call DestroyGroup(g2)
call DestroyGroup(g3)
call DestroyBoolExpr(b)
set l=DTV(tm,5)
if DZV(tm,4)then
if l>=20*(3+2*i)then
set i=DTV(tm,$A)+99
loop
exitwhen i<'d'
call DestroyEffect(D2V(tm,i))
set i=i-1
endloop
call FIV()
else
call DPV(tm,5,l+1)
endif
else
if l>0 then
if l==40 then
call SetUnitPosition(s,x,y)
endif
call DPV(tm,5,l-1)
set l=6
loop
exitwhen l<1
set x1=x+GetRandomReal(-875,875)
set y1=y+GetRandomReal(-875,875)
set i=DTV(tm,$A)
call DUV(tm,$3E8+i,x1)
call DUV(tm,$7D0+i,y1)
call D1V(tm,'d'+i,AddSpecialEffect("Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl",x1,y1))
call DPV(tm,$A,i+1)
set l=l-1
endloop
else
call DYV(tm,4,true)
endif
endif
set tm=null
set s=null
set f=null
set g2=null
set g3=null
set b=null
endfunction
function WCR takes unit s,real x,real y,integer i returns nothing
local timer tm=CreateTimer()
call DFV(tm,0,s)
call DUV(tm,1,x)
call DUV(tm,2,y)
call DPV(tm,3,i)
call DYV(tm,4,false)
call DPV(tm,5,40)
call DPV(tm,$A,0)
call DUV(tm,$3E8,0)
call DUV(tm,$7D0,0)
call TimerStart(tm,.05,true,function WBR)
set tm=null
endfunction
function WDR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local integer i=DTV(t,'i')
local lightning l=D0V(t,'l')
local real r=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetUnitState(u,UNIT_STATE_MANA)<1 or C3V(s,u)>$578 or IsUnitVisible(u,GetOwningPlayer(s))==false then
call DestroyLightning(l)
call GDV()
elseif GetTriggerEvalCount(t)==1 then
call IssueImmediateOrderById(s,$D0004)
call D_V(t,'l',HZV(AddLightning("DRAM",false,0,0,1,1),s,u))
else
call HZV(l,s,u)
set r=20*i+20*C0V(i==4)
set r=RMinBJ(r*.1,GetUnitState(u,UNIT_STATE_MANA))
call HGV(s,false,r)
call HGV(u,false,-r)
endif
set t=null
set s=null
set u=null
set l=null
endfunction
function WFR takes unit s,unit u,integer id,integer l,real r returns nothing
local real d=0
local real n=0
if id!='A095' and id!='A09W' then
set d=450
if l==2 then
set d=675
elseif l==3 then
set d=950
endif
if id!='A01P' then
if l==1 then
set d=d+$96
else
set d=d+$C8
endif
endif
else
set d=750
if l==2 then
set d=1300
elseif l==3 then
set d=2000
endif
if id!='A095' then
set d=d+$96
if l==3 then
set d=d+25
endif
endif
set n=1-GetUnitState(u,UNIT_STATE_LIFE)/GetUnitState(u,UNIT_STATE_MAX_LIFE)
if n>0 then
if IVV then
set d=d+d*n*(2+C0V(id!='A095')*3)
endif
endif
endif
set d=d+H4V(s,1)
call QQV(s,u,1,d,r)
endfunction
function AA4OB takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
if GetTriggerEventId()==EVENT_UNIT_DEATH or ITV-DWV(u,'AA4O')>0 then
call KRV(u,'AB45','B945')
call GDV()
endif
set t=null
set u=null
endfunction
function WGR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local real a=DWV(t,'a')
local integer l=DTV(t,'l')
local integer i=DTV(t,'i')
local group g=DKV(t,'g')
local group g1=null
local boolexpr b=null
local unit f=null
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local trigger tm=null
call UnitRemoveAbility(s,'Bbsk')
call CPV(s,true)
if l-l/4*4==0 then
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x,y))
endif
set x=x+Cos(a)*20
set y=y+Sin(a)*20
call MMV(x,y,$AF)
call SetUnitFacing(s,a*bj_RADTODEG)
call SetUnitAnimationByIndex(s,3)
if GetTriggerEventId()==EVENT_UNIT_DEATH or l==1 or IsTerrainPathable(x,y,PATHING_TYPE_WALKABILITY)then
loop
set f=FirstOfGroup(g)
exitwhen f==null
call QHV(null,f,.5)
call SetUnitPathing(f,true)
call J6V(f,'AB45','B945',4,0,0,0,0,0,0,0)
call HPV(s,f,2,'d'*i)
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call CPV(s,false)
call SetUnitPathing(s,true)
call IssueImmediateOrderById(s,$D0004)
call SetUnitTimeScale(s,1)
call GDV()
else
call SetUnitX(s,x)
call SetUnitY(s,y)
set g1=CreateGroup()
set AUV=s
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g1,x,y,$AF,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call GroupAddUnit(g1,f)
call GroupRemoveUnit(g,f)
endloop
call DestroyBoolExpr(b)
set b=null
loop
set f=FirstOfGroup(g1)
exitwhen f==null
set x=GetUnitX(f)+Cos(a)*20
set y=GetUnitY(f)+Sin(a)*20
call SetUnitPathing(f,false)
call SetUnitPosition(f,x,y)
call GroupAddUnit(g,f)
call GroupRemoveUnit(g1,f)
endloop
call DestroyGroup(g1)
set g1=null
call DPV(t,'l',l-1)
endif
set t=null
set s=null
set g=null
endfunction
function WHR takes unit s,real a,integer i returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function WGR))
call SetUnitTimeScale(s,1.5)
call UnitRemoveAbility(s,'Bbsk')
call SetUnitPathing(s,false)
call DFV(t,'s',s)
call DUV(t,'a',a)
call DPV(t,'l',R2I(((400.+200.*i)/800.)/.025))
call DPV(t,'i',i)
call DJV(t,'g',CreateGroup())
set t=null
endfunction
function DeathCoil takes nothing returns nothing
if IsUnitAlly(ADV,GetOwningPlayer(AFV))then
call HGV(AFV,true,50+'d'*AHV+H4V(ADV,1)*.5)
else
call HPV(ADV,AFV,1,20+80*AHV+H4V(ADV,1)*.5)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",AFV,"origin"))
endfunction
function WJR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
if GetTriggerEventId()==EVENT_UNIT_DEATH or ITV-DWV(t,'t')>0 then
call GDV()
elseif GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER or GetTriggerEventId()==EVENT_UNIT_ISSUED_POINT_ORDER or GetTriggerEventId()==EVENT_UNIT_ISSUED_TARGET_ORDER then
call DisableTrigger(t)
call IssueImmediateOrderById(u,$D0004)
call IssueTargetOrderById(u,$D000F,DHV(t,'s'))
call EnableTrigger(t)
endif
set t=null
set u=null
endfunction
function WKR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local lightning l=D0V(t,'l')
local integer i=GetTriggerEvalCount(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=0
local real d=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or i==80 then
call DestroyLightning(l)
call SetUnitPathing(u,true)
call CPV(u,false)
call SetUnitFlyHeight(u,GetUnitDefaultFlyHeight(u),0)
call GDV()
if GetTriggerEventId()!=EVENT_UNIT_DEATH then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(t,Condition(function WJR))
call DFV(t,'s',s)
call DFV(t,'u',u)
set d=3
set a=GetUnitLevel(s)-GetUnitLevel(u)
set d=RMinBJ(d*(a/24),0)
call DUV(t,'t',ITV+d)
set t=null
endif
else
set a=HYV(u,s)
set d=C3V(s,u)-'d'
set d=d/(80-i)
set x=x+Cos(a)*d
set y=y+Sin(a)*d
call SetUnitX(u,x)
call SetUnitY(u,y)
call HZV(l,s,u)
set d=$640-(i-40)*(i-40)
set d=d*.35
call SetUnitFlyHeight(u,GetUnitDefaultFlyHeight(u)+d,0)
endif
set t=null
set s=null
set u=null
set l=null
endfunction
function WLR takes unit s,unit u returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function WKR))
call DFV(t,'s',s)
call DFV(t,'u',u)
call D_V(t,'l',HZV(AddLightning("ETHE",false,0,0,1,1),s,u))
call CPV(u,true)
call SetUnitPathing(u,false)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
set t=null
endfunction
function WMR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
if GetTriggerEventId()==EVENT_UNIT_DEATH or ITV-DWV(t,'t')>0 then
call CPV(u,false)
call SetUnitTimeScale(u,1)
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call KRV(u,'AB48','B948')
endif
call DestroyEffect(D2V(t,'e'))
call GDV()
else
call CPV(u,true)
call SetUnitTimeScale(u,0)
endif
set t=null
set u=null
endfunction
function WPR takes unit s,real x,real y,integer i returns nothing
local trigger t=null
local group g=CreateGroup()
local unit f=null
local boolexpr b=Condition(function PJV)
local integer l=0
loop
exitwhen l>17
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl",x+Cos(bj_PI/9*l)*$E1,y+Sin(bj_PI/9*l)*$E1))
set l=l+1
endloop
set AUV=s
call GroupEnumUnitsInRange(g,x,y,349,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function WMR))
call DUV(t,'t',ITV+.75+.75*i)
if IsUnitType(f,UNIT_TYPE_HERO)then
call DUV(f,'aa4t',ITV+.75*.75*i+1+2*i)
call KOV(f,'AB48',0)
endif
call DFV(t,'u',f)
call D1V(t,'e',AddSpecialEffectTarget("Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl",f,"origin"))
call CPV(f,true)
call SetUnitTimeScale(f,0)
set t=null
call HPV(s,f,1,50+$96*i+H4V(s,1)*.3)
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
function WQR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local real d=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or ITV-DWV(t,'t')>0 or GetWidgetLife(s)<1 or GetWidgetLife(u)<1 then
call HVV(u,DWV(t,'d'))
call GDV()
else
set d=C3V(s,u)
set d=GEV(u)*.1*d*.01
call HVV(u,DWV(t,'d')-d)
call DUV(t,'d',d)
endif
set t=null
set s=null
set u=null
endfunction
function WSR takes nothing returns nothing
