call TriggerRegisterTimerEvent(t,r,false)
call TriggerRegisterTimerEvent(t,r+2,false)
call TriggerAddCondition(t,Condition(function LSR))
call DFV(t,'u',u)
call DFV(t,'s',s)
call DPV(t,'i',i)
call DPV(t,'l',l)
call DYV(t,'b',false)
call DYV(t,'t',false)
call D1V(t,'e',AddSpecialEffectTarget("war3mapImported\\RadianceHands.mdx",u,"overhead"))
call CPV(u,true)
if l==1 or l==2 then
call HPV(s,u,2,80)
endif
if l==1 or l==3 then
call HPV(s,u,1,80)
endif
set t=null
endfunction
function LUR takes nothing returns nothing
