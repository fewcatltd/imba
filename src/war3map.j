loop
set s=FirstOfGroup(g)
exitwhen s==null
if GetUnitState(s,UNIT_STATE_MAX_MANA)>1 then
call HGV(s,false,RMaxBJ($87,GetUnitState(s,UNIT_STATE_MAX_MANA)*.2))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl",s,"origin"))
endif
call GroupRemoveUnit(g,s)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
set s=null
endfunction
function EGI takes nothing returns nothing
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local integer x=400
local real y=1
local real d=0
local integer id=GetSpellAbilityId()
call HXV(s,'AA62',1,"banish",s)
if s!=u and u!=null then
if id=='AA5Y' then
set x=500
set y=1.5
elseif id=='AA5Z' then
set x=600
set y=2
elseif id=='AA60' then
set x=700
set y=2.5
elseif id=='AA61' then
set x=800
set y=3
endif
set d=x+B8V(s,true)*y
call HXV(s,'AA63',1,"banish",u)
call H0V(s,u,.45,"ETHE",false)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",u,"origin"))
call QQV(s,u,1,d,.1)
endif
set s=null
set u=null
endfunction
function EHI takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local integer i=DTV(t,'i')
local real x=DWV(t,'x')
local real y=DWV(t,'y')
local unit f=null
if GetTriggerEvalCount(t)==1 then
set f=CreateUnit(GetOwningPlayer(s),'n0KE',x,y,0)
call UnitAddAbility(f,'Aloc')
call SetUnitX(f,x)
call SetUnitY(f,y)
call SetUnitScale(f,.65,.65,.65)
call UnitApplyTimedLife(f,'BTLF',5)
call SetUnitTimeScale(f,1.35)
call SetUnitVertexColor(f,$FF,$FF,$FF,0)
call TriggerRegisterTimerEvent(t,5,false)
set f=null
else
call Q_V(s,x,y,425,70+$96*i,3)
call GDV()
endif
set t=null
set s=null
endfunction
function EJI takes nothing returns nothing
