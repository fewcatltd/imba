function DFX takes unit DGX,integer DHX,real RK returns nothing
local real DJX=GetUnitX(DGX)-50*Cos(RK)
local real DKX=GetUnitY(DGX)-50*Sin(RK)
local unit oA=CreateUnit(GetOwningPlayer(DGX),'e00E',DJX,DKX,0)
local real x=GetUnitX(oA)+50*Cos(RK)
local real y=GetUnitY(oA)+50*Sin(RK)
local real x2=x+(300+50*DHX)*Cos(RK)
local real y2=y+(300+50*DHX)*Sin(RK)
call UnitAddAbility(oA,'A087')
call SetUnitAbilityLevel(oA,'A087',DHX)
call IssuePointOrderById(oA,$D0264,x,y)
call KillUnit(DGX)
set oA=null
endfunction
function DLX takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local integer iX=E8(K3V,"Count")
local integer DHX=iX-1
local real RK=X8(K3V,"Angle")
local unit oA=Y7(K3V,"Caster")
local unit K8V=Y7(K3V,"Hero")
local integer JFV=E8(K3V,"Level")
local integer DMX=2+JFV*2
local boolean DPX=O8(K3V,"SpiritCast")
local unit DQX
if GetTriggerEventId()!=EVENT_UNIT_SPELL_ENDCAST then
call n7(K3V,"Count",iX+1)
endif
call SetUnitScale(oA,I2R('d'+20*DHX)/ 'd',I2R('d'+20*DHX)/ 'd',I2R('d'+20*DHX)/ 'd')
if(GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST and DPX==false)or(GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST and GetSpellAbilityId()=='A121')or DHX==DMX then
if DPX then
set DQX=Y7(K3V,"Dummy")
call ShowUnit(DQX,false)
call UnitApplyTimedLife(DQX,'BTLF',1)
endif
call a7(K3V)
call KJV(t)
call SetPlayerAbilityAvailable(GetOwningPlayer(K8V),'A085',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(K8V),'A121',false)
call UnitRemoveAbility(K8V,'A121')
call DFX(oA,DHX,RK)
if IVV and EMV==false then
call DFX(oA,DHX,RK)
endif
endif
set oA=CreateUnit(GetOwningPlayer(oA),'h06M',GetUnitX(oA)+$96*(DHX)*Cos(RK),GetUnitY(oA)+$96*(DHX)*Sin(RK),0)
call UnitApplyTimedLife(oA,'BTLF',7)
set t=null
set oA=null
set K8V=null
set DQX=null
return false
endfunction
