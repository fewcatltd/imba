function QHV takes unit p5,unit m5,real PNV returns nothing
local unit QJV=null
local integer JFV=0
if GUV(m5)then
return
endif
call QDV(m5,PNV,false)
return
set JFV=QNV(PNV)
set QJV=CreateUnit(GetOwningPlayer(m5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
call UnitAddAbility(QJV,'A0X6')
call SetUnitAbilityLevel(QJV,'A0X6',JFV)
call IssueTargetOrderById(QJV,$D007F,m5)
call UnitApplyTimedLife(QJV,'BTLF',1)
set QJV=null
endfunction
function QKV takes integer z8 returns integer
local integer i=1
loop
exitwhen i>Wt
if z8==qt[i]then
return i
endif
set i=i+1
endloop
return 0
endfunction
function J1V takes nothing returns nothing
local unit u=XWV
local integer i=DTV(u,'AB39')
local real r=0
local group g=null
local boolexpr b=null
local unit f=null
if DHV(u,'ab39')==null or(J and GetWidgetLife(DHV(u,'ab39'))<1)then
set u=null
return
endif
if ITV-R2I(ITV)<.25 then
set i=i+1
call DPV(u,'AB39',i)
call J6V(u,'AB39','B939',.1,-i,-2*i,0,0,0,0,0)
call HPV(DHV(u,'ab39'),u,2,24)
endif
set r=ITV-R2I(ITV)
if r<.25 or(r>=.5 and r<.75)then
set b=Condition(function PJV)
set AUV=DHV(u,'ab39')
set g=CreateGroup()
set r=DWV(u,'b939')
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),r,b)
call GroupRemoveUnit(g,u)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call DUV(f,'b939',r)
call DFV(f,'ab39',AUV)
if GetUnitAbilityLevel(f,'AB39')==0 then
set i=0
else
set i=DTV(f,'AB39')
endif
call J6V(f,'AB39','B939',1,-i,-2*i,0,0,0,0,0)
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set u=null
endfunction
function QLV takes unit s,unit u,real d returns nothing
if GetWidgetLife(u)-d<1 then
call SetWidgetLife(u,1)
set O9V=true
set ONV=true
set p3=true
call HPV(s,u,5,'d')
set p3=false
set ONV=false
set O9V=false
else
call SetWidgetLife(u,GetWidgetLife(u)-d)
endif
endfunction
function QMV takes unit s,real x,real y,real r,real d,integer i,real t,boolean b returns nothing
local group g=CreateGroup()
local boolexpr n=Condition(function PJV)
local unit f=null
set AUV=s
call GroupEnumUnitsInRange(g,x,y,r+16,n)
call DestroyBoolExpr(n)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call HPV(s,f,i,d)
call QDV(f,t,b)
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
set g=null
set n=null
endfunction
