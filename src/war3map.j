endif
set i=GetUnitAbilityLevel(u,'A00V')
if i>0 and(IsUnitType(s,UNIT_TYPE_STRUCTURE)==false and GetWidgetLife(s)>1)and IsUnitAlly(s,GetOwningPlayer(u))==false and GetUnitAbilityLevel(s,'A04R')==0 and IsUnitPaused(u)==false and FRV(u)==false then
call HPV(u,s,2,(K9V(u)+Ld(u)+(C8V(u)+DTV(u,'aAtk'))*.5)*(.05+.15*i))
endif
call DPV(s,'AA4L',0)
if xy and IsUnitType(u,UNIT_TYPE_STRUCTURE)and IsUnitAlly(s,GetTriggerPlayer())then
call IssueImmediateOrderById(s,$D0004)
endif
set i=GetPlayerId(GetTriggerPlayer())
if(i==0 or i==6)and GetOwningPlayer(s)==GetTriggerPlayer()then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.4,false)
call DFV(t,'s',s)
call DFV(t,'u',u)
call TriggerAddCondition(t,Condition(function Z1R))
set t=null
endif
if GetUnitAbilityLevel(u,'AA3O')>0 and IsUnitType(s,UNIT_TYPE_STRUCTURE)==false then
set f=CreateUnit(GetOwningPlayer(u),'hspt',-$2710,0,0)
call ShowUnit(f,false)
call UnitAddAbility(f,'Aloc')
call UnitAddAbility(f,'Avul')
call UnitApplyTimedLife(f,'BTLF',.5)
set f=null
endif
if GetUnitAbilityLevel(s,'B08K')>0 then
call DYV(s,'A0RV',false)
call UnitRemoveAbility(s,'B08K')
call DYV(s,'a0rv',true)
endif
if u==Q then
call GTV(Q,R2I('d'*(1-GetWidgetLife(Q)/GetUnitState(Q,UNIT_STATE_MAX_LIFE))))
endif
if GetUnitAbilityLevel(s,'AB49')>0 or GetUnitAbilityLevel(s,'AB53')>0 or GetUnitAbilityLevel(s,'AB54')>0 or GetUnitAbilityLevel(s,'AB55')>0 then
call KRV(s,'AB49','B949')
call KRV(s,'AB53','B953')
call KRV(s,'AB54','B954')
call KRV(s,'AB55','B955')
call UnitRemoveAbility(s,'AA3B')
endif
set i=GetUnitAbilityLevel(u,'AA0D')
if i>0 and 4+3*i>GetRandomInt(0,99)and GetUnitAbilityLevel(u,'AA0I')==0 then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,2,false)
call TriggerAddCondition(t,Condition(function Z_R))
call DFV(t,'u',u)
set t=null
call UnitAddAbility(u,'AA0I')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'AA0I',false)
endif
set i=GetUnitAbilityLevel(s,'AA4I')
if i>0 and ITV-DWV(s,'AA4I')>0 then
call DUV(s,'AA4I',ITV+.4)
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterTimerEvent(t,RMaxBJ(.1,.35-.002*B7V(s,true)),false)
call TriggerAddCondition(t,Condition(function Z2R))
call DFV(t,'s',s)
call DFV(t,'u',u)
set t=null
endif
set i=GetUnitAbilityLevel(u,'A0MM')
if i>0 and IsUnitType(s,UNIT_TYPE_STRUCTURE)==false and IsUnitPaused(u)==false and FRV(u)==false then
if IVV then
set i=R2I(GetUnitState(s,UNIT_STATE_MAX_LIFE)*.01*i)
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,7,false)
call TriggerAddCondition(t,Condition(function Z0R))
call DFV(t,'u',s)
call DPV(t,'i',i)
call G8V(s,-i)
call HEV(s)
set t=null
endif
endif
if GetUnitAbilityLevel(u,'A03P')>0 and IsUnitPaused(u)==false and FRV(u)==false then
set a=DIV(GetUnitFacing(u))-DIV(Atan2(GetUnitY(u)-GetUnitY(s),GetUnitX(u)-GetUnitX(s)))
if a>-90 and a<90 then
call IssueImmediateOrderById(s,$D0004)
endif
endif
if C7V(u,'I0LC')+C7V(u,'I0BA')>0 and IsUnitType(s,UNIT_TYPE_STRUCTURE)==false and IsUnitPaused(u)==false and FRV(u)==false then
set i=GetRandomInt(0,99)
if i<$A then
call HGV(u,true,80)
call HPV(u,s,3,80)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Cleave\\CleaveDamageTarget.mdl",s,"origin"))
endif
endif
set u=null
set s=null
endfunction
function Z6R takes nothing returns nothing
local timer tm=GetExpiredTimer()
