call G6V(p5,-DTV(t,'i'))
set t=null
set p5=null
return false
endfunction
function MGR takes unit p5,unit LYR,integer MHR,integer MJR returns nothing
local trigger t
local integer K3V
local unit QJV
local real i=60
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",LYR,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",p5,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",p5,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",p5,"hand,left"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",p5,"hand,right"))
call ShowUnit(LYR,false)
call KillUnit(LYR)
call SaveInteger(le,(GetHandleId((p5))),((4270)),(2))
if MJR>0 or MHR>0 then
set t=CreateTrigger()
set K3V=GetHandleId(t)
call TriggerRegisterTimerEvent(t,i,false)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function MFR))
call SaveUnitHandle(le,(K3V),(2),(p5))
call DPV(t,'i',MHR)
set QJV=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(p5),GetUnitY(p5),0)
call UnitAddAbility(QJV,'A1G9')
call SetUnitAbilityLevel(QJV,'A1G9',MJR)
call IssueTargetOrderById(QJV,$D0085,p5)
call G6V(p5,MHR)
call SaveEffectHandle(le,(K3V),(32),(AddSpecialEffectTarget("war3mapImported\\RadianceHands.mdx",p5,"weapon")))
endif
set t=null
set QJV=null
endfunction
function MKR takes nothing returns nothing
if IsUnitInGroup(GetEnumUnit(),M1)==false then
if IsUnitIllusion(GetEnumUnit())==false then
if IsUnitType(GetEnumUnit(),UNIT_TYPE_HERO) then
set Q1=Q1+(q1*$A)
set T1=T1+5
else
set Q1=Q1+(q1*3)
set T1=T1+1
endif
endif
call GroupAddUnit(M1,GetEnumUnit())
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",GetEnumUnit(),"chest"))
set w1=true
set W1=true
call HPV(p1,GetEnumUnit(),1,P1)
set w1=false
set W1=false
endif
endfunction
function MLR takes real MMR,real MPR,real MQR,real MSR,real MTR,real MUR returns real
local real MWR
local real MYR
local real MZR
local real M_R
local real M0R
local real M1R
local real M2R
local real REFLECTED_SCALED_V_X
local real REFLECTED_SCALED_V_Y
local real M3R
local real M4R
local real M5R
local real M6R
local real M7R
local real M8R
local real M9R
local real PVR
set M5R=MQR-MTR
set M6R=MSR-MUR
set M7R=-1*M6R
set M8R=M5R
set M9R=SquareRoot(M7R*M7R+M8R*M8R)
set M7R=M7R/ M9R
set M8R=M8R/ M9R
set MWR=MMR-MQR
set MYR=MPR-MSR
set MZR=SquareRoot(MWR*MWR+MYR*MYR)
set M_R=MWR/ MZR
set M0R=MYR/ MZR
set PVR=MWR*M7R+MYR*M8R
set M1R=-1*MMR+2*MQR+2*M7R*PVR
set M2R=-1*MPR+2*MSR+2*M8R*PVR
set M3R=MTR+MQR-M1R
set M4R=MUR+MSR-M2R
return M3R
endfunction
function PER takes real MMR,real MPR,real MQR,real MSR,real MTR,real MUR returns real
local real MWR
local real MYR
local real MZR
local real M_R
local real M0R
local real M1R
local real M2R
local real REFLECTED_SCALED_V_X
local real REFLECTED_SCALED_V_Y
local real M3R
local real M4R
local real M5R
local real M6R
local real M7R
local real M8R
local real M9R
local real PVR
set M5R=MQR-MTR
set M6R=MSR-MUR
set M7R=-1*M6R
set M8R=M5R
set M9R=SquareRoot(M7R*M7R+M8R*M8R)
set M7R=M7R/ M9R
set M8R=M8R/ M9R
set MWR=MMR-MQR
set MYR=MPR-MSR
set MZR=SquareRoot(MWR*MWR+MYR*MYR)
set M_R=MWR/ MZR
set M0R=MYR/ MZR
set PVR=MWR*M7R+MYR*M8R
set M1R=-1*MMR+2*MQR+2*M7R*PVR
set M2R=-1*MPR+2*MSR+2*M8R*PVR
set M3R=MTR+MQR-M1R
set M4R=MUR+MSR-M2R
return M4R
endfunction
function PXR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=(LoadUnitHandle(le,(K3V),(2)))
local unit LYR=(LoadUnitHandle(le,(K3V),(335)))
local real x0=(LoadReal(le,(K3V),(282)))
local real y0=(LoadReal(le,(K3V),(283)))
local real x1=GetUnitX(p5)
local real y1=GetUnitY(p5)
local real x2=GetUnitX(LYR)
local real y2=GetUnitY(LYR)
local real x3
local real y3
local real a
local group WSX=(LoadGroupHandle(le,(K3V),($BB)))
local group g
local real d
local integer JFV=GetUnitAbilityLevel(p5,'A1A8')
local real POR=(LoadReal(le,(K3V),(342)))
local real SAV=(TimerGetElapsed(D))
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call KGV(WSX)
call FlushChildHashtable(le,(K3V))
call KJV(t)
call ShowUnit(LYR,false)
call KillUnit(LYR)
call SaveInteger(le,(GetHandleId((p5))),((4270)),(2))
elseif v6(x1,y1,x2,y2)<'d' then
call MGR(p5,LYR,(LoadInteger(le,(K3V),(344))),(LoadInteger(le,(K3V),(345))))
call KGV(WSX)
call FlushChildHashtable(le,(K3V))
call KJV(t)
elseif GetTriggerEvalCount(t)>400 then
if GetTriggerEvalCount(t)==401 then
call SetUnitAnimationByIndex(LYR,3)
endif
set g=KHV()
set q1=JFV
set Q1=(LoadInteger(le,(K3V),(344)))
set T1=(LoadInteger(le,(K3V),(345)))
set P1=80+40*JFV
set p1=p5
set xL=p5
set M1=WSX
call GroupEnumUnitsInRange(g,GetUnitX(LYR),GetUnitY(LYR),300,Condition(function P0V))
call ForGroup(g,function MKR)
call KGV(g)
set g=null
call SaveInteger(le,(K3V),(344),(Q1))
call SaveInteger(le,(K3V),(345),(T1))
if((LoadInteger(le,(GetHandleId((p5))),((4269))))==1)==false then
set a=Atan2(y1-y2,x1-x2)
call SetUnitFacing(LYR,a*bj_RADTODEG)
set x3=GetUnitX(LYR)+$C*Cos(a)
set y3=GetUnitY(LYR)+$C*Sin(a)
call SetUnitX(LYR,L1V(x3))
call SetUnitY(LYR,L2V(y3))
call SaveReal(le,(K3V),(282),((x1)*1.))
call SaveReal(le,(K3V),(283),((y1)*1.))
endif
else
set g=KHV()
set q1=JFV
set Q1=(LoadInteger(le,(K3V),(344)))
set T1=(LoadInteger(le,(K3V),(345)))
set P1=80+40*JFV
set p1=p5
set xL=p5
set M1=WSX
call GroupEnumUnitsInRange(g,GetUnitX(LYR),GetUnitY(LYR),300,Condition(function P0V))
call ForGroup(g,function MKR)
call KGV(g)
set g=null
call SaveInteger(le,(K3V),(344),(Q1))
call SaveInteger(le,(K3V),(345),(T1))
if x0!=x1 or y0!=y1 then
set POR=SAV
call SaveReal(le,(K3V),(342),((POR)*1.))
endif
if((LoadInteger(le,(GetHandleId((p5))),((4269))))==1)==false then
if POR==SAV then
set x3=MLR(x0,y0,x1,y1,x2,y2)
set y3=PER(x0,y0,x1,y1,x2,y2)
set a=Atan2(y3-y2,x3-x2)*bj_RADTODEG
call SetUnitFacing(LYR,a)
call SetUnitX(LYR,L1V(x3))
call SetUnitY(LYR,L2V(y3))
call SaveReal(le,(K3V),(282),((x1)*1.))
call SaveReal(le,(K3V),(283),((y1)*1.))
endif
if(POR+.3)<SAV then
call SaveInteger(le,(K3V),(343),(1))
call SetUnitAnimationByIndex(LYR,2)
elseif(POR+.3)>SAV and(LoadInteger(le,(K3V),(343)))==1 then
call SaveInteger(le,(K3V),(343),(2))
call SetUnitAnimationByIndex(LYR,3)
elseif(LoadInteger(le,(K3V),(343)))==3 then
call SetUnitAnimationByIndex(LYR,2)
call SaveInteger(le,(K3V),(343),(1))
endif
else
call SaveInteger(le,(K3V),(343),(3))
endif
endif
set t=null
set p5=null
set LYR=null
set WSX=null
return false
endfunction
function PRR takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit p5=GetTriggerUnit()
local real x0=GetUnitX(p5)
local real y0=GetUnitY(p5)
local location l=GetSpellTargetLoc()
local real KYX=GetLocationX(l)
local real KZX=GetLocationY(l)
local real a=Atan2(KZX-y0,KYX-x0)
local real d=MXV(v6(x0,y0,KYX,KZX),300)
local real x1=L1V(x0+d*Cos(a))
local real y1=L2V(y0+d*Sin(a))
local unit LYR=CreateUnit(GetOwningPlayer(p5),'h07U',x1,y1,(a*bj_RADTODEG)-$B4)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",LYR,"chest"))
if GetUnitAbilityLevel(p5,'A1CD')>0 then
call UnitAddAbility(LYR,'A1CQ')
call UnitAddAbility(LYR,'A1CD')
call SetUnitAbilityLevel(LYR,'A1CD',GetUnitAbilityLevel(p5,'A1CD'))
endif
call RemoveLocation(l)
set U1[GetPlayerId(GetOwningPlayer(p5))]=LYR
call SaveInteger(le,(GetHandleId((p5))),((4270)),(1))
call UnitAddAbility(LYR,'Aloc')
call UnitAddAbility(LYR,'Aetl')
if(LoadBoolean(le,(GetHandleId(p5)),(339))) then
call TriggerEvaluate((LoadTriggerHandle(le,(K3V),(338))))
endif
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function PXR))
call SaveUnitHandle(le,(K3V),(2),(p5))
call SaveUnitHandle(le,(K3V),(335),(LYR))
call SaveReal(le,(K3V),(282),((x0)*1.))
call SaveReal(le,(K3V),(283),((y0)*1.))
call SaveGroupHandle(le,(K3V),($BB),(KHV()))
call SaveInteger(le,(K3V),(343),(2))
call SaveReal(le,(K3V),(342),(((TimerGetElapsed(D))-5)*1.))
set t=null
set p5=null
set LYR=null
endfunction
function VXe takes nothing returns boolean
if GetSpellAbilityId()=='A1A8' then
call PRR()
endif
return false
endfunction
function EVE takes nothing returns nothing
call CZV('A1A8',"PRR")
call L3V('A1G9')
endfunction
function PIR takes nothing returns boolean
if GetPlayerController(GetOwningPlayer(GetTriggerUnit()))==MAP_CONTROL_COMPUTER and(GetItemTypeId(GetManipulatedItem())==Ac[zd]or GetItemTypeId(GetManipulatedItem())==Ac[yd]or GetItemTypeId(GetManipulatedItem())==Ac[eD])then
call UnitRemoveAbility(GetTriggerUnit(),'A14A')
endif
return false
endfunction
function PAR takes unit u,integer d returns nothing
local texttag t=CreateTextTag()
call SetTextTagText(t,I2S(d),.03)
call SetTextTagPosUnit(t,u,0)
call SetTextTagColorBJ(t,0,0,$FF,$F)
call SetTextTagVelocity(t,0,.035)
call SetTextTagFadepoint(t,3)
call SetTextTagLifespan(t,2.5)
call SetTextTagPermanent(t,false)
call SetTextTagVisibility(t,false)
call SetTextTagVisibility(t,true)
set t=null
endfunction
function PNR takes unit u,integer d returns nothing
local texttag t=CreateTextTag()
call SetTextTagText(t,I2S(d),.03)
call SetTextTagPosUnit(t,u,0)
call SetTextTagColorBJ(t,0,$80,0,$F)
call SetTextTagVelocity(t,0,.035)
call SetTextTagFadepoint(t,3)
call SetTextTagLifespan(t,2.5)
call SetTextTagPermanent(t,false)
call SetTextTagVisibility(t,false)
call SetTextTagVisibility(t,true)
set t=null
endfunction
function PBR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
local integer i=DTV(t,'i')
call G6V(u,-i)
call HEV(u)
call GDV()
set t=null
set u=null
endfunction
function PCR takes real r,unit s,unit u,integer i returns nothing
local group g=CreateGroup()
local boolexpr b=Condition(function PTV)
local trigger t=null
local unit f=null
set AUV=s
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),$FA,b)
call GroupRemoveUnit(g,u)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if IsUnitType(f,UNIT_TYPE_HERO)==false then
call G6V(f,R2I(r*(.02+.01*i)))
call G5V(f,R2I(r*(.01*i)))
call G7V(f,R2I(r*(.07+.03*i)))
call HEV(f)
call SetUnitVertexColor(f,$A,$A,$A,$FF)
endif
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set t=null
set g=null
set b=null
endfunction
function PDR takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local real i=0
local integer l=0
local trigger t=null
if GetSpellAbilityId()=='A04Q' and GetUnitState(p5,UNIT_STATE_LIFE)>1 then
set i=GetUnitState(m5,UNIT_STATE_LIFE)*GetUnitAbilityLevel(p5,'A04Q')*.5
if H3V(p5)then
set i=i*3
endif
call SetUnitState(p5,UNIT_STATE_LIFE,GetUnitState(p5,UNIT_STATE_LIFE)+i)
call PNR(m5,R2I(i))
call SetUnitState(m5,UNIT_STATE_LIFE,1)
call HPV(p5,m5,2,20)
call HPV(p5,m5,1,20)
call HPV(p5,m5,3,20)
if H3V(p5)then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,$F,false)
set l=R2I(GetUnitState(m5,UNIT_STATE_MAX_LIFE)*(.04+.03*GetUnitAbilityLevel(p5,'A04Q')))
call G6V(p5,l)
call HEV(p5)
call DPV(t,'i',l)
call DFV(t,'u',p5)
call TriggerAddCondition(t,Condition(function PBR))
set t=null
endif
elseif GetSpellAbilityId()=='A053' and GetUnitState(p5,UNIT_STATE_LIFE)>1 then
call PCR(GetWidgetLife(m5),p5,m5,GetUnitAbilityLevel(p5,'A053'))
call SetUnitState(p5,UNIT_STATE_MANA,GetUnitState(p5,UNIT_STATE_MANA)+GetUnitState(m5,UNIT_STATE_LIFE)*GetUnitAbilityLevel(p5,'A053')*.15)
call PAR(m5,R2I(GetUnitState(m5,UNIT_STATE_LIFE)*GetUnitAbilityLevel(p5,'A053')*.15))
call KillUnit(m5)
endif
set p5=null
set m5=null
endfunction
function PFR takes nothing returns boolean
if(GetSpellAbilityId()=='A04Q' and P4(GetSpellTargetUnit())==false)or(GetSpellAbilityId()=='A053' and P4(GetSpellTargetUnit())==false)then
call PDR()
endif
return false
endfunction
function PGR takes nothing returns boolean
local unit p5=GetTriggerUnit()
local item PHR=GetManipulatedItem()
local integer id=GetItemTypeId(PHR)
if PHR==null or IsUnitIllusion(p5) or IsUnitType(p5,UNIT_TYPE_HERO)==false or GetUnitTypeId(p5)=='H00J' or GetItemTypeId(PHR)=='I00E' or GetItemTypeId(PHR)=='I02M' then
set p5=null
set PHR=null
return false
endif
if(GetTriggerEventId()==EVENT_PLAYER_UNIT_DROP_ITEM and GetItemType(PHR)!=ITEM_TYPE_PURCHASABLE)or GetTriggerEventId()==EVENT_PLAYER_UNIT_PAWN_ITEM then
call SSV("DRI_"+I2S(GetPlayerId(GetOwningPlayer(p5))),Ac[DOE(CUV(PHR))])
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_PICKUP_ITEM then
call SSV("PUI_"+I2S(GetPlayerId(GetOwningPlayer(p5))),Ac[DOE(CUV(PHR))])
endif
set p5=null
set PHR=null
return false
endfunction
