function EYE takes player hV,string iR returns nothing
if IsPlayerInForce(GetLocalPlayer(),BMV(hV))then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,Qx,40,R[GetPlayerId(hV)]+JZV(hV)+"|r "+iR)
endif
endfunction
function EZE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
set ou=true
call KJV(t)
call DestroyFogModifier(CreateFogModifierRadius(A7V[0],FOG_OF_WAR_MASKED,TW,UW,700,false,false))
call DestroyFogModifier(CreateFogModifierRadius(A8V[0],FOG_OF_WAR_MASKED,TW,UW,700,false,false))
set t=null
return false
endfunction
function E_E takes unit u returns boolean
return GetUnitTypeId(u)!='H00M' and GetUnitTypeId(u)!='H07G' and GetUnitTypeId(u)!='H00Y' and GetUnitTypeId(u)!='H00J' and GetUnitTypeId(u)!='H0B8'
endfunction
function E0E takes nothing returns boolean
return GetUnitTypeId(GetFilterUnit())=='n00C'
endfunction
function E1E takes nothing returns nothing
call RemoveUnit(GetEnumUnit())
endfunction
function E2E takes player j8 returns nothing
local group S8V=KHV()
local boolexpr hP=Condition(function E0E)
call GroupEnumUnitsOfPlayer(S8V,j8,hP)
call ForGroup(S8V,function E1E)
call DestroyBoolExpr(hP)
call KGV(S8V)
set hP=null
set S8V=null
endfunction
function E3E takes nothing returns boolean
return GetUnitTypeId(GetFilterUnit())=='ncop'
endfunction
function E4E takes nothing returns nothing
if Wb then
call UnitRemoveAbility(ft[GetPlayerId(GetOwningPlayer(GetEnumUnit()))],'A14F')
call UnitRemoveAbility(ft[GetPlayerId(GetOwningPlayer(GetEnumUnit()))],'A14E')
call UnitRemoveAbility(ft[GetPlayerId(GetOwningPlayer(GetEnumUnit()))],'A14H')
endif
if GetUnitAbilityLevel(GetEnumUnit(),'A0I4')==0 then
call UnitAddAbility(GetEnumUnit(),'A0I4')
endif
endfunction
function E5E takes player p returns nothing
local group g=KHV()
call GroupEnumUnitsOfPlayer(g,p,Condition(function E3E))
call ForGroup(g,function E4E)
call KGV(g)
set g=null
endfunction
function u6 takes player Ua returns player
local integer O5=1
local integer Uc=0
local boolean O6=false
loop
if((Uc>0)and(Jz(O5,O6)!=null)and(IsPlayerInForce(Jz(O5,O6),fz)))then
return Jz(O5,O6)
endif
if(A7V[O5]==Ua)then
set O6=true
set Uc=O5
elseif(A8V[O5]==Ua)then
set Uc=O5
endif
set O5=O5+1
exitwhen O5>5
endloop
return null
endfunction
function E6E takes unit K8V,player p returns string
local string s=(GetObjectName(('n0DB')))
set s=STV(s,"$hero",GetUnitName(K8V))
set s=STV(s,"$p",(lt[GetPlayerId((p))]))
return s
endfunction
function E7E takes unit E8E returns nothing
local item E9E=UnitItemInSlot(E8E,0)
local item XVE=UnitItemInSlot(E8E,1)
local item XEE=UnitItemInSlot(E8E,2)
local item XXE=UnitItemInSlot(E8E,3)
local item XOE=UnitItemInSlot(E8E,4)
local item XRE=UnitItemInSlot(E8E,5)
local integer XIE=CWV(E9E)
local integer XAE=CWV(XVE)
local integer XNE=CWV(XEE)
local integer XBE=CWV(XXE)
local integer XCE=CWV(XOE)
local integer XDE=CWV(XRE)
local integer XFE=0
call t4()
call UnitRemoveItem(E8E,E9E)
call UnitRemoveItem(E8E,XVE)
call UnitRemoveItem(E8E,XEE)
call UnitRemoveItem(E8E,XXE)
call UnitRemoveItem(E8E,XOE)
call UnitRemoveItem(E8E,XRE)
call RemoveItem(E9E)
call RemoveItem(XVE)
call RemoveItem(XEE)
call RemoveItem(XXE)
call RemoveItem(XOE)
call RemoveItem(XRE)
call T4()
if XIE>-1 then
set XFE=XFE+fH[XIE]
endif
if XAE>-1 then
set XFE=XFE+fH[XAE]
endif
if XNE>-1 then
set XFE=XFE+fH[XNE]
endif
if XBE>-1 then
set XFE=XFE+fH[XBE]
endif
if XCE>-1 then
set XFE=XFE+fH[XCE]
endif
if XDE>-1 then
set XFE=XFE+fH[XDE]
endif
call SetPlayerState(GetOwningPlayer(E8E),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(E8E),PLAYER_STATE_RESOURCE_GOLD)+XFE)
set dH[GetPlayerId(GetOwningPlayer(E8E))]=0
set E9E=null
set XVE=null
set XEE=null
set XXE=null
set XOE=null
set XRE=null
endfunction
function XGE takes unit u,integer id returns boolean
local integer i=1
local integer l=LoadInteger(HV,id,0)
local boolean b=false
local integer x=0
local integer r=GetUnitPointValue(u)
loop
set x=LoadInteger(HV,l,i)
exitwhen x==0 or b
set b=(GetUnitAbilityLevel(u,x)>0 or x==PH[r]or x==qH[r]or x==QH[r]or x==sH[r])
set i=i+1
endloop
return b
endfunction
function XHE takes nothing returns nothing
call HPV(ADV,AFV,5,B7V(ADV,true)*.35+$F)
endfunction
function I60S takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local real a=DWV(t,'a')
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local group g=null
local boolexpr b=null
local unit f=null
local integer i=3
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call KillUnit(u)
call DYV(s,'i60s',false)
call GDV()
else
if IsUnitVisible(u,Player(0))and IsUnitVisible(u,Player(6))then
call UnitRemoveAbility(u,'AA3B')
else
call UnitAddAbility(u,'AA3B')
endif
set a=a+bj_PI*.025
call DUV(t,'a',a)
set x=x+Cos(a)*'}'
set y=y+Sin(a)*'}'
if ITV-DWV(t,'t')>0 and GetWidgetLife(s)>1 then
set AUV=s
set g=CreateGroup()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,x,y,525,b)
loop
set f=GroupPickRandomUnit(g)
exitwhen f==null or i==0
call GYV('hsor',s,u,f,$4B0,"XHE",0,0)
set i=i-1
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
call DUV(t,'t',ITV+.375)
endif
call SetUnitX(u,x)
call SetUnitY(u,y)
endif
set t=null
set s=null
set u=null
endfunction
function XJE takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
call G8V(u,-DTV(t,'l'))
call HEV(u)
call GDV()
set t=null
set u=null
endfunction
function XKE takes unit u,integer i returns nothing
local trigger t=CreateTrigger()
local integer l=R2I(GetUnitState(u,UNIT_STATE_MAX_LIFE)*.2*i)
call DPV(u,'A0M3',0)
call DUV(u,'a0m3',ITV+5)
call UnitRemoveAbility(u,'AB19')
call UnitRemoveAbility(u,'B919')
call UnitRemoveAbility(u,'AB20')
call UnitRemoveAbility(u,'B920')
call UnitRemoveAbility(u,'AB21')
call UnitRemoveAbility(u,'B921')
call UnitRemoveAbility(u,'AB22')
call UnitRemoveAbility(u,'B922')
call UnitRemoveAbility(u,'AB23')
call UnitRemoveAbility(u,'B923')
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,5,false)
call TriggerAddCondition(t,Condition(function XJE))
call DFV(t,'u',u)
call DPV(t,'l',l)
call G8V(u,l)
call HEV(u)
call HGV(u,true,l*.5)
set t=null
endfunction
function A0R7A takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
call UnitRemoveAbility(u,'AB10')
call UnitRemoveAbility(u,'B910')
call GDV()
set t=null
set u=null
endfunction
function XLE takes real r returns integer
local integer i=R2I(r)
if r-i>=.5 then
return i+1
endif
return i
endfunction
function XME takes unit u returns real
local real d=0
if GetUnitTypeId(u)=='Udea' then
set d=2
endif
set d=d+B7V(u,true)*.14
set d=d+C7V(u,'I093')*5
set d=d+GetUnitAbilityLevel(u,'BHab')*7
set d=d+C7V(u,'I0BD')*3
set d=d+C7V(u,'I066')*5
set d=d+GetUnitAbilityLevel(u,'BAad')*3
set d=d+C7V(u,'I0BJ')*$A
set d=d+GetUnitAbilityLevel(u,'BBad')*5
set d=d+GetUnitAbilityLevel(u,'B03E')*(-5)
set d=d+C7V(u,'I00Z')*$F
set d=d+C7V(u,'I08O')*5
set d=d+C7V(u,'I0AB')*5
set d=d+C7V(u,'I08T')*5
set d=d+C7V(u,'I00M')*$A
set d=d+C7V(u,'I00Q')*5
set d=d+C7V(u,'I04U')*2
set d=d+C7V(u,'I047')*5
set d=d+C7V(u,'I04E')*5
set d=d+C7V(u,'I04Q')*$A
set d=d+DTV(u,'aDef')
return d
endfunction
function XPE takes unit u returns nothing
local integer i=0
local integer l=0
local item it=null
if C7V(u,'I700')==0 then
set i=DTV(u,'I700')
if i!=0 then
call G6V(u,-20*i)
call G2V(u,-$A*i)
call DPV(u,'I700',0)
call HEV(u)
endif
call DYV(u,'i700',false)
call FIV()
return
endif
loop
exitwhen i>5
set it=UnitItemInSlot(u,i)
if GetItemTypeId(it)=='I700' then
set l=GetItemCharges(it)+l
endif
set i=i+1
endloop
set i=DTV(u,'I700')
call G6V(u,-20*i)
call G2V(u,-$A*i)
call G6V(u,20*l)
call G2V(u,$A*l)
call DPV(u,'I700',l)
call HEV(u)
set it=null
endfunction
function XQE takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
call XPE(u)
set u=null
endfunction
function HeroIllusion takes nothing returns boolean
return IsUnitIllusion(GetFilterUnit())and GetWidgetLife(GetFilterUnit())>1 and GetUnitTypeId(GetFilterUnit())==GetUnitTypeId(AUV)
endfunction
function XSE takes nothing returns nothing
local unit u=DHV(GetTriggeringTrigger(),'Sour')
local integer i=0
local integer n=0
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local unit s=null
local real r=0
local integer l=0
local player p=GetOwningPlayer(u)
local boolean XTE=IsUnitIllusion(u)
if u==null then
call GDV()
set p=null
return
endif
if GetTriggerEventId()==EVENT_UNIT_DEATH and(J or XTE)then
set u=null
set p=null
call GDV()
return
endif
if IsUnitIllusion(u)==false then
set i=R2I(ITV*4)
set i=i-i/80*80
call FUV(u,"PastX"+I2S(i),x)
call FUV(u,"PastY"+I2S(i),y)
call FUV(u,"PastLife"+I2S(i),GetUnitState(u,UNIT_STATE_LIFE))
call FUV(u,"PastMana"+I2S(i),GetUnitState(u,UNIT_STATE_MANA))
call FHV(u,"PastActive"+I2S(i),true)
endif
if GetWidgetLife(u)<1 then
set u=null
return
endif
if GetUnitAbilityLevel(u,'BA3W')>0 then
if GetUnitState(u,UNIT_STATE_MANA)<GetUnitState(u,UNIT_STATE_MAX_MANA)*.02*.25 or GetUnitState(u,UNIT_STATE_LIFE)+1<GetUnitState(u,UNIT_STATE_MAX_LIFE)*.02*.25 then
call IssueImmediateOrderById(u,$D00D2)
else
call HGV(u,true,-GetUnitState(u,UNIT_STATE_MAX_LIFE)*.02*.25)
call HGV(u,false,-GetUnitState(u,UNIT_STATE_MAX_MANA)*.02*.25)
endif
endif
call C6V(u)
if GetUnitAbilityLevel(u,'B0BI')>0 and C7V(u,'I09Z')==0 then
call BJDebugMsg("1")
call UnitRemoveAbility(u,'B0BI')
endif
set i=E8(GetHandleId(u),"Invoker|Quas")
set n=GetUnitAbilityLevel(u,'A0VB')
if n>0 then
if i>0 then
call HGV(u,true,i*n*.25)
endif
endif
if GetUnitAbilityLevel(u,'AA64')>0 then
call DUV(u,'AA64',RMaxBJ(0,DWV(u,'AA64')-.01))
endif
if GetUnitMoveSpeed(u)>500 and XTE==false then
call KDV(GetOwningPlayer(u),'CJ27')
endif
if GetUnitAbilityLevel(u,'B948')>0 and ITV-DWV(u,'aa4t')>0 then
call KRV(u,'AB48','B948')
endif
set r=GetWidgetLife(u)
if R2I(r)==1 and GetUnitState(u,UNIT_STATE_MAX_LIFE)>350 and XTE==false then
call KDV(GetOwningPlayer(u),'CJ25')
endif
if B6V(u,true)>350 and B7V(u,true)>$96 and B8V(u,true)>$96 and XTE==false then
call KDV(GetOwningPlayer(u),'CJ26')
endif
if DTV(GetOwningPlayer(u),'DEAD')==0 and ITV>$708 and XTE==false then
call KDV(GetOwningPlayer(u),'CJ10')
endif
