endfunction
function SNOTFILTER takes nothing returns boolean 
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(SNOTU)) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(SNOTU)) 
endfunction
function SNOTTHEUNIT takes nothing returns nothing
local unit u
local unit f   
local real r=0                                 //add this!!
local group g=CreateGroup()   
call GroupEnumUnitsInRange(g,GetUnitX(SNOTU),GetUnitY(SNOTU),10,Condition(function SNOTFILTER))           
loop
exitwhen CountUnitsInGroup(g)>=1 or r>=600
set r=r+25
call GroupEnumUnitsInRange(g,GetUnitX(SNOTU),GetUnitY(SNOTU),r,Condition(function SNOTFILTER)) 
endloop  
if CountUnitsInGroup(g)>=1 then  
set f=GroupPickRandomUnit(g)
set u=CreateUnit(GetOwningPlayer(SNOTU),'e00E',GetUnitX(SNOTU),GetUnitY(SNOTU),0)
call UnitAddAbility(u,'A0FW')
call SetUnitAbilityLevel(u,'A0FW',GetUnitAbilityLevel(SNOTU,'A0FW'))
call IssueTargetOrderById(u,852600,f)
call RemoveUnit(u)
endif
set f=null
set g=null
set u=null   
endfunction
function XUE2 takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer id=GetLearnedSkill()
local integer i=GetUnitAbilityLevel(u,id)
local integer l=0
local timer tm=null
local trigger t=null
if id=='A0FW' and GetUnitAbilityLevel(u, 'A0FW')==1 then 
set SNOTU=u                                                                                                                      //add this
call TimerStart(CreateTimer(),3,true,function SNOTTHEUNIT)            //add this   change the 0.5 into the cd of the snot i think 3-5 sec would be fine
endif                                                                                                                                     //add this
set t=null
set tm=null
set u=null
endfunction
function XUE takes nothing returns nothing
local unit u=GetTriggerUnit()
