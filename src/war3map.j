function GIO takes integer GAO,integer GNO returns integer
local integer kc=0
local integer afw=0
loop
set kc=GetRandomInt(GAO,GNO)
if kc==$F or kc==41 or kc==45 or kc==46 or kc==47 or kc==56 or kc==71 or kc==92 or kc==94 or kc==96 or kc==97 or kc==98 then
set kc=0
endif
exitwhen(kc>0)
endloop
return kc
endfunction
function GBO takes integer O5 returns nothing
local integer GCO=0
local rect GDO=null
local integer GFO=St
local integer GGO=Wt
local integer kg=0
local player pl=Player(O5)
if(m8(pl)and(GetPlayerController(pl)==MAP_CONTROL_COMPUTER)and(ie[GetPlayerId(pl)]==null))then
if(((C8(pl))and(not M))or((M)and(GetRandomInt(1,2)==1)))then
set GFO=St
set GGO=Tt
else
set GFO=Ut
set GGO=Wt
endif
if(C8(pl))then
set GDO=Nr
else
set GDO=Ar
endif
set eY[GetPlayerId(pl)]=0
loop
set GCO=GIO(GFO,GGO)
if(not v[GCO])then
set ie[GetPlayerId(pl)]=CreateUnit(pl,qt[GCO],GetRectCenterX(GDO),GetRectCenterY(GDO),bj_UNIT_FACING)
endif
exitwhen(ie[GetPlayerId(pl)]!=null)
endloop
if(not(K or L or Lx or Lj))then
call AdjustPlayerStateBJ(-$FA,pl,PLAYER_STATE_RESOURCE_GOLD)
endif
endif
set GDO=null
set pl=null
endfunction
function GHO takes nothing returns nothing
if(IsUnitType(GetEnumUnit(),UNIT_TYPE_HERO))then
if(GetUnitTypeId(GetEnumUnit())=='U006')then
call ExecuteFunc("BHE")
endif
call KAV(BMV(GetOwningPlayer(GetEnumUnit())),10.,"g_strGameInfo enemy player has repicked "+KPV(GetEnumUnit())+".")
elseif((GetUnitTypeId(GetEnumUnit())=='n004')or(GetUnitTypeId(GetEnumUnit())=='n018')or(GetUnitTypeId(GetEnumUnit())=='n01C')or(GetUnitTypeId(GetEnumUnit())=='n01G'))then
call RemoveUnit(GetEnumUnit())
endif
endfunction
function GJO takes player pl,boolean GKO returns nothing
local integer GFO
local integer GGO
local integer GCO
if(((C8(pl))and(not M))or((M)and(GetRandomInt(1,2)==1)))then
set GFO=St
set GGO=Tt
else
set GFO=Ut
set GGO=Wt
endif
if(GKO)then
if M or Gx then
set T='d'
endif
call AdjustPlayerStateBJ(-1*T,pl,PLAYER_STATE_RESOURCE_GOLD)
endif
set I[GetPlayerId(pl)]=true
call GroupEnumUnitsOfPlayer(H8,GetOwningPlayer(GetAttacker()),Sz)
call ForGroup(H8,function GHO)
call L8V(ie[GetPlayerId(pl)])
set ie[GetPlayerId(pl)]=null
loop
set GCO=GIO(GFO,GGO)
if(v[GCO]==false)then
set v[GCO]=true
if(C8(pl))then
set ie[GetPlayerId(pl)]=CreateUnit(pl,qt[GCO],GetRectCenterX(Nr),GetRectCenterY(Nr),bj_UNIT_FACING)
else
set ie[GetPlayerId(pl)]=CreateUnit(pl,qt[GCO],GetRectCenterX(Ar),GetRectCenterY(Ar),bj_UNIT_FACING)
endif
call s8(qt[GCO])
endif
exitwhen ie[GetPlayerId(pl)]!=null
endloop
endfunction
function GLO takes nothing returns nothing
local string VH=GetEventPlayerChatString()
local player pl=i3(S2I(SubString(VH,9,StringLength(VH))))
if((pl!=null)and(m8(pl))and(IsPlayerInForce(pl,fz)))then
if((IsPlayerAlly(GetTriggerPlayer(),pl))or(A6(not IsPlayerAlly(GetTriggerPlayer(),A7V[0]))==null))then
if((I[GetPlayerId(pl)])or(ie[GetPlayerId(pl)]==null))then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Cannot repick")
elseif(Bz>60.)then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Too late to repick")
else
call GJO(pl,false)
endif
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Cannot force repick on enemies with human ally")
endif
endif
set pl=null
endfunction
function GMO takes nothing returns nothing
