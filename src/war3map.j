call DPV(t,'i',FGO)
call G7V(FBO,20*FGO)
call HEV(FBO)
set t=null
call GroupRemoveUnit(g,FBO)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set hn=null
set FBO=null
set p=null
