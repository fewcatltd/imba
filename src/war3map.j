set UP=GetPlayerId(pl)
if((ie[UP]!=null)and(A5(ie[UP]))and(not N5(ie[UP]))and(i0(ie[UP])))then
set G0[64+UP]=true
set h4[UP]=null
call LHO(ie[UP],false)
call TriggerSleepAction(1.)
if(GetTriggerPlayer()==dz)then
if(((JDO==1)and(JTO(ie[UP])==2))or((JDO==2)and(JTO(ie[UP])==1)))then
set JDO=$A+JDO
call LYO(ie[UP],h7[9+hB])
elseif(JDO==1)then
call LYO(ie[UP],h7[29+hc])
elseif(JDO==2)then
call LYO(ie[UP],h7[49+hC])
else
call LYO(ie[UP],h7[9+hB])
endif
else
if(((JDO==1)and(JTO(ie[UP])==2))or((JDO==2)and(JTO(ie[UP])==1)))then
set JDO=$A+JDO
call LYO(ie[UP],h7['u'-hB])
elseif(JDO==1)then
call LYO(ie[UP],h7[$8B-hc])
elseif(JDO==2)then
call LYO(ie[UP],h7[$9F-hC])
else
call LYO(ie[UP],h7['u'-hB])
endif
