function TE takes nothing returns nothing
local unit u=GetDyingUnit()
local integer sr=GetUnitUserData(u)
local group g
local unit Tf
local unit TF
local boolexpr hP=Condition(function TD)
local integer i=0
if H3V(u)then
set i=$96
endif
set g=KHV()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),$AF+i,hP)
loop
set TF=FirstOfGroup(g)
exitwhen(TF==null)
call GroupRemoveUnit(g,TF)
set Tf=CreateUnit(GetOwningPlayer(u),'e00E',GetUnitX(TF),GetUnitY(TF),0)
call UnitAddAbility(Tf,'A0OF')
call SetUnitAbilityLevel(Tf,'A0OF',sr)
call IssueTargetOrderById(Tf,$D007F,TF)
call UnitApplyTimedLife(Tf,'BTLF',1)
call UnitAddAbility(Tf,'Aloc')
endloop
call KGV(g)
call DestroyBoolExpr(hP)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathMissile.mdl",GetUnitX(u),GetUnitY(u)))
set u=null
set g=null
set Tf=null
set TF=null
set hP=null
endfunction
function Tg takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer K3V=GetHandleId(t)
local unit K8V=Y7(K3V,"Hero")
local integer JFV=GetUnitAbilityLevel(K8V,'A0O6')
local real x=X8(K3V,"IcePathX")
local real y=X8(K3V,"IcePathY")
local real RK=X8(K3V,"IcePathAngle")
local unit Tf
local integer Rd=E8(K3V,"IcePath|Counter")
local integer i=$A
if H3V(K8V)then
set i=50
endif
set x=x+'d'*Cos(RK*bj_DEGTORAD)
set y=y+'d'*Sin(RK*bj_DEGTORAD)
call E7(K3V,"IcePathX",x)
call E7(K3V,"IcePathY",y)
set Tf=CreateUnit(GetOwningPlayer(K8V),'e01U',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(Tf,'BTLF',.5)
call SetUnitUserData(Tf,JFV)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl",x,y))
set Rd=Rd+1
call n7(K3V,"IcePath|Counter",Rd)
if Rd>=i then
call PauseTimer(t)
call a7(K3V)
call DestroyTimer(t)
endif
set t=null
set K8V=null
set Tf=null
endfunction
function Fsv takes nothing returns boolean
return GetSpellAbilityId()=='A0O6'
endfunction
function C7X takes nothing returns nothing
local timer t=CreateTimer()
local unit K8V=GetTriggerUnit()
