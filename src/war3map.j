set D_O=w5+(d-25)*Sin(l4*bj_DEGTORAD)
call SetUnitX(m5,DZO)
call SetUnitY(m5,D_O)
call SetUnitFacing(m5,l4)
call IssueTargetOrderById(p5,$D000F,m5)
set g=KHV()
set OB=DZO
set AB=D_O
set BB=p5
set cB=m5
call GroupEnumUnitsInRange(g,t5,w5,$578,Condition(function HPR))
call KGV(g)
set u2=CreateUnit(GetOwningPlayer(p5),EB,DZO,D_O,0)
call KillUnit(u2)
endif
call KillUnit(u)
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function HQR))
call DFV(t,'u',m5)
call DUV(t,'t',ITV+JFV+1)
call DUV(t,'x',GetUnitX(u))
call DUV(t,'y',GetUnitY(u))
set t=null
set p5=null
set m5=null
set u=null
set u2=null
set g=null
endfunction
