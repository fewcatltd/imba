call UnitAddAbility(c,'B003')
endif
call SelectUnitForPlayerSingle(c,p)
call SetUnitScalePercent(c,.01,.01,.01)
call RemoveUnit(u)
elseif VFV[PJE] and OSE()then
if GetUnitTypeId(u)!='O00P' then
if XSV then
