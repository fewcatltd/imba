call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",GetUnitX(GMX),GetUnitY(GMX)))
call RemoveUnit(GMX)
call UnitRemoveAbility(K8V,('A0GC'))
call SetPlayerAbilityAvailable(GetOwningPlayer(K8V),('A0G8'),true)
call a7(GetHandleId(t))
call KJV((t))
set t=null
set K8V=null
set GMX=null
endfunction
