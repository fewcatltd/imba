call LQV(qt[40],"stand ready")
call LKV(qt[40],1,IT[40])
set cT[i]="PotM can be extremely efficient and gank with just a few Wraith Bands, Boots of Speed and a Bottle."
set CT[i]="Getting one level of Leap is usually sufficient early on until Starfall and Elune's Arrow are fully leveled."
set DT[i]="Land your Elune's Arrow by coordinating with allies and predicting enemy movements. You can even hit invisible or faraway targets with practice."
set fT[i]="Starfall hits a second time for half damage to one random enemy within 200 range, get close if you can to deal bonus damage"
set FT[i]="Moonlight Shadow can be used to initiate or escape but sometimes it can be learned later when PotM can use it without compromising her mana pool."
set i=i+1
set qt[41]='H00S'
set IT[41]='h04Q'
set Qt[41]='n0AT'
set RT[41]="ReplaceableTextures\\CommandButtons\\BTNStorm.blp"
call LQV(qt[41],"spell")
call LKV(qt[41],1,IT[41])
set cT[i]="Do not get Overload at level 1 since you do not have any spells to activate its effect with."
set CT[i]="Choosing which ability to max first can be difficult, but generally at least one point in all three skills is a good idea."
set DT[i]="You have to wait 1 second after casting Static Remnant before it begins detecting nearby units for its explosion effect."
set fT[i]="In addition to chasing and escaping, Lightning Ball can be used to dodge many spells with the right timing."
set FT[i]="An item like Bloodstone is useful on Storm Spirit because the percentage-based mana cost of Lightning Ball makes regeneration an important asset."
set i=i+1
set qt[42]='H00Q'
set IT[42]='h04Y'
set Qt[42]='n0AG'
set RT[42]="ReplaceableTextures\\CommandButtons\\BTNHeadHunterBerserker.blp"
call LQV(qt[42],"stand alternate 3")
call LKV(qt[42],1.15,IT[42])
set cT[i]="A level of Burning Spears early on is great for harassing enemy heroes. Use it manually by clicking 'R' then the desired target to avoid drawing focus fire."
set CT[i]="Berserker's Blood makes you stronger as you take damage. The bonuses stop when you have 51% HP, so there is little point in taking additional damage."
set DT[i]="Life Break deals damage based on the remaining health of the target, making it strongest at the beginning of a fight. "
set fT[i]="Inner Vitality heals more when you have less than 40% of your life, but avoid making the mistake of casting it too late in battles."
set FT[i]="Survivability while in low health is important for Huskar: Consider items such as Armlet of Mordiggan, Black King Bar, or Heart of Tarrasque."
set i=i+1
set qt[43]='E01Y'
set IT[43]='h058'
set Qt[43]='n0AF'
set RT[43]="ReplaceableTextures\\CommandButtons\\BTNAssassin.blp"
call LQV(qt[43],"stand victory")
call LKV(qt[43],1.2,IT[43])
set cT[i]="Refraction is a great way of surviving in a lane, just be careful not to get hit by creeps too much."
set CT[i]="Meld starts cooling down when you click the spell, so you can hit him twice with it if you can predict your enemy's movements."
set DT[i]="Traps can be used for vision, most effectively in cramped areas like the end of ramps or at the rune powerup spots."
set fT[i]="You can farm extremely fast by positioning yourself so that the Psi Blades splash on multiple creeps at once."
set FT[i]="Placing a trap or two before engaging a fight can be a good idea, to cut off possible escape and/or chase routes."
set i=i+1
set qt[44]='N00B'
set IT[44]='h050'
set Qt[44]='n0AE'
set RT[44]="ReplaceableTextures\\CommandButtons\\BTNFaerieDragon.blp"
call LQV(qt[44],"attack spell")
call LKV(qt[44],1.1,IT[44])
set cT[i]="Illusory Orb and Jaunt are used to travel short distances quickly, but if you wait too long to Jaunt, you will lose the opportunity."
set CT[i]="Puck is very fragile early game, some Bracers or Null Talismans and a level of Phase Shift can help you survive."
set DT[i]="Using Phase Shift manually instead of Autocast will prevent stray attacks from triggering it on Autocast. In general you will have better control of its use."
set fT[i]="Waning Rift deals damage and silences, but forces you to be close enough. Use Illusory Orb or Dream Coil to help you land the spell on enemies."
set FT[i]="Puck is a great initiator in fights who offers control of the battle with his spells, allowing allies to join the battle and use their spells or attacks safely."
set i=i+1
set qt[45]='H00T'
set IT[45]='h051'
set Qt[45]='n0AU'
set RT[45]="ReplaceableTextures\\CommandButtons\\BTNClockWerkGoblin.blp"
call LQV(qt[45],"Birth")
call LKV(qt[45],1.5,IT[45])
set cT[i]="You can use Rocket Flare for harassing and killing creeps early on. With the right timing, you can even fire at enemies across the map."
set CT[i]="Power Cogs can be used to trap an enemy, push them away while draining mana, or as an escape mechanism since Rattletrap destroys Cogs in only 1 hit."
set DT[i]="Battery Assault adds a lot of damage and the stuns help you with chasing, use it when no other units are nearby for best results."
set fT[i]="Hookshot's long range and high speed lets you reach enemies from out of sight. Follow up with your other spells quickly so your target cannot escape."
set FT[i]="Rocket Flare also gives vision where it lands, making it very useful for scouting areas such as rune spots, neutral creeps, the enemy base."
set i=i+1
set qt[46]='H06S'
set IT[46]='h06T'
set Qt[46]='n0EE'
set RT[46]="ReplaceableTextures\\CommandButtons\\BTNProudmoore.blp"
call LQV(qt[46],"stand victory")
call LKV(qt[46],1.1,IT[46])
set cT[i]="Tidebringer is extremely useful early game: Use the bonus damage for killing creeps and the cleave effect to harass opponents at the same time."
set CT[i]="The bubble animation from Torrent can only be seen by your team so try to use this to your advantage."
set DT[i]="An ally's assistance or X Marks the Spot is a great way of making sure Torrent and Ghost Ship hit your opponent."
set fT[i]="Escaping enemy heroes is easy by casting X Marks the Spot on them. It also prevents them from getting away."
set FT[i]="The Ghost Ship will crash 1000 range from where you stand when you cast it. Keep your distance when you use it."
set i=i+1
set qt[47]='N0EG'
set IT[47]='h07A'
