call DPV(p5,'A1IQ',0)
call HEV(p5)
endif
elseif GetAttacker()==Y7(GetHandleId(GetTriggeringTrigger()),"JinadaHero")then
if IsUnitAlly(GetAttacker(),GetOwningPlayer(GetTriggerUnit()))==false then
set t=CreateTrigger()
set K3V=GetHandleId(t)
set m5=GetTriggerUnit()
set p5=GetAttacker()
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DAMAGED)
call TriggerRegisterTimerEvent(t,2.5,false)
call TriggerAddCondition(t,Condition(function AIX))
call n7(K3V,"TargetIndex",c8(m5))
call A7(K3V,"Source",p5)
set m5=null
set p5=null
set t=null
endif
endif
return false
endfunction
function ANX takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit K8V=Y7(K3V,"Hero")
local real ABX=TimerGetElapsed(D)
local integer JFV=GetUnitAbilityLevel(K8V,'A1IQ')
local real ACX=X8(GetHandleId(K8V),"LastUsed")
local boolean ADX=O8(GetHandleId(K8V),"JinadaActive")
local integer i=26-JFV*5
local integer l=0
if H3V(K8V)then
set i=4-JFV
endif
if ABX-ACX>i and ADX==false and LAV(K8V)==false then
if H3V(K8V)then
set l=B7V(K8V,true)
call G6V(K8V,l)
call HEV(K8V)
call DPV(K8V,'A1IQ',l)
