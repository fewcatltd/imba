loop
set f=FirstOfGroup(g)
exitwhen f==null
call GroupAddUnit(g1,f)
call HPV(s,f,1,r)
if IsUnitType(f,UNIT_TYPE_HERO)then
call QDV(f,1+.25*i,false)
else
call QDV(f,.75*i,false)
endif
call GroupRemoveUnit(g,f)
endloop
call FIV()
if IVV then
set t=CreateTimer()
call TimerStart(t,.025,true,function RAR)
endif
call DUV(t,'x',x)
call DUV(t,'y',y)
call DPV(t,'i',i)
call DJV(t,'g',g1)
call DFV(t,'s',s)
call DUV(t,'t',ITV+.5+i+1+.25*i)
call DestroyBoolExpr(b)
call DestroyGroup(g)
set t=null
set s=null
set g=null
set b=null
set g1=null
endfunction
