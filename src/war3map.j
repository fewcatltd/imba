local unit QJV
local integer K3V=GetHandleId(K8V)
local location l=GetSpellTargetLoc()
local real a=MDV(GetUnitX(K8V),GetUnitY(K8V),GetLocationX(l),GetLocationY(l))
local real x=GetUnitX(K8V)
local real y=GetUnitY(K8V)
local group g=null
local group g1=null
local boolexpr b=null
local unit f=null
local real r=0
local integer i=GetUnitAbilityLevel(K8V,GetSpellAbilityId())
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real d=0
local trigger t=null
if H3V(K8V)then
set g1=CreateGroup()
set g=CreateGroup()
set b=Condition(function PQV)
set AUV=K8V
set d=SquareRoot((x-x1)*(x-x1)+(y-y1)*(y-y1))
set d=d/40
loop
exitwhen d<0
set r=40
set d=d-1
set x=x+Cos(a*bj_DEGTORAD)*r
set y=y+Sin(a*bj_DEGTORAD)*r
call GroupEnumUnitsInRange(g1,x,y,'s',b)
call GroupAddGroup(g1,g)
