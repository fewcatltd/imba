endfunction
function ANR takes unit S4,integer ABR returns unit
local group g=KHV()
set xL=S4
set oL=null
call GroupEnumUnitsInRange(g,GetUnitX(eH),GetUnitY(eH),$514+ABR,Condition(function AAR))
if oL==null then
set Sl=0
call KGV(g)
set g=KHV()
call GroupEnumUnitsInRange(g,GetUnitX(eH),GetUnitY(eH),$44C+ABR,Condition(function AIR))
if Sl>1 then
set oL=null
endif
endif
call KGV(g)
set g=null
return oL
endfunction
function ACR takes player p4,unit S4,unit ADR,integer DRE,real x,real y,integer N6E,integer AFR returns nothing
local unit AGR
local item ZMO
local real AHR
local real AJR
local integer PJE=(1+GetPlayerId(p4))
if ENV[PJE] then
set AHR=GetUnitX(ft[GetPlayerId(p4)])
set AJR=GetUnitY(ft[GetPlayerId(p4)])
else
set AHR=x
set AJR=y
endif
set eH=ADR
if GetUnitPointValue(S4)==$C8 then
set AGR=ANR(S4,0)
if AGR==null then
set AGR=ANR(S4,300)
endif
else
set AGR=S4
endif
if AGR==null or ARR(p4,AGR,DOE(DRE))==false or EL==false then
if DCE(DOE(DRE))then
if RYR(AGR)==0 or AGR==null then
call RTR(Oc[DRE],AHR,AJR,p4,true,N6E)
else
set ZMO=UnitAddItemById(AGR,Ac[DRE])
call SetItemCharges(ZMO,N6E)
call SetItemPlayer(ZMO,p4,true)
call SetItemUserData(ZMO,AFR)
endif
elseif DBE(DOE(DRE))then
if AGR==null or(RYR(AGR)==0 and F5(AGR,Ac[DRE])==null)then
call RTR(Oc[DRE],AHR,AJR,p4,true,R_R(DRE))
else
set ZMO=CreateItem(Oc[DRE],AHR,AJR)
call SetItemPlayer(ZMO,p4,true)
call SetItemUserData(ZMO,AFR)
call SetItemCharges(ZMO,R_R(DRE))
call UnitAddItem(AGR,ZMO)
endif
else
if RYR(AGR)==0 or AGR==null then
call RTR(Oc[DRE],AHR,AJR,p4,false,0)
else
set ZMO=UnitAddItemById(AGR,Ac[DRE])
call SetItemPlayer(ZMO,p4,true)
call SetItemUserData(ZMO,0)
endif
endif
endif
set AGR=null
set ZMO=null
endfunction
function AKR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit S4=Y7(K3V,"Tower")
if GetTriggerEventId()!=EVENT_UNIT_DEATH then
call UnitRemoveAbility(S4,'A17R')
endif
call DestroyEffect(r8(K3V,"FX"))
call a7(K3V)
call KJV(t)
set t=null
set S4=null
return false
endfunction
function ALR takes nothing returns boolean
return(IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>.5 and IsUnitAlly(GetFilterUnit(),Sh) and GetOwningPlayer(GetFilterUnit())!=NVV and GetUnitTypeId(GetFilterUnit())!='ncop' and GetUnitTypeId(GetFilterUnit())!='n0FJ' and GetUnitTypeId(GetFilterUnit())!='n0FI' and GetUnitTypeId(GetFilterUnit())!='n0F6' and GetUnitTypeId(GetFilterUnit())!='n0FH')!=null
