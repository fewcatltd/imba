function To takes unit K8V,unit m5 returns nothing
local real a=GetRandomReal(0,360)
local real x=GetUnitX(m5)+50*Cos(a*bj_DEGTORAD)
local real y=GetUnitY(m5)+50*Sin(a*bj_DEGTORAD)
local integer i=0
local integer l=0
call SetUnitPosition(K8V,x,y)
call SetUnitFacing(K8V,bj_RADTODEG*Atan2(GetUnitY(m5)-GetUnitY(K8V),GetUnitX(m5)-GetUnitX(K8V)))
call SetUnitAnimation(K8V,"Attack")
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",K8V,"chest"))
call IssueTargetOrderById(K8V,$D000F,m5)
call DYV(K8V,'A00K',false)
set i=GetUnitAbilityLevel(K8V,'A00K')
if i>0 then
set l=2+8*i+CQV(K8V)*$A
if i==4 then
set l=l+2
endif
if GetRandomInt(0,99)<l then
call DYV(K8V,'A00K',true)
call HNV("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",K8V,"weapon",.5)
call SetUnitAnimation(K8V,"slam")
endif
endif
call QUV(K8V,m5,GetRandomReal($96,$FA))
endfunction
