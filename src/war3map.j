function md takes nothing returns string
return qW
endfunction
function mD takes player j8 returns string
return KTV(ie[GetPlayerId(j8)])
endfunction
function me takes player j8,integer Lp returns string
return TAV(UnitItemInSlot(ie[GetPlayerId(j8)],Lp-1))
endfunction
function mE takes player j8 returns string
return R[GetPlayerId(j8)]+JZV(j8)+"|r"
endfunction
function mf takes player j8 returns string
return I2S(GetPlayerState(j8,PLAYER_STATE_RESOURCE_GOLD))
endfunction
function mF takes player p returns string
return I2S(Zh[GetPlayerId(p)])
endfunction
function mg takes player p returns string
return I2S(GetUnitLevel(ie[GetPlayerId(p)]))
endfunction
function mG takes player p returns string
return I2S(E8(StringHash("Stats"+I2S(GetPlayerId(p))),"NumOfWards"))
endfunction
function mh takes player j8 returns string
return I2S(eU[GetPlayerId(j8)])
endfunction
function mH takes player j8 returns string
return I2S(tu[GetPlayerId(j8)])
endfunction
function mi takes player j8 returns string
return I2S(N[GetPlayerId(j8)])
endfunction
function mI takes player j8 returns string
return I2S(C[GetPlayerId(j8)])
endfunction
function mj takes player j8 returns string
return I2S(Ae[GetPlayerId(j8)])
endfunction
function mJ takes player j8 returns string
return I2S(Ne[GetPlayerId(j8)])
endfunction
function mk takes player p returns string
return I2S(E8(StringHash("Stats"+I2S(GetPlayerId(p))),"NumOfNeutrals"))
endfunction
function mK takes player j8 returns string
return I2S(wu[GetPlayerId(j8)])
endfunction
function ml takes player j8 returns string
return I2S(Wu[GetPlayerId(j8)])
endfunction
function mL takes player j8 returns string
return I2S(Tu[GetPlayerId(j8)])
endfunction
function mm takes player j8 returns string
local integer k=gD[GetPlayerId(j8)]
local integer d=CU[GetPlayerId(j8)]
if k<1 then
set k=0
endif
if d<1 then
set d=0
endif
return I2S(k)+"/"+I2S(d)
endfunction
function mM takes player j8 returns string
local integer L0=vU[GetPlayerId(j8)]
local string TLV
local integer L1
local integer L2
set L1=(L0/60)-(1/2)
set L2=ModuloInteger(L0,60)
if(L2<$A)then
set TLV=I2S(L1)+":0"+I2S(L2)
else
set TLV=I2S(L1)+":"+I2S(L2)
endif
return TLV
endfunction
function mn takes player p5,player m5 returns string
local integer k=E8(StringHash("Stats"+I2S(GetPlayerId(p5))),"Killed "+I2S(GetPlayerId(m5)))
local integer d=E8(StringHash("Stats"+I2S(GetPlayerId(p5))),"Died To "+I2S(GetPlayerId(m5)))
if k<1 then
set k=0
endif
if d<1 then
set d=0
endif
return I2S(k)+"/"+I2S(d)
endfunction
function mN takes player p5 returns string
local string mo
if LAV(ie[GetPlayerId(p5)])then
set mo=I2S(R2I(TimerGetRemaining(B[GetPlayerId(p5)])))
else
set mo=" "
endif
return mo
endfunction
function AZE takes player p5 returns string
local real r=(TimerGetRemaining(bu[GetPlayerId((p5))]))
local string A_E
if r>0 then
set A_E=I2S(R2I(r))
else
set A_E=" "
endif
return A_E
endfunction
function A0E takes integer mp,integer mP returns nothing
set Ju=CreateMultiboard()
call MultiboardSetItemsWidth(Ju,0)
call MultiboardSetRowCount(Ju,mp)
call MultiboardSetColumnCount(Ju,mP)
call MultiboardSetTitleText(Ju,(GetObjectName(('n0E3')))+" "+" - "+md())
call MultiboardMinimize(Ju,true)
call MultiboardSetItemsStyle(Ju,false,false)
if GetLocalPlayer()==jt or GetLocalPlayer()==Jt then
call MultiboardDisplay(Ju,true)
endif
endfunction
function mq takes nothing returns string
return"|c00ff0303"+I2S(N[GetPlayerId(A7V[0])])+"|r/|c0020c000"+I2S(C[GetPlayerId(A7V[0])])+"|r"
endfunction
function A1E takes player A2E returns string
return I2S(zb[GetPlayerId(A2E)])
endfunction
