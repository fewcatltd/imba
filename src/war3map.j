function OSO takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer K3V=GetHandleId(t)
local unit K8V=Y7(K3V,"Hero")
local real PNV=X8(K3V,"Duration")
local integer T8=0
local integer i=20
if IVV then
set i=i*2
endif
loop
exitwhen T8>5
if OQO(K8V,T8)then
if GetUnitAbilityLevel(K8V,('B047'))==0 then
call SetItemDropOnDeath(UnitItemInSlot(K8V,T8),true)
if GetItemTypeId(UnitItemInSlot(K8V,T8))=='oflg' then
call SetItemDroppable(UnitItemInSlot(K8V,T8),true)
endif
else
call SetItemDropOnDeath(UnitItemInSlot(K8V,T8),false)
if GetItemTypeId(UnitItemInSlot(K8V,T8))=='oflg' then
call SetItemDroppable(UnitItemInSlot(K8V,T8),false)
endif
endif
endif
set T8=T8+1
endloop
set PNV=PNV+.2
call E7(K3V,"Duration",(PNV)*1.)
if GetUnitAbilityLevel(K8V,('B047'))==0 then
call SetUnitPathing(K8V,true)
else
call SetUnitPathing(K8V,false)
endif
if PNV>i then
call PauseTimer(t)
call a7(K3V)
call SetUnitPathing(K8V,true)
set T8=0
loop
exitwhen T8>5
if OQO(K8V,T8)then
call SetItemDropOnDeath(UnitItemInSlot(K8V,T8),true)
if GetItemTypeId(UnitItemInSlot(K8V,T8))=='oflg' then
call SetItemDroppable(UnitItemInSlot(K8V,T8),true)
endif
endif
set T8=T8+1
endloop
endif
endfunction
