endfunction
function Z8R takes nothing returns nothing
local trigger t=null
local integer i=GetRandomInt(0,3)
local integer l=R2I(AHV)
if i==0 then
call HGV(ADV,true,$A+l*$A)
elseif i==1 then
call HGV(ADV,false,$A+l*$A)
elseif i==2 then
set t=CreateTrigger()
