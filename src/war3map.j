function VQI takes unit u returns nothing
local group g=CreateGroup()
local boolexpr b=Condition(function VPI)
local unit f=null
local integer i=$A
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(u),b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if i>0 then
set i=i-1
else
call KillUnit(f)
endif
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
