function OGR takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'Sour')
local real a=DWV(tm,'a')
local real x=DWV(tm,'x')
local real y=DWV(tm,'y')
local integer i=DTV(tm,'Levl')
local group g=null
local boolexpr b=null
local unit u=null
if DTV(tm,'Loop')<1 then
call FIV()
else
call DQV(tm,'Loop',-1)
set x=x+Cos(a)*280
set y=y+Sin(a)*280
call DUV(tm,'x',x)
call DUV(tm,'y',y)
call KillUnit(CreateUnit(GetOwningPlayer(s),'h07Q',x,y,0))
set g=CreateGroup()
set b=Condition(function PJV)
set AUV=s
call GroupEnumUnitsInRange(g,x,y,280,b)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call QHV(null,u,2)
call HPV(s,u,1,25+75*i)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\StormBolt\\StormBoltMissile.mdl",u,"origin"))
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set tm=null
set s=null
endfunction
function OHR takes player p,unit m5,integer JFV,unit p5,real a returns nothing
