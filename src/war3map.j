if hn!=null then
call DFV(t,'Targ',hn)
endif
call DestroyBoolExpr(b)
call DestroyGroup(g)
set b=null
set g=null
else
call E7(K3V,"TargetX",GetUnitX(hn))
call E7(K3V,"TargetY",GetUnitY(hn))
endif
endif
call SetUnitX(G3R,G9R)
call SetUnitY(G3R,HVR)
call E7(K3V,"SourceX",G9R)
call E7(K3V,"SourceY",HVR)
if v6(G4R,G5R,G9R,HVR)<=35 then
call KillUnit(G3R)
set hn=Y7(K3V,"Hero")
call GZR(hn,G9R,HVR)
call a7(K3V)
call KJV(t)
endif
set t=null
set hn=null
set G3R=null
return false
endfunction
