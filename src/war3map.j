call SetUnitAnimation(s,"stand")
if GetUnitTypeId(u)!='e00E' then
call IssueTargetOrderById(s,$D000F,u)
else
call IssueImmediateOrderById(s,$D0004)
call KillUnit(u)
endif
set g=KHV()
set AUV=s
call GroupEnumUnitsInRange(g,x,y,274,Condition(function PJV))
loop
set f=FirstOfGroup(g)
exitwhen f==null
call QDV(f,1.7+.3*i,false)
call HPV(s,f,2,'d'*i)
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
set g=null
call GDV()
else
call PauseUnit(s,true)
