exitwhen i>$B or b
if GetPlayerName(Player(i))==GetObjectName('A0Q1')or GetPlayerName(Player(i))==GetObjectName('A0Q2')or GetPlayerName(Player(i))=="HivZio" or GetPlayerName(Player(i))=="Mimya" or GetPlayerName(Player(i))==GetObjectName('AMMY')then
