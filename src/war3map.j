function AAR takes nothing returns boolean
if IsUnitAlly(GetFilterUnit(),GetOwningPlayer(xL)) and GetUnitAbilityLevel(GetFilterUnit(),'Aloc')==0 and UnitInventorySize(GetFilterUnit())>1 and GetUnitTypeId(GetFilterUnit())!='ncop' and IsUnitIllusion(GetFilterUnit())==false and LAV(GetFilterUnit())==false then
if GetOwningPlayer(xL)==GetOwningPlayer(GetFilterUnit())then
if IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) then
if GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 then
set oL=GetFilterUnit()
endif
elseif IsUnitType(oL,UNIT_TYPE_HERO)==false then
set oL=GetFilterUnit()
