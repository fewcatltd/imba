function UWR takes nothing returns nothing
local timer tm=GetExpiredTimer()
local integer i=0
local integer n=DTV(tm,'Loop')
local real x=DWV(tm,'x')
local real y=DWV(tm,'y')
local group g=DKV(tm,'have')
local group g1=null
local unit s=DHV(tm,'Sour')
local unit u=null
local boolexpr b=null
if n<39 then
call DQV(tm,'Loop',1)
set AUV=s
set g1=CreateGroup()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g1,x,y,25*(n+1),b)
call DestroyBoolExpr(b)
set b=null
call GroupRemoveGroup(g,g1)
set u=FirstOfGroup(g1)
if u!=null then
loop
set u=FirstOfGroup(g1)
exitwhen u==null
call HPV(s,u,1,B8V(s,true)*.8*DTV(tm,'Levl')+H4V(s,1.2))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",u,"origin"))
call GroupAddUnit(g,u)
call GroupRemoveUnit(g1,u)
endloop
endif
call DestroyGroup(g1)
set g1=null
loop
exitwhen i>29
call MoveLightning(D0V(tm,i),false,x+Cos(bj_PI/$F*i)*25*(n+1),y+Sin(bj_PI/$F*i)*25*(n+1),x+Cos(bj_PI/$F*(i+1))*25*(n+1),y+Sin(bj_PI/$F*(i+1))*25*(n+1))
set i=i+1
endloop
else
loop
exitwhen i>29
call DestroyLightning(D0V(tm,i))
set i=i+1
endloop
call DestroyGroup(g)
call FIV()
endif
set tm=null
set g=null
set s=null
endfunction
function UYR takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit u=DHV(tm,'Sour')
local real x=DWV(tm,'x')
local real y=DWV(tm,'y')
local integer i=DTV(tm,'Levl')
local integer n=0
local unit s=null
local integer PJE=7
if EMV then
set PJE=1
endif
loop
exitwhen n>PJE
set s=CreateUnit(GetOwningPlayer(u),'e00E',x,y,0)
call UnitAddAbility(s,'AA7W')
call SetUnitAbilityLevel(s,'AA7W',i)
call IssuePointOrderById(s,$D0079,x+Cos(bj_PI*.25*n)*300,y+Sin(bj_PI*.25*n)*300)
set n=n+1
endloop
call FIV()
set tm=null
set u=null
set s=null
endfunction
function UZR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'Sour')
local integer i=DTV(t,'Levl')
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real a=0
local group g=null
local boolexpr b=null
local real d=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetTriggerEvalCount(t)==$C8 then
call GDV()
else
set g=CreateGroup()
set AUV=u
set b=Condition(function PJV)
if EMV then
call GroupEnumUnitsInRange(g,x,y,$E1,b)
else
call GroupEnumUnitsInRange(g,x,y,375,b)
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
if IsUnitInRange(u,AUV,$FA)then
call HPV(AUV,u,1,.025*(60+20*GetUnitAbilityLevel(AUV,'A05G')))
endif
if IVV then
if GUV(u)==false then
set a=HYV(AUV,u)
set x1=GetUnitX(u)-Cos(a)*5
set y1=GetUnitY(u)-Sin(a)*5
if IsTerrainPathable(x1,y1,PATHING_TYPE_WALKABILITY)==false then
call SetUnitX(u,x1)
call SetUnitY(u,y1)
endif
set d=C3V(AUV,u)
set a=HYV(AUV,u)+bj_PI*.03
set x1=GetUnitX(AUV)+Cos(a)*d
set y1=GetUnitY(AUV)+Sin(a)*d
if IsTerrainPathable(x1,y1,PATHING_TYPE_WALKABILITY)==false then
call SetUnitX(u,x1)
call SetUnitY(u,y1)
call MMV(x1,y1,75)
endif
endif
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set b=null
set g=null
endif
set t=null
set u=null
endfunction
function Owning takes nothing returns boolean
return(IsUnitType(GetFilterUnit(),UNIT_TYPE_DEAD)==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetOwningPlayer(GetFilterUnit())==GetOwningPlayer(AUV))!=null
endfunction
function U_R takes nothing returns nothing
