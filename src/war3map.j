function LEE takes unit K8V,real x,real y returns nothing
local integer K3V=GetHandleId(GetOwningPlayer(K8V))
local unit NSE=Y7(K3V,"Kobold1")
local unit NTE=Y7(K3V,"Kobold2")
local unit NUE=Y7(K3V,"Kobold3")
set VW=true
if NSE!=null then
call ReviveHero(NSE,x,y,true)
call LVE(NSE)
call TTV(NSE)
call SetUnitX(NSE,x)
call SetUnitY(NSE,y)
endif
if NTE!=null then
call ReviveHero(NTE,x,y,true)
call LVE(NTE)
call TTV(NTE)
call SetUnitX(NTE,x)
call SetUnitY(NTE,y)
endif
if NUE!=null then
call ReviveHero(NUE,x,y,true)
call LVE(NUE)
call TTV(NUE)
call SetUnitX(NUE,x)
call SetUnitY(NUE,y)
endif
set NSE=null
set NTE=null
set NUE=null
endfunction
