local integer K3V=GetHandleId(t)
local unit K8V=Y7(K3V,"Hero")
local real x=X8(K3V,"x")
local real y=X8(K3V,"y")
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT or O8(GetHandleId(K8V),"PendingUnfreeze") then
if O8(GetHandleId(K8V),"PendingUnfreeze") then
call O7(GetHandleId(K8V),"PendingUnfreeze",false)
call K_V(K8V,"Frozen")
call UnitRemoveAbility(K8V,'A04R')
call SetUnitInvulnerable(K8V,false)
call CPV(K8V,false)
call a7(K3V)
call KJV(t)
elseif GetSpellTargetUnit()==K8V and GetSpellAbilityId()==vw and(GetPlayerSlotState(GetOwningPlayer((K8V)))==PLAYER_SLOT_STATE_LEFT)and KUV(K8V,"Frozen") then
call K_V(K8V,"Frozen")
call UnitRemoveAbility(K8V,'A04R')
call SetUnitInvulnerable(K8V,false)
call CPV(K8V,false)
call a7(K3V)
call KJV(t)
endif
elseif LAV(K8V)==false then
call SetUnitX(K8V,x)
call SetUnitY(K8V,y)
call KYV(K8V,"Frozen")
call UnitAddAbility(K8V,'A04R')
call SetUnitInvulnerable(K8V,true)
call CPV(K8V,true)
endif
set K8V=null
set t=null
return false
endfunction
function D4E takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit K8V=GetSpellTargetUnit()
call O7(GetHandleId(K8V),"PendingUnfreeze",false)
call KYV(K8V,"Frozen")
call UnitAddAbility(K8V,'A04R')
call SetUnitInvulnerable(K8V,true)
call CPV(K8V,true)
call A7(K3V,"Hero",K8V)
call E7(K3V,"x",GetUnitX(K8V)*1.)
call E7(K3V,"y",GetUnitY(K8V)*1.)
call TriggerRegisterTimerEvent(t,1,true)
call MKV(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function D3E))
set t=null
set K8V=null
endfunction
function D5E takes nothing returns boolean
if GetSpellAbilityId()==TU and(GetPlayerSlotState(GetOwningPlayer((GetSpellTargetUnit())))==PLAYER_SLOT_STATE_LEFT)and KUV(GetSpellTargetUnit(),"Frozen")==false then
call D4E()
elseif(GetSpellAbilityId()==vw or GetSpellAbilityId()==TU)and(GetPlayerSlotState(GetOwningPlayer((GetSpellTargetUnit())))==PLAYER_SLOT_STATE_LEFT)==false then
call LYV(GetOwningPlayer(GetTriggerUnit()),(GetObjectName(('n02N'))))
endif
return false
endfunction
function D6E takes destructable d returns boolean
local real x=GetDestructableX(d)
local real y=GetDestructableY(d)
local group g=KHV()
local boolean D7E
call GroupEnumUnitsInRange(g,x,y,$FA,Condition(function P8V))
set D7E=FirstOfGroup(g)!=null
call KGV(g)
set g=null
return D7E
endfunction
function D8E takes nothing returns nothing
if JYV(GetEnumDestructable())and GetDestructableLife(GetEnumDestructable())<1 and GetDestructableTypeId(GetEnumDestructable())!='B002' and GetDestructableTypeId(GetEnumDestructable())!='B003' then
if D6E(GetEnumDestructable())==false then
call DestructableRestoreLife(GetEnumDestructable(),GetDestructableMaxLife(GetEnumDestructable()),false)
if PW[GetPlayerId(GetLocalPlayer())]==1 and GetDestructableTypeId(GetEnumDestructable())=='ATtr' then
call SetDestructableAnimation(GetEnumDestructable(),"stand alternate")
endif
endif
endif
endfunction
function D9E takes nothing returns nothing
call EnumDestructablesInRectAll(bj_mapInitialPlayableArea,function D8E)
endfunction
function FVE takes nothing returns boolean
if GetUnitTypeId(GetTriggerUnit())=='n00L' then
if IsUnitIllusion(GetAttacker()) then
call KillUnit(GetAttacker())
elseif IsUnitInRegion(ow,GetAttacker())==false then
call LYV(GetOwningPlayer(GetAttacker()),(GetObjectName(('n035'))))
call IssueImmediateOrderById(GetAttacker(),$D0004)
endif
endif
return false
endfunction
function FEE takes nothing returns boolean
return GetUnitTypeId(GetSummonedUnit())=='o004' or GetUnitTypeId(GetSummonedUnit())=='oeye'
endfunction
function FXE takes unit K8V,unit FOE returns nothing
local integer FRE
local item FIE
if GetUnitTypeId(GetSummonedUnit())=='o004' then
set FRE=Ac[NIV]
else
set FRE=Ac[NAV]
endif
call DisableTrigger(rH)
set FIE=F5(K8V,FRE)
if FIE==null then
set nL=GetOwningPlayer(K8V)
set cj=CreateItem(FRE,0,0)
call UnitAddItem(K8V,cj)
call SetItemPlayer(cj,nL,false)
call SetItemUserData(cj,1)
else
call SetItemCharges(FIE,GetItemCharges(FIE)+1)
endif
call EnableTrigger(rH)
endfunction
function FAE takes nothing returns nothing
local unit FOE=GetSummonedUnit()
local unit K8V=GetSummoningUnit()
if IsUnitInRegion(ow,FOE)then
call FXE(K8V,FOE)
call RemoveUnit(FOE)
elseif P4(K8V)then
call FXE(K8V,FOE)
call LYV(GetOwningPlayer(FOE),"Couriers cannot place wards")
call RemoveUnit(FOE)
endif
endfunction
function GiveItemA takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=DHV(t,'u')
local integer id=DTV(t,'d')
local integer i=DTV(t,'i')
set cj=X8E(u,id,i)
if UnitItemInSlot(u,i)!=cj then
call RemoveItem(cj)
else
call SetItemPlayer(cj,GetOwningPlayer(u),false)
call SetItemUserData(cj,1)
call FIV()
endif
set t=null
set u=null
endfunction
function FNE takes unit u returns boolean
return IsUnitPaused(u)==false and IsUnitIllusion(u)==false and IsUnitType(u,UNIT_TYPE_POLYMORPHED)==false
endfunction
function FBE takes unit K8V returns nothing
local integer i=0
local item FCE
local integer DRE
local boolean FDE=false
local integer l=GetPlayerId(GetOwningPlayer(K8V))
if nW[GetPlayerId(GetOwningPlayer(K8V))]+3>(TimerGetElapsed(D))then
set FDE=true
endif
loop
exitwhen i>5
set FCE=UnitItemInSlot(K8V,i)
set DRE=CWV(FCE)
if DRE==aC and FDE then
call DisableTrigger(rH)
set nL=GetItemPlayer(FCE)
call RemoveItem(FCE)
set cj=X8E(K8V,Ac[nC],i)
call SetItemPlayer(cj,nL,false)
call SetItemUserData(cj,1)
set OU[$A+l*7+i]=cj
set OS[l*7+i]=Ac[nC]
call EnableTrigger(rH)
endif
if DRE==nC and FDE==false then
call DisableTrigger(rH)
set nL=GetItemPlayer(FCE)
call RemoveItem(FCE)
set cj=X8E(K8V,Ac[aC],i)
call SetItemPlayer(cj,nL,false)
call SetItemUserData(cj,1)
set OU[$A+l*7+i]=cj
set OS[l*7+i]=Ac[aC]
call EnableTrigger(rH)
endif
set i=i+1
endloop
set K8V=null
set FCE=null
endfunction
function FFE takes unit K8V returns nothing
