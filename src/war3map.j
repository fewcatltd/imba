function A6R takes integer DRE returns boolean
return DRE==jD or DRE==cF or DRE==CF or DRE==fF or DRE==HD or DRE==bF or DRE==BF or DRE==NSV
endfunction
function A7R takes unit K8V,item OVE returns boolean
local item Z4=OVE
local integer DRE=CWV(Z4)
local integer A8R=0
local boolean D7E=false
if IsUnitType(K8V,UNIT_TYPE_HERO) then
if DRE==jD then
set A8R=HD
endif
if DRE==cF then
set A8R=bF
endif
if DRE==CF then
set A8R=BF
endif
if DRE==fF then
set A8R=NSV
endif
if A8R!=0 then
set nL=GetItemPlayer(Z4)
call CTV(Z4)
set cj=UnitAddItemById(K8V,Ac[A8R])
call SetItemPlayer(cj,nL,false)
call SetItemUserData(cj,1)
set D7E=true
endif
else
if DRE==HD then
set A8R=jD
endif
if DRE==bF then
set A8R=cF
endif
if DRE==BF then
set A8R=CF
endif
if DRE==NSV then
set A8R=fF
endif
if A8R!=0 then
set nL=GetItemPlayer(Z4)
call CTV(Z4)
set cj=UnitAddItemById(K8V,Ac[A8R])
call SetItemPlayer(cj,nL,false)
call SetItemUserData(cj,1)
set D7E=true
endif
endif
set Z4=null
return D7E
endfunction
function A9R takes unit K8V,item OVE returns boolean
if A6R(CWV(OVE))then
return A7R(K8V,OVE)
endif
return false
endfunction
function NVR takes unit NER,integer NXR returns integer
local integer i
if NXR==1 then
if GetUnitAbilityLevel(NER,'A500')>0 then
return 500
endif
set i=St
loop
exitwhen i>Wt
if GetUnitAbilityLevel(NER,PH[i])>0 then
return i
endif
set i=i+1
endloop
return 0
elseif NXR==2 then
if GetUnitAbilityLevel(NER,'A501')>0 then
return 500
endif
set i=St
loop
exitwhen i>Wt
if GetUnitAbilityLevel(NER,qH[i])>0 then
return i
endif
set i=i+1
endloop
return 0
elseif NXR==3 then
if GetUnitAbilityLevel(NER,'A502')>0 then
return 500
endif
set i=St
loop
exitwhen i>Wt
if GetUnitAbilityLevel(NER,QH[i])>0 then
return i
endif
set i=i+1
endloop
return 0
elseif NXR==4 then
if GetUnitAbilityLevel(NER,'A503')>0 then
return 500
endif
set i=St
loop
exitwhen i>Wt
if GetUnitAbilityLevel(NER,sH[i])>0 or GetUnitAbilityLevel(NER,uH[i])>0 then
return i
endif
set i=i+1
endloop
return 0
endif
return 0
endfunction
function NOR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit NRR=Y7(K3V,"Unit")
local integer NIR=E8(K3V,"EventType")
local integer NAR=E8(K3V,"indexId")
local boolean NNR=O8(K3V,"Temporary")
