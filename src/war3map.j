function FKR takes real s,real FLR,real FMR,real FPR returns boolean
return s<=FLR and s<=FMR and s<=FPR
endfunction
function FQR takes unit u,real x,real y,real d returns real
local real x2=GetUnitX(u)
local real y2=GetUnitY(u)
local real FSR=v6(x-d,y,x2,y2)
local real FTR=v6(x+d,y,x2,y2)
local real FUR=v6(x,y+d,x2,y2)
local real FWR=v6(x,y-d,x2,y2)
if FKR(FSR,FTR,FWR,FUR)then
return 180.
elseif FKR(FTR,FSR,FWR,FUR)then
return .0
elseif FKR(FWR,FTR,FSR,FUR)then
return 270.
endif
return 90.
endfunction
function FYR takes real s,real FLR,real FMR,real FPR,real FZR,real F_R,real F0R,real F1R returns boolean
return s<=FLR and s<=FMR and s<=FPR and s<=FZR and s<=F_R and s<=F0R and s<=F1R
endfunction
function F2R takes unit u,integer K3V returns unit
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local unit F3R=Y7(K3V,"Cog1")
local unit F4R=Y7(K3V,"Cog2")
local unit F5R=Y7(K3V,"Cog3")
local unit F6R=Y7(K3V,"Cog4")
local unit F7R=Y7(K3V,"Cog5")
local unit F8R=Y7(K3V,"Cog6")
local unit F9R=Y7(K3V,"Cog7")
local unit GVR=Y7(K3V,"Cog8")
local real FLR=v6(x1,y1,GetUnitX(F3R),GetUnitY(F3R))
local real FMR=v6(x1,y1,GetUnitX(F4R),GetUnitY(F4R))
local real FPR=v6(x1,y1,GetUnitX(F5R),GetUnitY(F5R))
local real FZR=v6(x1,y1,GetUnitX(F6R),GetUnitY(F6R))
local real F_R=v6(x1,y1,GetUnitX(F7R),GetUnitY(F7R))
local real F0R=v6(x1,y1,GetUnitX(F8R),GetUnitY(F8R))
local real F1R=v6(x1,y1,GetUnitX(F9R),GetUnitY(F9R))
local real GER=v6(x1,y1,GetUnitX(GVR),GetUnitY(GVR))
if FYR(FLR,FMR,FPR,FZR,F_R,F0R,F1R,GER)then
return F3R
elseif FYR(FMR,FLR,FPR,FZR,F_R,F0R,F1R,GER)then
return F4R
elseif FYR(FPR,FMR,FLR,FZR,F_R,F0R,F1R,GER)then
return F5R
elseif FYR(FZR,FMR,FPR,FLR,F_R,F0R,F1R,GER)then
return F6R
elseif FYR(F_R,FMR,FPR,FZR,FLR,F0R,F1R,GER)then
return F7R
elseif FYR(F0R,FMR,FPR,FZR,F_R,FLR,F1R,GER)then
return F8R
elseif FYR(F1R,FMR,FPR,FZR,F_R,F0R,FLR,GER)then
return F9R
elseif FYR(GER,FMR,FPR,FZR,F_R,F0R,F1R,FLR)then
return GVR
endif
call CAV("WTF????")
return null
endfunction
function GXR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit m5=Y7(K3V,"Target")
local real GOR=X8(K3V,"Angle")
local real x=GetUnitX(m5)
local real y=GetUnitY(m5)
local real ESR=$C
local unit p5=Y7(K3V,"Source")
local integer JFV=E8(K3V,"Level")
local integer GRR=40+$F*JFV
if GetTriggerEvalCount(t)>21 then
call a7(K3V)
call KJV(t)
call K_V(m5,"PowerCogShocked")
call HPV(p5,m5,1,I2R(GRR))
call SetUnitState(m5,UNIT_STATE_MANA,MXV(GetUnitState(m5,UNIT_STATE_MANA)-GRR,0))
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBoltImpact.mdl",x,y))
call MMV(x,y,$96)
call SetUnitPosition(m5,x+ESR*Cos(GOR*bj_DEGTORAD),y+ESR*Sin(GOR*bj_DEGTORAD))
endif
set t=null
set m5=null
return false
endfunction
function GIR takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit m5=GetEnumUnit()
local real x=wl
local real y=Wl
local real d=zl
local real GOR=FQR(m5,x,y,d)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBoltImpact.mdl",m5,"chest"))
call KYV(m5,"PowerCogShocked")
call A7(K3V,"Target",m5)
call E7(K3V,"Angle",GOR)
call n7(K3V,"Level",Sl)
call A7(K3V,"Source",xL)
call TriggerRegisterTimerEvent(t,.04,true)
call TriggerAddCondition(t,Condition(function GXR))
set t=null
set m5=null
endfunction
function GAR takes unit u,integer K3V returns boolean
local unit GNR=F2R(u,K3V)
