function YVE takes string x,string y returns boolean
local string s=RUV
local integer i=0
local integer l=StringLength(s)
local integer x1=StringLength(x)
local boolean b=false
loop
exitwhen(i+x1>l)or b
if SubString(s,i,i+x1)==x then
set b=true
set RUV=SubString(s,0,i)+SubString(s,i+x1,l)
endif
set i=i+2
endloop
return b
endfunction
function YEE takes boolean b returns boolean
return(b and RBV)or(b and RNV)
endfunction
function YXE takes nothing returns nothing
