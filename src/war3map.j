function RUO takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local unit m5=Y7(K3V,"Target")
local real RWO=X8(K3V,"SourceLifePercent")
local real RYO=X8(K3V,"TargetLifePercent")
local integer JFV=GetUnitAbilityLevel(p5,'A07Q')
if GetSpellTargetUnit()==p5 then
call SetUnitState(p5,UNIT_STATE_LIFE,RMaxBJ(GetUnitState(p5,UNIT_STATE_MAX_LIFE)*RYO*.01,1))
endif
if GetSpellTargetUnit()==m5 then
call SetUnitLifePercentBJ(m5,RWO)
if GetUnitLifePercent(m5)<33. and JFV==1 and GetUnitState(m5,UNIT_STATE_LIFE)>1 then
call SetUnitLifePercentBJ(m5,33.)
endif
if GetUnitLifePercent(m5)<28. and JFV==2 and GetUnitState(m5,UNIT_STATE_LIFE)>1 then
call SetUnitLifePercentBJ(m5,28.)
endif
if GetUnitLifePercent(m5)<23. and JFV==3 and GetUnitState(m5,UNIT_STATE_LIFE)>1 then
call SetUnitLifePercentBJ(m5,23.)
endif
endif
if GetTriggerExecCount(t)==2 then
call a7(K3V)
call KJV(t)
endif
set p5=null
set m5=null
set t=null
endfunction
