function NUR takes unit K8V,item OVE returns boolean
local boolean b=false
if GetItemTypeId(OVE)=='I007' or GetItemTypeId(OVE)=='I006' or GetItemTypeId(OVE)=='I008' or GetItemTypeId(OVE)=='I00K' or GetItemTypeId(OVE)=='I00J' then
call K3E(K8V,GetItemTypeId(OVE),false)
set b=true
endif
if GetItemTypeId(OVE)=='I007' then
call NTR(K8V,OVE)
elseif GetItemTypeId(OVE)=='I00J' then
if GetUnitAbilityLevel(K8V,'B09Y')>0 then
call UnitRemoveAbility(K8V,'B09Y')
call UnitRemoveAbility(K8V,'B01Q')
call DisableTrigger(GetTriggeringTrigger())
call UnitAddItemById(K8V,'I00J')
call EnableTrigger(GetTriggeringTrigger())
endif
endif
return b
