call SetUnitVertexColor(u,0,0,0,$9B)
call SetUnitScale(u,0.7,0.7,0.7)
call SetUnitMoveSpeed(u,1000)
call IssueTargetOrder(u,"move",s)
call UnitAddAbility(u,'Aloc') 
set u=GetDyingUnit()

endif
if GetUnitAbilityLevel(u,'A0MU')>=1 and IsUnitType(s,UNIT_TYPE_HERO) then
set DOOMLVL=GetUnitAbilityLevel(u,'A0MU')
set DOOMU=s
call PauseUnit(s,true)
call SetUnitInvulnerable(s,true)
set DOOME=AddSpecialEffectTarget("war3mapImported\\VoidDrown.mdx",s,"origin")
call TimerStart(CreateTimer(),1.5,false,function DOOMULTI)
endif
if IsUnitInRangeXY(lastwordu,GetUnitX(u),GetUnitY(u),900) and IsUnitEnemy(u,GetOwningPlayer(lastwordu)) and IsUnitType(u,UNIT_TYPE_HERO) then    //silencer int steal
set sint1=(GetHeroInt(u,false)*0.07)
set nint1=R2I(sint1)
call SetHeroInt(lastwordu,GetHeroInt(lastwordu,false)+nint1,true)
call SetHeroInt(u,GetHeroInt(u,false)-nint1,true)
endif
endfunction
function VBI takes nothing returns nothing

local unit s=GetKillingUnit()
local unit u=GetDyingUnit()
local unit p=ie[GetPlayerId(GetOwningPlayer(s))]
local integer i=0
local unit n=null
local integer l=0
local integer k=0
local timer tm=null
local trigger t=null
local group g=null
local boolexpr b=null
local unit f=null
local item VCI=null
local real r=0
local real x=0
local real y=0
if GetUnitAbilityLevel(u,'A024')>0 then
set magnusfix=true
endif

if GetUnitTypeId(u)=='h03Y'or GetUnitTypeId(u)=='e00E'then
return
endif
if H7V(GetOwningPlayer(u))then
call CKE()
endif
if IsUnitOwnedByPlayer(u,A9V)then
if CCE()then
call CGE()
endif
endif
if IsUnitOwnedByPlayer(u,A7V[0])or IsUnitOwnedByPlayer(u,A8V[0])then
call CYE()
endif
if IsUnitOwnedByPlayer(u,A7V[0])or IsUnitOwnedByPlayer(u,A8V[0])or IsUnitOwnedByPlayer(u,A9V)then
call O0E()
endif
if s==null then
set s=u
endif
call ZVX()
if GetUnitTypeId(u)=='e00T'then
set i=GetUnitAbilityLevel(HMV(u),'A027')
if i>0 then
set AUV=u
set g=KHV()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),$E1+24,b)
set l=30+60*i
if i>3 then
set l=l+$A
endif
loop
set n=FirstOfGroup(g)
exitwhen n==null
call QDV(n,1.6,false)
call HPV(HMV(u),n,1,l)
call GroupRemoveUnit(g,n)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
endif
if GetUnitAbilityLevel(u,'Aloc')==0 and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and IsUnitIllusion(u)==false and H6 then
set g=KHV()
set b=Condition(function VAI)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),625,b)
call GroupAddUnit(g,s)
loop
set f=FirstOfGroup(g)
exitwhen f==null
set i=GetUnitAbilityLevel(f,'A0I8')
if i>0 then
if IsUnitType(u,UNIT_TYPE_HERO)then
set r=.1*i*GetUnitState(u,UNIT_STATE_MAX_LIFE)
else
set r=(.05+.05*i)*GetUnitState(u,UNIT_STATE_MAX_LIFE)
endif
if f!=s then
set r=r*.5
endif
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HeroBloodElfBlood.mdl",f,"overhead"))
call HGV(f,true,r)
endif
call GroupRemoveUnit(g,f)
endloop
call DestroyBoolExpr(b)
call KGV(g)
set g=null
set b=null
endif
if AKV!=null and IsUnitType(u,UNIT_TYPE_HERO)then
call DUV(AKV,GetPlayerId(GetOwningPlayer(u)),0)
endif
if IJV and IsUnitOwnedByPlayer(u,Player($C))and GetUnitAbilityLevel(u,'Aloc')==0 and GetUnitTypeId(u)!='e00E' and GUV(u)==false and IsUnitAlly(s,GetOwningPlayer(u))==false and(((EZV>ITV and IsUnitAlly(s,A7V[0]))or(E_V>ITV and IsUnitAlly(s,A8V[0])))==false)then
set tm=CreateTimer()
call TimerStart(tm,0,false,function VNI)
call DFV(tm,'s',s)
call DPV(tm,'l',GetUnitLevel(u))
set tm=null
endif
if L5 then
if IsUnitAlly(s,GetOwningPlayer(u))==false and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(u,'Aloc')==0 and IsUnitIllusion(u)==false then
set g=KHV()
set b=Condition(function XZE)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),$4B0+24,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
set i=GetUnitAbilityLevel(f,'A1NA')
if i>0 then
set tm=CreateTimer()
call TimerStart(tm,.3,true,function X_E)
call DQV(f,'A1NA',1)
call DFV(tm,'s',f)
call DUV(tm,'t',ITV+30)
call HGV(f,true,$A*i)
set i=4+2*i
call G6V(f,i)
call DPV(tm,'i',i)
set tm=null
endif
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
endif
set i=GetUnitTypeId(u)
if i=='nfoh' or i=='ndfl' then
call KDV(GetOwningPlayer(s),'CJ05')
endif
if(s==Q)and IsUnitType(u,UNIT_TYPE_HERO)then
call KDV(GetOwningPlayer(u),'CJ17')
endif
set i=GetUnitAbilityLevel(HMV(s),'A0IF')
if IsUnitType(u,UNIT_TYPE_HERO)and IsUnitIllusion(u)==false and i>0 and IsUnitAlly(u,GetOwningPlayer(s))==false and GetUnitAbilityLevel(u,'Aloc')==0 then
set i=R2I(B8V(u,false)*(.05+.05*i))
call FPX(s,2,0,i)
call FPX(u,2,1,i)
endif
set i=GetUnitAbilityLevel(s,'A0LE')
if i>0 and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and IsUnitAlly(s,GetOwningPlayer(u))==false then
set AUV=s
set g=CreateGroup()
set b=Condition(function PJV)
set x=GetUnitX(u)
set y=GetUnitY(u)
set r=bj_PI/6.
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodFootman.mdl",x,y))
loop
exitwhen r>2*bj_PI
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodFootman.mdl",x+Cos(r)*74,y+Sin(r)*74))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodFootman.mdl",x+Cos(r)*'|',y+Sin(r)*'|'))
set r=r+bj_PI/6.
endloop
call GroupEnumUnitsInRange(g,x,y,425,b)
set n=CreateUnit(GetOwningPlayer(s),'e00E',x,y,0)
call UnitAddAbility(n,'AA8Y')
call SetUnitAbilityLevel(n,'AA8Y',i)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call IssueTargetOrderById(n,$D006B,f)
call HPV(s,f,2,GetUnitState(u,UNIT_STATE_MAX_LIFE)*.1*i)
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
if u==Q then
set i=GetPlayerId(GetOwningPlayer(s))
set RXV[i]=RXV[i]+1
set i=RXV[i]
if i==1 then
call KDV(GetOwningPlayer(s),'CJ14')
elseif i==2 then
call KDV(GetOwningPlayer(s),'CJ15')
else
call KDV(GetOwningPlayer(s),'CJ16')
endif
endif
set i=GetUnitAbilityLevel(u,'A06B')
if i>0 and GetUnitAbilityLevel(u,'Aloc')==0 then
if IVV then
call HRV(u,'A06B',i,"selfdestruct",GetUnitX(u),GetUnitY(u))
endif
endif
if GetOwningPlayer(u)==Player($C)and GetUnitAbilityLevel(u,'AA3B')>0 then
set k='I721'
if GetRandomInt(0,99)==2 then
set k='I722'
endif
set VCI=CreateItem(k,GetUnitX(u),GetUnitY(u))
call SetItemPlayer(VCI,GetOwningPlayer(s),true)
if k=='I721' then
call SetItemCharges(VCI,1)
endif
set VCI=null
endif
set i=GetPlayerId(GetOwningPlayer(s))
if IsUnitType(u,UNIT_TYPE_HERO)and IsUnitIllusion(u)==false and(Player(i)==A7V[0]or Player(i)==A8V[0]or i>$B)and GetUnitAbilityLevel(u,'Aloc')==0 then
call DQV(GetOwningPlayer(u),'CJ29',1)
if DTV(GetOwningPlayer(u),'CJ29')>4 then
call KDV(GetOwningPlayer(u),'CJ29')
endif
endif
set i=GetPlayerId(GetOwningPlayer(u))
if IsUnitType(u,UNIT_TYPE_STRUCTURE)and(i==0 or i==6)then
if IsUnitAlly(s,Player(i))==false then
if i==0 then
set O3V=O3V+1
else
set O2V=O2V+1
endif
if GetPlayerState(Player(0),PLAYER_STATE_RESOURCE_LUMBER)<2 then
if O3V>4 then
call KDV(Player(7),'CJ28')
call KDV(Player(8),'CJ28')
call KDV(Player(9),'CJ28')
call KDV(Player($A),'CJ28')
call KDV(Player($B),'CJ28')
endif
if O2V>4 then
call KDV(Player(1),'CJ28')
call KDV(Player(2),'CJ28')
call KDV(Player(3),'CJ28')
call KDV(Player(4),'CJ28')
call KDV(Player(5),'CJ28')
endif
endif
endif
endif
if IsUnitType(u,UNIT_TYPE_HERO)and IsUnitIllusion(u)==false and i>0 and i<$C and i!=6 and GetUnitAbilityLevel(u,'Aloc')==0 then
if(s==u or s==null)then
call KDV(Player(i),'CJ11')
elseif IsUnitAlly(s,GetTriggerPlayer())then
call KDV(GetOwningPlayer(s),'CJ13')
endif
if IsUnitAlly(s,GetTriggerPlayer())==false and IsUnitIllusion(s)==false and IsUnitIllusion(u)==false then
call VOI(HMV(s))
call VRI(u)
if IsUnitAlly(u,A7V[0])then
if EPV>ITV then
set ESV=ESV+1
else
set ESV=1
endif
set EPV=ITV+8
if ESV>4 then
call StartSound(VXV)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F," ")
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F,GetObjectName('CM0H'))
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F," ")
endif
else
if EQV>ITV then
set ETV=ETV+1
else
set ETV=1
endif
set EQV=ITV+8
if ETV>4 then
call StartSound(VXV)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F," ")
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F,GetObjectName('CM0I'))
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F," ")
endif
endif
endif
endif
set i=GetPlayerId(GetOwningPlayer(u))
if IsUnitType(u,UNIT_TYPE_HERO)and IsUnitIllusion(u)==false and i>0 and i<$C and i!=6 and GetUnitAbilityLevel(u,'Aloc')==0 and IsUnitAlly(s,GetTriggerPlayer())==false then
if IsUnitInRange(s,u,$5DC)==false then
call KDV(GetOwningPlayer(s),'CJ20')
endif
if IsUnitVisible(s,GetOwningPlayer(u))==false then
call KDV(GetOwningPlayer(s),'CJ21')
endif
set l=GetPlayerId(GetOwningPlayer(s))
if RYV[l]>9 then
call KDV(GetOwningPlayer(s),'CJ22')
endif
if A4V[i]>9 then
call KDV(GetOwningPlayer(u),'CJ23')
endif
set RYV[l]=0
set RYV[i]=RYV[i]+1
set A4V[i]=0
set A4V[l]=A4V[l]+1
call DQV(Player(i),'DEAD',1)
call DQV(Player(l),'KILL',1)
set tm=CreateTimer()
call DPV(tm,'p',i)
call DPV(tm,'i',RYV[i])
call DPV(tm,'l',GetPlayerId(GetOwningPlayer(s)))
call TimerStart(tm,1,false,function Z6R)
set tm=null
if ITV-DWV(s,'LtKT')<1 and GetUnitState(s,UNIT_STATE_MAX_LIFE)-GetWidgetLife(s)<1 then
call KDV(GetOwningPlayer(s),'CJ07')
endif
if A4V[l]>19 then
call KDV(Player(l),'CJ09')
endif
call DUV(s,'LtKT',ITV)
set i=GetUnitAbilityLevel(HMV(s),'A0O3')
if i>0 then
set i=IMaxBJ(i,4)
set l=R2I(GetPlayerState(GetOwningPlayer(u),PLAYER_STATE_RESOURCE_GOLD)*(.1+.05*i))
set l=IMinBJ(l,GetPlayerState(GetOwningPlayer(u),PLAYER_STATE_RESOURCE_GOLD)/3)
call SetPlayerState(GetOwningPlayer(u),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(u),PLAYER_STATE_RESOURCE_GOLD)-l)
call BIE(GetOwningPlayer(s),l,p)
endif
endif
set i=GetUnitAbilityLevel(HMV(s),'A0O3')
if i>0 and IsUnitIllusion(u)==false and IsUnitType(u,UNIT_TYPE_HERO)==false and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(u,'Aloc')==0 and IsUnitAlly(u,GetOwningPlayer(s))==false then
if(IsUnitOwnedByPlayer(u,Player($C))==false or((EZV>ITV and IsUnitAlly(s,A7V[0]))or(E_V>ITV and IsUnitAlly(s,A8V[0])))==false)then
set l=IMinBJ(DTV(HMV(s),'A0O3')+1,'d')
call DPV(HMV(s),'A0O3',l)
if IVV then
set l= (i*(GetUnitLevel(u)))+20  //alchem gold for greed
if EMV then
if l>55 then
set l=55
endif
endif
else
set l=DTV(HMV(s),'A0O3')
if l>18 then
set l=18
endif
endif
call BIE(GetOwningPlayer(s),l,HMV(s))
endif
endif
if IsUnitType(u,UNIT_TYPE_HERO)and IsUnitIllusion(u)==false and i>0 and i<$C and i!=6 and GetUnitAbilityLevel(u,'Aloc')==0 then
if i<6 then
set l=0
else
set l=6
endif
if DZV(Player(l),'AA47')then
set r=GetUnitState(u,UNIT_STATE_MAX_LIFE)*.25
set g=CreateGroup()
set b=Condition(function PGV)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),475,b)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",GetUnitX(u),GetUnitY(u)))
loop
set n=FirstOfGroup(g)
exitwhen n==null
call HPV(u,n,1,r)
call GroupRemoveUnit(g,n)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
endif
if R6V and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(u,'Aloc')==0 and IsUnitIllusion(u)==false then
set AUV=u
set g=CreateGroup()
set b=Condition(function Z9R)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),$4B0,b)
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
if IVV and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(u,'Aloc')==0 then
set g=CreateGroup()
set b=Condition(function PQV)
set AUV=u
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),$5DC,b)
loop
set n=FirstOfGroup(g)
exitwhen n==null
if C7V(n,'I00M')>0 and IsUnitIllusion(n)==false then
call GYV('hkni',n,u,n,875,"Z8R",C0V(IsUnitType(u,UNIT_TYPE_HERO)),0)
endif
call GroupRemoveUnit(g,n)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
if GetUnitAbilityLevel(p,'A0BR')>0 and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false then
set i=DTV(p,'AA18')
if IVV then
if GetUnitAbilityLevel(p,'A0BR')<4 then
if i+2<=GetUnitAbilityLevel(p,'A0BR')*30 then
set i=i+2
call G6V(p,2)
call DPV(p,'AA18',i)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\ZigguratMissile\\ZigguratMissile.mdl",GetUnitX(u),GetUnitY(u)))
endif
else
set i=i+2
call G6V(p,2)
call DPV(p,'AA18',i)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\ZigguratMissile\\ZigguratMissile.mdl",GetUnitX(u),GetUnitY(u)))
endif
else
if i+2<=GetUnitAbilityLevel(p,'A0BR')*16 then
set i=i+2
call G6V(p,2)
call DPV(p,'AA18',i)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\ZigguratMissile\\ZigguratMissile.mdl",GetUnitX(u),GetUnitY(u)))
endif
endif
call HEV(p)
endif
if GetUnitAbilityLevel(u,'A0BR')>0 then
set i=DTV(u,'AA18')/2
call G6V(u,-i)
call DPV(u,'AA18',i)
call HEV(u)
endif
if IsUnitType(u,UNIT_TYPE_HERO)and GetUnitAbilityLevel(p,'A06D')>0 then
set tm=CreateTimer()
call TimerStart(tm,900,false,function VII)
set i=R2I(B6V(u,false)*.05*GetUnitAbilityLevel(p,'A06D'))
call SetHeroStr(u,B6V(u,false)-i,false)
call SetHeroStr(p,B6V(p,false)+i,false)
call FUV(u,"SAStr",F0V(u,"SAStr")-i)
call FUV(p,"SAStr",F0V(p,"SAStr")+i)
call DFV(tm,'s',p)
call DFV(tm,'u',u)
call DPV(tm,'i',i)
set tm=null
endif
set i=GetUnitAbilityLevel(s,'A0FA')
if DZV(s,'DmgA')and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false and i>0 then
call HBV("Abilities\\Spells\\Undead\\PlagueCloud\\PlagueCloudCaster.mdl",GetUnitX(u),GetUnitY(u),1.5)
call Q_V(s,GetUnitX(u),GetUnitY(u),400,50+40*i+$A*C0V(i==4),1)
if IsUnitType(u,UNIT_TYPE_HERO)==false then
call RemoveUnit(u)
endif
endif
if GetUnitAbilityLevel(u,'A0O3')>0 then
call DPV(u,'A0O3',0)
endif
if C7V(u,'I099')==6 then
set i=0
loop
exitwhen i>5
call RemoveItem(UnitItemInSlot(u,i))
set i=i+1
endloop
endif
set p=null
set s=null
set u=null
endfunction
function VDI takes nothing returns boolean
if IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) then
if GetUnitAbilityLevel(GetTriggerUnit(),'Aloc')>0 or GetPlayerId(GetTriggerPlayer())>$B then
return false
endif
if GetUnitTypeId(GetTriggerUnit())=='H00J' and NWE(GetTriggerUnit())then
return false
endif
return true
endif
return false
endfunction
function VFI takes integer i,integer id returns nothing
call DPV(AIV,$3E8+i,id)
endfunction
function VGI takes nothing returns nothing
call VFI(0,'A0JJ')
call VFI(1,'A0PL')
endfunction
function VHI takes nothing returns nothing
call H6V('I600',259)
call H6V('I0AY',$C8)
endfunction
function VJI takes integer x1,integer x2,integer x3,integer x4,integer y1,integer y2,integer y3,integer y4,integer x returns boolean
local integer id=GetItemTypeId(GetManipulatedItem())
local unit u=GetTriggerUnit()
local item l=null
local integer t1=0
local integer t2=0
local integer t3=0
local integer t=0
local integer i=0
if id!=x1 and id!=x2 and id!=x3 and id!=x4 then
set u=null
return false
endif
if id==x1 then
if x1!=0 then
set t1=t1+1
endif
elseif id==x2 then
if x2!=0 then
set t2=t2+1
endif
elseif id==x3 then
if x3!=0 then
set t3=t3+1
endif
elseif id==x4 then
if x4!=0 then
set t=t+1
endif
endif
loop
exitwhen i>5
set id=GetItemTypeId(UnitItemInSlot(u,i))
if UnitItemInSlot(u,i)!=GetManipulatedItem()then
if id==x1 then
if x1!=0 then
set t1=t1+1
endif
elseif id==x2 then
if x2!=0 then
set t2=t2+1
endif
elseif id==x3 then
if x3!=0 then
set t3=t3+1
endif
elseif id==x4 then
if x4!=0 then
set t=t+1
endif
endif
endif
set i=i+1
endloop
if t1>=y1 and t2>=y2 and t3>=y3 and t>=y4 then
set i=0
set t1=y1
set t2=y2
set t3=y3
set t=y4
loop
exitwhen i>5
set l=UnitItemInSlot(u,i)
set id=GetItemTypeId(l)
if id==x1 then
if x1>0 and t1>0 then
set t1=t1-1
call UnitRemoveItem(u,l)
call RemoveItem(l)
endif
elseif id==x2 then
if x2>0 and t2>0 then
set t2=t2-1
call UnitRemoveItem(u,l)
call RemoveItem(l)
endif
elseif id==x3 then
if x3>0 and t3>0 then
set t3=t3-1
call UnitRemoveItem(u,l)
call RemoveItem(l)
endif
elseif id==x4 then
if x4>0 and t>0 then
set t=t-1
call UnitRemoveItem(u,l)
call RemoveItem(l)
endif
endif
set i=i+1
endloop
set l=CreateItem(x,-$3E80,-$3E80)
call SetItemPlayer(l,GetOwningPlayer(u),true)
call UnitAddItem(u,l)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl",u,"origin"))
set l=null
set u=null
return true
endif
set u=null
return false
endfunction
function Fun_Item_PickUp takes nothing returns nothing
if IVV==false then
call GDV()
return
endif
if VJI('I050','I054','I04L',0,1,1,1,0,'I600')then
return
endif
if VJI('I045',0,0,0,3,0,0,0,'I603')then
return
endif
if VJI('I0KW','I04C','I042',0,1,2,1,0,'I0KY')then
return
endif
if VJI('I0KV','I04C','I03W',0,1,2,1,0,'I0KY')then
return
endif
if VJI('I0KV','I04C','I042','I038',1,1,1,1,'I0KY')then
return
endif
if VJI('I0KV','I04C','I042',0,1,2,1,0,'I0KY')then
return
endif
endfunction
