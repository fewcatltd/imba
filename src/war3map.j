function PFX takes unit u,real wP,real wq,real wQ,real wr,real wR returns boolean
local real ws=wQ-wP
local real wS=wr-wq
local real wt=GetUnitX(u)-wP
local real wT=GetUnitY(u)-wq
return wR>=RAbsBJ(ws*wT-wS*wt)/ RAbsBJ(Pow(Pow(ws,2)+Pow(wS,2),.5))
endfunction
function PGX takes unit p5,unit m5,real HSV,real wU,real wv returns nothing
local real wV=$A0*4
local real ww=$BE/ 2
local unit wW
local real dx
local real dy
local real wx
local real x
local real y
local group g=KHV()
local boolean wX
local boolean wy
set dx=GetUnitX(m5)-GetUnitX(p5)
set dy=GetUnitY(m5)-GetUnitY(p5)
set wx=Pow(Pow(dx,2)+Pow(dy,2),.5)
set x=GetUnitX(m5)+(wV/ 2)*(dx/ wx)
set y=GetUnitY(m5)+(wV/ 2)*(dy/ wx)
set xL=p5
set wl=HSV
call GroupEnumUnitsInRange(g,x,y,Pow(Pow(wV/ 2,2)+Pow(ww/ 2,2),.5)*(1+C0V(H3V(p5))),Condition(function P0V))
call GroupRemoveUnit(g,m5)
set wW=FirstOfGroup(g)
loop
exitwhen wW==null
set wX=PFX(wW,GetUnitX(p5),GetUnitY(p5),GetUnitX(m5),GetUnitY(m5),ww/ 2)
set wy=PFX(wW,x,y,x-'d',y+'d'*x*Pow(y,-1),.01+wV/ 2)
if wX and wy then
call HPV(p5,wW,3,HSV)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\PriestMissile\\PriestMissile.mdl",wW,"chest"))
endif
call GroupRemoveUnit(g,wW)
set wW=FirstOfGroup(g)
endloop
call KGV(g)
set wW=null
set g=null
endfunction
function PHX takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit m5=Y7(K3V,"Target")
local unit p5=Y7(K3V,"Source")
local group g=null
local boolexpr b=null
local unit f=null
local group g1=null
local real a=HYV(p5,m5)
local real x=GetUnitX(m5)+Cos(a)*'d'
local real y=GetUnitY(m5)+Sin(a)*'d'
local integer i=2*GetUnitAbilityLevel(p5,'A0RO')
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamageSource()==p5 and GetEventDamage()>1 then
call DisableTrigger(t)
if H3V(p5)then
set g=CreateGroup()
set g1=CreateGroup()
set b=Condition(function PJV)
set AUV=p5
loop
exitwhen i<1
call GroupEnumUnitsInRange(g1,x,y,'d',b)
call GroupAddGroup(g1,g)
call GroupClear(g1)
set x=x+Cos(a)*'d'
set y=y+Sin(a)*'d'
set i=i-1
endloop
call DestroyGroup(g1)
call DestroyBoolExpr(b)
call GroupRemoveUnit(g,m5)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call HPV(p5,f,3,GetEventDamage())
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\PriestMissile\\PriestMissile.mdl",f,"chest"))
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
set g=null
set g1=null
set b=null
else
call PGX(p5,m5,GetEventDamage(),X8(K3V,"InitX"),X8(K3V,"InitY"))
endif
call a7(K3V)
call KJV(t)
endif
else
call a7(K3V)
call KJV(t)
endif
set t=null
set p5=null
set m5=null
return false
endfunction
