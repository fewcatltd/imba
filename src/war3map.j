function XBO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local real XIO=X8(K3V,"damage")
local real Hk=X8(K3V,"duration")
local real x1=X8(K3V,"x1")
local real y1=X8(K3V,"y1")
local real x2=X8(K3V,"x2")
local real y2=X8(K3V,"y2")
local real w=X8(K3V,"w")
local real a=Atan2(y2-y1,x2-x1)
local group g=o8(K3V,"g")
local group XCO=KHV()
local real XAO=RN*.0625
local real XDO=X8(K3V,"LastFX_x")
local real XFO=X8(K3V,"LastFX_y")
local real XGO=X8(K3V,"FX_Interval")
local real XHO=X8(K3V,"airtime")
if XAO>v6(x1,y1,x2,y2)then
set x1=x2
set y1=y2
else
set x1=x1+XAO*Cos(a)
set y1=y1+XAO*Sin(a)
endif
set xL=p5
set wl=XIO
set Wl=Hk
set zl=XHO
set rL=g
set X8V=D4V(t,'s')
call GroupEnumUnitsInRange(XCO,x1,y1,w,Condition(function P0V))
call ForGroup(XCO,function XNO)
set X8V=null
call KGV(XCO)
if v6(x1,y1,XDO,XFO)>=XGO then
call E7(K3V,"LastFX_x",x1)
call E7(K3V,"LastFX_y",y1)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl",x1,y1))
endif
call E7(K3V,"x1",x1)
call E7(K3V,"y1",y1)
if x1==x2 and y1==y2 then
if O8(K3V,"destroyGroup") then
call KGV(g)
endif
call a7(K3V)
call KJV(t)
endif
set g=null
set XCO=null
set p5=null
set t=null
return false
endfunction
function XJO takes real XKO,real XLO returns integer
if XKO/ XLO-R2I(XKO/ XLO)>=.5 then
return R2I(XKO/ XLO)+1
endif
return R2I(XKO/ XLO)
endfunction
function XMO takes unit p5,unit m5,real XIO,real Hk,real XHO,real x1,real y1,real x2,real y2,real w,group XPO,boolean XQO returns nothing
