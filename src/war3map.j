function R_X takes real R0X returns string
if R0X>4.5 then
return"5.0"
elseif R0X>4. then
return"4.5"
elseif R0X>3.5 then
return"4.0"
elseif R0X>3. then
return"3.5"
elseif R0X>2.5 then
return"3.0"
elseif R0X>2. then
return"2.5"
elseif R0X>1.5 then
return"2.0"
elseif R0X>1. then
return"1.5"
elseif R0X>.5 then
return"1.0"
elseif R0X>.0 then
return"0.5"
else
return"0.0"
endif
return" "
endfunction
function R1X takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local real RTX=X8(K3V,"OriginalTime")
local real SAV=(TimerGetElapsed(D))
local real R2X=5.-(SAV-RTX)
local real RIE=MEV(SAV-RTX,5.)
local integer R3X=E8(K3V,"Count")+1
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1NI',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1NH',false)
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF)
call a7(K3V)
call KJV(t)
elseif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT then
if GetSpellAbilityId()=='A1NH' then
if(GetUnitAbilityLevel((GetSpellTargetUnit()),'B0BI')>0)==false then
call BJDebugMsg("2")
call RUX(p5,GetSpellTargetUnit(),RIE,RTX)
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1NI',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1NH',false)
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF)
call a7(K3V)
call KJV(t)
endif
else
call SaveInteger(le,(K3V),StringHash("Count"),(R3X))
if R2X>=0 then
call RWX(R_X(R2X),p5,p5)
if ModuloInteger(R3X,2)==0 then
call SetUnitVertexColor(p5,$FF,'}','}',$FF)
else
call SetUnitVertexColor(p5,$FF,$AF,$AF,$FF)
endif
else
call SetUnitVertexColor(p5,$FF,0,0,$FF)
endif
if SAV-RTX>(5.+2.)then
call RMX(p5,p5,5.)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1NI',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1NH',false)
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF)
call a7(K3V)
call KJV(t)
endif
endif
set t=null
set p5=null
return false
endfunction
