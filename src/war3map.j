call UnitAddAbility(u,'ACrk')
call UnitAddAbility(u,'A03P')
call SetUnitAbilityLevel(u,'A03P',4)
call UnitAddAbility(u,'A0KY')
call SetUnitAbilityLevel(u,'A0KY',4)
call DYV(u,'eLit',true)
call HEV(u)
endif
call DestroyGroup(g)
call DestroyBoolExpr(b)
