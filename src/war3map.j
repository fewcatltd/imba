call A7(K3V,"Target",m5)
call n7(K3V,"Level",JFV)
call TriggerRegisterTimerEvent(t,.01,true)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function RMO))
call UnitAddAbility(p5,'A179')
set t=null
set p5=null
set m5=null
