local integer Ys=GetUnitAbilityLevel(JO,'A0NR')
call YM(Jo,JO)
call Ym(Jo,JO,'A0N8',YN,Yq)
call Ym(Jo,JO,'A0NB',Yo,YQ)
call Ym(Jo,JO,'A0N7',YO,Yr)
call Ym(Jo,JO,'A0MW',Yp,YR)
call Ym(Jo,JO,'A0NR',YP,Ys)
