set y=y+1
endloop
if i==0 then
return
endif
if x>$3FFF then
set x=$3FFF
elseif x<-$3FFF then
set x=-$3FFF
endif
if i<0 then
set x=-i
set n=20
endif
set y=0
loop
exitwhen x<1 or y>$D
if x-x/2*2==1 then
call UnitAddAbility(u,A0V[y+n])
call UnitMakeAbilityPermanent(u,true,A0V[y+n])
else
call UnitRemoveAbility(u,A0V[y+n])
endif
set x=x/2
set y=y+1
endloop
endfunction
