function J1X takes nothing returns nothing
local unit p5=GetAttacker()
local unit m5=GetTriggerUnit()
local integer JFV=GetUnitAbilityLevel(p5,'A0DZ')
local boolean J2X=O8(GetHandleId(p5),"Backstab|Free")
local real d=RAbsBJ(GetUnitFacing(m5)-GetUnitFacing(p5))
local trigger t=null
local integer rikifix=3
local integer rikifixb=GetUnitAbilityLevel(p5,'A0DZ')
local integer rikifixa=6
if d>$B4 then
set d=360-d
endif
if d<='i' or J2X then
call O7(GetHandleId(p5),"Backstab|Free",false)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",m5,"chest"))
call HPV(p5,m5,2,B7V(p5,true)*.25*JFV)
if IVV then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
if IsUnitType(m5,UNIT_TYPE_HERO)then
call TriggerRegisterTimerEvent(t,20,false)
if GetUnitTypeId(p5)=='HC92' or GetUnitTypeId(m5)=='HC92' and GetUnitAbilityLevel(p5,'A0DZ')==1 then
set JFV=1
set rikifixb=3
set rikifix=1
set rikifixa=1
endif
if GetUnitTypeId(p5)=='HC92' or GetUnitTypeId(m5)=='HC92' and GetUnitAbilityLevel(p5,'A0DZ')==2 then
set JFV=3
set rikifixb=6
set rikifix=1 
set rikifixa=1   //riki backstab fix 
endif
if GetUnitTypeId(p5)=='HC92' or GetUnitTypeId(m5)=='HC92' and GetUnitAbilityLevel(p5,'A0DZ')==3 then
set JFV=4
set rikifixb=9
set rikifix=1
set rikifixa=1    //riki backstab fix 
endif
if GetUnitTypeId(p5)=='HC92' or GetUnitTypeId(m5)=='HC92' and GetUnitAbilityLevel(p5,'A0DZ')==4 then
set JFV=6
set rikifixb=12
set rikifix=1
set rikifixa=1   //riki backstab fix 
endif
call G3V(p5,rikifixb*rikifixa)
call DPV(t,'!agi',rikifixb*rikifixa)
call DPV(t,'!atk',0)
else
call TriggerRegisterTimerEvent(t,$F,false)
call G6V(p5,JFV*6)
call DPV(t,'!atk',JFV*6)
call DPV(t,'!agi',0)
endif
call TriggerAddCondition(t,Condition(function J0X))
call DFV(t,'u',p5)
call HEV(p5)
set t=null
endif
endif
set p5=null
set m5=null
endfunction
