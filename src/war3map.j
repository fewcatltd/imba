function YKR takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit HOV=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local integer id=GetSpellAbilityId()
local integer i=GetUnitAbilityLevel(u,id)
local integer n=0
local real d=SquareRoot((x-x1)*(x-x1)+(y-y1)*(y-y1))
local real a=Atan2(y1-y,x1-x)
local timer tm=null
local trigger t=null
local group g=null
local boolexpr b=null
local group g1=null
local real r=0
local unit f=null
local boolean b5=DZV(u,'skst')
local integer l=0
local boolean YLR=DZV(u,'link')
local string fx=null
local boolean hookdb=true 
local real fcing=GetUnitFacing(u)
local item ageis
local boolean hookulti=false   
if id=='A0QE' and GetUnitTypeId(GetTriggerUnit())!='e00E' then
set vacumx=x1
set vacumy=y1
set vacumlvl=GetUnitAbilityLevel(u,'A0QE')
set vacumunit=u
call TimerStart(CreateTimer(),0.8,false,function vacum1)
call TimerStart(CreateTimer(),1.5,false,function vacum2)
call TimerStart(CreateTimer(),2.3,false,function vacum3)
endif  
set ageis=UnitItemInSlot(u,5)
if IMBA131_Cond2(ageis,u) then
set hookulti=true
else
set hookulti=false
endif
if GetUnitTypeId(GetTriggerUnit())=='e00E'then
set hookdb=false
else 
set hookdb=true
endif

if GetUnitAbilityLevel(u,'A0QW')>0 and F5V(id)and DZV(u,'A0QW')==false then
call DYV(u,'A0QW',true)
set i=GetHandleId(u)
if IsUnitAlly(u,GetLocalPlayer())then
set fx="Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl"
else
set fx=""
endif
call b7(i,"OverloadFX1",AddSpecialEffectTarget(fx,u,"right hand"))
call b7(i,"OverloadFX2",AddSpecialEffectTarget(fx,u,"left hand"))
endif
if id=='AChx'or id=='A08U'or id=='A09H'or id=='A0MN'or id=='A0P5'or id=='A0PG'or id=='A0RX'or id=='AA86'then
call YJR(HOV,id,i)
endif
if GetUnitAbilityLevel(HOV,'A1E6')>0 and HOV!=null and IsUnitAlly(u,GetOwningPlayer(HOV))==false and GetUnitAbilityLevel(u,'Aloc')==0 and IsUnitIllusion(HOV)==false then
call EAO(HOV,HOV,u,GetUnitAbilityLevel(HOV,'A1E6'))
endif
set l=0
loop
exitwhen LoadStr(GB,id,l)=="" or LoadStr(GB,id,l)==null
call ExecuteFunc(LoadStr(GB,id,l))
set l=l+1
endloop
if id=='A900' then
call UQR(u,a,i)
elseif id=='Aprg'or id=='ACpu'or id=='AIpg'or id=='A02E'or id=='A02V'or id=='A0QH'or id=='A0QX'or id=='A18D'or id=='A1OU'or id=='AA6S'then
call DXE(HOV)
call CCV(HOV,IsUnitAlly(u,GetOwningPlayer(HOV))==false,IsUnitAlly(u,GetOwningPlayer(HOV)))
elseif(id=='A01P' or id=='A09Z' or id=='A095' or id=='A09W')then
call WFR(u,HOV,id,i,C3V(u,HOV)*.01*.03)
elseif id=='A02O'or id=='A08Y'or id=='A08Z'or id=='A090'or id=='A092'then
call W8R()
elseif id=='A1DP'then
call EWO()
elseif id=='A0HE'or id=='A1MP'then
call ZDX()
elseif id=='A1EA'then
call PBX()
elseif id=='A0I6'then
call SDX(u,i)
elseif id=='A0LH'then
call SSX()
elseif id=='A0J1'or id=='A1D7'then
call UXX()
elseif id=='A049'then
set AUV=u
set g=KHV()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,x1,y1,274,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call J6V(f,'AA8D','AA8D',.75+.75*i,0,0,0,0,0,0,0)
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
elseif id=='A1E7'then
call EOO()
elseif id=='A0EC'then
if HOV!=u then
if IsUnitAlly(HOV,GetOwningPlayer(u))==false then
set f=CreateUnit(GetOwningPlayer(u),'e00E',x1,y1,0)
call UnitAddAbility(f,'AA8X')
call SetUnitAbilityLevel(f,'AA8X',i)
call IssueTargetOrderById(f,$D02BC,HOV)
set f=null
else
call J6V(u,'AB95','B995',2+2*i,R2I((K9V(u)+Ld(u))*.2*i),0,0,0,0,0,0)
call J6V(HOV,'AB95','B995',2+2*i,R2I((K9V(HOV)+Ld(HOV))*.2*i),0,0,0,0,0,0)
endif
set r=GetUnitState(HOV,UNIT_STATE_MAX_LIFE)*.4
set r=RMinBJ(r,GetWidgetLife(u)-'d')
set r=RMaxBJ(r,0)
call HGV(u,true,r)
call HGV(HOV,true,-r)
set tm=CreateTimer()
call TimerStart(tm,1,true,function YFR)
call DFV(tm,'s',u)
call DFV(tm,'u',HOV)
call DPV(tm,'i',2+2*i)
call DPV(tm,'l',0)
call DUV(tm,'r',r)
set tm=null
else
call J6V(u,'AB95','B995',2+2*i,R2I((K9V(u)+Ld(u))*.2*i),0,0,0,0,0,0)
set r=GetWidgetLife(u)
call HGV(u,true,GetUnitState(u,UNIT_STATE_MAX_LIFE)*.4)
set r=GetWidgetLife(u)-r
set r=RMaxBJ(r,0)
set tm=CreateTimer()
call DFV(tm,'s',u)
call DPV(tm,'i',2+2*i)
call DPV(tm,'l',l)
call DUV(tm,'r',r)
call TimerStart(tm,1,true,function YGR)
set tm=null
endif
elseif id=='A04A'then
call FXO()
elseif id=='A07A'then
set tm=CreateTimer()
call TimerStart(tm,.1,true,function YBR)
call DFV(tm,'s',u)
call FHV(u,"A07A|Active",true)
set tm=null
elseif id=='A08C'then
call DPV(HOV,'A08C',i)
elseif id=='ANtm'then
call YVR()
elseif id=='A1NA'then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AntiMagicShell\\AntiMagicShell.mdl",u,"chest"))
call GYV('h0BE',u,u,HOV,$3E8,"YCR",DTV(u,'A1NA'),0)
call DYV(u,'a1NA',true)
set tm=CreateTimer()
call TimerStart(tm,.5,false,function YDR)
call DFV(tm,'s',u)
set tm=null
elseif id=='AA37' then    // new pit lord skills
call WIR(u,x1,y1,i)
elseif id=='AA38' then
call WNR(u,x1,y1,i)
elseif id=='AA0S' then
call WXR(u,HOV,a+bj_PI*.5,(i*2))
elseif id=='AA0O' then
call GYV('ohun',u,u,HOV,600,"WER",i,0)
elseif id=='AA3A' then
call WCR(u,x1,y1,i)
elseif id=='A07F'then
call HXV(u,'AA7V',i,"frostnova",HOV)
elseif id=='A05J'then
set f=CreateUnit(GetOwningPlayer(u),'n00O',x1,y1,0)
if GetLocalPlayer()==GetTriggerPlayer()then
call SelectUnit(f,true)
endif
call SetUnitAnimation(f,"birth")
call QueueUnitAnimation(f,"stand")
set t=CreateTrigger()
call TriggerRegisterUnitInRange(t,f,$C8,null)
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function YXR))
call DFV(t,'s',f)
set t=null
