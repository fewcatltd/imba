set JDO=S2I(SubString(VH,kg+1,StringLength(VH)))
set pl=i3(JDO)
if(ie[GetPlayerId(pl)]==null)then
set JDO=0
elseif(not A5(ie[GetPlayerId(pl)]))then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"|cffffcc00Target is dead|r
")
set JDO=0
set kg=0
elseif(not IsUnitVisible(ie[GetPlayerId(pl)],GetTriggerPlayer()))then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"|cffffcc00Target not visible|r
")
set JDO=0
set kg=0
else
set VH=SubString(VH,0,kg+1)
set m5=JWO(ie[GetPlayerId(pl)])
endif
else
set JDO=0
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"|cffffcc00Incomplete Parameters|r
")
endif
