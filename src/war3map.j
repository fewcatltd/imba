function ZEO takes player pl,integer O5 returns nothing
set hG[48+GetPlayerId(pl)]=GetRandomInt(0,1)
if(J or R0)then
set hG[48+GetPlayerId(pl)]=GetRandomInt(0,2)
endif
set hG[64+GetPlayerId(pl)]=GetRandomInt(0,2)
set hG[80+GetPlayerId(pl)]=GetRandomInt(0,2)
set NW[GetPlayerId(pl)]=false
call ForceRemovePlayer(Px,pl)
if(O5==0)then
elseif(GetAIDifficulty(pl)==AI_DIFFICULTY_NEWBIE)then
call SetPlayerStateBJ(pl,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD)+('d'/O5)+($A*(O5-1)))
elseif(GetAIDifficulty(pl)==AI_DIFFICULTY_NORMAL)then
call SetPlayerStateBJ(pl,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD)+(300/O5)+($A*(O5-1)))
else
call SetPlayerStateBJ(pl,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD)+(500/O5)+($A*(O5-1)))
endif
if(Sy)then
call SetPlayerStateBJ(pl,PLAYER_STATE_RESOURCE_GOLD,R2I(GetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD)*1.1))
endif
endfunction
function ZXO takes trigger t,boolean O6,boolean ZOO,boolean ZRO returns nothing
