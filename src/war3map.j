function RCO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local unit m5=Y7(K3V,"Target")
local unit QJV=Y7(K3V,"Caster")
local integer JFV=E8(K3V,"Level")
local integer R3X=GetTriggerEvalCount(t)
local integer X2O
local integer RDO=E8(K3V,"CasterAbility")
local real RFO
local real RGO
local real a=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER or GetTriggerEventId()==EVENT_UNIT_ISSUED_POINT_ORDER or GetTriggerEventId()==EVENT_UNIT_ISSUED_TARGET_ORDER then
if KUV(p5,"ChargeOfDarkness|Charging")==false then
if E8(K3V,"Count")==1 or GetTriggerEventId()==EVENT_UNIT_DEATH then
call DestroyEffect(r8(K3V,"FX1"))
call DestroyEffect(r8(K3V,"FX2"))
call DestroyEffect(r8(K3V,"FX3"))
call SetUnitTimeScale(p5,1)
call a7(K3V)
call KJV(t)
call RemoveUnit(QJV)
call UnitRemoveAbility(m5,'B01Y')
call UnitRemoveAbility(p5,'B01Z')
call UnitShareVision(m5,GetOwningPlayer(p5),false)
call SetUnitPathing(p5,true)
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF)
call UnitRemoveAbility(p5,'A179')
elseif E8(K3V,"Count")==0 then
call n7(K3V,"Count",1)
call DisableTrigger(t)
call IssueTargetOrderById(p5,$D000F,m5)
call EnableTrigger(t)
endif
endif
elseif GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST then
call K5V(p5,"ChargeOfDarkness|Charging",.01)
set RFO=X8(K3V,"OriginalTime")
set RGO=TimerGetElapsed(D)
if E8(K3V,"Count")==0 then
call SetUnitTimeScale(p5,2.75)
call n7(K3V,"Count",1)
call DisableTrigger(t)
if H3V(p5)then
set a=Atan2(GetUnitY(p5)-GetUnitY(m5),GetUnitX(p5)-GetUnitX(m5))
call SetUnitX(p5,GetUnitX(m5)+Cos(a)*'d')
call SetUnitY(p5,GetUnitY(m5)+Sin(a)*'d')
call SetUnitAbilityLevel(QJV,RDO,4)
set a=Atan2(GetUnitY(m5)-GetUnitY(p5),GetUnitX(m5)-GetUnitX(p5))
call SetUnitFacing(p5,Rad2Deg(a))
endif
call IssueTargetOrderById(p5,$D000F,m5)
call EnableTrigger(t)
if RGO-RFO>3.8 then
call SetUnitAbilityLevel(QJV,RDO,4)
elseif RGO-RFO>2.7 then
call SetUnitAbilityLevel(QJV,RDO,3)
elseif RGO-RFO>1.2 then
call SetUnitAbilityLevel(QJV,RDO,2)
elseif RGO-RFO>0 then
call SetUnitAbilityLevel(QJV,RDO,1)
endif
endif
elseif GetTriggerEventId()==EVENT_UNIT_ATTACKED then
if GetAttacker()==p5 then
call DestroyEffect(r8(K3V,"FX1"))
call DestroyEffect(r8(K3V,"FX2"))
call DestroyEffect(r8(K3V,"FX3"))
call SetUnitTimeScale(p5,1)
call a7(K3V)
call KJV(t)
call QDV(m5,.5+.5*JFV,false)
call RemoveUnit(QJV)
call UnitRemoveAbility(m5,'B01Y')
call UnitRemoveAbility(p5,'B01Z')
call UnitShareVision(m5,GetOwningPlayer(p5),false)
call SetUnitPathing(p5,true)
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF)
call UnitRemoveAbility(p5,'A179')
endif
elseif E8(K3V,"Count")>0 then
if p5==null or LAV(m5) or C7E(m5)then
call UnitShareVision(m5,v8(K3V,"p"),false)
call DestroyEffect(r8(K3V,"FX1"))
call DestroyEffect(r8(K3V,"FX2"))
call DestroyEffect(r8(K3V,"FX3"))
call SetUnitTimeScale(p5,1)
call a7(K3V)
call KJV(t)
call RemoveUnit(QJV)
call UnitRemoveAbility(m5,'B01Y')
call UnitRemoveAbility(p5,'B01Z')
call UnitShareVision(m5,GetOwningPlayer(p5),false)
call SetUnitPathing(p5,true)
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF)
call UnitRemoveAbility(p5,'A179')
else
call DisableTrigger(t)
call IssueTargetOrderById(p5,$D000F,m5)
call EnableTrigger(t)
set X2O=E8(K3V,"Iteration")
set X2O=X2O+1
call n7(K3V,"Iteration",X2O)
if GetUnitAbilityLevel(p5,'A179')==0 then
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF*('d'-(JFV*X2O))/ 'd')
else
call SetUnitVertexColor(p5,25,25,25,$FF*('d'-(JFV*X2O))/ 'd')
endif
if GetUnitAbilityLevel(m5,'B01Y')==0 and v6(GetUnitX(p5),GetUnitY(p5),GetUnitX(m5),GetUnitY(m5))<$9C4 then
call IssueTargetOrderById(QJV,$D00B5,m5)
endif
if(GetUnitAbilityLevel(QJV,RDO)==4)and GetUnitAbilityLevel(p5,'A179')==0 then
call UnitAddAbility(p5,'A179')
endif
endif
endif
set t=null
set p5=null
set m5=null
set QJV=null
return false
endfunction
function RHO takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer JFV=GetUnitAbilityLevel(p5,'A1P8')
local unit oA=CreateUnit(GetOwningPlayer(p5),'e00C',GetUnitX(p5),GetUnitY(p5),0)
local integer RJO
local string fx=""
if GetUnitAbilityLevel(m5,'B0BI')>0 then
set p5=GetSpellTargetUnit()
set m5=GetTriggerUnit()
endif
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(p5))then
set fx="Abilities\\Spells\\Other\\HowlOfTerror\\HowlTarget.mdl"
endif
call UnitShareVision(m5,GetOwningPlayer(p5),true)
if JFV==1 then
set RJO='A0GE'
elseif JFV==2 then
set RJO='A0GF'
elseif JFV==3 then
set RJO='A0GG'
else
set RJO='A0GH'
endif
call A7(GetHandleId(GetOwningPlayer(p5)),"ChargeUnit",oA)
call UnitAddAbility(oA,'Aloc')
call UnitAddAbility(oA,RJO)
call UnitAddAbility(oA,'A0GJ')
call SetUnitPathing(p5,false)
call KYV(p5,"ChargeOfDarkness|Charging")
call A7(K3V,"Source",p5)
call D7(K3V,"p",GetOwningPlayer(p5))
call A7(K3V,"Target",m5)
call A7(K3V,"Caster",oA)
call n7(K3V,"Level",JFV)
call n7(K3V,"CasterAbility",RJO)
call n7(K3V,"Iteration",0)
call b7(K3V,"FX1",AddSpecialEffectTarget(fx,m5,"overhead"))
call b7(K3V,"FX2",AddSpecialEffectTarget(fx,m5,"overhead"))
call b7(K3V,"FX3",AddSpecialEffectTarget("war3mapImported\\ShockwaveMissilePurple.mdx",p5,"origin"))
call n7(K3V,"Count",0)
call E7(K3V,"OriginalTime",TimerGetElapsed(D))
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_ATTACKED)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(t,Condition(function RCO))
call SetUnitAnimationByIndex(p5,2)
call SetUnitTimeScale(p5,2.5)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A179',false)
set t=null
set p5=null
set m5=null
set oA=null
endfunction
