function XNI takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
if C7V(u,'IA02')==0 or(IsUnitType(u,UNIT_TYPE_DEAD)and(J or IsUnitIllusion(u)))then
call DYV(u,'IA02',false)
call SetUnitVertexColor(u,$FF,$FF,$FF,$FF)
call UnitRemoveAbility(u,'AA5H')
call FIV()
else
call SetUnitVertexColor(u,0,0,0,$9B)
call UnitAddAbility(u,'AA5H')
call Q_V(u,GetUnitX(u),GetUnitY(u),650,$A,1)
endif
set u=null
endfunction
function I0KL takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
local integer i=C7V(u,'I0A9')+C7V(u,'I0KL')
local real r=0
local real x1=0
local integer l=0
if i>0 then
set r=0
set x1=.24
loop
exitwhen i<1
set r=r+x1
set i=i-1
set x1=x1-.06
endloop
set r=r*(GetUnitState(u,UNIT_STATE_MAX_LIFE)-G9V(u))
set l=R2I(r)
call G8V(u,l-DTV(u,'I0A9'))
call DPV(u,'I0A9',l)
else
set i=DTV(u,'I0A9')
call G8V(u,-i)
call DPV(u,'I0A9',0)
call DYV(u,'I0KL',false)
call FIV()
endif
set u=null
endfunction
function XBI takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
local integer i=C7V(u,'I0A1')+C7V(u,'I0BP')+C7V(u,'I0LJ')+C7V(u,'I0LK')
local integer l=0
if i==0 then
call DYV(u,'I0BP',false)
call FIV()
else
set l=R2I($FA*(B6V(u,true)+B7V(u,true)+B8V(u,true))*.0085)*i
endif
call G6V(u,l-DTV(u,'I0A1'))
call DPV(u,'I0A1',l)
set u=null
endfunction
function XCI takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
local integer i=C7V(u,'I099')
if i<6 then
call G6V(u,-DTV(u,'I099'))
call DPV(u,'I099',0)
call DYV(u,'i099',false)
call FIV()
else
call KDV(GetOwningPlayer(u),'CJ18')
set i=B6V(u,true)+B7V(u,true)+B8V(u,true)
set i=i*6
call G6V(u,i-DTV(u,'I099'))
call DPV(u,'I099',i)
endif
set u=null
endfunction
function XDI takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
local integer i=C7V(u,'I0A8')+C7V(u,'I0KP')
local group g=null
local boolexpr b=null
local unit s=null
if i==0 then
call DYV(u,'I0A8',false)
call FIV()
elseif C7V(u,'I0A8')>0 then
set g=CreateGroup()
set b=Condition(function PJV)
set AUV=u
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),650+24,b)
loop
set s=FirstOfGroup(g)
exitwhen s==null
if ITV-DWV(s,'i0A8')>0 and GetUnitAbilityLevel(s,'B02E')>0 then
call DUV(s,'i0A8',ITV+.99)
call HPV(HMV(u),s,3,40+GetUnitState(s,UNIT_STATE_MAX_LIFE)*.015+$A+H4V(u,1)*.08)
endif
call GroupRemoveUnit(g,s)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set u=null
endfunction
function XFI takes nothing returns nothing
local unit s=DHV(GetExpiredTimer(),'s')
local group g=null
local boolexpr b=null
local unit f=null
local integer l=0
if C7V(s,'IV03')==0 then
call DYV(s,'IV03',false)
call FIV()
else
set g=KHV()
set b=Condition(function PMV)
set AUV=s
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),$3E8,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if GetUnitAbilityLevel(f,'w0au')>0 then
set l=R2I((K9V(f)+Ld(f))*.35)
call J6V(f,'w0au','w0au',2,-l,0,0,0,0,0,0)
call HPV(s,f,9,8)
endif
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set s=null
endfunction
function XGI takes nothing returns nothing
local unit s=DHV(GetExpiredTimer(),'s')
local group g=null
local boolexpr b=null
local unit f=null
local integer i=0
if C7V(s,'I0BJ')==0 then
call DYV(s,'I0BJ',false)
call FIV()
else
set AUV=s
set g=KHV()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),$3E8,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if GetUnitAbilityLevel(f,'B03E')>0 then
set i=R2I((GRV(f)+B7V(f,true)*.14)*.8)
call J6V(f,'B03E','B03E',2,0,-i,0,0,0,0,0)
endif
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set s=null
endfunction
function XHI takes nothing returns boolean
return((IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)or IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE))and IsUnitAlly(GetFilterUnit(),GetOwningPlayer(AUV))==false and GetWidgetLife(GetFilterUnit())>1)!=null
endfunction
function XJI takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local group g=null
local boolexpr b=null
if GetWidgetLife(s)<1 or ITV-DWV(s,'I00J')>0 or GetUnitAbilityLevel(s,'AA8Z')==0 then
call UnitSetUsesAltIcon(s,false)
call HVV(s,-75)
call DestroyEffect(D2V(t,'e'))
call UnitRemoveAbility(s,'AA8Z')
call FIV()
else
set g=CreateGroup()
set b=Condition(function XHI)
set AUV=s
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),474,b)
if FirstOfGroup(g)!=null then
call UnitRemoveAbility(s,'AA8Z')
endif
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(s))==false then
call UnitSetUsesAltIcon(s,true)
endif
endif
set t=null
set s=null
endfunction
function XKI takes unit s returns nothing
local group g=CreateGroup()
local boolexpr b=Condition(function PTV)
local unit f=null
local timer t=null
set AUV=s
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),$5F4,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if IsUnitOwnedByPlayer(f,A7V[0])==false and IsUnitOwnedByPlayer(f,A8V[0])==false and GetUnitAbilityLevel(f,'AA8Z')==0 then
set t=CreateTimer()
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(f))==false then
call UnitSetUsesAltIcon(f,true)
endif
call UnitAddAbility(f,'AA8Z')
call UnitMakeAbilityPermanent(f,true,'AA8Z')
call HVV(f,75)
call TimerStart(t,.1,true,function XJI)
call DFV(t,'s',f)
call D1V(t,'e',AddSpecialEffectTarget("SmokeOfDeceit.mdx",f,"chest"))
set t=null
endif
call DUV(f,'I00J',ITV+45)
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
function XLI takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local group g=null
local boolexpr b=null
local unit f=null
if GetWidgetLife(s)<1 or ITV-DWV(t,'t')>0 then
call G5V(s,-$A)
call DestroyEffect(D2V(t,'e'))
call FIV()
else
call HGV(s,false,B8V(s,true)*.04+.01)
set AUV=s
set g=CreateGroup()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),624,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call J6V(f,'AA91','AA91',1,0,-$A,0,0,0,0,0)
call HGV(f,false,-B8V(f,true)*.04-.01)
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set t=null
set s=null
endfunction
function XMI takes unit s returns nothing
local timer t=CreateTimer()
call TimerStart(t,.5,true,function XLI)
call DFV(t,'s',s)
call G5V(s,$A)
call DUV(t,'t',ITV+30)
call D1V(t,'e',AddSpecialEffectTarget("Abilities\\Spells\\Other\\Drain\\DrainCaster.mdl",s,"chest"))
set t=null
endfunction
function XPI takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=DHV(t,'u')
local real l=DWV(t,'l')
local real m=DWV(t,'m')
local real r=0
if GetWidgetLife(u)<1 or ITV-DWV(t,'t')>0 then
call FIV()
else
set r=GetWidgetLife(u)
if r>l then
call SetWidgetLife(u,l)
else
call DUV(t,'l',r)
endif
set r=GetUnitState(u,UNIT_STATE_MANA)
if r>m then
call SetUnitState(u,UNIT_STATE_MANA,m)
else
call DUV(t,'m',r)
endif
endif
set t=null
set u=null
endfunction
function XQI takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=DHV(t,'u')
if GetWidgetLife(u)<1 or ITV-DWV(t,'t')>0 then
call FIV()
else
call HGV(u,true,$C)
call HGV(u,false,$A)
endif
set t=null
set u=null
endfunction
function XSI takes unit s returns nothing
local timer t=null
local group g=CreateGroup()
local boolexpr b=Condition(function PQV)
local unit f=null
set AUV=s
call GroupEnumUnitsInRange(g,0,0,$7530,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
set t=CreateTimer()
call TimerStart(t,.1,true,function XPI)
call DFV(t,'u',f)
call DUV(t,'t',ITV+7)
call DUV(t,'l',GetWidgetLife(f))
call DUV(t,'m',GetUnitState(f,UNIT_STATE_MANA))
set t=null
call GroupRemoveUnit(g,f)
endloop
call DestroyBoolExpr(b)
set b=Condition(function PUV)
call GroupEnumUnitsInRange(g,0,0,$7530,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
set t=CreateTimer()
call TimerStart(t,.1,true,function XQI)
call DFV(t,'u',f)
call DUV(t,'t',ITV+7)
set t=null
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
function I006A takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit f=null
local group g=DKV(t,'g')
loop
set f=FirstOfGroup(g)
exitwhen f==null
call UnitRemoveAbility(f,'AA92')
call UnitRemoveAbility(f,'AA93')
call UnitRemoveAbility(f,'aa92')
call UnitRemoveAbility(f,'aa93')
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call FIV()
set g=null
set t=null
set f=null
endfunction
function XTI takes unit s returns nothing
local group g=CreateGroup()
local boolexpr b=Condition(function j6)
local unit f=null
call GroupEnumUnitsInRange(g,0,0,$9C40,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if GetWidgetLife(f)>1 then
if IsUnitAlly(f,GetOwningPlayer(s))then
call UnitAddAbility(f,'AA92')
call UnitRemoveAbility(f,'AA92')
else
call UnitAddAbility(f,'AA93')
call UnitRemoveAbility(f,'AA93')
endif
endif
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
function XUI takes unit u,integer id,boolean b returns nothing
local timer tm=null
local integer l=0
local boolean XWI=IsUnitIllusion(u)
local integer i=0
local real r=0
local real d=0
set l=C7V(u,id)
if b==false then
set l=l-1
endif
if id=='IV03'then
if l>0 and XWI==false and b then
if DZV(u,'IV03')==false then
call DYV(u,'IV03',true)
set tm=CreateTimer()
call TimerStart(tm,1,true,function XFI)
call DFV(tm,'s',u)
set tm=null
endif
endif
endif
if id=='I700'and b and DZV(u,'i700')==false then
call DYV(u,'i700',true)
set tm=CreateTimer()
call TimerStart(tm,.25,true,function XQE)
call DFV(tm,'s',u)
set tm=null
endif
if id=='I60S'then
if GetUnitTypeId(u)=='Nbrn'or GetUnitTypeId(u)=='L005'or GetUnitTypeId(u)=='N0EG'then
if l>0 then
call UnitAddAbility(u,'AA5D')
call UnitMakeAbilityPermanent(u,true,'AA5D')
else
call UnitRemoveAbility(u,'AA5D')
endif
endif
endif
if(id=='I0A8'or id=='I0KP')and l>0 then
if DZV(u,'I0A8')==false then
call DYV(u,'I0A8',true)
set tm=CreateTimer()
call TimerStart(tm,1,true,function XDI)
call DFV(tm,'s',u)
set tm=null
endif
endif
if id=='I099'then
if l==6 then
if DZV(u,'i099')==false then
call DYV(u,'i099',true)
set tm=CreateTimer()
call TimerStart(tm,.3,true,function XCI)
call DFV(tm,'s',u)
set tm=null
endif
endif
endif
if id=='I0A1'or id=='I0BP'or id=='I0LJ'or id=='I0LK'then
if l>0 and XWI==false then
if DZV(u,'I0BP')==false then
call DYV(u,'I0BP',true)
set tm=CreateTimer()
call TimerStart(tm,.3,true,function XBI)
call DFV(tm,'s',u)
set tm=null
endif
endif
endif
if id=='IA02'then
if GetUnitTypeId(u)=='Ucrl'then
if DZV(u,'IA02')==false then
call DYV(u,'IA02',true)
set tm=CreateTimer()
call TimerStart(tm,.25,true,function XNI)
call DFV(tm,'s',u)
set tm=null
endif
endif
endif
if id=='I0BJ'then
if DZV(u,'I0BJ')==false and l>0 then
call DYV(u,'I0BJ',true)
set tm=CreateTimer()
call TimerStart(tm,.3,true,function XGI)
call DFV(tm,'s',u)
set tm=null
endif
endif
if id=='I00J'and XWI==false and b then
call XKI(u)
endif
if id=='I00K'and XWI==false and b then
call XMI(u)
endif
if id=='I008'and XWI==false and b then
call XSI(u)
endif
if id=='I006'and XWI==false and b then
call XTI(u)
endif
set tm=null
endfunction
function XYI takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local group g=null
local boolexpr b=null
local real r=GetWidgetLife(s)
local unit f=null
if C7V(s,'I80N')==0 then
call DYV(s,'I80N',false)
call FIV()
elseif r>1 then
set AUV=s
set g=CreateGroup()
set b=Condition(function PMV)
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),$44C,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if GetUnitAbilityLevel(f,'aa97')>0 then
if IsUnitInRange(s,f,924)then
call SetWidgetLife(f,RMinBJ(r,GetWidgetLife(f)))
else
call UnitRemoveAbility(f,'aa97')
endif
endif
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set t=null
set s=null
endfunction
function XZI takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer i=GetPlayerId(GetOwningPlayer(u))
local trigger t=null
local boolean b=GetTriggerEventId()==EVENT_PLAYER_UNIT_PICKUP_ITEM
local timer tm=null
local integer id=GetItemTypeId(GetManipulatedItem())
local integer l=0
call C6V(u)  
if IsUnitIllusion(u)then
set l=0
loop
exitwhen l>5
set id=GetItemTypeId(UnitItemInSlot(u,l))
if id>0 then
call XUI(u,id,true)
endif
set l=l+1
endloop
else
call XUI(u,id,b)
if id=='I80K'then
if b then
call G6V(u,75)
else
call G6V(u,-75)
endif
call HEV(u)
elseif id=='IV03'then
if b then
call G6V(u,35)
call G7V(u,$F)
else
call G6V(u,-35)
call G7V(u,-$F)
endif
call HEV(u)
elseif id=='I80N'then
if b then
call G5V(u,7)
call G2V(u,5)
call G4V(u,9)
if DZV(u,'I80N')==false then
call DYV(u,'I80N',true)
set tm=CreateTimer()
call TimerStart(tm,.1,true,function XYI)
call DFV(tm,'s',u)
set tm=null
endif
else
call G5V(u,-7)
call G2V(u,-5)
call G4V(u,-9)
endif
call HEV(u)
endif
if id=='I0AW'or id=='I0B1'then
if GetItemCharges(GetManipulatedItem())<1 then
call SetItemCharges(GetManipulatedItem(),1)
endif
endif
endif
set u=null
endfunction
function X_I takes nothing returns nothing
local player p=GetTriggerPlayer()
local integer i=0
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call GDV()
else
set i=DTV(p,'?DMH')
if i==1 then
if GetLocalPlayer()==p then
call TimerStart(CreateTimer(),.1,false,function VTI)
endif
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F,lt[GetPlayerId(p)]+GetObjectName('NDFW'))
else
call DPV(p,'?DMH',i+1)
endif
endif
set p=null
endfunction
function DisableMH takes nothing returns nothing
local real x=V8I()
local real y=V8I()
local unit f=CreateUnit(Player($C),'eA09',x,y,0)
local trigger t=CreateTrigger()
loop
exitwhen IsUnitVisible(f,A7V[0])==false and IsUnitVisible(f,A8V[0])==false
set x=V8I()
set y=V8I()
call SetUnitX(f,x)
call SetUnitY(f,y)
endloop
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_SELECTED)
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DEATH)
call UnitApplyTimedLife(f,'BTLF',1)
call TriggerAddCondition(t,Condition(function X_I))
set t=null
set f=null
endfunction
function X0I takes nothing returns nothing
local integer id=GetItemTypeId(GetManipulatedItem())
local unit s=GetTriggerUnit()
if id=='I71I' then
call DisplayTimedTextToPlayer(GetOwningPlayer(s),0,0,$A," ")
call DisplayTimedTextToPlayer(GetOwningPlayer(s),0,0,$A,GetObjectName('s71i'))
call DisplayTimedTextToPlayer(GetOwningPlayer(s),0,0,$A," ")
endif
set s=null
endfunction
function Fun_SellItem takes nothing returns nothing
local integer id=GetItemTypeId(GetSoldItem())
local unit s=GetBuyingUnit()
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local player p=GetOwningPlayer(s)
local item it=null
local integer i=0
local boolean b=false
local integer r=0
local boolean X1I=false
if id=='I71M' then
set b=true
endif
if b then
call RemoveItem(GetSoldItem())
endif
set p=null
set s=null
endfunction
function Hallowmas takes nothing returns nothing
local group g=CreateGroup()
local boolexpr b=Condition(function j6)
local unit f=null
call GroupEnumUnitsOfPlayer(g,Player($C),b)
set f=GroupPickRandomUnit(g)
if f!=null and GetUnitAbilityLevel(f,'AA3B')==0 then
if IMV==1 then
call PingMinimap(GetUnitX(f),GetUnitY(f),3)
endif
call UnitAddAbility(f,'AA3B')
call G8V(f,R2I(GetUnitState(f,UNIT_STATE_MAX_LIFE)))
call G6V(f,GetRandomInt(20,30))
call G5V(f,GetRandomInt(5,$A))
call HEV(f)
call UnitAddAbility(f,'ACrk')
call DYV(f,'eLit',true)
set f=null
endif
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
function X2I takes integer i,string s,boolean b returns nothing
if s==null or s=="" then
call D3V(Player($E),i,null)
else
call D3V(Player($E),i,s)
endif
if b then
call DPV(Player($D),IYV,i)
call DPV(Player($D),i,1)
set IYV=IYV+1
endif
endfunction
function X3I takes integer i,integer x,integer x1,integer y,integer y1,integer x2 returns nothing
call SaveInteger(HV,i,1,x)
call SaveInteger(HV,i,2,x1)
call SaveInteger(HV,i,3,y)
call SaveInteger(HV,i,4,y1)
call SaveInteger(HV,i,5,x2)
endfunction
