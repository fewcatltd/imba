if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamageSource()==p5 then
call DisableTrigger(t)
if GetUnitTypeId(m5)!='hkni' and GUV(m5)==false then
call Z2O(p5,m5)
endif
call a7(K3V)
call KJV(t)
endif
else
call a7(K3V)
call KJV(t)
endif
set t=null
set p5=null
set m5=null
return false
endfunction
