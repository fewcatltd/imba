call SetUnitPathing(QJV,false)
call UnitAddAbility(QJV,'Aeth')
call UnitAddAbility(QJV,'Aloc')
call UnitAddAbility(QJV,'A04R')
call SetUnitVertexColor(QJV,$FF,$FF,$FF,0)
call SetUnitX(QJV,x)
call SetUnitY(QJV,y)
call SetUnitX(K8V,x)
call SetUnitY(K8V,y)
call SetUnitAnimation(QJV,"Spell Throw")
call SetUnitPathing(K8V,true)
call UnitRemoveAbility(K8V,'Aeth')
call A7(K3V,"BlinkAM_Caster",QJV)
set K8V=null
set QJV=null
endfunction
