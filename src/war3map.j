call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,$A,(GetObjectName(('n0CQ')))+" [|cff0000ffQ|r|cff00ffffW|r|cffff0000E|r] - [|cffffcc00B|r]")
endfunction
function U4E takes string s returns nothing
