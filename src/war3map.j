set IT[52]='h05B'
set Qt[52]='n0AY'
set RT[52]="ReplaceableTextures\\CommandButtons\\BTNBanshee.blp"
call LQV(qt[52],"spell wail")
call LKV(qt[52],1.35,IT[52])
set cT[i]="Carrion Swarm is your primary nuke and first skill to max. Make use of its range by casting it on the ground instead of on a unit directly."
set CT[i]="An early level of Silence can help prevent you and your allies from being attacked by multiple spells."
set DT[i]="The ghosts of Exorcism will attack whatever you attack, so if you want to direct all attention to a single unit simply focus them and stay nearby."
set fT[i]="Exorcism also makes Krobelus extremely effective for quickly destroying enemy buildings, so be sure to push the enemy base when you can"
set FT[i]="The effect of Exorcism stops if you die in combat: Invest in items that improve your survivability, such as a Bloodstone or a Heart of Tarrasque."
set i=i+1
