call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl",GetUnitX(f),GetUnitY(f)))
call GroupRemoveUnit(g,f)
endloop
