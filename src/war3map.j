local real IL=GetUnitY(IJ)+30*Sin(RK)
if(Il-hN)*(Il-hN)+(IL-ho)*(IL-ho)<$4B0 then
call SetUnitX(IJ,hN)
call SetUnitY(IJ,ho)
call yL(IJ,hN,ho)
call PauseTimer(t)
call a7(K3V)
call KillUnit(IJ)
