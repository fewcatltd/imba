function RLI takes nothing returns nothing
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local integer id=GetSpellAbilityId()
local integer i=GetUnitAbilityLevel(s,id)
local integer n=0
local real d=SquareRoot((x-x1)*(x-x1)+(y-y1)*(y-y1))
local real a=Atan2(y1-y,x1-x)
local timer tm=null
local trigger t=null
local group g=null
local boolexpr b=null
local group g1=null
local real r=0
if id=='A02M' or id=='A06N' or id=='A072' or id=='A074' or id=='A078' then
set n=B8V(s,true)
set r=n*.004+n*(n+1)*.5*.0001*.1
set r=r*C0V(H3V(s))+1
set r=r*(25*C0V(i<4)+75*i)+H4V(s,1)
call Q1V(s,a,$44C,r,300,810)
endif
set s=null
set u=null
endfunction
function RebuildTrigger takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function RLI))
set t=null
call FIV()
endfunction
