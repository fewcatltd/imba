call TriggerRegisterTimerEvent(Eo,30,true)
call TriggerEvaluate(Eo)
if Y then
call TriggerRegisterTimerEvent(yA,600,true)
endif
elseif r==7 then
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,30,true)
call TriggerAddCondition(t,Condition(function G3E))
elseif MLE<$C and bz==false then
set bz=true
call PlaySoundBJ(cR)
call C4E(C5E,C6E,true)
else
call C4E(C5E,C6E,true)
endif
return false
endfunction
function MPE takes nothing returns nothing
local trigger t
local real r=Nz+1
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.25,true)
call TriggerAddCondition(t,Condition(function MKE))
set Oz=CreateTimer()
if IBV then
set r=Nz+1
endif
call TimerStart(Oz,r,false,null)
set t=null
set Au=TimerGetElapsed(D)+1
endfunction
function MQE takes nothing returns boolean
if GetOwningPlayer(GetTriggerUnit())!=A7V[0]and GetOwningPlayer(GetTriggerUnit())!=A8V[0]then
set Vb[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]=Vb[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]+1
if GetIssuedOrderId()!=851983then
set nb[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]=(TimerGetElapsed(D))
set Eb[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]=false
endif
if(GetIssuedOrderId()==851983or GetIssuedOrderId()==$D0003)and GetOrderTargetItem()!=null then
if GetIssuedOrderId()==851983or(GetIssuedOrderId()==$D0003 and O8(GetHandleId(GetItemPlayer(GetOrderTargetItem())),"DisableHelp"))then
if GetItemPlayer(GetOrderTargetItem())!=GetOwningPlayer(GetTriggerUnit())and IsPointInRegion(Ew,GetItemX(GetOrderTargetItem()),GetItemY(GetOrderTargetItem())) then
call DisableTrigger(GetTriggeringTrigger())
call LZV(GetTriggerUnit())
call LYV(GetOwningPlayer(GetTriggerUnit()),(GetObjectName(('n0G7'))))
call EnableTrigger(GetTriggeringTrigger())
endif
endif
endif
endif
return false
endfunction
function MSE takes nothing returns nothing
local integer i=S2I(SubString(StringCase(GetEventPlayerChatString(),false),5,8))
call DYV(AIV,i,true)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F,"|cffffff00"+GetObjectName(DTV(AIV,$3E8+i))+"|r"+GetObjectName('Arpl'))
endfunction
function MTE takes nothing returns nothing
local integer i=S2I(SubString(StringCase(GetEventPlayerChatString(),false),4,6))
call OIE(i)
endfunction
function MUE takes nothing returns nothing
local integer i=1
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,$F," ")
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,$F,GetObjectName('AUls'))
loop
exitwhen i>$B
if i!=6 and ie[i]!=null then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,$F,GetUnitName(ie[i])+" - "+R2S(DWV(AKV,i)))
endif
set i=i+1
endloop
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,$F," ")
endfunction
function MWE takes nothing returns nothing
local player p=GetTriggerPlayer()
local integer l=GetHandleId(p)
local integer i=1
local integer k=LoadInteger(GB,l,0)
local string s=null
call DisplayTimedTextToPlayer(p,0,0,$A," ")
if k==0 then
call DisplayTimedTextToPlayer(p,0,0,$A,GetObjectName('CJS1'))
else
call DisplayTimedTextToPlayer(p,0,0,$A,GetObjectName('CJS2'))
loop
set k=LoadInteger(GB,l,i)
exitwhen k==0
if s!=null then
set s=s+" / "+GetObjectName(k)
else
set s=GetObjectName(k)
endif
set i=i+1
endloop
call DisplayTimedTextToPlayer(p,0,0,$A,s)
endif
call DisplayTimedTextToPlayer(p,0,0,$A," ")
set p=null
endfunction
function MYE takes nothing returns nothing
local integer i=GetPlayerId(GetTriggerPlayer())
local unit u=ie[i]
call DisplayTimedTextToPlayer(Player(i),0,0,30," ")
call DisplayTimedTextToPlayer(Player(i),0,0,30,I2S(DTV(u,'aAtk'))+"/"+I2S(DTV(u,'aDef'))+"/"+I2S(DTV(u,'aIas'))+"/"+I2S(DTV(u,'aLfe'))+"/"+I2S(DTV(u,'aStr'))+"/"+I2S(DTV(u,'aAgi'))+"/"+I2S(DTV(u,'aInt')))
call DisplayTimedTextToPlayer(Player(i),0,0,30," ")
set u=null
endfunction
function MZE takes nothing returns nothing
call OAE(ie[GetPlayerId(GetTriggerPlayer())],'Udea','AA4Q','AA4Q')
call OAE(ie[GetPlayerId(GetTriggerPlayer())],'HC92','AA4W','AA4W')
endfunction
function M_E takes nothing returns nothing
local unit u=ie[GetPlayerId(GetTriggerPlayer())]
local integer i=0
local item l=null
local integer id=0
loop
exitwhen i>5
set l=UnitItemInSlot(u,i)
set id=GetItemTypeId(l)
if id=='I0DR' or id=='I0GX' or id=='I0GY' or id=='I0GZ' or id=='I0H0' or id=='I0H1' then
call RemoveItem(l)
set l=CreateItem('I0AP',0,0)
call SetItemPlayer(l,GetTriggerPlayer(),false)
call UnitAddItem(u,l)
call UnitDropItemSlot(u,l,i)
set l=null
endif
set i=i+1
endloop
set u=null
set l=null
endfunction
function M0E takes nothing returns nothing
local player p=GetTriggerPlayer()
local unit s=ie[GetPlayerId(p)]
if GetUnitAbilityLevel(s,'AB84')>0 then
call DisplayTimedTextToPlayer(p,0,0,$F,GetObjectName('SNMS')+I2S(DTV(s,'AA18')/2))
endif
set p=null
set s=null
endfunction
function M1E takes nothing returns nothing
call C5V(ie[GetPlayerId(GetTriggerPlayer())])
endfunction
function ChangeWeather takes nothing returns nothing
local integer i=0
local boolean b=false
if GetTriggerPlayer()!=null then
set VU[GetPlayerId(GetTriggerPlayer())]=not VU[GetPlayerId(GetTriggerPlayer())]
if GetLocalPlayer()==GetTriggerPlayer()then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,$A," ")
if VU[GetPlayerId(GetTriggerPlayer())]then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,$A,GetObjectName('CM0J')+GetObjectName('CM0L'))
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,$A,GetObjectName('CM0J')+GetObjectName('CM0K'))
endif
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,$A," ")
endif
endif
set b=VU[GetPlayerId(GetLocalPlayer())]
endfunction
function M2E takes nothing returns nothing
local item OVE=GetEnumItem()
local player p=EHV
local integer id=GetPlayerId(p)
local real x
local real y
if GetWidgetLife(OVE)>0 and GetItemPlayer(OVE)==p then
if C8(EHV)then
set x=GetRandomReal(GetRectMinX(rr),GetRectMaxX(rr))
set y=GetRandomReal(GetRectMinY(rr),GetRectMaxY(rr))
else
set x=GetRandomReal(GetRectMinX(Mo),GetRectMaxX(Mo))
set y=GetRandomReal(GetRectMinY(Mo),GetRectMaxY(Mo))
endif
call SetItemPosition(OVE,x,y)
endif
set OVE=null
set p=null
endfunction
function M3E takes nothing returns boolean
if C8(EHV)then
call EnumItemsInRect(Ei,Condition(function j6),function M2E)
else
call EnumItemsInRect(ni,Condition(function j6),function M2E)
endif
return true
endfunction
function SWAPFILTER takes nothing returns boolean
return GetOwningPlayer(GetFilterUnit())==SWAPPLAYER and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)==true
endfunction
function M4E takes player M5E,player M6E,boolean M7E,boolean M8E,force M9E,force PVE returns nothing
local integer PEE=(1+GetPlayerId(M5E))
local integer PXE=(1+GetPlayerId(M6E))
local integer i=0
local boolean POE=false
local integer array num1
local integer array num2
local player PRE
local player PIE
local unit PAE=ft[GetPlayerId(M5E)]
local unit PNE=ft[GetPlayerId(M6E)]
local location PBE=GetUnitLoc(PAE)
local location PCE=GetUnitLoc(PNE)
local location PDE=GetRectCenter(bj_mapInitialPlayableArea)
local real x
local real y
local unit PFE
local group swapg=CreateGroup() 
set SWAPPLAYER=M5E
call GroupEnumUnitsInRange(swapg,0,0,1000000,Condition(function SWAPFILTER))
call BJDebugMsg(I2S(CountUnitsInGroup(swapg))) 
set i=0
loop
exitwhen i>5
if A7V[i]==M5E then
set POE=true
endif
set i=i+1
endloop
if POE then
set PRE=M5E
set PIE=M6E
else
set PRE=M6E
set PIE=M5E
endif
if M7E==false and M8E==false then
set i=0
loop
exitwhen i>5
if A8V[i]==PRE then
set A8V[i]=PIE
elseif A8V[i]==PIE then
set A8V[i]=PRE
endif
if A7V[i]==PRE then
set A7V[i]=PIE
elseif A7V[i]==PIE then
set A7V[i]=PRE
endif
set i=i+1
endloop
call ForceAddPlayer(M9E,PIE)
call ForceAddPlayer(PVE,PRE)
call SetPlayerAllianceStateBJ(PRE,Player(6),3)
call SetPlayerAllianceStateBJ(PRE,A8V[1],3)
call SetPlayerAllianceStateBJ(PRE,A8V[2],3)
call SetPlayerAllianceStateBJ(PRE,A8V[3],3)
call SetPlayerAllianceStateBJ(PRE,A8V[4],3)
call SetPlayerAllianceStateBJ(PRE,A8V[5],3)
call SetPlayerAllianceStateBJ(Player(6),PRE,3)
call SetPlayerAllianceStateBJ(A8V[1],PRE,3)
call SetPlayerAllianceStateBJ(A8V[2],PRE,3)
call SetPlayerAllianceStateBJ(A8V[3],PRE,3)
call SetPlayerAllianceStateBJ(A8V[4],PRE,3)
call SetPlayerAllianceStateBJ(A8V[5],PRE,3)
call SetPlayerAllianceStateBJ(PIE,Player(0),3)
call SetPlayerAllianceStateBJ(PIE,A7V[1],3)
call SetPlayerAllianceStateBJ(PIE,A7V[2],3)
call SetPlayerAllianceStateBJ(PIE,A7V[3],3)
call SetPlayerAllianceStateBJ(PIE,A7V[4],3)
call SetPlayerAllianceStateBJ(PIE,A7V[5],3)
call SetPlayerAllianceStateBJ(Player(0),PIE,3)
call SetPlayerAllianceStateBJ(A7V[1],PIE,3)
call SetPlayerAllianceStateBJ(A7V[2],PIE,3)
call SetPlayerAllianceStateBJ(A7V[3],PIE,3)
call SetPlayerAllianceStateBJ(A7V[4],PIE,3)
call SetPlayerAllianceStateBJ(A7V[5],PIE,3)
call SetPlayerAllianceStateBJ(PRE,Player(0),0)
call SetPlayerAllianceStateBJ(PRE,A7V[1],0)
call SetPlayerAllianceStateBJ(PRE,A7V[2],0)
call SetPlayerAllianceStateBJ(PRE,A7V[3],0)
call SetPlayerAllianceStateBJ(PRE,A7V[4],0)
call SetPlayerAllianceStateBJ(PRE,A7V[5],0)
call SetPlayerAllianceStateBJ(Player(0),PRE,0)
call SetPlayerAllianceStateBJ(A7V[1],PRE,0)
call SetPlayerAllianceStateBJ(A7V[2],PRE,0)
call SetPlayerAllianceStateBJ(A7V[3],PRE,0)
call SetPlayerAllianceStateBJ(A7V[4],PRE,0)
call SetPlayerAllianceStateBJ(A7V[5],PRE,0)
call SetPlayerAllianceStateBJ(PIE,Player(6),0)
call SetPlayerAllianceStateBJ(PIE,A8V[1],0)
call SetPlayerAllianceStateBJ(PIE,A8V[2],0)
call SetPlayerAllianceStateBJ(PIE,A8V[3],0)
call SetPlayerAllianceStateBJ(PIE,A8V[4],0)
call SetPlayerAllianceStateBJ(PIE,A8V[5],0)
call SetPlayerAllianceStateBJ(Player(6),PIE,0)
call SetPlayerAllianceStateBJ(A8V[1],PIE,0)
call SetPlayerAllianceStateBJ(A8V[2],PIE,0)
call SetPlayerAllianceStateBJ(A8V[3],PIE,0)
call SetPlayerAllianceStateBJ(A8V[4],PIE,0)
call SetPlayerAllianceStateBJ(A8V[5],PIE,0)
call SetPlayerAllianceStateBJ(PIE,PRE,0)
call SetPlayerAllianceStateBJ(PRE,PIE,0)
endif
call SetUnitPositionLoc(PAE,PDE)
call SetUnitPositionLoc(PNE,PBE)
call SetUnitPositionLoc(PAE,PCE)
set EHV=PRE
call M3E()
set EHV=PIE
call M3E()
if C8(PRE)then
set x=GetRandomReal(GetRectMinX(rr),GetRectMaxX(rr))
set y=GetRandomReal(GetRectMinY(rr),GetRectMaxY(rr))
else
set x=GetRandomReal(GetRectMinX(Mo),GetRectMaxX(Mo))
set y=GetRandomReal(GetRectMinY(Mo),GetRectMaxY(Mo))
endif
set PFE=EGV[(1+GetPlayerId(PRE))]
call SetUnitX(PFE,x)
call SetUnitY(PFE,y)
call SetUnitPosition(PFE,x,y)
call PanCameraToTimedForPlayer(PRE,x,y,0)
if C8(PIE)then
set x=GetRandomReal(GetRectMinX(rr),GetRectMaxX(rr))
set y=GetRandomReal(GetRectMinY(rr),GetRectMaxY(rr))
else
set x=GetRandomReal(GetRectMinX(Mo),GetRectMaxX(Mo))
set y=GetRandomReal(GetRectMinY(Mo),GetRectMaxY(Mo))
endif
set PFE=EGV[(1+GetPlayerId(PIE))]
call SetUnitX(PFE,x)
call SetUnitY(PFE,y)
call SetUnitPosition(PFE,x,y)
call PanCameraToTimedForPlayer(PIE,x,y,0)  
loop
exitwhen CountUnitsInGroup(swapg)==0
set PFE=GroupPickRandomUnit(swapg)
call SetUnitX(PFE,-6943)
call SetUnitY(PFE,-6666)
call GroupRemoveUnit(swapg,PFE)
endloop
call DestroyGroup(swapg)
set swapg=null
set ENV[PEE]=true
set ENV[PXE]=true
set PAE=null
set PNE=null
set PBE=null
set PCE=null
set PDE=null
set PRE=null
set PIE=null 
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,"--------Switching  is  now  OFFF !!!--------")
set SWAPON=false
endfunction
