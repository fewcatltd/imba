local real CZX=$C8
local real C_X=$FA
local real C0X=Asin((C_X-CZX)/ CKX)
local real x=CZX/ Sin(C0X)
local real y=(CKX+C_X+x)*Tan(C0X)
local real CMX=CHX+x*Cos((CYX-$B4)*bj_DEGTORAD)
local real CPX=CJX+x*Sin((CYX-$B4)*bj_DEGTORAD)
local real CQX=(CHX+(CKX+C_X)*Cos(CYX*bj_DEGTORAD))+y*Cos((CYX-90)*bj_DEGTORAD)
local real CSX=(CJX+(CKX+C_X)*Sin(CYX*bj_DEGTORAD))+y*Sin((CYX-90)*bj_DEGTORAD)
local real CTX=(CHX+(CKX+C_X)*Cos(CYX*bj_DEGTORAD))+y*Cos((CYX+90)*bj_DEGTORAD)
local real CUX=(CJX+(CKX+C_X)*Sin(CYX*bj_DEGTORAD))+y*Sin((CYX+90)*bj_DEGTORAD)
set wl=CMX
set Wl=CPX
set zl=CQX
set Zl=CSX
set vL=CTX
set eL=CUX
endfunction
