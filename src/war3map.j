set xL=IJ
set lN=IJ
set MN=JFV
call GroupEnumUnitsInRange(g,GetUnitX(IJ),GetUnitY(IJ),425,Condition(function J_R))
call ForGroup(g,function JZR)
call KGV(g)
if H3V(IJ)then
set x=GetUnitX(IJ)
set y=GetUnitY(IJ)
set g=CreateGroup()
set g1=DKV(t,'g')
set AUV=IJ
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,x,y,275,b)
call GroupAddGroup(g,g1)
call GroupClear(g)
call GroupAddGroup(g1,g)
set x=J5R-Cos(RK)*$96
set y=J6R-Sin(RK)*$96
loop
set f=FirstOfGroup(g)
exitwhen f==null
if GUV(f)==false and GetUnitTypeId(f)!='n00L'then
call SetUnitPosition(f,x,y)
endif
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
set g1=null
endif
call SetUnitX(IJ,J5R)
call SetUnitY(IJ,J6R)
if iX==$8C then
set J2R=Y7(K3V,"Projectile2")
call KillUnit(J2R)
elseif iX<$8C then
set J2R=Y7(K3V,"Projectile2")
call SetUnitX(J2R,J5R)
call SetUnitY(J2R,J6R)
endif
if iX==$96 then
set g=KHV()
set xL=IJ
call GroupEnumUnitsInRange(g,J5R,J6R,425,Condition(function P0V))
call ForGroup(g,function J0R)
call KGV(g)
call DestroyGroup(DKV(t,'g'))
call KillUnit(IJ)
call KGV(J7R)
call a7(K3V)
call KJV(t)
endif
set t=null
set IJ=null
set J2R=null
set J7R=null
set g=null
return false
endfunction
function J8R takes nothing returns nothing
local unit K8V=GetTriggerUnit()
local real iN=GetUnitX(K8V)
local real io=GetUnitY(K8V)
local location l=GetSpellTargetLoc()
local real KNX=GetLocationX(l)
local real KBX=GetLocationY(l)
local real RK
local real x1
local real y1
local real x2
local real y2
local trigger t
local integer K3V
local integer JFV
local unit IJ
local unit J2R
if KNX==GetUnitX(K8V)and KBX==GetUnitY(K8V)then
set KNX=KNX+50*Cos(GetUnitFacing(K8V)*bj_DEGTORAD)
set KBX=KBX+50*Sin(GetUnitFacing(K8V)*bj_DEGTORAD)
endif
set RK=Atan2(io-KBX,iN-KNX)
set x1=L1V(iN-$3E8*Cos(RK))
set y1=L2V(io-$3E8*Sin(RK))
set x2=L1V(iN+$3E8*Cos(RK))
set y2=L2V(io+$3E8*Sin(RK))
set t=CreateTrigger()
set K3V=GetHandleId(t)
set JFV=GetUnitAbilityLevel(K8V,GetSpellAbilityId())
set IJ=CreateUnit(GetOwningPlayer(K8V),'h06U',x1,y1,Atan2(KBX-io,KNX-iN)*bj_RADTODEG)
set J2R=CreateUnit(GetOwningPlayer(K8V),'h06V',x1,y1,Atan2(KBX-io,KNX-iN)*bj_RADTODEG)
call SetUnitVertexColor(IJ,$FF,$FF,$FF,0)
call SetUnitPathing(IJ,false)
call RemoveLocation(l)
call n7(K3V,"Level",JFV)
call E7(K3V,"Angle",RK)
call A7(K3V,"Projectile",IJ)
call A7(K3V,"Projectile2",J2R)
call E7(K3V,"x2",x2)
call E7(K3V,"y2",y2)
call F7(K3V,"AlreadyHit",KHV())
call DJV(t,'g',CreateGroup())
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function J1R))
set K8V=null
set t=null
set IJ=null
set J2R=null
set l=null
endfunction
function ane takes nothing returns boolean
if GetSpellAbilityId()=='A11K' or GetSpellAbilityId()=='AIA1' then
call J8R()
endif
return false
endfunction
function V_E takes nothing returns nothing
call CZV('A11K',"J8R")
call CZV('AIA1',"J8R")
call L3V('A11L')
endfunction
function J9R takes nothing returns nothing
local destructable m5=GetEnumDestructable()
local real a=Atan2(GetDestructableY(m5)-GetUnitY(xL),GetDestructableX(m5)-GetUnitX(xL))
local real B0R=RAbsBJ((wl-a)*bj_RADTODEG)
if(JYV(m5)or GetDestructableTypeId(m5)=='B005')and GetDestructableLife(m5)>1 and B0R<wB and B0R<(WB-5)then
set wB=B0R
set SB=m5
endif
set m5=null
endfunction
function KVR takes unit RSX,unit p5,real l4 returns destructable
local real x=GetUnitX(RSX)
local real y=GetUnitY(RSX)
local rect r=Rect(x-zB,y-zB,x+zB,y+zB)
set wB=9999
set xL=RSX
set SB=null
call EnumDestructablesInRect(r,Condition(function j6),function J9R)
call RemoveRect(r)
set r=null
return SB
endfunction
function KER takes nothing returns nothing
local unit m5=GetEnumUnit()
local real a=Atan2(GetUnitY(m5)-GetUnitY(xL),GetUnitX(m5)-GetUnitX(xL))
local real B0R=RAbsBJ((wl-a)*bj_RADTODEG)
if B0R<wB and B0R<WB and m5!=oL then
set wB=B0R
set TB=m5
endif
set m5=null
endfunction
function KXR takes unit RSX,unit p5,real l4 returns unit
local group g=KHV()
local integer i=550
set TB=null
set wB=9999
set xL=RSX
set wl=l4
set oL=p5
call GroupEnumUnitsInRange(g,GetUnitX(p5),GetUnitY(p5),i,Condition(function P1V))
call ForGroup(g,function KER)
call KGV(g)
set g=null
return TB
endfunction
function KOR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
if i8(K3V,"Light")!=null then
call DestroyLightning(i8(K3V,"Light"))
endif
call a7(K3V)
call KJV(t)
set t=null
return false
endfunction
function KRR takes unit s,real x,real y,integer i returns nothing
local group g=KHV()
local boolexpr b=Condition(function PJV)
local unit f=null
set AUV=s
call GroupEnumUnitsInRange(g,x,y,325,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call J6V(f,'AB85','B985',.75+.75*i,0,0,0,0,0,0,0)
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
function KIR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit RSX=Y7(K3V,"Projectile")
local unit m5=Y7(K3V,"Target")
local real KAR=X8(K3V,"OriginalAngle")
local real l4=Atan2(GetUnitY(m5)-GetUnitY(RSX),GetUnitX(m5)-GetUnitX(RSX))
local integer JFV=E8(K3V,"Level")
local real x=GetUnitX(RSX)+50*Cos(l4)
local real y=GetUnitY(RSX)+50*Sin(l4)
local unit QJV
local destructable d
local lightning EJO
local unit KNR
local boolean DWE=O8(K3V,"Active")
local unit s=DHV(t,'s')
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call a7(K3V)
call KJV(t)
call KillUnit(RSX)
else
call SetUnitX(RSX,x)
call SetUnitY(RSX,y)
call SetUnitFacing(RSX,l4*bj_RADTODEG)
if v6(x,y,GetUnitX(m5),GetUnitY(m5))<45 then
call a7(K3V)
call KJV(t)
if GetUnitTypeId(m5)!='n00L' and DWE then
set QJV=KXR(RSX,m5,KAR)
set d=KVR(RSX,m5,KAR)
if QJV!=null then
set t=CreateTrigger()
set K3V=GetHandleId(t)
call QDV(m5,.75+.75*JFV,false)
call QDV(QJV,.75+.75*JFV,false)
call KRR(s,GetUnitX(m5),GetUnitY(m5),JFV)
call KRR(s,GetUnitX(QJV),GetUnitY(QJV),JFV)
call TriggerRegisterTimerEvent(t,.25+JFV*.75,false)
call TriggerAddCondition(t,Condition(function KOR))
set EJO=AddLightning("MFPB",true,GetUnitX(m5),GetUnitY(m5),GetUnitX(QJV),GetUnitY(QJV))
call SetLightningColor(EJO,.5,.5,1,1)
call c7(K3V,"Light",EJO)
elseif d!=null then
set t=CreateTrigger()
set K3V=GetHandleId(t)
call QDV(m5,.75+.75*JFV,false)
call KRR(s,GetUnitX(m5),GetUnitY(m5),JFV)
call KRR(s,GetDestructableX(d),GetDestructableY(d),JFV)
call TriggerRegisterTimerEvent(t,.25+JFV*.75,false)
call TriggerAddCondition(t,Condition(function KOR))
set EJO=AddLightning("MFPB",true,GetUnitX(m5),GetUnitY(m5),GetDestructableX(d),GetDestructableY(d))
call SetLightningColor(EJO,.5,.5,1,1)
call c7(K3V,"Light",EJO)
call SetDestructableAnimation(d,"stand hit")
else
call QDV(m5,.5,false)
endif
endif
call KillUnit(RSX)
endif
endif
set t=null
set RSX=null
set m5=null
set EJO=null
set QJV=null
set d=null
set KNR=null
set s=null
return false
endfunction
function KBR takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local real l4=Atan2(GetUnitY(m5)-GetUnitY(p5),GetUnitX(m5)-GetUnitX(p5))
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit RSX=CreateUnit(GetOwningPlayer(p5),'h077',GetUnitX(p5),GetUnitY(p5),l4*bj_RADTODEG)
local integer JFV=GetUnitAbilityLevel(p5,'A12J')
local boolean DWE=(GetUnitAbilityLevel((GetSpellTargetUnit()),'B0BI')>0)==false
call A7(K3V,"Projectile",RSX)
call A7(K3V,"Target",m5)
call n7(K3V,"Level",JFV)
call E7(K3V,"OriginalAngle",(l4)*1.)
call O7(K3V,"Active",DWE)
call DFV(t,'s',p5)
call TriggerRegisterTimerEvent(t,.033,true)
call TriggerAddCondition(t,Condition(function KIR))
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
set p5=null
set m5=null
set t=null
endfunction
function abe takes nothing returns boolean
if GetSpellAbilityId()=='A12J' then
call KBR()
endif
return false
endfunction
function V0E takes nothing returns nothing
call CZV('A12J',"KBR")
endfunction
function KCR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local integer JFV=E8(K3V,"Level")
local integer KDR=E8(K3V,"BonusID")
call DestroyEffect(AddSpecialEffect("effects\\Tornado.mdx",GetUnitX(p5),GetUnitY(p5)))
if GetTriggerEvalCount(t)>$A*(2+.75*JFV)or GetTriggerEventId()==EVENT_UNIT_DEATH then
call UnitRemoveAbility(p5,KDR)
call UnitRemoveAbility(p5,'B09W')
call DestroyEffect(r8(K3V,"FX1"))
call DestroyEffect(r8(K3V,"FX2"))
call a7(K3V)
call KJV(t)
endif
set t=null
set p5=null
return false
endfunction
function KFR takes nothing returns nothing
local unit p5=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local integer JFV=GetUnitAbilityLevel(p5,'A14I')
local integer KDR
if JFV==1 then
set KDR='A135'
elseif JFV==2 then
set KDR='A12O'
elseif JFV==3 then
set KDR='A134'
elseif JFV==4 then
set KDR='A139'
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),KDR,false)
call PXV(p5,KDR,1,2+.75*JFV)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function KCR))
call A7(K3V,"Source",p5)
call n7(K3V,"Level",JFV)
call n7(K3V,"BonusID",KDR)
call b7(K3V,"FX1",AddSpecialEffectTarget("effects\\Tornado.mdx",p5,"hand,left"))
call b7(K3V,"FX2",AddSpecialEffectTarget("effects\\Tornado.mdx",p5,"hand,right"))
set p5=null
set t=null
endfunction
function afe takes nothing returns boolean
if GetSpellAbilityId()=='A14I' then
call KFR()
endif
return false
endfunction
function V1E takes nothing returns nothing
call CZV('A14I',"KFR")
endfunction
function KGR takes unit p5,unit m5,real HSV,integer KHR,integer KJR returns nothing
local real PJE=(HSV)*Pow(.9,KHR)*Pow(.99,KJR)
if EIV then
set ERV=true
call FCV(I2S(R2I(PJE)),m5,true)
endif
call HPV(p5,m5,1,(HSV)*Pow(.9,KHR)*Pow(.99,KJR))
endfunction
function KKR takes nothing returns nothing
if IsUnitInGroup(GetEnumUnit(),ZB)==false and GetUnitAbilityLevel(GetEnumUnit(),'Bcyc')==0 then
call KGR(vc,GetEnumUnit(),ec,ac,xc)
call GroupAddUnit(ZB,GetEnumUnit())
set ac=ac+1
endif
endfunction
function KLR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit IJ=Y7(K3V,"Projectile")
local real J3R=X8(K3V,"TargetX")
local real J4R=X8(K3V,"TargetY")
local real RK=X8(K3V,"Angle")
local real HSV=X8(K3V,"Damage")
local integer KJR=E8(K3V,"TreeCount")
local integer KHR=E8(K3V,"UnitCount")
local group J7R=o8(K3V,"AlreadyHit")
local real x=L1V(GetUnitX(IJ)+(60*Pow(.9,KHR)*Pow(.99,KJR))*Cos(RK))
local real y=L2V(GetUnitY(IJ)+(60*Pow(.9,KHR)*Pow(.99,KJR))*Sin(RK))
local group g=KHV()
local real d
local integer i=29 
if IVV then
set i=i*4
if EMV then
set i=i*3
endif
endif
if GetTriggerEvalCount(t)>2 then
set d=$96
else
set d=75
endif
call DestroyEffect(AddSpecialEffect("effects\\Tornado.mdx",x,y))
set KJR=KJR+MMV(x,y,75)
call n7(K3V,"TreeCount",KJR)
set ZB=J7R
set vc=IJ
set ec=HSV
if IVV then

set ec=ec+B8V(HMV(IJ),true)*(1.4+.7*GetUnitAbilityLevel(HMV(IJ),'A12K'))+H4V(IJ,1)*1
if EMV then
set ec=ec+B8V(HMV(IJ),true)*(.2+.7*GetUnitAbilityLevel(HMV(IJ),'A12K'))+H4V(IJ,1)*1

endif
else
set ec=ec
endif
set xc=KJR
set ac=KHR
set xL=IJ
call GroupEnumUnitsInRange(g,x,y,d,Condition(function P0V))
call ForGroup(g,function KKR)
call KGV(g)
call n7(K3V,"UnitCount",ac)
call SetUnitX(IJ,x)
call SetUnitY(IJ,y)
if GetTriggerEvalCount(t)>i then
call KillUnit(IJ)
call KGV(J7R)
call a7(K3V)
call KJV(t)
endif 
set t=null
set IJ=null
set J7R=null
set g=null
return false
endfunction
function KMR takes nothing returns nothing
local unit p5=GetTriggerUnit()
local real x2=X8(GetHandleId(p5),"ReverseLance|x")
local real y2=X8(GetHandleId(p5),"ReverseLance|y")
local real KPR=MEV(J_V()-X8(GetHandleId(p5),"ReverseLance|Time"),1.)
local real RK=Atan2(y2-GetUnitY(p5),x2-GetUnitX(p5))
local trigger t
local integer K3V
local unit IJ
local integer JFV=GetUnitAbilityLevel(p5,'A12K')
local real HSV=(80)*(KPR)  // wind arrow damag
set t=CreateTrigger()
set K3V=GetHandleId(t)
set IJ=CreateUnit(GetOwningPlayer(p5),'h078',GetUnitX(p5),GetUnitY(p5),RK*bj_RADTODEG)
set x2=GetUnitX(p5)+$6A4*Cos(RK)
set y2=GetUnitY(p5)+$6A4*Sin(RK)
call A7(K3V,"Projectile",IJ)
call E7(K3V,"TargetX",x2)
call E7(K3V,"TargetY",y2)
call E7(K3V,"Angle",RK)
call E7(K3V,"Damage",HSV)
call n7(K3V,"TreeCount",0)
call n7(K3V,"UnitCount",0)
call F7(K3V,"AlreadyHit",KHV())
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function KLR))
set p5=null
set t=null
set IJ=null
endfunction
function KQR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit K8V=Y7(K3V,"Hero")
call SetUnitTimeScale(K8V,1)
call a7(K3V)
call KJV(t)
set t=null
set K8V=null
return false
endfunction
function KSR takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit K8V=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real x=GetLocationX(l)
local real y=GetLocationY(l)
call RemoveLocation(l)
call E7(GetHandleId(K8V),"ReverseLance|x",x)
call E7(GetHandleId(K8V),"ReverseLance|y",y)
call E7(GetHandleId(K8V),"ReverseLance|Time",J_V())
call SetUnitTimeScale(K8V,.75)
call A7(K3V,"Hero",K8V)
call TriggerRegisterTimerEvent(t,.75,false)
call TriggerRegisterUnitEvent(t,K8V,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function KQR))
set t=null
set K8V=null
endfunction
function KTR takes nothing returns boolean
if GetSpellAbilityId()=='A12K' then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_CAST then
call O7(GetHandleId(GetTriggerUnit()),"ReverseLance|Active",false)
call KSR()
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT then
call O7(GetHandleId(GetTriggerUnit()),"ReverseLance|Active",true)
elseif O8(GetHandleId(GetTriggerUnit()),"ReverseLance|Active") then
call KMR()
endif
endif
return false
endfunction
function V2E takes nothing returns nothing
local trigger t=CreateTrigger()
call MKV(t,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call MKV(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call MKV(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function KTR))
set t=null
endfunction
function KUR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local integer Q4V=E8(K3V,"TargetIndex")
local unit m5=B8(Q4V)
local real KWR=X8(K3V,"Rate")
local boolean GZX=O8(K3V,"Scepter")
if GetTriggerEvalCount(t)==1 then
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_EFFECT)
endif
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamageSource()==p5 and GZX==false then
if H3V(p5)then
call DisableTrigger(t)
call HPV(p5,m5,3,(1-KWR)*GetEventDamage())
call EnableTrigger(t)
else
call SetUnitState(m5,UNIT_STATE_LIFE,GetUnitState(m5,UNIT_STATE_LIFE)+(KWR)*GetEventDamage())
endif
endif
elseif GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT then 
if GetSpellAbilityId()=='A12P' or GetSpellAbilityId()=='A1D6' then
call b8(Q4V)
call a7(K3V)
call KJV(t)
endif
else
call UnitRemoveAbility(p5,'A12R')
call UnitRemoveAbility(p5,'B09X')
call b8(Q4V)
call a7(K3V)
call KJV(t)
call UnitRemoveAbility(p5,'A1FK')
call UnitRemoveAbility(p5,'A1FL')
call UnitRemoveAbility(p5,'A1FJ')
endif
set t=null
set p5=null
set m5=null
return false
endfunction
function KYR takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local integer JFV=GetUnitAbilityLevel(p5,'A12P')
local real KWR=.6-JFV*.1
local boolean GZX=false
call UnitRemoveAbility(p5,'A12R')
call UnitRemoveAbility(p5,'B09X')
if JFV==0 then
call UnitRemoveAbility(p5,'A1FK')
call UnitRemoveAbility(p5,'A1FL')
call UnitRemoveAbility(p5,'A1FJ')
set GZX=true
set JFV=GetUnitAbilityLevel(p5,'A1D6')
set KWR=.6-JFV*.15
if JFV==1 then
call UnitAddAbility(p5,'A1FK')
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1FK',false)
elseif JFV==2 then
call UnitAddAbility(p5,'A1FL')
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1FL',false)
elseif JFV==3 then
call UnitAddAbility(p5,'A1FJ')
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1FJ',false)
endif
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A12R',false)
call UnitAddAbility(p5,'A12R')
call IssueTargetOrderById(p5,$D000F,m5)
call A7(K3V,"Source",p5)
call O7(K3V,"Scepter",GZX)
call n7(K3V,"TargetIndex",c8(m5))
call E7(K3V,"Rate",KWR)
call n7(K3V,"Attacks",0)
call A7(GetHandleId(p5),"Target",m5)
call TriggerRegisterTimerEvent(t,20,false)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DAMAGED)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function KUR))
set p5=null
set m5=null
set t=null
endfunction
function ate takes nothing returns boolean
if GetSpellAbilityId()=='A12P' or GetSpellAbilityId()=='A1D6' then
call KYR()
endif
return false
endfunction
function KZR takes unit p5 returns nothing
call DestroyEffect(AddSpecialEffectTarget("effects\\Tornado.mdx",p5,"hand,left"))
call DestroyEffect(AddSpecialEffectTarget("effects\\Tornado.mdx",p5,"hand,right"))
endfunction
function K_R takes nothing returns boolean
if GetUnitAbilityLevel(GetAttacker(),'AB71')>0 then
call KZR(GetAttacker())
endif
return false
endfunction
function A12PZZ takes nothing returns nothing
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local integer i=GetUnitAbilityLevel(s,GetSpellAbilityId())
local boolean b=GetSpellAbilityId()=='A12P'
local real r=GetRandomInt(23,44)+Ld(s)
if b==false then
set r=r+C8V(s)
endif
call A7(GetHandleId(s),"Target",u)
call IssueTargetOrderById(s,$D000F,u)
set r=r*.2*i
set i=R2I(r)
call J6V(s,'AB71','B971',$E10,i,0,5000,0,0,0,0)
set s=null
set u=null
endfunction
function A12PA takes nothing returns nothing
local unit s=DHV(GetTriggeringTrigger(),'s')
if GetUnitTypeId(s)=='N0EG'then
call GDV()
elseif GetUnitAbilityLevel(s,'AB71')==0 then
call UnitAddAbility(s,'AA7C')
call UnitRemoveAbility(s,'AA7C')
