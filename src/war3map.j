function TFV takes nothing returns nothing
call KAV(bj_FORCE_ALL_PLAYERS,25.,(lt[GetPlayerId((GetTriggerPlayer()))])+"|c00ff0303 "+(GetObjectName(('n02D')))+"|r")
endfunction
function Jf takes nothing returns nothing
local player JF=v8(GetHandleId(GetExpiredTimer()),"Leaver")
local integer T8=1
local integer Jg
local integer hY=GetPlayerState(JF,PLAYER_STATE_RESOURCE_GOLD)
if hY>20 then
call SetPlayerState(JF,PLAYER_STATE_RESOURCE_GOLD,0)
if C8(JF)then
set Jg=P8(ce)
else
set Jg=P8(Ce)
endif
if C8(JF)then
loop
exitwhen T8>5
if m8(A7V[T8])then
call SetPlayerState(A7V[T8],PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(A7V[T8],PLAYER_STATE_RESOURCE_GOLD)+hY/Jg)
endif
set T8=T8+1
endloop
else
loop
exitwhen T8>5
if m8(A8V[T8])then
call SetPlayerState(A8V[T8],PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(A8V[T8],PLAYER_STATE_RESOURCE_GOLD)+hY/Jg)
endif
set T8=T8+1
endloop
endif
endif
endfunction
