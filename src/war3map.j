endfunction
function NMR takes nothing returns boolean
local item OVE
local integer NPR
local unit AGR=GetTriggerUnit()
local trigger t
local integer K3V
local integer n5
local integer NQR
local integer id
if GetItemTypeId(GetManipulatedItem())=='I0HM'or K8E(GetItemTypeId(GetManipulatedItem()))then
set t=null
set AGR=null
set OVE=null
return false
endif
set id=GetPlayerId(GetOwningPlayer(AGR))
if IsUnitType(AGR,UNIT_TYPE_HERO) or PDV(AGR)then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_PICKUP_ITEM then
if GetItemTypeId(GetManipulatedItem())==Ac[zC]then
set nH=nH+1
set AZ[id]=AZ[id]+1
elseif GetItemTypeId(GetManipulatedItem())==Ac[aC]then
set EH=EH+1
set NZ[id]=NZ[id]+1
elseif GetItemTypeId(GetManipulatedItem())==Ac[NQV]then
set OH=OH+1
set bZ[id]=bZ[id]+1
elseif GetItemTypeId(GetManipulatedItem())==Ac[AD]then
set RH=RH+1
set BZ[id]=BZ[id]+1
elseif GetItemTypeId(GetManipulatedItem())==Ac[NLV]then
set aH=aH+1
set cZ[id]=cZ[id]+1
call UnitAddItemById(AGR,'I0HM')
elseif GetItemTypeId(GetManipulatedItem())==Ac[Lf]then
set AH=AH+1
set CZ[id]=CZ[id]+1
endif
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_DROP_ITEM then
if GetItemTypeId(GetManipulatedItem())==Ac[zC]then
set AZ[id]=AZ[id]-1
set nH=nH-1
elseif GetItemTypeId(GetManipulatedItem())==Ac[aC]then
set NZ[id]=NZ[id]-1
set EH=EH-1
elseif GetItemTypeId(GetManipulatedItem())==Ac[NQV]then
set bZ[id]=bZ[id]-1
set OH=OH-1
elseif GetItemTypeId(GetManipulatedItem())==Ac[AD]then
set RH=RH-1
set BZ[id]=BZ[id]-1
if BZ[id]<1 or C5(AGR,Ac[AD],GetManipulatedItem())==null then
call UnitRemoveAbility(AGR,'A174')
endif
elseif GetItemTypeId(GetManipulatedItem())==Ac[NLV]then
set aH=IMaxBJ(aH-1,0)
set cZ[id]=IMaxBJ(cZ[id]-1,0)
call UnitRemoveAbility(AGR,'B0BI')
elseif GetItemTypeId(GetManipulatedItem())==Ac[Lf]then
set CZ[id]=CZ[id]-1
set AH=AH-1
endif
endif
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_PAWN_ITEM then
set OVE=GetSoldItem()
call SetItemUserData(OVE,-2)
set n5=RMR(AGR)
set NQR=RPR(AGR)
if C5(AGR,Ac[n5],OVE)==null and GetUnitAbilityLevel(AGR,NQR)>0 then
call UnitRemoveAbility(AGR,NQR)
endif
elseif GetItemTypeId(GetManipulatedItem())!='I00E' and GetItemTypeId(GetManipulatedItem())!='I02M' then
set OVE=GetManipulatedItem()
if IsUnitIllusion(AGR)or GetItemUserData(OVE)==-2 then
set OVE=null
set AGR=null
set t=null
return false
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_PICKUP_ITEM then
set NPR=1
else
set NPR=2
endif
if(NPR==1 or(NPR==2 and R0R(OVE)==false and GetWidgetLife(OVE)>0))and GetUnitTypeId(AGR)!='H00J' then
set t=CreateTrigger()
set K3V=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function NOR))
call A7(K3V,"Unit",AGR)
call n7(K3V,"EventType",NPR)
call n7(K3V,"indexId",CUV(OVE))
if R0R(OVE)then
call O7(K3V,"Temporary",true)
call D7(K3V,"p",GetItemPlayer(OVE))
call n7(K3V,"charges",GetItemCharges(OVE))
call E7(K3V,"x",(GetItemX(OVE))*1.)
call E7(K3V,"y",(GetItemY(OVE))*1.)
else
call O7(K3V,"Temporary",false)
call f7(K3V,"Item",OVE)
call SetItemUserData(OVE,0)
endif
endif
endif
set OVE=null
set AGR=null
set t=null
return false
endfunction
function NSR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
