function RQR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local integer n5=E8(K3V,"itemId")
local real x=X8(K3V,"x")
local real y=X8(K3V,"y")
local player p=v8(K3V,"p")
local boolean RSR=O8(K3V,"consumable")
local integer N6E=E8(K3V,"charges")
local item ZMO=CreateItem(n5,x,y)
call SetItemPlayer(ZMO,p,true)
call SetItemUserData(ZMO,0)
if RSR then
call SetItemCharges(ZMO,N6E)
endif
call a7(K3V)
call KJV(t)
set t=null
set p=null
return false
endfunction
function RTR takes integer n5,real x,real y,player p,boolean RSR,integer N6E returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
call n7(K3V,"itemId",n5)
call E7(K3V,"x",x*1.)
call E7(K3V,"y",y*1.)
call D7(K3V,"p",p)
call O7(K3V,"consumable",RSR)
call n7(K3V,"charges",N6E)
call TriggerAddCondition(t,Condition(function RQR))
call TriggerRegisterTimerEvent(t,0,false)
set t=null
endfunction
function RUR takes unit S4,integer DRE,item Z4 returns item
local integer D5
local item f5
set D5=0
loop
exitwhen D5>5
set f5=UnitItemInSlot(S4,D5)
if f5!=null and f5!=Z4 and CUV(f5)==DRE then
set f5=null
return UnitItemInSlot(S4,D5)
endif
set D5=D5+1
endloop
set f5=null
return null
endfunction
function RWR takes unit S4,integer DRE returns item
local integer D5
local item f5
set D5=0
loop
exitwhen D5>5
set f5=UnitItemInSlot(S4,D5)
if(f5!=null)and(CUV(f5)==DRE)then
set f5=null
return UnitItemInSlot(S4,D5)
endif
set D5=D5+1
endloop
set f5=null
return null
endfunction
function RYR takes unit S4 returns integer
local integer i=0
local integer n=0
local integer SVV=UnitInventorySize(S4)-1
loop
exitwhen i>SVV
if UnitItemInSlot(S4,i)==null then
set n=n+1
endif
set i=i+1
endloop
return n
endfunction
function RZR takes item Z4 returns integer
local integer n5
local integer i=1
if Z4==null then
return-2
endif
set n5=GetItemTypeId(Z4)
loop
exitwhen i>fc
if bc[i]==n5 then
return Ac[i]
endif
set i=i+1
endloop
return-1
endfunction
function R_R takes integer DRE returns integer
if NRV==DRE then
return 3
endif
if NIV==DRE or NAV==DRE or pd==DRE or Fd==DRE or qd==DRE then
return 2
endif
return 1
endfunction
function R0R takes item Z4 returns boolean
return GetItemType(Z4)==ITEM_TYPE_POWERUP or GetItemType(Z4)==ITEM_TYPE_PURCHASABLE or GetItemType(Z4)==ITEM_TYPE_MISCELLANEOUS
endfunction
