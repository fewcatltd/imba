function TBR takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
local group g=null
local boolexpr b=null
local integer i=0
local real r=0
local unit s=null
local integer l=0
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if GetUnitAbilityLevel(u,'A0AQ')+GetUnitAbilityLevel(u,'A06X')==0 then
call DYV(u,'a0AQ',true)
call FIV()
else
if GetUnitAbilityLevel(u,'B024')>0 then
set i=GetUnitAbilityLevel(u,'A0AQ')+GetUnitAbilityLevel(u,'A06X')
set r=20*i*.25
if GetUnitState(u,UNIT_STATE_MANA)<r then
call IssueImmediateOrderById(u,$D00D2)
set u=null
return
else
call HGV(u,false,-r)
endif
if i>0 and ITV-DWV(u,'a06X')>0 then
call DUV(u,'a06X',ITV+.995)
set g=CreateGroup()
set b=Condition(function PJV)
set AUV=u
call GroupEnumUnitsInRange(g,x,y,$FA+50*i+24,b)
set r=22+44*i
if GetUnitAbilityLevel(u,'A0AQ')>0 then
set r=r+33-$B*C0V(i==1)
endif
set r=r+H4V(u,1)*.1
loop
set s=FirstOfGroup(g)
exitwhen s==null
set l=0
if ITV-DWV(s,'A06X')<0 then
set l=DTV(s,'a06x')+1
endif
call DPV(s,'a06x',l)
call DUV(s,'A06X',ITV+1.5)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",s,"origin"))
if l==0 then
call HPV(u,s,1,r)
else
call HPV(u,s,1,r*Pow(1.1,l))
endif
call GroupRemoveUnit(g,s)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
endif
endif
set u=null
endfunction
