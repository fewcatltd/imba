call UnitAddAbility(oA,'A10M')
call SetUnitAbilityLevel(oA,'A10M',JFV)
call IssuePointOrderById(oA,$D02AC,GetLocationX(l),GetLocationY(l))
call TriggerRegisterTimerEvent(t,.25,true)
