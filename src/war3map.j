elseif JB then
call UnitAddItem(YE,CreateItem(Ac[Wd],0,0))
elseif Jb then
call UnitAddItem(YE,CreateItem(Ac[yd],0,0))
elseif UGX then
call UnitAddItem(YE,CreateItem(Ac[eD],0,0))
elseif UHX then
call UnitAddItem(YE,CreateItem(Ac[zd],0,0))
elseif JA then
call UnitAddItem(YE,CreateItem(Ac[Fc],0,0))
endif
call EnableTrigger(t)
call T4()
endfunction
function Yf takes nothing returns nothing
local unit JP=GetTriggerUnit()
local integer i=0
local boolean JA=false
local boolean Jb=false
local boolean JB=false
local boolean UGX=false
local boolean UHX=false
local boolean UKX=false
local integer yP=GetHandleId(GetOwningPlayer(JP))
local unit JN=Y7(yP,"Kobold0")
local unit Jo=Y7(yP,"Kobold1")
local unit JO=Y7(yP,"Kobold2")
local unit Jp=Y7(yP,"Kobold3")
local integer OC
local boolean YF=false
local integer Yg=0
local integer YG=0
local integer Yh=0
local integer ULX=0
call DisableTrigger(GetTriggeringTrigger())
if GetUnitTypeId(JP)=='H00J'then
call UnitRemoveItemFromSlot(JP,0)
call EnableTrigger(GetTriggeringTrigger())
return
endif
if not(GetItemTypeId(GetManipulatedItem())==Ac[Fc]or GetItemTypeId(GetManipulatedItem())==Ac[yd]or GetItemTypeId(GetManipulatedItem())==Ac[Wd]or GetItemTypeId(GetManipulatedItem())==Ac[eD]or GetItemTypeId(GetManipulatedItem())==Ac[zd]or GetItemTypeId(GetManipulatedItem())==Ac[gF])then
call EnableTrigger(GetTriggeringTrigger())
return
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_DROP_ITEM then
set YF=true
endif
loop
exitwhen i>5
set OC=GetItemTypeId(UnitItemInSlot(JP,i))
if OC==Ac[Fc]then
set Yg=Yg+1
if(not(YF and OC==GetItemTypeId(GetManipulatedItem())))or(Yg>1 and OC==GetItemTypeId(GetManipulatedItem()))then
set JA=true
endif
endif
if OC==Ac[yd]then
set YG=YG+1
if(not(YF and OC==GetItemTypeId(GetManipulatedItem())))or(YG>1 and OC==GetItemTypeId(GetManipulatedItem()))then
set Jb=true
endif
endif
if OC==Ac[Wd]then
set Yh=Yh+1
if(not(YF and OC==GetItemTypeId(GetManipulatedItem())))or(Yh>1 and OC==GetItemTypeId(GetManipulatedItem()))then
set JB=true
endif
endif
if OC==Ac[eD]then
set Yh=Yh+1
if(not(YF and OC==GetItemTypeId(GetManipulatedItem())))or(Yh>1 and OC==GetItemTypeId(GetManipulatedItem()))then
set UGX=true
endif
endif
if OC==Ac[zd]then
set Yh=Yh+1
if(not(YF and OC==GetItemTypeId(GetManipulatedItem())))or(Yh>1 and OC==GetItemTypeId(GetManipulatedItem()))then
set UHX=true
endif
endif
if OC==Ac[gF]then
set ULX=ULX+1
if(not(YF and OC==GetItemTypeId(GetManipulatedItem())))or(ULX>1 and OC==GetItemTypeId(GetManipulatedItem()))then
set UKX=true
endif
endif
set i=i+1
endloop
call RemoveItem(UnitRemoveItemFromSlot(Jo,0))
if JO!=null then
call RemoveItem(UnitRemoveItemFromSlot(JO,0))
endif
if JO!=null then
call RemoveItem(UnitRemoveItemFromSlot(Jp,0))
endif
if UKX then
call UnitAddItem(Jo,CreateItem(Ac[gF],0,0))
if JO!=null then
call UnitAddItem(JO,CreateItem(Ac[gF],0,0))
endif
if Jp!=null then
call UnitAddItem(Jp,CreateItem(Ac[gF],0,0))
endif
elseif JB then
call UnitAddItem(Jo,CreateItem(Ac[Wd],0,0))
if JO!=null then
call UnitAddItem(JO,CreateItem(Ac[Wd],0,0))
endif
if Jp!=null then
call UnitAddItem(Jp,CreateItem(Ac[Wd],0,0))
endif
elseif Jb then
call UnitAddItem(Jo,CreateItem(Ac[yd],0,0))
if JO!=null then
call UnitAddItem(JO,CreateItem(Ac[yd],0,0))
endif
if Jp!=null then
call UnitAddItem(Jp,CreateItem(Ac[yd],0,0))
endif
elseif UGX then
call UnitAddItem(Jo,CreateItem(Ac[eD],0,0))
if JO!=null then
call UnitAddItem(JO,CreateItem(Ac[eD],0,0))
endif
if Jp!=null then
call UnitAddItem(Jp,CreateItem(Ac[eD],0,0))
endif
elseif UHX then
call UnitAddItem(Jo,CreateItem(Ac[zd],0,0))
if JO!=null then
call UnitAddItem(JO,CreateItem(Ac[zd],0,0))
endif
if Jp!=null then
call UnitAddItem(Jp,CreateItem(Ac[zd],0,0))
endif
elseif JA then
call UnitAddItem(Jo,CreateItem(Ac[Fc],0,0))
if JO!=null then
call UnitAddItem(JO,CreateItem(Ac[Fc],0,0))
endif
if Jp!=null then
call UnitAddItem(Jp,CreateItem(Ac[Fc],0,0))
endif
endif
call EnableTrigger(GetTriggeringTrigger())
endfunction
