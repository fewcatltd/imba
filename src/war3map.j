// IMBA131: -zoom [N]  camera distance for the typing player only (local, no desync). Max 2500, "-zoom 0" = default 1650
function IMBA131_ZoomSet takes real d returns nothing
call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE,d,0)
if d>1650 then
call SetCameraField(CAMERA_FIELD_FARZ,10000,0)
else
call SetCameraField(CAMERA_FIELD_FARZ,5000,0)
endif
endfunction
function IMBA131_ZoomTick takes nothing returns nothing
local real d=IMBA131_Zoom[GetPlayerId(GetLocalPlayer())]
if d>0 then
if GetCameraField(CAMERA_FIELD_TARGET_DISTANCE)<d-1 or GetCameraField(CAMERA_FIELD_TARGET_DISTANCE)>d+1 then
call IMBA131_ZoomSet(d)
endif
endif
endfunction
function IMBA131_ZoomCmd takes nothing returns boolean
local string s=GetEventPlayerChatString()
local integer id=GetPlayerId(GetTriggerPlayer())
local real d=2500
if SubString(s,0,5)!="-zoom" then
return false
endif
if StringLength(s)>6 then
set d=S2R(SubString(s,6,StringLength(s)))
endif
if d<=0 then
set IMBA131_Zoom[id]=0
if GetLocalPlayer()==GetTriggerPlayer() then
call IMBA131_ZoomSet(1650)
endif
return false
endif
if d>2500 then
set d=2500
elseif d<600 then
set d=600
endif
set IMBA131_Zoom[id]=d
if GetLocalPlayer()==GetTriggerPlayer() then
call IMBA131_ZoomSet(d)
endif
return false
endfunction
function IMBA131_ZoomInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
exitwhen i>11
call TriggerRegisterPlayerChatEvent(t,Player(i),"-zoom",false)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function IMBA131_ZoomCmd))
call TimerStart(CreateTimer(),.5,true,function IMBA131_ZoomTick)
set t=null
endfunction
function IMBA131_Cond3 takes nothing returns boolean
local boolean b=(GetPlayerController(A7V[1])==MAP_CONTROL_COMPUTER and(GetAIDifficulty(A7V[1])==AI_DIFFICULTY_NORMAL or GetAIDifficulty(A7V[1])==AI_DIFFICULTY_INSANE))
set b=b or (GetPlayerController(A7V[2])==MAP_CONTROL_COMPUTER and(GetAIDifficulty(A7V[2])==AI_DIFFICULTY_NORMAL or GetAIDifficulty(A7V[2])==AI_DIFFICULTY_INSANE))
set b=b or (GetPlayerController(A7V[3])==MAP_CONTROL_COMPUTER and(GetAIDifficulty(A7V[3])==AI_DIFFICULTY_NORMAL or GetAIDifficulty(A7V[3])==AI_DIFFICULTY_INSANE))
set b=b or (GetPlayerController(A7V[4])==MAP_CONTROL_COMPUTER and(GetAIDifficulty(A7V[4])==AI_DIFFICULTY_NORMAL or GetAIDifficulty(A7V[4])==AI_DIFFICULTY_INSANE))
set b=b or (GetPlayerController(A7V[5])==MAP_CONTROL_COMPUTER and(GetAIDifficulty(A7V[5])==AI_DIFFICULTY_NORMAL or GetAIDifficulty(A7V[5])==AI_DIFFICULTY_INSANE))
set b=b or (GetPlayerController(A8V[1])==MAP_CONTROL_COMPUTER and(GetAIDifficulty(A8V[1])==AI_DIFFICULTY_NORMAL or GetAIDifficulty(A8V[1])==AI_DIFFICULTY_INSANE))
set b=b or (GetPlayerController(A8V[2])==MAP_CONTROL_COMPUTER and(GetAIDifficulty(A8V[2])==AI_DIFFICULTY_NORMAL or GetAIDifficulty(A8V[2])==AI_DIFFICULTY_INSANE))
set b=b or (GetPlayerController(A8V[3])==MAP_CONTROL_COMPUTER and(GetAIDifficulty(A8V[3])==AI_DIFFICULTY_NORMAL or GetAIDifficulty(A8V[3])==AI_DIFFICULTY_INSANE))
set b=b or (GetPlayerController(A8V[4])==MAP_CONTROL_COMPUTER and(GetAIDifficulty(A8V[4])==AI_DIFFICULTY_NORMAL or GetAIDifficulty(A8V[4])==AI_DIFFICULTY_INSANE))
set b=b or (GetPlayerController(A8V[5])==MAP_CONTROL_COMPUTER and(GetAIDifficulty(A8V[5])==AI_DIFFICULTY_NORMAL or GetAIDifficulty(A8V[5])==AI_DIFFICULTY_INSANE))
return b
endfunction
