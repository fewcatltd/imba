function ROSHFALSE takes nothing returns nothing
set ROSHDEATH=true
endfunction
function ROSHTRUE takes nothing returns nothing
set ROSHDEATH=false
endfunction
function ROSHVUN takes nothing returns nothing
call SetUnitInvulnerable(Q,false)
call SetUnitState(Q,UNIT_STATE_LIFE,ROSHDMD*2+1500)
endfunction
function ROSHDAMAGE takes nothing returns nothing
local unit u=Q
local timer tm=CreateTimer()
if GetUnitState(Q,UNIT_STATE_LIFE)-GetEventDamage()<1 and ROSHDEATH==true then
set ROSHDMD=GetEventDamage()
call SetUnitInvulnerable(Q,true)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Cure.mdx",Q,"chest"))
call TimerStart(tm,0.8,false,function ROSHVUN)
call TimerStart(CreateTimer(),6,false,function ROSHTRUE)
call TimerStart(CreateTimer(),9,false,function ROSHFALSE)
endif
set tm=null
set u=null
endfunction
function RemoveErrorEffect takes nothing returns nothing
local integer i=1
local integer l=0
local group g=KHV()
local boolexpr b=Condition(function ONI)
local unit f=null
call FIV()
loop
exitwhen i>$B
if i!=6 then
set l=GetStoredInteger(dL,"platform",I2S(i))
if l!=1 then
call GroupEnumUnitsOfPlayer(g,Player(i),b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call UnitRemoveAbility(f,XOV[i])
call GroupRemoveUnit(g,f)
endloop
set XOV[i]=-1
call LYV(Player(i),GetObjectName('SMF5'))
endif
endif
set i=i+1
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
function InitFXOrbData takes nothing returns nothing
local integer id=0
local integer i=0
set id='FX00'
loop
exitwhen id>'FX09'
set XIV[XRV]=id
set XRV=XRV+1
set id=id+1
endloop
set id='FX0A'
loop
exitwhen id>'FX0D'
set XIV[XRV]=id
set XRV=XRV+1
set id=id+1
endloop
endfunction
function RXI takes nothing returns nothing
call s8('U006')
endfunction
function ROI takes nothing returns nothing
local integer i=1
local integer l=0
local unit u=null
local integer x=0
local real r=0
local real d=0
loop
exitwhen i>5
call KFV(A7V[i])
call KFV(A8V[i])
if GetPlayerState(A7V[i],PLAYER_STATE_RESOURCE_GOLD)>=$2710 then
call KDV(A7V[i],'CJ03')
endif
if GetPlayerState(A8V[i],PLAYER_STATE_RESOURCE_GOLD)>=$2710 then
call KDV(A8V[i],'CJ03')
endif
set l=GetPlayerId(A7V[i])
set u=ie[l]
set d=.2
set r=0
if GetWidgetLife(u)>1 then
set x=C7V(u,'I0KL')+C7V(u,'I0A9')
loop
exitwhen x<1
set r=r+d
set d=d-.03
set x=x-1
endloop
call SetPlayerHandicap(A7V[i],1+r)
else
call SetPlayerHandicap(A7V[i],1)
endif
if C7V(u,'I600')>0 and C7V(u,'I60I')>0 and C7V(u,'I60S')>0 and C7V(u,'I71I')>0 then
call KDV(GetOwningPlayer(u),'CJ06')
endif
set l=GetPlayerId(A8V[i])
set u=ie[l]
set d=.2
set r=0
if GetWidgetLife(u)>1 then
set x=C7V(u,'I0KL')+C7V(u,'I0A9')
loop
exitwhen x<1
set r=r+d
set d=d-.03
set x=x-1
endloop
call SetPlayerHandicap(A8V[i],1+r)
else
call SetPlayerHandicap(A8V[i],1)
endif
if C7V(u,'I600')>0 and C7V(u,'I60I')>0 and C7V(u,'I60S')>0 and C7V(u,'I71I')>0 then
call KDV(GetOwningPlayer(u),'CJ06')
endif
set i=i+1
endloop
set u=null
endfunction
function RRI takes nothing returns nothing
local group g=CreateGroup()
local boolexpr b=Condition(function j6)
local unit f=null
call GroupEnumUnitsOfPlayer(g,Player($C),b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call UnitSetUsesAltIcon(f,false)
call GroupRemoveUnit(g,f)
endloop
call GroupEnumUnitsOfPlayer(g,Player($F),b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call UnitSetUsesAltIcon(f,false)
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endfunction
function RII takes integer id,integer RAI returns nothing
set RAI=R2I(RAI*Y4)
set RAI=IMaxBJ(RAI,1)
set Y4=Y4*(1-1./RAI)
set H2[HZ]=id
set H3[HZ]=RAI
set HZ=HZ+1
endfunction
function RNI takes nothing returns nothing
call RII('okod',$3E8)// adds regen haste and damage
call RII('I80K',650)
call RII('I08G',500)//replace with yasha
call RII('I08H',500)//replace with sange
call RII('I722',$3E8)
call RII('I0AW',$3E8)//replace with ageis
call RII('AB81',50) //set exp game to 1.7
call RII('I71I',$A)
call RII('CJ32',$3E8)
call RII('I0JI',40)//ghost staff
call RII('I0BD',20)//replace with Arcane Ring
call RII('I05Y',$A)// replace with boots
call RII('I0HI',$A)//replace with magic want with unlimit chargers
call RII('I06D',20)
call RII('I06F',7) //replace with oblivain staff
call RII('I062',$A)
call RII('I04R',$A)
call RII('I728',300)
call RII('I093',$C8)
call RII('I08T',$C8)// replace with helm of demi
call RII('I0BM',$C8)
call RII('I052',50) //replace with ulitim orb
endfunction
function PrintLuckyTime takes nothing returns nothing
local integer i=0
local real l=0
local real r=0
local integer id=0
local string s=null
loop
exitwhen i>=HZ
set l=l+1./H3[i]
set i=i+1
endloop
set l=l+Y4
set i=0
loop
exitwhen i>=HZ
set id=H2[i]
if id=='okod'then
set s="Kodo"
elseif id=='AB81'then
set s="Brewfest"
elseif id=='CJ32'then
set s="Nothing"
else
set s=GetObjectName(id)
endif
set s=s+"  "
call BJDebugMsg(s+R2S((1./H3[i])*'d'/l)+"%")
set i=i+1
endloop
call BJDebugMsg("Gold  "+R2S(Y4/l*'d')+"%")
endfunction
function ShowDropItemData takes nothing returns nothing
local integer i=0
local real r='d'
loop
exitwhen i>=AVV
set r=r*('d'-100./I8V[i])*.01
call BJDebugMsg(R2S(r)+"%")
set i=i+1
endloop
call BJDebugMsg(R2S(r)+"%")
endfunction
function FixItemDropBug takes nothing returns nothing
local integer i=0
local integer l=1
local integer id=0
local unit u=null
loop
exitwhen l>5
set id=GetPlayerId(A7V[l])
set u=ie[id]
if GetWidgetLife(u)>1 then
if OS[l*7+i]>0 then
if GetItemTypeId(UnitItemInSlot(u,l))==OS[l*7+i]then
set OU[$A+id*7+l]=null
set OS[l*7+i]=0
else
call RemoveItem(OU[$A+id*7+l])
set OU[$A+id*7+l]=X8E(u,OS[l*7+i],l)
endif
endif
else
if OU[$A+id*7+l]!=null then
call RemoveItem(OU[$A+id*7+l])
set OU[$A+id*7+l]=null
endif
endif
set id=GetPlayerId(A8V[l])
set u=ie[id]
if GetWidgetLife(u)>1 then
if OS[l*7+i]>0 then
if GetItemTypeId(UnitItemInSlot(u,l))==OS[l*7+i]then
set OU[$A+id*7+l]=null
set OS[l*7+i]=0
else
call RemoveItem(OU[$A+id*7+l])
set OU[$A+id*7+l]=X8E(u,OS[l*7+i],l)
endif
endif
else
if OU[$A+id*7+l]!=null then
call RemoveItem(OU[$A+id*7+l])
set OU[$A+id*7+l]=null
endif
endif
set l=l+1
endloop
endfunction
function RBI takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local real d=DNV(s,u)
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local real a=HYV(s,u)
call SetUnitFacing(s,a*bj_DEGTORAD)
call SetUnitAnimationByIndex(s,$C)
if GetWidgetLife(u)<1 then
call SetUnitTimeScale(s,1)
call IssueImmediateOrderById(s,$D0004)
call PauseUnit(s,false)
call UnitRemoveAbility(s,'Avul')
call FIV()
elseif d<'d' then
call SetUnitTimeScale(s,1)
call IssueImmediateOrderById(s,$D0004)
call IssueTargetOrderById(s,$D000F,u)
call HPV(s,u,2,500)
call QDV(u,2,true)
call PauseUnit(s,false)
call UnitRemoveAbility(s,'Avul')
call FIV()
else
set x=x+Cos(a)*50
set y=y+Sin(a)*50
call SetUnitX(s,x)
call SetUnitY(s,y)
endif
set s=null
set u=null
set t=null
endfunction
function RCI takes nothing returns boolean
return GetWidgetLife(GetFilterUnit())>1 and IsUnitOwnedByPlayer(GetFilterUnit(),Player($C))and GetUnitTypeId(GetFilterUnit())=='nfpu'and DWV(GetFilterUnit(),'BO61')>ITV
endfunction
function RDI takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local group g=null
local boolexpr b=null
local unit f=null
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local timer tm=null
local real QZV=GetWidgetLife(s)
local real RFI=DWV(t,'life')
if RFI-QZV>500 then
call SetWidgetLife(s,RFI)
endif
if GetWidgetLife(s)>1 then
if GetUnitLifePercent(s)<20 then
call GTV(s,$F423F)
call HGV(s,true,$A)
call CCV(s,false,true)
call UnitAddAbility(s,'AA98')
call UnitMakeAbilityPermanent(s,true,'AA98')
if GetTriggerEvalCount(t)-GetTriggerEvalCount(t)/$A*$A==0 then
set g=CreateGroup()
set b=Condition(function RCI)
call GroupEnumUnitsInRange(g,x,y,600,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call HPV(s,f,5,$5F5E0FF)
call HGV(s,true,$BB8)
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
else
call GTV(s,0)
call UnitRemoveAbility(s,'AA98')
endif
endif
call DUV(t,'life',GetWidgetLife(s))
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call KDV(GetOwningPlayer(GetKillingUnit()),'CJ33')
call SetItemPlayer(CreateItem(Oc[FL],x,y),GetOwningPlayer(GetKillingUnit()),false)
call GDV()
elseif UnitMakeAbilityPermanent(s,true,'Avul')then
elseif IsUnitInRegion(ow,s)==false then
call SetUnitPosition(s,XAV,XNV)
call SetWidgetLife(s,$F423F)
call SetUnitAnimation(s,"stand")
else
set g=CreateGroup()
set b=Condition(function PLV)
call GroupEnumUnitsInRange(g,x,y,700,b)
set f=FirstOfGroup(g)
if f==null then
if IsUnitInRangeXY(s,XAV,XNV,20)==false then
call SetUnitPosition(s,XAV,XNV)
call SetWidgetLife(s,$F423F)
call SetUnitAnimation(s,"stand")
endif
else
if GetUnitCurrentOrder(s)!=851983or IsUnitInRegion(ow,DHV(t,'u'))==false or GetWidgetLife(DHV(t,'u'))<1 then
call IssueTargetOrderById(s,$D000F,f)
call DFV(t,'u',f)
endif
set f=DHV(t,'u')
if IsUnitInRange(s,f,300)==false then
