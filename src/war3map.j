function H_X takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
local unit f=null
local group g=null
local boolexpr b=null
if GetTriggerEventId()==EVENT_UNIT_DEATH or DTV(t,'l')<1 then
call GDV()
else
call DQV(t,'l',-1)
set g=CreateGroup()
set b=Condition(function PJV)
set AUV=u
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),750,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if GetUnitAbilityLevel(f,'BEer')==0 then
call HXV(u,'A06T',1,"entanglingroots",f)
endif
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set t=null
set u=null
set g=null
set b=null
endfunction
function H0X takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer i=GetUnitAbilityLevel(u,'A07Z')
local trigger t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.25,true)
call TriggerAddCondition(t,Condition(function H_X))
call DFV(t,'u',u)
if IVV then
if EMV then
call DPV(t,'l',((i+2)*4)+1)
else
call DPV(t,'l',(4+2*i)*4)
endif
else
call DPV(t,'l',((i+2)*4))
endif
set u=null
set t=null
endfunction
