exitwhen u==null
if u!=null then
call GroupRemoveUnit(g,u)
endif
endif
set u=CreateUnit(GetTriggerPlayer(),'e00E',GetUnitX(u),GetUnitY(u),0)
call UnitAddAbility(u,id)
call SetUnitAbilityLevel(u,id,i)
call IssueTargetOrderById(u,$D007F,HOV)
endloop
call DestroyGroup(g)
set g=null
endif
