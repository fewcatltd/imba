function OSE takes nothing returns boolean
return(IsUnitType(GetSoldUnit(),UNIT_TYPE_HERO))!=null
endfunction
function OTE takes nothing returns nothing
local unit K8V=GetSoldUnit()
local player j8=GetOwningPlayer(K8V)
if((jz!=null)and(IsTriggerEnabled(jz)))then
if((GetOwningPlayer(GetSoldUnit())==dz)and(HH!=null))then
set K8V=null
set j8=null
return
elseif((GetOwningPlayer(GetSoldUnit())==Dz)and(Hi!=null))then
set K8V=null
set j8=null
return
endif
endif
call t8(j8)
set K8V=null
set j8=null
endfunction
function OUE takes nothing returns nothing
local integer OWE
local integer O5=1
local integer i=0
loop
exitwhen O5>5
if(GetPlayerController(A7V[O5])!=MAP_CONTROL_USER)then
if(ty)then
set OWE=3
elseif yb then
if not U then
set OWE=1
else
set OWE=2
endif
elseif(GetAIDifficulty(A7V[O5])==AI_DIFFICULTY_NORMAL)then
if oB then
set OWE=2
else
set OWE=1
endif
elseif(GetAIDifficulty(A7V[O5])==AI_DIFFICULTY_INSANE)then
set OWE=2
else
set OWE=1
endif
else
if(U)then
set OWE=2
else
set OWE=1
endif
endif
call SetPlayerState(A7V[O5],PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(A7V[O5],PLAYER_STATE_RESOURCE_GOLD)+OWE)
if(GetPlayerController(A8V[O5])!=MAP_CONTROL_USER)then
if(ty)then
set OWE=3
elseif yb then
if not U then
set OWE=1
else
set OWE=2
endif
elseif(GetAIDifficulty(A8V[O5])==AI_DIFFICULTY_NORMAL)then
if oB then
set OWE=2
else
set OWE=1
endif
elseif(GetAIDifficulty(A8V[O5])==AI_DIFFICULTY_INSANE)then
set OWE=2
else
set OWE=1
endif
else
if(U)then
set OWE=2
else
set OWE=1
endif
endif
call SetPlayerState(A8V[O5],PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(A8V[O5],PLAYER_STATE_RESOURCE_GOLD)+OWE)
set O5=O5+1
endloop
set oB=not oB
endfunction
function OYE takes nothing returns boolean
if IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) and(LoadInteger(Nu,(GetSpellAbilityId()),(GetUnitAbilityLevel(GetTriggerUnit(),GetSpellAbilityId()))))>0 then
call TimerStart(bu[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))],(LoadInteger(Nu,(GetSpellAbilityId()),(GetUnitAbilityLevel(GetTriggerUnit(),GetSpellAbilityId())))),false,null)
endif
if GetSpellAbilityId()=='A02W' then
call TimerStart(bu[GetPlayerId((GetOwningPlayer(GetTriggerUnit())))],0,false,null)
endif
return false
endfunction
