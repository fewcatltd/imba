endfunction
function P3R takes nothing returns nothing
local unit NER=GetTriggerUnit()
local player p=GetOwningPlayer(NER)
local integer P4R=GetUnitPointValue(GetSpellTargetUnit())
local integer P5R=GetUnitAbilityLevel(NER,GetSpellAbilityId())
local integer P6R=GetSpellAbilityId()
local integer PKR=GetPlayerId(p)
local unit T6V=null
local integer P7R=0
local integer P8R=0
local integer P9R=0
local string QVR=""
local string QER=""
local boolean GZX=c5(NER,Ac[ph])
local trigger t
local integer QXR=NVR(NER,1)
local integer QOR=NVR(NER,2)
local integer QRR=NVR(NER,3)
local integer QIR=NVR(NER,4)
if P6R=='A500' then
set P7R=PH[P4R]
set P8R=UH[P4R]
set QVR=ZH[P4R]
set QER="Abilities\\Spells\\Items\\AIsm\\AIsmTarget.mdl"
elseif P6R=='A501' then
set P7R=qH[P4R]
set P8R=wH[P4R]
set QVR=vj[P4R]
set QER="Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl"
elseif P6R=='A502' then
set P7R=QH[P4R]
set P8R=WH[P4R]
set QVR=ej[P4R]
set QER="Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl"
elseif P6R=='A503' then
set P7R=sH[P4R]
set P8R=yH[P4R]
set QVR=oj[P4R]
set QER="Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl"
if GZX and uH[P4R]!=0 then
set P7R=uH[P4R]
set P8R=zH[P4R]
endif
endif
if P8R==0 then
call LYV(p,"Unable to copy "+GetObjectName(P7R)+".")
elseif bj[PKR]==false and QVR!="passive" and(QVR==ZH[QXR]or QVR==vj[QOR]or QVR==ej[QRR]or QVR==oj[QIR])then
if QVR==ZH[QXR]then
set P9R=PH[QXR]
elseif QVR==vj[QOR]then
set P9R=qH[QOR]
elseif QVR==ej[QRR]then
set P9R=QH[QRR]
elseif QVR==oj[QIR]then
set P9R=sH[QIR]
endif
call LYV(p,"Cannot copy "+GetObjectName(P7R)+" because you already
have an ability with this base order ("+GetObjectName(P9R)+").
Use -override to disable this.")
else
call DestroyEffect(AddSpecialEffectTarget(QER,NER,"origin"))
call UnitRemoveAbility(NER,P6R)
call UnitAddAbility(NER,P7R)
call UnitAddAbility(NER,P8R)
call SetPlayerAbilityAvailable(p,P8R,false)
call SetUnitAbilityLevel(NER,P7R,P5R)
if P7R=='A0S9' then
call UnitAddAbility(NER,'A0SA')
elseif P7R=='A11N' then
call UnitAddAbility(NER,'A13D')
elseif P7R=='A00J' then
call UnitAddAbility(NER,'A0MB')
call SetUnitAbilityLevel(NER,'A0MB',P5R)
elseif P7R=='A0AK' or P7R=='A1FY' then
call UnitAddAbility(NER,'A02T')
elseif P7R=='A0RP' then
call UnitAddAbility(NER,'A0RT')
elseif P7R=='A0H9' then
call UnitAddAbility(NER,'A0HA')
endif
if P7R=='A0DY' then
call N9X(NER,true)
elseif P7R=='A18X' then
call K7R(NER,true)
elseif P7R=='A0LZ' then
call JNX(NER,true)
elseif P7R=='A0MC' then
call JJX(NER,true)
elseif P7R=='A1CD' then
call L4R(NER,true)
elseif P7R=='A19Q' then
call M2X(NER,true)
elseif P7R=='A0M3' then
call NXX(NER,true)
elseif P7R=='A0FV' then
call A5X(NER,true)
elseif P7R=='A1IQ' then
call AFX(NER,true)
elseif P7R=='A0O8' then
call CFX(NER,true)
elseif P7R=='A0QW' then
call KSX(NER,true)
elseif P7R=='A0QN' then
call B7X(NER,true)
elseif P7R=='A0QQ' then
call B9X(NER,true)
elseif P7R=='A1EA' then
call PCX(NER,true)
elseif P7R=='A03E' then
call FFO(NER,true)
elseif P7R=='A0BG' then
call S0X(NER,true)
elseif P7R=='A03P' then
call ZZX(NER,true)
elseif P7R=='A08E' or P7R=='A086' then
call ZMX(NER,true,P7R)
elseif P7R=='A0CZ' then
call TZX(NER,true)
elseif P7R=='A081' then
call UNX(NER,true)
elseif P7R=='A1E6' then
call EBO(NER,true)
elseif P7R=='A0SS' then
call Z7O(NER,true)
elseif P7R=='A04E' then
call R3O(NER,true)
elseif P7R=='A01N' then
call YAX(NER,true)
elseif P7R=='A06D' then
call VKO(NER,true)
elseif P7R=='A0ES' then
call RIO(NER,true)
elseif P7R=='A0CT' then
call BKO(NER,true)
elseif P7R=='A0I8' then
call SUX(NER,true)
elseif P7R=='A0NS' or P7R=='A1DA' then
call Q9X(NER,true)
elseif P7R=='A0NA' then
call OZO(NER,true)
elseif P7R=='A0OI' then
call TVX(NER,true)
elseif P7R=='A0IF' then
call S9X(NER,true)
elseif P7R=='A1HR' then
call DQO(NER,true)
elseif P7R=='A1IN' then
call DBO(NER,true)
endif
endif
set NER=null
set p=null
set t=null
endfunction
function ELE takes nothing returns nothing
local trigger t=CreateTrigger()
call MKV(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function P2R))
call TriggerAddAction(t,function P3R)
set t=null
endfunction
function QAR takes nothing returns boolean
return(GetLearnedSkill()=='A500' or GetLearnedSkill()=='A501' or GetLearnedSkill()=='A502' or GetLearnedSkill()=='A503')and GetUnitAbilityLevel(GetTriggerUnit(),'A504')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A505')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A506')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A507')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A508')==0
endfunction
function QNR takes nothing returns boolean
return GetIssuedOrderId()==$D023F
endfunction
function QBR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit QCR=Y7(GetHandleId(t),"FormlessUnit")
local integer QDR
call IssueImmediateOrderById(QCR,$D0240)
if GetUnitAbilityLevel(QCR,'A504')>0 then
set QDR='A509'
elseif GetUnitAbilityLevel(QCR,'A505')>0 then
set QDR='A50A'
elseif GetUnitAbilityLevel(QCR,'A506')>0 then
set QDR='A50B'
elseif GetUnitAbilityLevel(QCR,'A507')>0 then
set QDR='A50C'
elseif GetUnitAbilityLevel(QCR,'A508')>0 then
set QDR=0
endif
call UnitRemoveAbility(QCR,'A509')
call UnitRemoveAbility(QCR,'A50A')
call UnitRemoveAbility(QCR,'A50B')
call UnitRemoveAbility(QCR,'A50C')
if QDR!=0 then
call UnitAddAbility(QCR,QDR)
call SetPlayerAbilityAvailable(GetOwningPlayer(QCR),QDR,false)
endif
call a7(GetHandleId(t))
call DestroyTimer(t)
set t=null
set QCR=null
endfunction
function QFR takes nothing returns nothing
local unit QCR=GetTriggerUnit()
local timer t=CreateTimer()
call A7(GetHandleId(t),"FormlessUnit",QCR)
call TimerStart(t,0,false,function QBR)
set QCR=null
set t=null
endfunction
function QGR takes nothing returns nothing
local integer PKR=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
local trigger t=CreateTrigger()
call TriggerRegisterUnitEvent(t,GetTriggerUnit(),EVENT_UNIT_ISSUED_ORDER)
call TriggerAddCondition(t,Condition(function QNR))
call TriggerAddAction(t,function QFR)
if GetLearnedSkill()!='A500' then
call UnitAddAbility(GetTriggerUnit(),'A500')
call UnitRemoveAbility(GetTriggerUnit(),'A500')
elseif GetLearnedSkill()!='A501' then
call UnitAddAbility(GetTriggerUnit(),'A501')
call UnitRemoveAbility(GetTriggerUnit(),'A501')
elseif GetLearnedSkill()!='A502' then
call UnitAddAbility(GetTriggerUnit(),'A502')
call UnitRemoveAbility(GetTriggerUnit(),'A502')
elseif GetLearnedSkill()!='A503' then
call UnitAddAbility(GetTriggerUnit(),'A503')
call UnitRemoveAbility(GetTriggerUnit(),'A503')
endif
call UnitAddAbility(GetTriggerUnit(),'A505')
call UnitRemoveAbility(GetTriggerUnit(),'A505')
call UnitAddAbility(GetTriggerUnit(),'A506')
call UnitRemoveAbility(GetTriggerUnit(),'A506')
call UnitAddAbility(GetTriggerUnit(),'A507')
call UnitRemoveAbility(GetTriggerUnit(),'A507')
call UnitAddAbility(GetTriggerUnit(),'A508')
call UnitRemoveAbility(GetTriggerUnit(),'A508')
call UnitAddAbility(GetTriggerUnit(),'A504')
set t=null
endfunction
function EPE takes nothing returns nothing
local trigger t=CreateTrigger()
call MKV(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function QAR))
call TriggerAddAction(t,function QGR)
set t=null
endfunction
function QHR takes nothing returns nothing
local unit K8V=GetTriggerUnit()
local player j8=GetOwningPlayer(K8V)
local real x
local real y
local integer T0V
call CCV(K8V,true,true)
set jl[GetPlayerId(GetOwningPlayer((K8V)))]=false
if C8(GetOwningPlayer(K8V))then
set x=GetRectCenterX(rr)
set y=GetRectCenterY(rr)
else
set x=GetRectCenterX(Mo)
set y=GetRectCenterY(Mo)
endif
call TimerStart(B[GetPlayerId(j8)],.0,false,null)
if TZV(K8V)then
call T3V(K8V)
else
call TWV(K8V,j8,x,y,false)
endif
call SetUnitX(K8V,x)
call SetUnitY(K8V,y)
call TTV(K8V)
call SetUnitPathing(K8V,true)
if F5(GetTriggerUnit(),Ac[NQV])!=null and GetUnitTypeId(K8V)!='H00J' then
set T0V=(R2I(((GetItemCharges(F5(GetTriggerUnit(),Ac[NQV]))*.5)*1.)))
if GetItemCharges(F5(GetTriggerUnit(),Ac[NQV]))==1 then
set T0V=0
endif
call SetItemCharges(F5(GetTriggerUnit(),Ac[NQV]),T0V)
call AddHeroXP(GetTriggerUnit(),GetHeroXP(aW[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]),true)
call RemoveUnit(aW[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))])
endif
if R0 and GetUnitPointValue(GetTriggerUnit())==500 then
call P0R(GetTriggerUnit(),'A504')
endif
set K8V=null
set j8=null
endfunction
function QJR takes unit QKR,integer QLR returns nothing
call UnitRemoveAbility(QKR,'A554')
call UnitRemoveAbility(QKR,'A555')
call UnitRemoveAbility(QKR,'A556')
call UnitRemoveAbility(QKR,'A557')
call UnitRemoveAbility(QKR,'A558')
if QLR>=16 then
call UnitAddAbility(QKR,'A558')
set QLR=QLR-16
endif
if QLR>=8 then
call UnitAddAbility(QKR,'A557')
set QLR=QLR-8
endif
if QLR>=4 then
call UnitAddAbility(QKR,'A556')
set QLR=QLR-4
endif
if QLR>=2 then
call UnitAddAbility(QKR,'A555')
set QLR=QLR-2
endif
if QLR>=1 then
call UnitAddAbility(QKR,'A554')
set QLR=QLR-1
endif
endfunction
function V5e takes nothing returns boolean
return GetSpellAbilityId()=='A550'
endfunction
function QMR takes nothing returns nothing
local unit QKR=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer QPR=(1+GetUnitAbilityLevel(QKR,'A550'))*B6V(QKR,true)
local integer QQR=E8(GetHandleId(QKR),"iPFCount")+1
local integer QLR=E8(GetHandleId(QKR),"iPFStrength")
local integer QSR=QLR
if QQR>9 then
set QQR=0
set QSR=L9V(5*GetUnitAbilityLevel(QKR,'A550'),QLR+1)
if QSR!=QLR then
call QJR(QKR,QSR)
if m5!=QKR then
call MHV("+1 Strength",3,QKR,.023,$FF,0,0,$FF)
endif
endif
endif
call SetUnitState(m5,UNIT_STATE_LIFE,GetUnitState(m5,UNIT_STATE_LIFE)+QPR)
if QQR!=0 or m5!=QKR or QSR==QLR then
call MHV("+"+I2S(QPR)+" HP",3,m5,.023,$FF,0,0,$FF)
else
call MHV("+"+I2S(QPR)+" HP
+1 Strength",3,QKR,.023,$FF,0,0,$FF)
endif
call n7(GetHandleId(QKR),"iPFCount",QQR)
call n7(GetHandleId(QKR),"iPFStrength",QSR)
set QKR=null
set m5=null
endfunction
function QTR takes nothing returns boolean
return SKV(GetEventDamage())
endfunction
function QUR takes nothing returns nothing
local unit QKR=GetTriggerUnit()
local real QWR=X8(GetHandleId(QKR),"rPFDamage")+GetEventDamage()
local integer QLR=E8(GetHandleId(QKR),"iPFStrength")
local integer QSR=QLR
if QWR>=500 then
set QWR=QWR-500
set QSR=L9V(5*GetUnitAbilityLevel(QKR,'A550'),QLR+1)
if QSR!=QLR then
call QJR(QKR,QSR)
call MHV("+1 Strength",3,QKR,.023,$FF,0,0,$FF)
endif
endif
call E7(GetHandleId(QKR),"rPFDamage",QWR)
call n7(GetHandleId(QKR),"iPFStrength",QSR)
set QKR=null
endfunction
function QYR takes nothing returns boolean
return GetLearnedSkill()=='A550' and GetUnitAbilityLevel(GetTriggerUnit(),'A550')==1
endfunction
function QZR takes nothing returns nothing
local unit QKR=GetTriggerUnit()
local trigger t=CreateTrigger()
call TriggerRegisterUnitEvent(t,QKR,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function QTR))
call TriggerAddAction(t,function QUR)
call E7(GetHandleId(QKR),"rPFDamage",0)
call n7(GetHandleId(QKR),"iPFCount",0)
call n7(GetHandleId(QKR),"iPFStrength",0)
set t=null
set QKR=null
endfunction
function EQE takes nothing returns nothing
