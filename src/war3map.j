call UnitRemoveAbility(IYE,'A174')
set IYE=null
return
endif
if DWE and DZE==false and DYE==false then
call E7(K3V,"bashertime",(KMV+2)*1.)
if D_E==false then
call O7(K3V,"basherremove",true)
endif
elseif DZE or DYE then
call UnitRemoveAbility(IYE,'A174')
call O7(K3V,"basheractive",false)
call O7(K3V,"basherremove",false)
endif
if D_E then
