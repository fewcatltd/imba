function JDV takes unit hn,integer JFV returns nothing
local integer JCV
local player p=GetOwningPlayer(hn)
local integer JGV=0
local integer JHV
set JCV=$A0+40*JFV
if C8(GetOwningPlayer(hn))then
set JHV=P8(ce)
else
set JHV=P8(Ce)
endif
if p==A7V[0]or p==A8V[0]then
set JGV=R2I(((400+50*JFV)+GetRandomInt(2,20))*.7)
endif
if IsUnitAlly(GetDyingUnit(),p)then
if IsUnitAlly(hn,A7V[0])then
set p=A8V[0]
else
set p=A7V[0]
endif
set JCV=JCV/ 2+JGV/ JHV
else
set JCV=JCV+JGV/ JHV
endif
if p==A7V[0]then
call lw(A7V[1],JCV)
call lw(A7V[2],JCV)
call lw(A7V[3],JCV)
call lw(A7V[4],JCV)
call lw(A7V[5],JCV)
elseif p==A8V[0]then
call lw(A8V[1],JCV)
call lw(A8V[2],JCV)
call lw(A8V[3],JCV)
call lw(A8V[4],JCV)
call lw(A8V[5],JCV)
else
call lW(GetOwningPlayer(hn),JCV)
endif
endfunction
