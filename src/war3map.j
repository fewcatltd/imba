function U5E takes player p,integer r,integer g,integer b,integer a returns nothing
if GetLocalPlayer()==p then
call SetWaterBaseColor(r,g,b,a)
endif
endfunction
function U6E takes string s returns nothing
local string U7E=""
local string U8E=""
local string U9E=""
local integer i=0
local integer SVV=StringLength(s)
local integer WVE=1
loop
exitwhen i>SVV
if SubString(s,i,i+1)==" " then
set WVE=WVE+1
else
if WVE==1 then
set U7E=U7E+SubString(s,i,i+1)
elseif WVE==2 then
set U8E=U8E+SubString(s,i,i+1)
else
set U9E=U9E+SubString(s,i,i+1)
endif
endif
set i=i+1
endloop
set bb=S2I(U7E)
set Bb=S2I(U8E)
set cb=S2I(U9E)
endfunction
function THE takes nothing returns nothing
local string WEE=SubString(GetEventPlayerChatString(),7,StringLength(GetEventPlayerChatString()))
local player p=GetTriggerPlayer()
local integer r
local integer g
local integer b
set Nb[GetPlayerId(p)]=true
if WEE=="red" then
call U5E(p,$FF,0,0,$FF)
elseif WEE=="blue" then
call U5E(p,0,0,$FF,$FF)
elseif WEE=="green" then
call U5E(p,0,$FF,0,$FF)
elseif WEE=="default" then
call U5E(p,0,0,$FF,$FF)
elseif WEE=="random" then
set r=GetRandomInt(0,$FF)
set g=GetRandomInt(0,$FF)
set b=GetRandomInt(0,$FF)
call U5E(p,r,g,b,$FF)
call DisplayTimedTextToPlayer(p,0,0,5,(GetObjectName(('n0HD')))+" r="+I2S(r)+" g="+I2S(g)+" b="+I2S(b))
else
call U6E(WEE)
set r=bb
set g=Bb
set b=cb
if r>=0 and r<=$FF and g>=0 and g<=$FF and b>=0 and b<=$FF then
call U5E(p,r,g,b,$FF)
endif
endif
endfunction
