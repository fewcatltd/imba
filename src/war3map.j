function EMI takes nothing returns nothing  //pugna ulti
local trigger t=CreateTrigger()
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local group g=CreateGroup()
local boolexpr b=Condition(function ELI)
local integer i=GetUnitAbilityLevel(s,'A04L')
if GetUnitAbilityLevel(s,'A0CC')==1 then
set i=4
elseif GetUnitAbilityLevel(s,'A0CC')==2 then
set i=7
elseif GetUnitAbilityLevel(s,'A0CC')==3 then
set i=9
endif
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function EKI))
call DFV(t,'s',s)
call DFV(t,'u',u)
call DUV(t,'t',ITV+4+i)
call DPV(t,'i',i)
set AUV=s
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(s),b)
loop
set s=FirstOfGroup(g)
exitwhen s==null
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,s,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function EKI))
call DFV(t,'s',s)
call DFV(t,'u',u)
call DUV(t,'t',ITV+4+i)
call DPV(t,'i',i)
call D_V(t,'l',HZV(AddLightning("DRAB",false,0,0,0,0),s,u))
call GroupRemoveUnit(g,s)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
set t=null
set s=null
set u=null
endfunction
