function BCX takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local real x=DWV(t,'x')
local real y=DWV(t,'y')
local group g=null
local boolexpr b=null
local unit f=null
local real x1=0
local real y1=0
local real a=0
local real d=0
local real r=DWV(t,'r')
local integer i=DTV(t,'i')
local group g1=DKV(t,'g')
if GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST then
loop
set s=FirstOfGroup(g1)
exitwhen s==null
call CPV(s,false)
call GroupRemoveUnit(g1,s)
endloop
call DestroyGroup(g1)
call KillUnit(DHV(t,'shd1'))
call KillUnit(DHV(t,'shd2'))
call KillUnit(DHV(t,'shd3'))
call KillUnit(DHV(t,'shd4'))
call KillUnit(DHV(t,'bkho'))
call GDV()
else
set AUV=s
set g=CreateGroup()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,x,y,r,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call CPV(f,true)
call GroupAddUnit(g1,f)
set d=DDV(f,x,y)
set x1=GetUnitX(f)
set y1=GetUnitY(f)
set a=Atan2(y-y1,x-x1)
call SetUnitPosition(f,x1+Cos(a)*3,y1+Sin(a)*3)
call HPV(s,f,1,(20+40*i)*.025*(1-.5*C0V(d>r*.5)))
call GroupRemoveUnit(g,f)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set t=null
set g1=null
set s=null
endfunction
function BDX takes unit s,real x,real y,integer i returns nothing
local trigger t=CreateTrigger()
