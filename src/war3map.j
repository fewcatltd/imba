call TriggerAddCondition(t,Condition(function VEO))
call b7(K3V,"FX",AddSpecialEffectTarget("war3mapImported\\DarkHands.mdl",m5,"overhead"))
call A7(K3V,"Source",p5)
call A7(K3V,"Target",m5)
