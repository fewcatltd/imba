call PingMinimapEx(GetUnitX(GetSoldUnit()),GetUnitY(GetSoldUnit()),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,20,R[GetPlayerId(GetOwningPlayer(GetSoldUnit()))]+(lt[GetPlayerId((GetOwningPlayer(GetSoldUnit())))])+"|r |c00ffff00"+GetObjectName('n0HU')+"|r")
endif
endif
else
call R8R()
endif
return false
endfunction
