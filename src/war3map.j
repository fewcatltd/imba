function H_V takes nothing returns nothing
local timer tm=GetExpiredTimer()
local integer i=DTV(tm,'loop')
local boolean b=DZV(tm,'dond')
local unit u1=DHV(tm,'Sour')
local unit u2=DHV(tm,'Targ')
if b then
set b=IsUnitType(u1,UNIT_TYPE_DEAD)==false and IsUnitType(u2,UNIT_TYPE_DEAD)==false
else
set b=true
endif
if i>0 and b then
call DPV(tm,'loop',i-1)
call HZV(D0V(tm,'ligt'),u1,u2)
else
call DestroyLightning(D0V(tm,'ligt'))
call FIV()
endif
set tm=null
set u1=null
set u2=null
endfunction
function H0V takes unit u1,unit u2,real t,string s,boolean b returns lightning
local timer tm=CreateTimer()
local lightning l=HZV(AddLightning(s,false,0,0,1,1),u1,u2)
call DFV(tm,'Sour',u1)
call DFV(tm,'Targ',u2)
call D_V(tm,'ligt',l)
call DYV(tm,'dond',b)
call DPV(tm,'loop',R2I(t*$A))
call TimerStart(tm,.1,true,function H_V)
set PF=l
set l=null
set tm=null
return PF
endfunction
