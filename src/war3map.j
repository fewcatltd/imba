local integer l=0
local timer tm=null
local trigger t=null
if id=='A0DY' then
call SetPlayerTechResearchedSwap('R005',i+5+(GetUnitAbilityLevel(u,'A03U'))+(GetUnitAbilityLevel(u,'A0RO')),GetOwningPlayer(GetLearningUnit())) //bambi range
endif
if id=='A0RO' then
