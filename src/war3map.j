function YZR takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'s')
local unit u=DHV(tm,'u')
local group g=DKV(tm,'g')
local group g1=CreateGroup()
local boolexpr b=Condition(function PMV)
local integer i=DTV(tm,'i')
local unit f=null
set AUV=s
call GroupEnumUnitsInRange(g1,GetUnitX(u),GetUnitY(u),600,b)
call GroupRemoveGroup(g,g1)
set f=GroupPickRandomUnit(g1)
if f!=null then
call DFV(tm,'u',f)
call H0V(f,u,.4,"CLSB",false)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",f,"origin"))
if IsUnitType(f,UNIT_TYPE_STRUCTURE)then
call HPV(s,f,1,.5*(300+H4V(s,2)))
else
call HPV(s,f,1,300+H4V(s,2))
endif
call GroupAddUnit(g,f)
if i==4 then
call DestroyGroup(g)
call FIV()
else
call DPV(tm,'i',i+1)
endif
else
call DestroyGroup(g)
call FIV()
endif
call DestroyGroup(g1)
call DestroyBoolExpr(b)
set tm=null
set s=null
set u=null
set g=null
set g1=null
set b=null
set f=null
endfunction
