call GLR(GNR,K3V,8,GUR)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function GPR))
call E7(K3V,"Duration",Hk)
call E7(K3V,"x",x1)
call E7(K3V,"y",y1)
call E7(K3V,"d",d)
call A7(K3V,"Hero",K8V)
call n7(K3V,"Level",JFV)
call D7(K3V,"Enemy",GUR)
set d=d+90
set g=KHV()
set GTR=Rect(x1-d,y1-d,x1+d,y1+d)
call GroupEnumUnitsInRect(g,GTR,Condition(function P6V))
set xL=K8V
call ForGroup(g,function GQR)
call KGV(g)
set t=null
set g=null
set K8V=null
set GNR=null
set GTR=null
set GUR=null
return false
endfunction
