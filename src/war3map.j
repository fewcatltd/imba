function UOE takes unit u1,unit u2 returns nothing
local player URE=GetOwningPlayer(u1)
local player UIE=GetOwningPlayer(u2)
local unit UAE=CreateUnit(URE,'e01F',0,0,0)
local group g
local item LKE
call DisableTrigger(rH)
if GetUnitAbilityLevel(u1,'A03E')>0 then
set B2=u1
set C2=u2
call ExecuteFunc("UNE")
elseif GetUnitAbilityLevel(u2,'A03E')>0 then
set B2=u2
set C2=u1
call ExecuteFunc("UNE")
endif
if GetUnitAbilityLevel(u1,'A0CY')>0 then
set B2=u1
set C2=u2
call ExecuteFunc("UBE")
elseif GetUnitAbilityLevel(u2,'A0CY')>0 then
set B2=u2
set C2=u1
call ExecuteFunc("UBE")
endif
if GetUnitAbilityLevel(u1,'A13T')>0 then
set B2=u1
set C2=u2
call ExecuteFunc("UCE")
elseif GetUnitAbilityLevel(u2,'A13T')>0 then
set B2=u2
set C2=u1
call ExecuteFunc("UCE")
endif
call a7(StringHash("SwapHero|"+I2S(GetPlayerId(GetOwningPlayer(u1)))))
call a7(StringHash("SwapHero|"+I2S(GetPlayerId(GetOwningPlayer(u2)))))
set g=KHV()
set bj_groupEnumOwningPlayer=URE
call GroupEnumUnitsInRect(g,GetWorldBounds(),filterGetUnitsInRectOfPlayer)
call ForGroup(g,function P5)
call KGV(g)
set g=KHV()
set bj_groupEnumOwningPlayer=UIE
call GroupEnumUnitsInRect(g,GetWorldBounds(),filterGetUnitsInRectOfPlayer)
call ForGroup(g,function P5)
call KGV(g)
call SetUnitOwner(u2,URE,true)
call SetUnitOwner(u1,UIE,true)
set ie[GetPlayerId(URE)]=u2
set ie[GetPlayerId(UIE)]=u1
call SetPlayerName(URE,JZV(URE)+" ("+KPV(ie[GetPlayerId(URE)])+")")
call SetPlayerName(UIE,JZV(UIE)+" ("+KPV(ie[GetPlayerId(UIE)])+")")
call UnitAddItem(UAE,UnitItemInSlot(u2,0))
call UnitAddItem(UAE,UnitItemInSlot(u2,1))
call UnitAddItem(UAE,UnitItemInSlot(u2,2))
call UnitAddItem(UAE,UnitItemInSlot(u2,3))
call UnitAddItem(UAE,UnitItemInSlot(u2,4))
call UnitAddItem(UAE,UnitItemInSlot(u2,5))
set LKE=UnitItemInSlot(u1,0)
if LKE!=null then
call SetItemPlayer(LKE,URE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u2,LKE)
endif
set LKE=UnitItemInSlot(u1,1)
if LKE!=null then
call SetItemPlayer(LKE,URE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u2,LKE)
endif
set LKE=UnitItemInSlot(u1,2)
if LKE!=null then
call SetItemPlayer(LKE,URE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u2,LKE)
endif
set LKE=UnitItemInSlot(u1,3)
if LKE!=null then
call SetItemPlayer(LKE,URE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u2,LKE)
endif
set LKE=UnitItemInSlot(u1,4)
if LKE!=null then
call SetItemPlayer(LKE,URE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u2,LKE)
endif
set LKE=UnitItemInSlot(u1,5)
if LKE!=null then
call SetItemPlayer(LKE,URE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u2,LKE)
endif
set LKE=UnitItemInSlot(UAE,0)
if LKE!=null then
call SetItemPlayer(LKE,UIE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u1,LKE)
endif
set LKE=UnitItemInSlot(UAE,1)
if LKE!=null then
call SetItemPlayer(LKE,UIE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u1,LKE)
endif
set LKE=UnitItemInSlot(UAE,2)
if LKE!=null then
call SetItemPlayer(LKE,UIE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u1,LKE)
endif
set LKE=UnitItemInSlot(UAE,3)
if LKE!=null then
call SetItemPlayer(LKE,UIE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u1,LKE)
endif
set LKE=UnitItemInSlot(UAE,4)
if LKE!=null then
call SetItemPlayer(LKE,UIE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u1,LKE)
endif
set LKE=UnitItemInSlot(UAE,5)
if LKE!=null then
call SetItemPlayer(LKE,UIE,false)
call SetItemUserData(LKE,1)
call UnitAddItem(u1,LKE)
endif
call RemoveUnit(UAE)
call EnableTrigger(rH)
if(IsUnitType(u1,UNIT_TYPE_MELEE_ATTACKER) or GetUnitTypeId(u1)=='H06S')and F5(u1,Ac[Cd])!=null then
call UnitRemoveItem(u1,F5(u1,Ac[Cd]))
elseif(IsUnitType(u1,UNIT_TYPE_RANGED_ATTACKER) or GetUnitTypeId(u1)=='H06S')and F5(u1,Ac[cd])!=null then
call UnitRemoveItem(u1,F5(u1,Ac[cd]))
endif
if(IsUnitType(u2,UNIT_TYPE_MELEE_ATTACKER) or GetUnitTypeId(u1)=='H06S')and F5(u2,Ac[Cd])!=null then
call UnitRemoveItem(u1,F5(u2,Ac[Cd]))
elseif(IsUnitType(u2,UNIT_TYPE_RANGED_ATTACKER) or GetUnitTypeId(u1)=='H06S')and F5(u2,Ac[cd])!=null then
call UnitRemoveItem(u1,F5(u2,Ac[cd]))
endif
if GetUnitTypeId(u1)=='H06S' and F5(u1,Ac[cd])!=null then
call UnitRemoveItem(u1,F5(u1,Ac[cd]))
elseif GetUnitTypeId(u1)=='H06S' and F5(u1,Ac[Cd])!=null then
call UnitRemoveItem(u1,F5(u1,Ac[Cd]))
endif
if GetUnitTypeId(u2)=='H06S' and F5(u2,Ac[cd])!=null then
call UnitRemoveItem(u2,F5(u2,Ac[cd]))
elseif GetUnitTypeId(u2)=='H06S' and F5(u2,Ac[Cd])!=null then
call UnitRemoveItem(u2,F5(u2,Ac[Cd]))
endif
if(IsUnitType(u1,UNIT_TYPE_MELEE_ATTACKER))and F5(u1,Ac[pF])!=null then
call UnitRemoveItem(u1,F5(u1,Ac[pF]))
elseif(IsUnitType(u1,UNIT_TYPE_RANGED_ATTACKER))and F5(u1,Ac[MF])!=null then
call UnitRemoveItem(u1,F5(u1,Ac[MF]))
endif
if(IsUnitType(u2,UNIT_TYPE_MELEE_ATTACKER))and F5(u2,Ac[pF])!=null then
call UnitRemoveItem(u1,F5(u2,Ac[pF]))
elseif(IsUnitType(u2,UNIT_TYPE_RANGED_ATTACKER))and F5(u2,Ac[MF])!=null then
call UnitRemoveItem(u1,F5(u2,Ac[MF]))
endif
call ClearSelectionForPlayer(URE)
call SelectUnitAddForPlayer(u2,URE)
call ClearSelectionForPlayer(UIE)
call SelectUnitAddForPlayer(u1,UIE)
call a7(StringHash("SwapHero|"+I2S(GetPlayerId(URE))))
call a7(StringHash("SwapHero|"+I2S(GetPlayerId(UIE))))
set xL=u1
call ExecuteFunc("OQE")
set xL=u2
call ExecuteFunc("OQE")
call SDV(URE)
call SDV(UIE)
if(GetPlayerController(UIE)==MAP_CONTROL_COMPUTER)then
call A7(tz,"AIHSwap|g_mbScoreboard",u1)
call ExecuteFunc("Uf")
endif
set URE=null
set UIE=null
set g=null
set UAE=null
set LKE=null
endfunction
function yM takes unit u1,unit u2 returns boolean
return O8(StringHash("SwapHero|"+I2S(GetPlayerId(GetOwningPlayer(u2)))),I2S(GetUnitTypeId(u2))+"|"+I2S(GetUnitTypeId(u1)))
endfunction
function YL takes nothing returns nothing
call a7(StringHash("SwapHero|"+I2S(GetPlayerId(GetTriggerPlayer()))))
endfunction
function qA takes player p returns integer
local integer i=1
loop
exitwhen i>5
if A7V[i]==p or A8V[i]==p then
return i
endif
set i=i+1
endloop
return-1
endfunction
function YT takes unit u1,unit u2 returns boolean
call O7(StringHash("SwapHero|"+I2S(GetPlayerId(GetOwningPlayer(u1)))),I2S(GetUnitTypeId(u1))+"|"+I2S(GetUnitTypeId(u2)),true)
if yM(u1,u2)then
call UOE(u1,u2)
else
call DisplayTimedTextToPlayer(GetOwningPlayer(u1),0,Qx,30,"  ")
call DisplayTimedTextToPlayer(GetOwningPlayer(u1),0,Qx,30,"|cff99ccffYou have requested to swap with |r"+R[GetPlayerId(GetOwningPlayer(u2))]+GetUnitName(u2)+"|r")
call DisplayTimedTextToPlayer(GetOwningPlayer(u1),0,Qx,30,"  ")
if(GetPlayerController(GetOwningPlayer(u2))==MAP_CONTROL_USER)then
call DisplayTimedTextToPlayer(GetOwningPlayer(u2),0,Qx,30,"  ")
call DisplayTimedTextToPlayer(GetOwningPlayer(u2),0,Qx,30,"                         "+R[GetPlayerId(GetOwningPlayer(u1))]+GetUnitName(u1)+"|r |cff99ccffwants to swap with you. Type|r |c00ff0303-swap "+I2S(qA(GetOwningPlayer(u1)))+"|r |cff99ccffto accept|r")
call DisplayTimedTextToPlayer(GetOwningPlayer(u2),0,Qx,30,"  ")
else
if(GetHeroSkillPoints(u1)!=GetHeroLevel(u1))then
call DisplayTimedTextToPlayer(GetOwningPlayer(u1),0,Qx,$A,"
|cff99ccffRequest to swap with |r"+R[GetPlayerId(GetOwningPlayer(u2))]+GetUnitName(u2)+"|r rejected because you used a skill point")
elseif(Bz>Nz)then
call DisplayTimedTextToPlayer(GetOwningPlayer(u1),0,Qx,$A,"
|cff99ccffRequest to swap with |r"+R[GetPlayerId(GetOwningPlayer(u2))]+GetUnitName(u2)+"|r rejected because it is too late")
elseif((hG[GetPlayerId(GetOwningPlayer(u2))]>0)or(not jN(u2)))then
call DisplayTimedTextToPlayer(GetOwningPlayer(u1),0,Qx,$A,"
|cff99ccffRequest to swap with |r"+R[GetPlayerId(GetOwningPlayer(u2))]+GetUnitName(u2)+"|r rejected because it already started its item build")
elseif(not jN(u1))then
call DisplayTimedTextToPlayer(GetOwningPlayer(u1),0,Qx,$A,"
|cff99ccffRequest to swap with |r"+R[GetPlayerId(GetOwningPlayer(u2))]+GetUnitName(u2)+"|r rejected because you have an item")
else
call UOE(u1,u2)
endif
endif
endif
return false
endfunction
function YV takes nothing returns nothing
local integer i=S2I(SubString(GetEventPlayerChatString(),6,StringLength(GetEventPlayerChatString())))
if GetEventPlayerChatString()=="-swapall" then
set i=1
set oL=ie[GetPlayerId(GetTriggerPlayer())]
loop
exitwhen i>5
if C8(GetTriggerPlayer())then
set nL=A7V[i]
else
set nL=A8V[i]
endif
set xL=ie[GetPlayerId(nL)]
if not(oL==null or GetOwningPlayer(oL)!=GetTriggerPlayer()or xL==null or GetOwningPlayer(xL)!=nL or nL==GetTriggerPlayer())then
if YT(oL,xL)then
return
endif
endif
set i=i+1
endloop
return
elseif i<1 or i>5 then
call LYV(GetTriggerPlayer(),"Invalid swap selection")
return
endif
set oL=ie[GetPlayerId(GetTriggerPlayer())]
if C8(GetTriggerPlayer())then
set nL=A7V[i]
else
set nL=A8V[i]
endif
set xL=ie[GetPlayerId(nL)]
if oL==null or GetOwningPlayer(oL)!=GetTriggerPlayer()or xL==null or GetOwningPlayer(xL)!=nL or nL==GetTriggerPlayer()then
call LYV(GetTriggerPlayer(),"Invalid swap selection")
return
endif
call YT(oL,xL)
endfunction
function Y2 takes nothing returns nothing
local integer i
local player p
local unit u
local string s
if GetLocalPlayer()==GetTriggerPlayer()then
call ClearTextMessages()
endif
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,45,"|cff99ccffSwap Hero Options:|r")
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,45," ")
set i=1
loop
exitwhen i>5
set p=A7V[i]
set u=ie[GetPlayerId(p)]
if IsPlayerAlly(GetTriggerPlayer(),p)and GetTriggerPlayer()!=p and u!=null and GetOwningPlayer(u)==p then
set s=" "
if yM(ie[GetPlayerId(GetTriggerPlayer())],u)then
set s=" |c00ff0303(Requested Swap With You)|r"
endif
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,45,R[GetPlayerId(p)]+I2S(i)+"|r"+" - "+"|cff99ccff"+GetUnitName(u)+"|r"+s)
endif
set p=A8V[i]
set u=ie[GetPlayerId(p)]
if IsPlayerAlly(GetTriggerPlayer(),p)and GetTriggerPlayer()!=p and u!=null and GetOwningPlayer(u)==p then
set s=" "
if yM(ie[GetPlayerId(GetTriggerPlayer())],u)then
set s=" |c00ff0303(Requested Swap With You)|r"
endif
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,45,R[GetPlayerId(p)]+I2S(i)+"|r"+" - "+"|cff99ccff"+GetUnitName(u)+"|r"+s)
endif
set i=i+1
endloop
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,45," ")
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,45,"|cff99ccffType|r |c00ff0303-swap #|r |cff99ccffto make a choice or -swapcancel to cancel swap requests|r")
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,45," ")
endfunction
function UDE takes player p4 returns boolean
local integer T8=1
local integer UFE=0
loop
exitwhen T8>5
if C8(p4)then
if ie[GetPlayerId(A7V[T8])]!=null and A7V[T8]!=p4 then
set UFE=UFE+1
endif
else
if ie[GetPlayerId(A8V[T8])]!=null and A8V[T8]!=p4 then
set UFE=UFE+1
endif
endif
set T8=T8+1
endloop
if UFE>0 then
return true
else
return false
endif
endfunction
function UGE takes nothing returns boolean
if Ey then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,$A,"-swaphero "+(GetObjectName(('n088'))))
return false
endif
if GetUnitState(ie[GetPlayerId(GetTriggerPlayer())],UNIT_STATE_LIFE)<1 then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,$A,(GetObjectName(('n08F'))))
return false
endif
if fU then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,$A,(GetObjectName(('n08G')))+" -swaphero.")
return false
endif
if UDE(GetTriggerPlayer())==false then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,$A,(GetObjectName(('n08H'))))
return false
endif
return true
endfunction
function SZE takes nothing returns nothing
if UGE()then
if GetEventPlayerChatString()=="-swap"or GetEventPlayerChatString()=="-swaphero"then
call Y2()
elseif GetEventPlayerChatString()=="-swapcancel"then
call YL()
else
call YV()
endif
endif
endfunction
function UHE takes nothing returns boolean
return GetSpellAbilityId()=='A0FI'
endfunction
function UJE takes integer o6,unit UKE,unit ULE returns nothing
local integer T8=1
local integer U8=GetUnitAbilityLevel(UKE,o6)
loop
exitwhen T8>U8
call SelectHeroSkill(ULE,o6)
set T8=T8+1
endloop
endfunction
function UME takes nothing returns nothing
local integer T8
local integer U8
local unit S4
local location CFE=GetUnitLoc(GetTriggerUnit())
set S4=CreateUnitAtLoc(GetOwningPlayer(GetTriggerUnit()),GetUnitTypeId(GetTriggerUnit()),CFE,bj_UNIT_FACING)
call SetHeroXP(S4,GetHeroXP(GetTriggerUnit()),false)
set T8=1
set U8=GetUnitAbilityLevel(GetTriggerUnit(),'A0NR')
loop
exitwhen T8>U8
call SelectHeroSkill(bj_lastCreatedUnit,'A0NR')
set T8=T8+1
endloop
set T8=0
set U8=5
loop
exitwhen T8>U8
call UnitAddItem(S4,UnitItemInSlot(GetTriggerUnit(),T8))
set T8=T8+1
endloop
if(GetUnitTypeId(GetTriggerUnit())=='Eevi')then
call UJE('A04L',GetTriggerUnit(),S4)
call UJE('A0H4',GetTriggerUnit(),S4)
call UJE('AEvi',GetTriggerUnit(),S4)
call UJE('A07Q',GetTriggerUnit(),S4)
endif
if(GetUnitTypeId(GetTriggerUnit())=='U008')then
call UJE('A03D',GetTriggerUnit(),S4)
call UJE('A02G',GetTriggerUnit(),S4)
call UJE('A03E',GetTriggerUnit(),S4)
call UJE('A093',GetTriggerUnit(),S4)
endif
if(GetUnitTypeId(GetTriggerUnit())=='U007')then
call UJE('A0F9',GetTriggerUnit(),S4)
call UJE('A06Y',GetTriggerUnit(),S4)
call UJE('A01E',GetTriggerUnit(),S4)
call UJE('A028',GetTriggerUnit(),S4)
endif
