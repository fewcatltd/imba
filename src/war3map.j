function T3V takes unit JQ returns nothing
local integer K3V=GetHandleId(GetOwningPlayer(JQ))
local unit JN=Y7(K3V,"Kobold0")
local unit Jo=Y7(K3V,"Kobold1")
local unit JO=Y7(K3V,"Kobold2")
local unit Jp=Y7(K3V,"Kobold3")
local unit JP
local real x=GetUnitX(JN)
local real y=GetUnitY(JN)
local trigger t
if VW==false then
if C8(GetOwningPlayer(JN))then
set x=GetRectCenterX(rr)
set y=GetRectCenterY(rr)
else
set x=GetRectCenterX(Mo)
set y=GetRectCenterY(Mo)
endif
else
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,2,false)
call TriggerAddCondition(t,Condition(function T2V))
endif
set JP=JN
if JP!=null and JQ!=JP then
call ReviveHero(JP,x,y,false)
call SetUnitX(JP,x)
call SetUnitY(JP,y)
call TTV(JP)
call SetUnitPathing(JP,true)
endif
set JP=Jo
if JP!=null and JQ!=JP then
call ReviveHero(JP,x,y,false)
call SetUnitX(JP,x)
call SetUnitY(JP,y)
call TTV(JP)
call SetUnitPathing(JP,true)
endif
set JP=JO
if JP!=null and JQ!=JP then
call ReviveHero(JP,x,y,false)
call SetUnitX(JP,x)
call SetUnitY(JP,y)
call TTV(JP)
call SetUnitPathing(JP,true)
endif
set JP=Jp
if JP!=null and JQ!=JP then
call ReviveHero(JP,x,y,false)
call SetUnitX(JP,x)
call SetUnitY(JP,y)
call TTV(JP)
call SetUnitPathing(JP,true)
endif
endfunction
