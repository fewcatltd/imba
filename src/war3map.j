function T_R takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
local integer i=GetUnitAbilityLevel(u,'A0QQ')
local integer l=0
local real r=0
if i==0 then
if F1V(u,"A0QQEffect")then
call FHV(u,"A0QQEffect",false)
call DestroyEffect(F3V(u,"A0QQEffect1"))
call DestroyEffect(F3V(u,"A0QQEffect2"))
endif
set l=DTV(u,'A0QQ')
call G7V(u,-l)
call G6V(u,-l)
call DPV(u,'A0QQ',0)
call DYV(u,'a0QQ',false)
call FIV()
else
set r=GetUnitLifePercent(u)
if r<80 then
if F1V(u,"A0QQEffect")==false then
call FPV(u,"A0QQEffect1",AddSpecialEffectTarget("Abilities\\Spells\\Orc\\TrollBerserk\\HeadhunterWEAPONSLeft.mdl",u,"left weapon"))
call FPV(u,"A0QQEffect2",AddSpecialEffectTarget("effects\\HeadhunterWEAPONSRight_NoSound.mdx",u,"right weapon"))
call FHV(u,"A0QQEffect",true)
endif
else
if F1V(u,"A0QQEffect")then
call FHV(u,"A0QQEffect",false)
call DestroyEffect(F3V(u,"A0QQEffect1"))
call DestroyEffect(F3V(u,"A0QQEffect2"))
endif
endif
set r='d'-r
if XXV then
set r=r/2
set r=RMaxBJ(r,(GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetUnitState(u,UNIT_STATE_LIFE))/20)+1
else
set r=r/7
set r=RMaxBJ(r,(GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetUnitState(u,UNIT_STATE_LIFE))/70)+1
endif
set l=R2I(r*2*i)
set i=DTV(u,'A0QQ')
if l!=i then
call G7V(u,l-i)
call G6V(u,l-i)
call DPV(u,'A0QQ',l)
endif
if ITV-DWV(u,'a0qq')>0 then
if IVV then
if XXV then
call DUV(u,'a0qq',ITV+$A-2*GetUnitAbilityLevel(u,'A0QQ'))
else
call DUV(u,'a0qq',ITV+$E-1.5*GetUnitAbilityLevel(u,'A0QQ'))
endif
call J6V(u,'AB30','B930',3.75,0,0,0,0,0,0,0)
endif
endif
endif
set u=null
endfunction
