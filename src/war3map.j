if GetUnitAbilityLevel(s,'A0MY')>0 and(IsUnitType(u,UNIT_TYPE_STRUCTURE)==false)and IsUnitAlly(s,GetOwningPlayer(u))==false then
set f=CreateUnit(GetOwningPlayer(s),'fx20',x,y,0)
call UnitAddAbility(f,'AA7P')
call SetUnitAbilityLevel(f,'AA7P',GetUnitAbilityLevel(s,'A0MY'))
call UnitApplyTimedLife(f,'BTLF',1)
if IssueTargetOrderById(f,$D000F,u)==false then
call KillUnit(f)
endif
call ShowUnit(f,false)
set f=null
endif
if DTV(s,'b013')>0 then
call G6V(s,-DTV(s,'b013'))
call DPV(s,'b013',0)
endif
set i=GetUnitTypeId(s)
if(DZV(s,'A0A5')or i=='N013' or i=='N014' or i=='N015')and GetRandomInt(0,99)<25 and GUV(u)==false then
call HTV(u)
call HPV(s,u,5,d/ASV-d)
call H1V(GetObjectName('A092'),$FF,50,50,s)
endif
if GetUnitTypeId(s)=='n901' and GetRandomInt(1,4)==1 then
set g=CreateGroup()
set b=Condition(function PJV)
set AUV=s
set a=Atan2(y-y1,x-x1)
set x2=x1+Cos(a)*275
set y2=y1+Sin(a)*275
call GroupEnumUnitsInRange(g,x2,y2,275,b)
call GroupRemoveUnit(g,u)
loop
set n=FirstOfGroup(g)
exitwhen n==null
call HPV(s,n,2,GetRandomReal(425,527))
call GroupRemoveUnit(g,n)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set i=GetUnitAbilityLevel(s,'A0MG')
if i>0 and(GetWidgetLife(u)-d<1 or GetEventDamage()>GetUnitState(u,UNIT_STATE_MAX_LIFE))and(IsUnitType(u,UNIT_TYPE_HERO)==false)and(IsUnitType(u,UNIT_TYPE_STRUCTURE)==false)and IsUnitIllusion(u)==false then
if IVV then
set f=CreateUnit(GetOwningPlayer(s),'e00E',x,y,0)
call UnitAddAbility(f,'AA96')
call SetUnitAbilityLevel(f,'AA96',i)
set IUV=f
call IssueTargetOrderById(f,$D0132,u)
call SetWidgetLife(IWV,$F423F)
call SetUnitVertexColor(IWV,50,50,50,$FF)
call KillUnit(f)
set f=null
endif
endif
set t=null
set s=null
set u=null
endfunction
function ZWR takes nothing returns nothing
if GetTriggerEventId()!=EVENT_UNIT_DAMAGED then
return
endif
call ZMR()
endfunction
function ZYR takes nothing returns nothing
local real d=(Ld(ADV)+GetRandomInt(24,30))*(.3+.15*AHV)
call QUV(ADV,AFV,d)
endfunction
function ZZR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit f=DHV(t,'f')
local real x=DWV(t,'x')
local real y=DWV(t,'y')
local group g=null
local boolexpr b=null
local unit u=null
if GetTriggerEvalCount(t)>20 then
call KillUnit(f)
call GDV()
else
if IsUnitInRange(s,f,$E1)then
call HGV(s,true,GetUnitState(s,UNIT_STATE_MAX_LIFE)*.01)
endif
if GetUnitAbilityLevel(s,'A173')>0 then
set g=CreateGroup()
set b=Condition(function PJV)
set AUV=s
call GroupEnumUnitsInRange(g,x,y,$AF,b)
loop
set u=FirstOfGroup(g)
exitwhen u==null
if GetUnitAbilityLevel(u,'B0AQ')==0 then
call HXV(s,'A17N',GetUnitAbilityLevel(s,'A173'),"shadowstrike",u)
call HAV("Abilities\\Spells\\Undead\\PlagueCloud\\PlagueCloudCaster.mdl",u,$F)
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
endif
set t=null
set s=null
set f=null
endfunction
function ZUR takes nothing returns nothing
local trigger t=CreateTrigger()
local real x=GetUnitX(AGV)
local real y=GetUnitY(AGV)
local unit f=CreateUnit(Player($F),'hfoo',x,y,0)
call UnitAddAbility(f,'Aloc')
call SetUnitX(f,x)
call SetUnitY(f,y)
call DFV(t,'s',ADV)
call DFV(t,'f',f)
call DUV(t,'x',x)
call DUV(t,'y',y)
call TriggerRegisterTimerEvent(t,.25,true)
call TriggerAddCondition(t,Condition(function ZZR))
set t=null
set f=null
endfunction
function ZTR takes nothing returns nothing
local group g=null
local boolexpr b=null
local unit n=null
local real d=0
local integer id='ewsp'
local boolean x=DZV(ADV,'iATK')
if C7V(ADV,'I0AB')+C7V(ADV,'I08Y')+C7V(ADV,'I08T')+C7V(ADV,'I04K')>0 then
set id='eA01'
endif
call DYV(ADV,'eA01',true)
call DYV(ADV,'iATK',false)
call UnitDamageTarget(ADV,AFV,AHV,false,false,null,null,null)
call DYV(ADV,'iATK',x)
call DYV(ADV,'eA01',false)
if AJV>0 then
set g=CreateGroup()
set b=Condition(function PPV)
set AUV=ADV
call GroupEnumUnitsInRange(g,GetUnitX(AFV),GetUnitY(AFV),600,b)
call GroupRemoveUnit(g,AFV)
if FirstOfGroup(g)!=null then
set n=GroupPickRandomUnit(g)
call GYV(id,ADV,AFV,n,650,"ZTR",AHV*(.8),AJV-1)
set n=null
endif
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
endfunction
function Z_R takes nothing returns nothing
local unit s=DHV(GetTriggeringTrigger(),'u')
call UnitRemoveAbility(s,'AA0I')
call GDV()
set s=null
endfunction
function Z0R takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
call G8V(u,DTV(t,'i'))
call HEV(u)
call GDV()
set t=null
set u=null
endfunction
function Z1R takes nothing returns nothing
