function TAR takes nothing returns nothing
local unit s=DHV(GetTriggeringTrigger(),'s')
local unit u=null
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DYV(s,'ANsi',false)
call GDV()
else
set u=GetTriggerUnit()
if IsUnitType(u,UNIT_TYPE_HERO)and IsUnitInRange(s,u,850)and IsUnitAlly(s,GetOwningPlayer(u))==false then
call IssuePointOrderById(s,$D0270,GetUnitX(u),GetUnitY(u))
endif
set u=null
endif
set s=null
endfunction
function TNR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local group g=DKV(t,'g')
local group g1=null
local boolexpr b=null
local group g2=null
local unit f=null
local integer i=GetUnitAbilityLevel(s,'A1CD')
local integer l=GetPlayerId(GetOwningPlayer(s))
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DestroyGroup(g)
call DYV(s,'a1CD',false)
call UnitRemoveAbility(s,'A1CQ')
call GDV()
else
set AUV=s
set g1=KHV()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g1,GetUnitX(s),GetUnitY(s),275,b)
if LoadInteger(le,GetHandleId(s),4270)==1 then
set f=U1[l]
set g2=KHV()
call GroupEnumUnitsInRange(g2,GetUnitX(f),GetUnitY(f),275,b)
loop
set f=FirstOfGroup(g2)
exitwhen f==null
call GroupAddUnit(g1,f)
call GroupRemoveUnit(g2,f)
endloop
call KGV(g2)
set g2=null
endif
loop
set f=FirstOfGroup(g)
exitwhen f==null
if IsUnitInGroup(f,g1)==false then
call UnitRemoveAbility(f,'A1CA')
call UnitRemoveAbility(f,'A1C9')
call UnitRemoveAbility(f,'A1CB')
call UnitRemoveAbility(f,'A1CC')
call UnitRemoveAbility(f,'B0BP')
call G5V(f,DTV(f,'B0BP'))
call DPV(f,'B0BP',0)
call HEV(f)
endif
call GroupRemoveUnit(g,f)
endloop
loop
set f=FirstOfGroup(g1)
exitwhen f==null
if GetUnitAbilityLevel(f,'B0BP')>0 then
if i==1 then
call UnitAddAbility(f,'A1CA')
elseif i==2 then
call UnitAddAbility(f,'A1C9')
elseif i==3 then
call UnitAddAbility(f,'A1CB')
elseif i==4 then
call UnitAddAbility(f,'A1CC')
endif
if IsUnitType(f,UNIT_TYPE_HERO)then
set l=R2I(B7V(f,true)*.14*.3*i)
else
set l=3*i
endif
call G5V(f,DTV(f,'B0BP'))
call G5V(f,-l)
call DPV(f,'B0BP',l)
call HEV(f)
call GroupAddUnit(g,f)
endif
call GroupRemoveUnit(g1,f)
endloop
call DestroyBoolExpr(b)
call KGV(g1)
set b=null
set g1=null
endif
set s=null
set g=null
set t=null
endfunction
