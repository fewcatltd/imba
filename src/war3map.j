call TimerStart(CreateTimer(),4.8,false,function DOOMULTIDMD)
elseif DOOMLVL==2 and GetUnitState(DOOMU,UNIT_STATE_LIFE)<=GetUnitState(DOOMU,UNIT_STATE_MAX_LIFE)*0.6 then
set DOOME=AddSpecialEffect("war3mapImported\\Eclipse.mdx",GetUnitX(DOOMU),GetUnitY(DOOMU))
call TimerStart(CreateTimer(),.8,false,function DOOMULTI2)
call TimerStart(CreateTimer(),4.8,false,function DOOMULTIDMD)
elseif DOOMLVL==3 and GetUnitState(DOOMU,UNIT_STATE_LIFE)<=GetUnitState(DOOMU,UNIT_STATE_MAX_LIFE)*0.7 then
set DOOME=AddSpecialEffect("war3mapImported\\Eclipse.mdx",GetUnitX(DOOMU),GetUnitY(DOOMU))
call TimerStart(CreateTimer(),.8,false,function DOOMULTI2)
call TimerStart(CreateTimer(),4.8,false,function DOOMULTIDMD)
else
call PauseUnit(DOOMU,false)
call SetUnitInvulnerable(DOOMU,false)
endif
endfunction
