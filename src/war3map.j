function C8X takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local integer JFV=E8(K3V,"Level")
local real a=X8(K3V,"a")
local real x=X8(K3V,"x")
local real y=X8(K3V,"y")
local integer id=GetPlayerId(GetOwningPlayer(p5))
local integer NAE=GetTriggerEvalCount(t)
local real C9X=x+$96*NAE*Cos(a)
local real DVX=y+$96*NAE*Sin(a)
local integer i=3
if H3V(p5)then
set i=30
call SetUnitX(r0[id],C9X)
call SetUnitY(r0[id],DVX)
endif
if GetPlayerController(GetOwningPlayer(r0[id]))==MAP_CONTROL_COMPUTER then
call UnitAddAbility(r0[GetPlayerId(GetOwningPlayer(p5))],'A0OE')
call SetUnitAbilityLevel(r0[GetPlayerId(GetOwningPlayer(p5))],'A0OE',JFV)
endif
call IssuePointOrderById(r0[id],$D0208,C9X,DVX)
if NAE==(i+JFV)then
call a7(K3V)
call KJV(t)
call SetUnitAnimation(p5,"stand")
endif
set t=null
set p5=null
return false
endfunction
function DEX takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit p5=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real x=GetLocationX(l)
local real y=GetLocationY(l)
local real a=Atan2(y-GetUnitY(p5),x-GetUnitX(p5))
local integer JFV=GetUnitAbilityLevel(p5,'A0O5')
local integer o6='A0OE'
if JFV==0 then
set JFV=GetUnitAbilityLevel(p5,'A1B1')
set o6='A1B2'
endif
call RemoveLocation(l)
call SetUnitAnimation(p5,"spell")
set r0[GetPlayerId(GetOwningPlayer(p5))]=CreateUnit(GetOwningPlayer(p5),'e00E',x,y,0)
call UnitAddAbility(r0[GetPlayerId(GetOwningPlayer(p5))],o6)
call SetUnitAbilityLevel(r0[GetPlayerId(GetOwningPlayer(p5))],o6,JFV)
call n7(K3V,"Level",JFV)
call E7(K3V,"x",(GetUnitX(p5))*1.)
call E7(K3V,"y",(GetUnitY(p5))*1.)
call E7(K3V,"a",(a)*1.)
call A7(K3V,"Source",p5)
if o6=='A0OE' then
call TriggerRegisterTimerEvent(t,.1,true)
else
call TriggerRegisterTimerEvent(t,.05,true)
endif
call TriggerAddCondition(t,Condition(function C8X))
set t=null
set p5=null
set l=null
endfunction
