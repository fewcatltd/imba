function HWX takes unit s,unit f returns unit
local unit u=CreateUnit(GetOwningPlayer(s),'e00E',GetUnitX(f),GetUnitY(f),0)
set IUV=u
call UnitAddAbility(u,'A0DC')
call IssueTargetOrderById(u,$D0132,f)
call UnitApplyTimedLife(u,'BTLF',1)
set u=null
return IWV
endfunction
function HYX takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'u')
local group g=DKV(t,'g')
local group g1=null
local unit f=null
local boolexpr b=null
local integer i=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetUnitAbilityLevel(s,'B039')==0 then
call DestroyGroup(g)
call GDV()
else
if IVV or EMV then
set i=1
endif
if i==1 then
set g1=CreateGroup()
set b=Condition(function PJV)
set AUV=s
call GroupEnumUnitsInRange(g1,GetUnitX(s),GetUnitY(s),$AF,b)
loop
set f=FirstOfGroup(g1)
exitwhen f==null
if IsUnitInGroup(f,g)==false then
call GroupAddUnit(g,f)
call HWX(s,s)
call IssueTargetOrderById(IWV,$D000F,f)
endif
call GroupRemoveUnit(g1,f)
endloop
call DestroyGroup(g1)
call DestroyBoolExpr(b)
set g1=null
set b=null
endif
endif
set t=null
set s=null
set g=null
endfunction
function HZX takes nothing returns nothing
local unit u=GetTriggerUnit()
local trigger t=CreateTrigger()
local real a=GetUnitFacing(u)*bj_DEGTORAD
call IssuePointOrderById(HWX(u,u),$D0012,GetUnitX(u)+300*Cos(a),GetUnitY(u)+Sin(a)*300)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function HYX))
call DFV(t,'u',u)
call DJV(t,'g',CreateGroup())
set t=null
set u=null
endfunction
