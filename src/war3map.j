function SNR takes nothing returns nothing
local unit QKR=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer SAR=R2I(.75*GetUnitAbilityLevel(QKR,'A552')*B8V(QKR,true))
local integer SBR=E8(GetHandleId(QKR),"iMFCount")+1
local integer SOR=E8(GetHandleId(QKR),"iMFIntelligence")
local integer SCR=SOR
local trigger t=CreateTrigger()
if SBR>9 then
set SBR=0
set SCR=L9V(5*GetUnitAbilityLevel(QKR,'A552'),SOR+1)
if SCR!=SOR then
call SXR(QKR,SCR)
if m5!=QKR then
call MHV("+1 Intelligence",3,QKR,.023,0,0,$FF,$FF)
endif
endif
endif
call A7(GetHandleId(t),"MFluxTarget",m5)
call n7(GetHandleId(t),"iMFluxMP",SAR)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddAction(t,function SIR)
if SBR!=0 or m5!=QKR or SCR==SOR then
call MHV("+"+I2S(SAR)+" MP",3,m5,.023,0,0,$FF,$FF)
else
call MHV("+"+I2S(SAR)+" MP
+1 Intelligence",3,QKR,.023,0,0,$FF,$FF)
endif
call n7(GetHandleId(QKR),"iMFCount",SBR)
call n7(GetHandleId(QKR),"iMFIntelligence",SCR)
set QKR=null
set m5=null
set t=null
endfunction
function SDR takes nothing returns boolean
return GetSpellTargetUnit()==Y7(GetHandleId(GetTriggeringTrigger()),"uKappa")and IsUnitEnemy(Y7(GetHandleId(GetTriggeringTrigger()),"uKappa"),GetOwningPlayer(GetTriggerUnit()))
endfunction
function SFR takes nothing returns nothing
local unit QKR=GetSpellTargetUnit()
local integer SGR=E8(GetHandleId(QKR),"iMFCast")+1
local integer SOR=E8(GetHandleId(QKR),"iMFIntelligence")
local integer SCR=SOR
if SGR>=3 then
set SGR=0
set SCR=L9V(5*GetUnitAbilityLevel(QKR,'A552'),SOR+1)
if SCR!=SOR then
call SXR(QKR,SCR)
call MHV("+1 Intelligence",3,QKR,.023,0,0,$FF,$FF)
endif
endif
call n7(GetHandleId(QKR),"iMFCast",SGR)
call n7(GetHandleId(QKR),"iMFIntelligence",SCR)
set QKR=null
endfunction
function SHR takes nothing returns boolean
return GetLearnedSkill()=='A552' and GetUnitAbilityLevel(GetTriggerUnit(),'A552')==1
endfunction
function SJR takes nothing returns nothing
local unit QKR=GetTriggerUnit()
local trigger t=CreateTrigger()
call MKV(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function SDR))
call TriggerAddAction(t,function SFR)
call A7(GetHandleId(t),"uKappa",QKR)
call n7(GetHandleId(QKR),"iMFCast",0)
call n7(GetHandleId(QKR),"iMFCount",0)
call n7(GetHandleId(QKR),"iMFIntelligence",0)
set t=null
set QKR=null
endfunction
function ETE takes nothing returns nothing
local trigger t=CreateTrigger()
call MKV(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SRR))
call TriggerAddAction(t,function SNR)
set t=CreateTrigger()
call MKV(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function SHR))
call TriggerAddAction(t,function SJR)
set t=null
endfunction
function SKR takes nothing returns boolean
return GetSpellAbilityId()=='A553'
endfunction
function SLR takes nothing returns nothing
local unit QKR=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer SMR=0
local integer SPR=0
if GetUnitAbilityLevel(QKR,'A55K')>0 then
set SPR=E8(GetHandleId(QKR),"iPFStrength")
elseif GetUnitAbilityLevel(QKR,'A55L')>0 then
set SPR=E8(GetHandleId(QKR),"iSFAgility")
elseif GetUnitAbilityLevel(QKR,'A55M')>0 then
set SPR=E8(GetHandleId(QKR),"iMFIntelligence")
endif
set SMR=SPR/2
if ModuloInteger(SPR,2)>0 then
set SMR=SMR+1
endif
set SPR=SPR/2
if GetUnitAbilityLevel(QKR,'A55K')>0 then
call QJR(QKR,0)
call n7(GetHandleId(QKR),"iPFStrength",0)
call SetHeroStr(m5,B6V(m5,false)+SMR,true)
call SetHeroStr(QKR,B6V(QKR,false)+SPR,true)
call MHV("+"+I2S(SMR)+" Strength",3,m5,.023,$FF,0,0,$FF)
call MHV("+"+I2S(SPR)+" Strength",3,QKR,.023,$FF,0,0,$FF)
call n7(GetHandleId(m5),"FluxStr",E8(GetHandleId(m5),"FluxStr")+SMR)
call n7(GetHandleId(QKR),"FluxStr",E8(GetHandleId(QKR),"FluxStr")+SPR)
elseif GetUnitAbilityLevel(QKR,'A55L')>0 then
call Q_R(QKR,0)
call n7(GetHandleId(QKR),"iSFAgility",0)
call SetHeroAgi(m5,B7V(m5,false)+SMR,true)
call SetHeroAgi(QKR,B7V(QKR,false)+SPR,true)
call MHV("+"+I2S(SMR)+" Agility",3,m5,.023,0,$FF,0,$FF)
call MHV("+"+I2S(SPR)+" Agility",3,QKR,.023,0,$FF,0,$FF)
call n7(GetHandleId(m5),"FluxAgi",E8(GetHandleId(m5),"FluxAgi")+SMR)
call n7(GetHandleId(QKR),"FluxAgi",E8(GetHandleId(QKR),"FluxAgi")+SPR)
elseif GetUnitAbilityLevel(QKR,'A55M')>0 then
call SXR(QKR,0)
call n7(GetHandleId(QKR),"iMFIntelligence",0)
call SetHeroInt(m5,B8V(m5,false)+SMR,true)
call SetHeroInt(QKR,B8V(QKR,false)+SPR,true)
call MHV("+"+I2S(SMR)+" Intelligence",3,m5,.023,0,0,$FF,$FF)
call MHV("+"+I2S(SPR)+" Intelligence",3,QKR,.023,0,0,$FF,$FF)
call n7(GetHandleId(m5),"FluxInt",E8(GetHandleId(m5),"FluxInt")+SMR)
call n7(GetHandleId(QKR),"FluxInt",E8(GetHandleId(QKR),"FluxInt")+SPR)
endif
set QKR=null
set m5=null
endfunction
function SQR takes nothing returns boolean
return GetLearnedSkill()=='A553' and GetUnitAbilityLevel(GetTriggerUnit(),'A553')==1
endfunction
function SSR takes nothing returns nothing
call UnitAddAbility(GetTriggerUnit(),'A55K')
endfunction
function STR takes nothing returns boolean
return GetSpellAbilityId()=='A55K' or GetSpellAbilityId()=='A55L' or GetSpellAbilityId()=='A55M'
endfunction
function SUR takes nothing returns nothing
if GetSpellAbilityId()=='A55K' then
call UnitRemoveAbility(GetTriggerUnit(),'A55K')
call UnitAddAbility(GetTriggerUnit(),'A55L')
elseif GetSpellAbilityId()=='A55L' then
call UnitRemoveAbility(GetTriggerUnit(),'A55L')
call UnitAddAbility(GetTriggerUnit(),'A55M')
else
call UnitRemoveAbility(GetTriggerUnit(),'A55M')
call UnitAddAbility(GetTriggerUnit(),'A55K')
endif
endfunction
function EUE takes nothing returns nothing
local trigger t=CreateTrigger()
call MKV(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SKR))
call TriggerAddAction(t,function SLR)
set t=CreateTrigger()
call MKV(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function SQR))
call TriggerAddAction(t,function SSR)
set t=CreateTrigger()
call MKV(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function STR))
call TriggerAddAction(t,function SUR)
set t=null
endfunction
function SWR takes nothing returns nothing
local unit SYR=ie[GetPlayerId(GetTriggerPlayer())]
local player p=GetTriggerPlayer()
local integer SZR=GetHandleId(SYR)
local integer S_R=E8(SZR,"FluxStr")
local integer S0R=E8(SZR,"FluxAgi")
local integer S1R=E8(SZR,"FluxInt")
local integer S3R=E8(SZR,"iPFStrength")
local integer S4R=E8(SZR,"iSFAgility")
local integer S5R=E8(SZR,"iMFIntelligence")
if GetUnitTypeId(SYR)=='H600' then
call DisplayTimedTextToPlayer(p,0,0,$F,"Bonus Strength: "+I2S(S3R))
call DisplayTimedTextToPlayer(p,0,0,$F,"Bonus Agility: "+I2S(S4R))
call DisplayTimedTextToPlayer(p,0,0,$F,"Bonus Intelligence: "+I2S(S5R))
endif
call DisplayTimedTextToPlayer(p,0,0,$F,"Flux Strength: "+I2S(S_R))
call DisplayTimedTextToPlayer(p,0,0,$F,"Flux Agility: "+I2S(S0R))
call DisplayTimedTextToPlayer(p,0,0,$F,"Flux Intelligence: "+I2S(S1R))
set SYR=null
endfunction
function EWE takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterPlayerChatEvent(t,A7V[1],"-flux",true)
call TriggerRegisterPlayerChatEvent(t,A7V[2],"-flux",true)
call TriggerRegisterPlayerChatEvent(t,A7V[3],"-flux",true)
call TriggerRegisterPlayerChatEvent(t,A7V[4],"-flux",true)
call TriggerRegisterPlayerChatEvent(t,A7V[5],"-flux",true)
call TriggerRegisterPlayerChatEvent(t,A8V[1],"-flux",true)
call TriggerRegisterPlayerChatEvent(t,A8V[2],"-flux",true)
call TriggerRegisterPlayerChatEvent(t,A8V[3],"-flux",true)
call TriggerRegisterPlayerChatEvent(t,A8V[4],"-flux",true)
call TriggerRegisterPlayerChatEvent(t,A8V[5],"-flux",true)
call TriggerAddAction(t,function SWR)
set t=null
endfunction
function InitCustomTeams takes nothing returns nothing
call SetPlayerTeam(Player(1),0)
call SetPlayerTeam(Player(2),0)
call SetPlayerTeam(Player(3),0)
call SetPlayerTeam(Player(4),0)
call SetPlayerTeam(Player(5),0)
call SetPlayerTeam(Player(7),1)
call SetPlayerTeam(Player(8),1)
call SetPlayerTeam(Player(9),1)
call SetPlayerTeam(Player($A),1)
call SetPlayerTeam(Player($B),1)
endfunction
function S6R takes nothing returns nothing
local trigger tm=GetTriggeringTrigger()
local unit u=DHV(tm,'Sour')
local group g=null
local boolexpr b=null
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetUnitAbilityLevel(u,'A07F')==0 then
call DYV(u,'A07f',false)
call GDV()
set tm=null
set u=null
return
endif
if IsUnitType(u,UNIT_TYPE_DEAD)==false then
set AUV=u
set b=Condition(function PJV)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),600,b)
call DestroyBoolExpr(b)
set b=null
if FirstOfGroup(g)!=null then
call HXV(u,'AA7V',GetUnitAbilityLevel(u,'A07F'),"frostnova",GroupPickRandomUnit(g))
endif
call DestroyGroup(g)
set g=null
endif
set tm=null
set u=null
endfunction
function A01L takes nothing returns nothing
local unit s=GetEventDamageSource()
local unit u=GetTriggerUnit()
local real d=0
local real r=.6
if IsUnitType(s,UNIT_TYPE_STRUCTURE)==false and GetUnitTypeId(GetEventDamageSource())!='hkni' and O9V==false then
set s=HMV(s)
set d=GetEventDamage()
if GetUnitAbilityLevel(u,'AIA0')>0 then
set r=.8
endif
set d=RMinBJ((B6V(u,true)-B6V(s,true))*.75,d*r)
if XXV then
set d=RMinBJ(d,(B6V(u,true)-B6V(s,true))*2)
endif
set E3V=GetWidgetLife(u)+d-GetEventDamage()
call HGV(u,true,RMaxBJ(0,d))
endif
set s=null
set u=null
endfunction
function A0CLA takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit u=DHV(tm,'Sour')
if DTV(tm,'Loop')<1 or IsUnitType(u,UNIT_TYPE_DEAD)then
call FIV()
else
call DQV(tm,'Loop',-1)
call HGV(u,true,GetUnitState(u,UNIT_STATE_MAX_LIFE)*.01*GetUnitAbilityLevel(u,'A0CL'))
endif
set tm=null
set u=null
endfunction
function A024 takes nothing returns nothing
call DPV(GetTriggerUnit(),'A024',0)
call Q6V(GetTriggerUnit(),-1)
endfunction
function S7R takes nothing returns boolean
return(PHV()and GetOwningPlayer(GetFilterUnit())==GetOwningPlayer(AUV)and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)==false)!=null
endfunction
function A0A8 takes nothing returns nothing
local group g=null
local boolexpr b=null
local unit u=null
if IVV then
if GetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE)-GetEventDamage()<1 and J_V()-DWV(GetTriggerUnit(),'A0A8')>$A then
call DUV(GetTriggerUnit(),'A0A8',J_V())
set AUV=GetTriggerUnit()
set g=CreateGroup()
set b=Condition(function S7R)
call GroupEnumUnitsInRange(g,0,0,$61A8,b)
call DestroyBoolExpr(b)
set b=null
set u=GroupPickRandomUnit(g)
call DestroyGroup(g)
set g=null
if u!=null then
call SetUnitState(AUV,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE))
call HWV(AUV,.5)
call CCV(AUV,false,true)
call SetUnitState(u,UNIT_STATE_LIFE,1)
call HPV(AUV,u,5,'d')
endif
set u=null
endif
endif
endfunction
function A01YA takes nothing returns boolean
if IsUnitType(GetFilterUnit(),UNIT_TYPE_DEAD)and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)==false then
set ANV=ANV+1
return true
endif
return false
endfunction
function S8R takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer i=GetUnitAbilityLevel(u,'A01Y')
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DYV(u,'a01Y',false)
call GDV()
set u=null
return
endif
if FRV(u)then
set u=null
return
endif
if GetUnitState(u,UNIT_STATE_LIFE)-GetEventDamage()<1 and J_V()-DWV(u,'A01Y')>0 then
call DUV(u,'A01Y',J_V()+45-5*i)
if IVV then
call HGV(u,true,$F423F)
endif
endif
set u=null
endfunction
function S9R takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer i=GetUnitAbilityLevel(u,'A04C')
local group g=null
local boolexpr b=null
local unit n=null
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DYV(u,'A04c',false)
set u=null
call GDV()
return
endif
if IsUnitType(GetEventDamageSource(),UNIT_TYPE_STRUCTURE)or FRV(u)then
set u=null
return
endif
if GetEventDamage()>5 and(J_V()-DWV(u,'A04C')>$A or DWV(u,'A04C')==0)then
call DUV(u,'A04C',J_V())
set g=CreateGroup()
set b=Condition(function PJV)
set AUV=u
if EMV then
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),450,b)
else
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),600,b)
endif
if IVV then
loop
set n=FirstOfGroup(g)
exitwhen n==null
call HXV(u,'A04C',1,"entanglingroots",n)
call GroupRemoveUnit(g,n)
endloop
endif
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set u=null
endfunction
function TVR takes nothing returns nothing
local unit u=GetTriggerUnit()
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DYV(u,'a0ER',false)
call GDV()
set u=null
return
endif
if FRV(u)then
set u=null
return
endif
if GetUnitState(u,UNIT_STATE_LIFE)-GetEventDamage()<1 and(J_V()-DWV(u,'A0ER')>35 or DWV(u,'A0ER')<1)then
call HWV(u,.5+.5*GetUnitAbilityLevel(u,'A0ER'))
call DUV(u,'A0ER',J_V())
endif
set u=null
endfunction
function TER takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
call G7V(u,-DTV(t,'l'))
call HEV(u)
call GDV()
set t=null
set u=null
endfunction
function A0O0 takes nothing returns nothing
local unit u=GetTriggerUnit()
local real d=GetEventDamage()
local integer i=GetUnitAbilityLevel(u,'A0O0')
local integer l=R2I(d/(36-6*i))
local trigger t=null
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call GDV()
else
if l>0 then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,8.25,false)
call TriggerAddCondition(t,Condition(function TER))
call DFV(t,'u',u)
call DPV(t,'l',l)
call G7V(u,l)
call HEV(u)
set t=null
endif
endif
set u=null
endfunction
function AA3W takes nothing returns nothing
local unit u=DHV(GetTriggeringTrigger(),'u')
local integer i=GetUnitAbilityLevel(u,'AA3W')
local integer id=0
local real r=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or i==0 then
call UnitRemoveAbility(u,'AB36')
call UnitRemoveAbility(u,'AB37')
call UnitRemoveAbility(u,'AB38')
call UnitRemoveAbility(u,'B936')
call UnitRemoveAbility(u,'B937')
call UnitRemoveAbility(u,'B938')
if J or i==0 then
call GDV()
endif
elseif GetTriggerEventId()==EVENT_UNIT_ISSUED_ORDER then
if GetIssuedOrderId()==852177then
if i==1 then
set id='AB36'
elseif i==2 then
set id='AB37'
else
set id='AB38'
endif
call UnitAddAbility(u,id)
call UnitMakeAbilityPermanent(u,true,id)
elseif GetIssuedOrderId()==852178then
call UnitRemoveAbility(u,'AB36')
call UnitRemoveAbility(u,'AB37')
call UnitRemoveAbility(u,'AB38')
call UnitRemoveAbility(u,'B936')
call UnitRemoveAbility(u,'B937')
call UnitRemoveAbility(u,'B938')
endif
else
if GetUnitAbilityLevel(u,'AB36')+GetUnitAbilityLevel(u,'AB37')+GetUnitAbilityLevel(u,'AB38')>0 then
set r=GetUnitState(u,UNIT_STATE_MAX_LIFE)*.01*.1
if GetUnitState(u,UNIT_STATE_LIFE)-r<2 then
call IssueImmediateOrderById(u,$D00D2)
else
call HGV(u,true,-r)
endif
endif
endif
set u=null
endfunction
function TXR takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer i=GetUnitAbilityLevel(u,'A0SC')
local unit f=null
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DYV(u,'a0SC',false)
call GDV()
set u=null
return
endif
if IsUnitType(GetEventDamageSource(),UNIT_TYPE_STRUCTURE)or FRV(u)then
set u=null
return
endif
if C3V(u,GetEventDamageSource())<300 and ITV-DWV(u,'A0SC')>0 then
set f=CreateUnit(GetOwningPlayer(u),'e00E',GetUnitX(u),GetUnitY(u),0)
call UnitAddAbility(f,'A0SC')
call SetUnitAbilityLevel(f,'A0SC',i)
call IssueImmediateOrderById(f,$D0278)
call UnitApplyTimedLife(f,'BTLF',1)
set f=null
call DUV(u,'A0SC',ITV+8.75)
endif
set u=null
endfunction
function AA01L takes nothing returns nothing
local unit u=DHV(GetTriggeringTrigger(),'u')
local integer i=0
local integer l=0
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call GDV()
set u=null
return
endif
set i=GetUnitAbilityLevel(u,'AIA0')
if i>0 then
set l=DTV(u,'AI01')
set i=i*5
if i!=l then
call G2V(u,i-l)
call DPV(u,'AI01',i)
endif
else
set l=DTV(u,'AI01')
if l!=0 then
set i=G2V(u,-l)
call DPV(u,'AI01',l-i)
endif
endif
set u=null
endfunction
function TOR takes unit s,real x,real y,integer i returns nothing
local group g1=CreateGroup()
local boolexpr b=Condition(function PQV)
local unit u=null
local unit f=FZV(s,"SpiritUnit"+I2S(i))
set AUV=s
call GroupEnumUnitsInRange(g1,x,y,'}',b)
set u=FirstOfGroup(g1)
call DestroyBoolExpr(b)
set b=Condition(function PJV)
call GroupClear(g1)
if u!=null then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathMissile.mdl",x,y))
call UnitAddAbility(f,'A04R')
call KillUnit(f)
call DQV(s,'aa5j',-1)
call FlushChildHashtable(ED,GetHandleId(f))
call FPV(s,"SpiritUnit"+I2S(i),null)
call GroupEnumUnitsInRange(g1,x,y,300,b)
loop
set f=FirstOfGroup(g1)
exitwhen f==null
call J6V(f,'AB68','B968',3,0,0,0,0,0,0,-GEV(f)*.3)
call HPV(s,f,1,25*GetUnitAbilityLevel(s,'AA5J'))
call GroupRemoveUnit(g1,f)
endloop
else
call GroupEnumUnitsInRange(g1,x,y,'}',b)
loop
set u=FirstOfGroup(g1)
exitwhen u==null
if ITV-DWV(s,GetHandleId(u))>0 then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\SpiritOfVengeanceMissile\\SpiritOfVengeanceMissile.mdl",u,"chest"))
call HPV(s,u,1,5*GetUnitAbilityLevel(s,'AA5J'))
call DUV(s,GetHandleId(u),ITV+1.99)
endif
call GroupRemoveUnit(g1,u)
endloop
endif
call DestroyGroup(g1)
call DestroyBoolExpr(b)
set u=null
set f=null
set g1=null
set b=null
endfunction
function AA5J takes nothing returns nothing
local unit s=DHV(GetTriggeringTrigger(),'s')
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local real x1=0
local real y1=0
local integer i=0
local unit f=null
local real a=0
local real d=0
local real r=0
if GetTriggerEventId()==EVENT_UNIT_DEATH then
set f=FZV(s,"SpiritUnit"+I2S(1))
call KillUnit(f)
set f=FZV(s,"SpiritUnit"+I2S(2))
call KillUnit(f)
set f=FZV(s,"SpiritUnit"+I2S(3))
call KillUnit(f)
set f=FZV(s,"SpiritUnit"+I2S(4))
call KillUnit(f)
set f=FZV(s,"SpiritUnit"+I2S(5))
call KillUnit(f)
call GDV()
set s=null
return
endif
if GetWidgetLife(s)>0 then
if ITV-DWV(s,'AA5J')>0 then
call DUV(s,'AA5J',ITV+6)
if DTV(s,'aa5j')<5 then
set i=1
loop
set f=FZV(s,"SpiritUnit"+I2S(i))
exitwhen f==null or i>5 or GetWidgetLife(f)<1 or GetUnitAbilityLevel(f,'A04R')>0
set i=i+1
endloop
if i<=5 then
set f=CreateUnit(GetOwningPlayer(s),'eA04',x,y,0)
call FPV(s,"SpiritUnit"+I2S(i),f)
call UnitAddAbility(f,'Aloc')
call DQV(s,'aa5j',1)
call UnitAddAbility(f,'Arav')
call UnitRemoveAbility(f,'Arav')
call SetUnitFlyHeight(f,$96,0)
endif
endif
endif
set a=F0V(s,"SpiritAngle")+bj_PI*.025
set d=F0V(s,"SpiritDistance")
if d<$C8 then
set d=$C8
endif
set r=F0V(s,"SpiritSpeed")
if r<1.5 and r>-1.5 then
set r=1.5
else
if d>=350 then
set r=-1.5
elseif d<=$C8 then
set r=1.5
endif
endif
set d=d+r
call FUV(s,"SpiritAngle",a)
call FUV(s,"SpiritDistance",d)
call FUV(s,"SpiritSpeed",r)
set i=1
set AUV=s
loop
exitwhen i>5
set x1=x+Cos(a+bj_PI*2/5*(i-1))*d
set y1=y+Sin(a+bj_PI*2/5*(i-1))*d
set f=FZV(s,"SpiritUnit"+I2S(i))
if f!=null and GetUnitAbilityLevel(f,'A04R')==0 then
call SetUnitX(f,x1)
call SetUnitY(f,y1)
call TOR(s,x1,y1,i)
endif
set i=i+1
endloop
endif
set s=null
set f=null
endfunction
function TRR takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
local integer i=0
local integer l=0
local integer n=0
set i=GetUnitAbilityLevel(u,'A03N')
if i>0 and GetTriggerEventId()!=EVENT_UNIT_DEATH then
set n=DTV(u,'A03N')
if EMV then
set l=GetRandomInt((-50+75*CQV(u))*i,'n'*i)
else
set l=GetRandomInt((-$96+75*CQV(u))*i,$FA*i)
endif
call G6V(u,l-n)
call DPV(u,'A03N',l)
else
set n=DTV(u,'A03N')
if n!=0 then
call G6V(u,-n)
call DPV(u,'A03N',0)
endif
call DYV(u,'a03n',false)
call GDV()
endif
call HEV(u)
set t=null
set u=null
endfunction
function TIR takes nothing returns nothing
