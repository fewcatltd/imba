local real yward=GetUnitY(GetTriggerUnit())
if GetSpellAbilityId()=='A0NT' and GetHeroInt(GetTriggerUnit(),true)>=30 then//wards
set clock1=CreateUnit(clockp,'o00A',(xward)+150,(yward)+6,0)
call UnitApplyTimedLife(clock1,'BTLF',8) 
set clock1=null
endif
if GetSpellAbilityId()=='A0NT' and GetHeroInt(GetTriggerUnit(),true)>=60 then//wards
set clock1=CreateUnit(clockp,'o00A',(xward)+4,(yward)+150,0)
call UnitApplyTimedLife(clock1,'BTLF',8) 
set clock1=null
endif
if GetSpellAbilityId()=='A0NT' and GetHeroInt(GetTriggerUnit(),true)>=90 then//wards
set clock1=CreateUnit(clockp,'o00A',(xward)-6,(yward)-160,0)
call UnitApplyTimedLife(clock1,'BTLF',8) 
set clock1=null
endif
if GetSpellAbilityId()=='A0NT' and GetHeroInt(GetTriggerUnit(),true)>=120 then//wards
set clock1=CreateUnit(clockp,'o00A',(xward)+104,(yward)+20,0)
call UnitApplyTimedLife(clock1,'BTLF',8) 
set clock1=null
endif
if GetSpellAbilityId()=='A0NT' and GetHeroInt(GetTriggerUnit(),true)>=150 then//wards
set clock1=CreateUnit(clockp,'o00A',(xward)+20,(yward)-6,0)
call UnitApplyTimedLife(clock1,'BTLF',8) 
set clock1=null
endif
if GetSpellAbilityId()=='ANsy'  then
set clockheal=GetTriggerUnit()
set clock1=CreateUnitAtLoc(clockp,'ncgb',GetSpellTargetLoc(),50)
call UnitApplyTimedLife(clock1,'BTLF',12) 
call UnitAddAbility(clock1,'A0N7')
call SetUnitAbilityLevel(clock1,'A0N7',GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')) //h0BP
call SetUnitState(clock1,UNIT_STATE_MAX_LIFE,(100*GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')))
set clock2=CreateUnitAtLoc(clockp,'ncgb',GetSpellTargetLoc(),50)
call UnitApplyTimedLife(clock2,'BTLF',12) 
call UnitAddAbility(clock2,'A0N7')
call SetUnitAbilityLevel(clock2,'A0N7',GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')) //h0BP 
call SetUnitState(clock2,UNIT_STATE_MAX_LIFE,(100*GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')))
set clock3=CreateUnitAtLoc(clockp,'ncgb',GetSpellTargetLoc(),50)
call UnitApplyTimedLife(clock3,'BOwd',12) 
call UnitAddAbility(clock3,'A0N7')
call SetUnitAbilityLevel(clock3,'A0N7',GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')) //h0BP
call SetUnitState(clock3,UNIT_STATE_MAX_LIFE,(100*GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')))
set clock4=CreateUnitAtLoc(clockp,'ncgb',GetSpellTargetLoc(),50)
call UnitApplyTimedLife(clock4,'BOwd',12) 
call UnitAddAbility(clock4,'A0N7')
call SetUnitAbilityLevel(clock4,'A0N7',GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')) //h0BP
call SetUnitState(clock4,UNIT_STATE_MAX_LIFE,(100*GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')))
set clock5=CreateUnitAtLoc(clockp,'ncgb',GetSpellTargetLoc(),50) 
call UnitApplyTimedLife(clock5,'BOwd',12) 
call UnitAddAbility(clock5,'A0N7')
call SetUnitAbilityLevel(clock5,'A0N7',GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')) //h0BP
call SetUnitState(clock5,UNIT_STATE_MAX_LIFE,(200*GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')))
set clocksp=AddSpecialEffectLoc("war3mapImported\\ShadowAssault.mdx",GetSpellTargetLoc())
call DestroyEffect(clocksp)
set clock5=CreateUnitAtLoc(clockp,'ncgb',GetSpellTargetLoc(),50)
call UnitApplyTimedLife(clock5,'BOwd',12)  
call UnitAddAbility(clock5,'A0N7')
call SetUnitAbilityLevel(clock5,'A0N7',GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')) //h0BP
call SetUnitState(clock5,UNIT_STATE_MAX_LIFE,(200*GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')))
set clocksp=AddSpecialEffectLoc("war3mapImported\\ShadowAssault.mdx",GetSpellTargetLoc())
call DestroyEffect(clocksp)
set clock5=CreateUnitAtLoc(clockp,'ncgb',GetSpellTargetLoc(),50) 
call UnitApplyTimedLife(clock5,'BOwd',12) 
call UnitAddAbility(clock5,'A0N7')
call SetUnitAbilityLevel(clock5,'A0N7',GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')) //h0BP
call SetUnitState(clock5,UNIT_STATE_MAX_LIFE,(200*GetUnitAbilityLevel(GetTriggerUnit(),'ANsy')))
set clocksp=AddSpecialEffectLoc("war3mapImported\\ShadowAssault.mdx",GetSpellTargetLoc())
call DestroyEffect(clocksp)
endif                             
set clocksp=null
set clock1=null
set clock2=null
set clock3=null
set clock4=null
set clock5=null
set clockp=null
if GetSpellAbilityId()=='A0SW' and GetUnitAbilityLevel(GetTriggerUnit(),'A0SW')==1 and IsUnitEnemy(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit()))and(GetOwningPlayer((GetSpellTargetUnit()))==A9V)==false then
call LZV(GetTriggerUnit())
call LYV(GetOwningPlayer(GetTriggerUnit()),(GetObjectName(('n03E'))))
