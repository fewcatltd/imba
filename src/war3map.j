function AMR takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit S4=GetEnumUnit()
local string s
call UnitAddAbility(S4,'A17R')
if C8(Sh)then
set s="effects\\GlyphSent.mdx"
else
set s="effects\\GlyphScourge.mdx"
endif
call b7(K3V,"FX",AddSpecialEffectTarget(s,S4,"origin"))
call A7(K3V,"Tower",S4)
call TriggerRegisterUnitEvent(t,S4,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,4,false)
call TriggerAddCondition(t,Condition(function AKR))
set t=null
set S4=null
endfunction
function APR takes unit SFV,player p returns nothing
