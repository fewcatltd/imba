set u=CreateUnit(GetOwningPlayer(vacumunit),'e00E',(GetRandomReal(-0,0)+vacumx),(GetRandomReal(-0,0)+vacumy),0)
call UnitAddAbility(u,'A0QE')
call SetUnitAbilityLevel(u,'A0QE',vacumlvl)
call IssuePointOrderById(u,852089,(GetRandomReal(-350,350)+vacumx),(GetRandomReal(-350,350)+vacumy))
call RemoveUnit(u)
set u=null
endfunction
