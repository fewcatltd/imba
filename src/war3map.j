function Z2O takes unit p5,unit m5 returns nothing
local integer JFV=GetUnitAbilityLevel(p5,'A0SS')
local real HSV=(.03+.01*JFV)*GetUnitState(m5,UNIT_STATE_LIFE)
if H3V(p5)then
set HSV=(.03+.01*JFV)*GetUnitState(m5,UNIT_STATE_MAX_LIFE)
endif
set O9V=true
call HPV(p5,m5,2,HSV)
call SetUnitState(p5,UNIT_STATE_LIFE,HSV+GetUnitState(p5,UNIT_STATE_LIFE))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",p5,"origin"))
endfunction
