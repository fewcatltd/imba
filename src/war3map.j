function R9O takes nothing returns boolean
return(IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(Me))and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0)!=null
endfunction
function IVO takes nothing returns nothing
call HPV(Me,GetEnumUnit(),2,Pe)
endfunction
function IEO takes unit p5,unit m5,real HSV returns nothing
local group S8V=KHV()
local boolexpr hP=Condition(function R9O)
set Me=p5
set Pe=HSV
call GroupEnumUnitsInRange(S8V,GetUnitX(m5),GetUnitY(m5),$B4,hP)
call ForGroup(S8V,function IVO)
call DestroyBoolExpr(hP)
call KGV(S8V)
endfunction
function IXO takes nothing returns boolean
return(IsUnitInGroup(GetFilterUnit(),ax)==false and IsUnitAlly(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit()))and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit()))and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and LAV(GetFilterUnit())==false)!=null
endfunction
function IOO takes group IRO,unit IIO,unit p5,unit IAO,boolean INO returns unit
local group S8V=KHV()
local boolexpr hP=Condition(function IXO)
local unit IBO=null
local unit ICO
local boolean IDO=IAO!=p5 and INO
local integer i=500
set EL=IDO
set ax=IRO
set Me=p5
call GroupEnumUnitsInRange(S8V,GetUnitX(IIO),GetUnitY(IIO),i,hP)
set ICO=FirstOfGroup(S8V)
set IBO=ICO
loop
exitwhen ICO==null
if GetUnitState(ICO,UNIT_STATE_LIFE)!=GetUnitState(ICO,UNIT_STATE_MAX_LIFE)then
if ICO!=p5 and IsUnitType(ICO,UNIT_TYPE_HERO) and IsUnitType(IBO,UNIT_TYPE_HERO)==false then
set IBO=ICO
elseif ICO!=p5 and GetUnitState(ICO,UNIT_STATE_LIFE)<GetUnitState(IBO,UNIT_STATE_LIFE)and IsUnitType(ICO,UNIT_TYPE_HERO) and IsUnitType(IBO,UNIT_TYPE_HERO) then
set IBO=ICO
elseif ICO!=p5 and IsUnitType(IBO,UNIT_TYPE_HERO)==false and GetUnitState(ICO,UNIT_STATE_LIFE)<GetUnitState(IBO,UNIT_STATE_LIFE)then
set IBO=ICO
elseif ICO==p5 then
set IBO=ICO
endif
endif
call GroupRemoveUnit(S8V,ICO)
set ICO=FirstOfGroup(S8V)
endloop
call KGV(S8V)
call DestroyBoolExpr(hP)
set S8V=null
set hP=null
set ICO=null
return IBO
endfunction
function IFO takes nothing returns nothing
local unit s=GetTriggerUnit()
local unit u=GetSpellTargetUnit()
local integer i=GetUnitAbilityLevel(s,'A0OR')
local real d=60+i*20+B8V(s,true)
local group g=CreateGroup()
local boolexpr b=Condition(function PTV)
local real x=0
local real y=0
local integer l=5*i
local group g1=CreateGroup()
local unit t=null
local real r=B8V(s,true)*3
set AUV=s
set t=u
set u=s
loop
exitwhen t==null or l<1
call GroupAddUnit(g1,t)
call HGV(t,true,d)
call Q_V(s,GetUnitX(t),GetUnitY(t),$B4+r*.5,d,2)
call MFV("SPLK",GetUnitX(t),GetUnitY(t),GetUnitX(u),GetUnitY(u),.3,.5,.9,1,.7)
set x=GetUnitX(t)
set y=GetUnitY(t)
call GroupEnumUnitsInRange(g,x,y,525+r,b)
call GroupRemoveGroup(g1,g)
set u=t
set t=GroupPickRandomUnit(g)
call GroupClear(g)
set l=l-1
endloop
call DestroyGroup(g)
call DestroyGroup(g1)
call DestroyBoolExpr(b)
set s=null
set u=null
set g=null
set b=null
set g1=null
set t=null
endfunction
function IGO takes nothing returns nothing
local unit K8V=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local string IHO="Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCaster.mdl"
local string IJO="origin"
local unit array IKO
local integer x
local integer i=1
local integer JFV=GetUnitAbilityLevel(K8V,'A0OR')
local real HSV=60+JFV*20
local group IRO=KHV()
local integer ILO
local boolean IMO=false
if H3V(K8V)then
call IFO()
set K8V=null
set m5=null
set IRO=null
return
endif
if JFV==3 then
set ILO=4
elseif JFV==4 then
set ILO=5
else
set ILO=3
endif
set IKO[i]=m5
if m5!=K8V then
call MFV("SPLK",GetUnitX(K8V),GetUnitY(K8V),GetUnitX(m5),GetUnitY(m5),.3,.5,.9,1,.7)
endif
call MNV(IHO,IKO[i],IJO,2)
if LAV(IKO[i])==false then
call SetUnitState(IKO[i],UNIT_STATE_LIFE,GetUnitState(IKO[i],UNIT_STATE_LIFE)+HSV)
endif
call IEO(K8V,IKO[i],HSV)
call GroupAddUnit(IRO,IKO[i])
set i=2
loop
exitwhen i>ILO or IMO
set IKO[i]=IOO(IRO,IKO[i-1],K8V,m5,i==ILO)
if IKO[i]==null then
set IMO=true
else
call GroupAddUnit(IRO,IKO[i])
call MNV(IHO,IKO[i],IJO,2)
call SetUnitState(IKO[i],UNIT_STATE_LIFE,GetUnitState(IKO[i],UNIT_STATE_LIFE)+HSV)
call IEO(K8V,IKO[i],HSV)
call MFV("SPLK",GetUnitX(IKO[i-1]),GetUnitY(IKO[i-1]),GetUnitX(IKO[i]),GetUnitY(IKO[i]),.3,.5,.9,1,.7)
set i=i+1
endif
endloop
call KGV(IRO)
set K8V=null
set m5=null
set IRO=null
endfunction
function tE takes nothing returns nothing
call CZV('A0OR',"IGO")
endfunction
function IPO takes unit p5,unit m5,integer JFV returns nothing
local unit oA=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
call UnitAddAbility(oA,'A0NJ')
call SetUnitAbilityLevel(oA,'A0NJ',JFV)
call IssueTargetOrderById(oA,$D006B,m5)
call UnitApplyTimedLife(oA,'BTLF',1)
set oA=null
endfunction
function IQO takes unit p5,unit m5 returns nothing
local unit oA=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
call UnitAddAbility(oA,'A0NK')
call IssueTargetOrderById(oA,$D007F,m5)
call UnitApplyTimedLife(oA,'BTLF',1)
set oA=null
endfunction
function ISO takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local unit m5=Y7(K3V,"Target")
local integer JFV=GetUnitAbilityLevel(p5,'A0NQ')
local integer QI=GetTriggerExecCount(t)
local real HSV=7*JFV
if JFV==1 then
call UnitAddAbility(m5,'A0OW')
call HPV(p5,m5,2,HSV)
if QI==8 then
call UnitRemoveAbility(m5,'A0OW')
call a7(K3V)
call KJV(t)
endif
endif
if JFV==2 then
if QI==1 then
call IPO(p5,m5,2)
endif
if QI>1 then
call UnitAddAbility(m5,'A0OW')
call HPV(p5,m5,2,HSV)
endif
if QI==9 then
call UnitRemoveAbility(m5,'A0OW')
call a7(K3V)
call KJV(t)
endif
endif
if JFV==3 then
if QI==1 then
call IPO(p5,m5,2)
endif
if QI==2 then
call IQO(p5,m5)
endif
if QI>2 then
call UnitAddAbility(m5,'A0OW')
call HPV(p5,m5,2,HSV)
endif
if QI==$A then
call UnitRemoveAbility(m5,'A0OW')
call a7(K3V)
call KJV(t)
endif
endif
if JFV==4 then
if QI==1 then
call IPO(p5,m5,2)
endif
if QI==2 then
call IQO(p5,m5)
endif
if QI>2 then
call UnitAddAbility(m5,'A0OW')
call HPV(p5,m5,2,HSV)
endif
if QI==$A then
call UnitRemoveAbility(m5,'A0OW')
call a7(K3V)
call KJV(t)
endif
endif
endfunction
function ITO takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local integer i=DTV(t,'i')
local integer l=GetTriggerEvalCount(t)
if l>40+40*i or GetTriggerEventId()==EVENT_UNIT_DEATH then
call HVV(u,DTV(t,'l'))
call GTV(u,DTV(t,'d'))
call HEV(u)
call GDV()
else
call HVV(u,-2)
call DQV(t,'l',2)
call GTV(u,-1)
call DQV(t,'d',1)
call HEV(u)
call HPV(s,u,2,1+B8V(s,true)*.025)
if l==$C8 then
call QHV(null,u,1)
endif
endif
set t=null
set s=null
set u=null
endfunction
function IUO takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
if H3V(GetTriggerUnit())then
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerRegisterUnitEvent(t,GetSpellTargetUnit(),EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function ITO))
call DFV(t,'s',GetTriggerUnit())
call DFV(t,'u',GetSpellTargetUnit())
call DPV(t,'i',GetUnitAbilityLevel(GetTriggerUnit(),'A0NQ'))
call DPV(t,'l',0)
call DPV(t,'d',0)
else
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddAction(t,function ISO)
call A7(K3V,"Source",GetTriggerUnit())
call A7(K3V,"Target",GetSpellTargetUnit())
call IPO(GetTriggerUnit(),GetSpellTargetUnit(),1)
endif
set t=null
endfunction
function IWO takes nothing returns boolean
if GetSpellAbilityId()=='A0NQ' and GetUnitAbilityLevel((GetSpellTargetUnit()),'B0BI')>0==false then
call IUO()
endif
return false
endfunction
function tf takes nothing returns nothing
call CZV('A0NQ',"IWO")
call L3V('A0NJ')
call L3V('A0NK')
endfunction
function IYO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit m5=Y7(K3V,"Target")
local real HJX=X8(K3V,"Damage")
local real IZO=MXV(GetUnitState(m5,UNIT_STATE_LIFE)-HJX,1)
local real I_O=X8(GetHandleId(m5),"ShallowGrave|FakeLife")
call SetUnitState(m5,UNIT_STATE_LIFE,IZO)
call E7(GetHandleId(m5),"ShallowGrave|FakeLife",I_O-HJX)
call a7(K3V)
call KJV(t)
set t=null
set m5=null
return false
endfunction
function I0O takes unit m5,real HJX returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local real I_O=X8(GetHandleId(m5),"ShallowGrave|FakeLife")
call A7(K3V,"Target",m5)
call E7(K3V,"Damage",HJX)
call E7(GetHandleId(m5),"ShallowGrave|FakeLife",I_O+HJX)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function IYO))
set t=null
endfunction
function I1O takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit m5
local real Wx
local real HJX
local integer iX=GetTriggerEvalCount(t)
local real I_O
local real I2O=X8(K3V,"LastFrame")
local real I3O=X8(K3V,"FrameDamage")
if I2O!=J_V()then
set I2O=J_V()
set I3O=0
call E7(K3V,"LastFrame",I2O)
call E7(K3V,"FrameDamage",I3O)
endif
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set m5=GetTriggerUnit()
set I_O=X8(GetHandleId(m5),"ShallowGrave|FakeLife")
set Wx=GetUnitState(m5,UNIT_STATE_LIFE)
set HJX=GetEventDamage()
if((Wx-I_O-I3O)-HJX)<1 then
call SetUnitState(m5,UNIT_STATE_LIFE,Wx+HJX+I3O)
call I0O(m5,HJX)
else
set I3O=I3O+HJX
call E7(K3V,"FrameDamage",I3O)
endif
else
call K_V(Y7(K3V,"Target"),"ShallowGrave|Active")
call DestroyEffect(r8(K3V,"FX"))
call a7(K3V)
call KJV(t)
endif
set m5=null
set t=null
return false
endfunction
function I4O takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer i=5
call TriggerRegisterTimerEvent(t,i,false)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function I1O))
call b7(K3V,"FX",AddSpecialEffectTarget("war3mapImported\\DarkHands.mdx",m5,"overhead"))
call E7(GetHandleId(m5),"ShallowGrave|FakeLife",0)
call E7(K3V,"LastFrame",J_V())
call E7(K3V,"FrameDamage",0)
call A7(K3V,"Target",m5)
call KYV(m5,"ShallowGrave|Active")
set t=null
set p5=null
set m5=null
endfunction
function I5O takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=null
local real d=0
local unit u=null
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set s=GetEventDamageSource()
set u=GetTriggerUnit()
set d=GetUnitState(u,UNIT_STATE_LIFE)-GetEventDamage()
if d<1 then
call SetUnitState(u,UNIT_STATE_LIFE,1)
call HWV(u,0)
set d=-d
if d>0 and GUV(HMV(s))==false and GetUnitTypeId(HMV(s))!='n00L' and F1V(Player($F),"isA10L")==false and ONV==false and IsUnitType(s,UNIT_TYPE_STRUCTURE)==false then
call FHV(Player($F),"isA10L",true)
call HPV(u,HMV(s),5,d)
call FHV(Player($F),"isA10L",false)
endif
endif
else
call DestroyEffect(D2V(t,'e'))
call GDV()
endif
set t=null
set s=null
set u=null
endfunction
function I6O takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=GetUnitAbilityLevel(GetTriggerUnit(),'A10L')
call TriggerRegisterUnitEvent(t,GetSpellTargetUnit(),EVENT_UNIT_DAMAGED)
call TriggerRegisterTimerEvent(t,2*i+1,false)
call TriggerAddCondition(t,Condition(function I5O))
call D1V(t,'e',AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AntiMagicShell\\AntiMagicShell.mdx",GetSpellTargetUnit(),"chest"))
set t=null
endfunction
function I7O takes nothing returns boolean
if GetSpellAbilityId()=='A10L' then
if H3V(GetTriggerUnit())then
call I6O()
else
call I4O()
endif
endif
return false
endfunction
function ZLV takes nothing returns nothing
call CZV('A10L',"I7O")
endfunction
function I8O takes nothing returns nothing
local unit m5=GetEnumUnit()
if LAV(m5)==false then
call UnitRemoveAbility(m5,'A0NU')
call UnitRemoveAbility(m5,'A0NW')
elseif IsUnitType(m5,UNIT_TYPE_HERO) then
call M0V(m5,'A0NU',5.1)
call M0V(m5,'A0NW',5.1)
endif
set m5=null
endfunction
function I9O takes nothing returns nothing
local unit m5=GetEnumUnit()
if LAV(m5)==false then
if IsUnitAlly(m5,nL)==false then
if Sl==0 then
call UnitAddAbility(m5,'A0NU')
else
call SetUnitAbilityLevel(m5,'A0NU',Sl+1)
endif
else
if Sl==0 then
call UnitAddAbility(m5,'A0NW')
else
call SetUnitAbilityLevel(m5,'A0NW',Sl+1)
endif
endif
endif
set m5=null
endfunction
function AVO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local group g=o8(K3V,"g")
local player p=v8(K3V,"p")
local integer NAE=GetTriggerEvalCount(t)
local integer PNV=E8(K3V,"Duration")
set nL=p
set Sl=NAE
if NAE==PNV then
call ForGroup(g,function I8O)
call KGV(g)
call a7(K3V)
call KJV(t)
else
call ForGroup(g,function I9O)
endif
set t=null
set g=null
set p=null
return false
endfunction
function AEO takes nothing returns nothing
call MNV(OL,GetEnumUnit(),"chest",3)
call MNV(OL,GetEnumUnit(),"chest",3)
call MNV(OL,GetEnumUnit(),"right hand",3)
call MNV(OL,GetEnumUnit(),"left hand",3)
endfunction
function AXO takes nothing returns nothing
local unit K8V=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local group g=KHV()
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local integer JFV=GetUnitAbilityLevel(K8V,'A10Q')
local integer PNV=6+6*JFV
local real x=GetLocationX(l)
local real y=GetLocationY(l)
local unit QJV=CreateUnit(GetOwningPlayer(K8V),'h007',x,y,0)
local boolean GZX=false
local integer i=0
if JFV==0 then
set JFV=GetUnitAbilityLevel(K8V,'A1DB')
set PNV=6+6*JFV+6
set GZX=true
endif
if i!=0 then
set PNV='x'
endif
call RemoveLocation(l)
set OL="Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl"
call SetUnitVertexColor(QJV,$FF,$FF,$FF,$FF)
call UnitApplyTimedLife(QJV,'BTLF',5)
if GZX then
call GroupEnumUnitsInRange(g,x,y,800+i,Condition(function P8V))
else
call GroupEnumUnitsInRange(g,x,y,600+i,Condition(function P8V))
endif
call ForGroup(g,function AEO)
call F7(K3V,"g",g)
call D7(K3V,"p",GetOwningPlayer(K8V))
call n7(K3V,"Duration",PNV)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function AVO))
call TriggerEvaluate(t)
set K8V=null
set l=null
set g=null
set t=null
endfunction
function AOO takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
local integer l=DTV(t,'l')
if GetTriggerEventId()==EVENT_UNIT_DEATH or l==DTV(t,'i')then
if DZV(t,'b')then
call G5V(u,-l)
else
call G5V(u,l)
endif
call HEV(u)
call UnitRemoveAbility(u,'AB13')
call UnitRemoveAbility(u,'B913')
call UnitRemoveAbility(u,'AB14')
call UnitRemoveAbility(u,'B914')
call DestroyEffect(D2V(t,0))
call DestroyEffect(D2V(t,1))
call DestroyEffect(D2V(t,2))
call DestroyEffect(D2V(t,3))
call GDV()
else
if DZV(t,'b')then
call G5V(u,1)
else
call G5V(u,-1)
endif
call HEV(u)
call DPV(t,'l',l+1)
endif
set t=null
set u=null
endfunction
function ARO takes nothing returns nothing
local trigger t=null
local unit s=GetTriggerUnit()
local integer i=GetUnitAbilityLevel(s,'A10Q')
local group g=CreateGroup()
local boolexpr b=Condition(function PQV)
local unit u=null
if GetSpellAbilityId()=='A1DB' then
set i=GetUnitAbilityLevel(s,'A1DB')+1
endif
set AUV=s
call GroupEnumUnitsInRange(g,0,0,$6590,b)
if FirstOfGroup(g)!=null then
loop
set u=FirstOfGroup(g)
exitwhen u==null
if GetUnitAbilityLevel(u,'AB13')==0 then
call UnitAddAbility(u,'AB13')
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerAddCondition(t,Condition(function AOO))
call DFV(t,'u',u)
call D1V(t,0,AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",u,"origin"))
call D1V(t,1,AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",u,"chest"))
call D1V(t,2,AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",u,"right hand"))
call D1V(t,3,AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",u,"left hand"))
call DPV(t,'i',$C+$C*1)
call DPV(t,'l',0)
call DYV(t,'b',false)
set t=null
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
endif
set g=CreateGroup()
call DestroyBoolExpr(b)
set b=Condition(function PUV)
call GroupEnumUnitsInRange(g,0,0,$6590,b)
if FirstOfGroup(g)!=null then
loop
set u=FirstOfGroup(g)
exitwhen u==null
if GetUnitAbilityLevel(u,'AB14')==0 then
call UnitAddAbility(u,'AB14')
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerAddCondition(t,Condition(function AOO))
call DFV(t,'u',u)
call D1V(t,0,AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",u,"origin"))
call D1V(t,1,AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",u,"chest"))
call D1V(t,2,AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",u,"right hand"))
call D1V(t,3,AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",u,"left hand"))
call DPV(t,'i',$C+$C*8)
call DPV(t,'l',0)
call DYV(t,'b',true)
set t=null
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
endif
call DestroyBoolExpr(b)
set g=null
set b=null
set s=null
endfunction
function AIO takes nothing returns boolean
if GetSpellAbilityId()=='A10Q' or GetSpellAbilityId()=='A1DB' then
if H3V(GetTriggerUnit())then
call ARO()
else
call AXO()
endif
endif
return false
endfunction
function ZMV takes nothing returns nothing
call CZV('A10Q',"AIO")
call CZV('A1DB',"AIO")
if IVV==false then
call L3V('A0NU')
call L3V('A0NW')
endif
endfunction
function AAO takes nothing returns nothing
if IsUnitInGroup(GetEnumUnit(),rL)==false then
set vZ=CreateUnit(GetOwningPlayer(xL),'e00E',GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),0)
call UnitAddAbility(vZ,'A17N')
call SetUnitAbilityLevel(vZ,'A17N',eZ)
call IssueTargetOrderById(vZ,$D022F,GetEnumUnit())
call GroupAddUnit(rL,GetEnumUnit())
endif
endfunction
function ANO takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local real r=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetTriggerEvalCount(t)>$E then
call DYV(u,'A173',false)
call HVV(u,DWV(t,'d'))
call GDV()
else
set r=GetUnitState(u,UNIT_STATE_MAX_LIFE)*.01+H4V(s,$E)
call HVV(u,$F)
call HPV(s,u,1,r)
call H1V(C_V(r),$FF,0,0,u)
call DSV(t,'d',-$F)
endif
set t=null
set s=null
set u=null
endfunction
function ABO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local group g=o8(K3V,"g")
local unit oA=Y7(K3V,"Caster")
local integer JFV=E8(K3V,"Level")
local real RK=X8(K3V,"Angle")
local group S8V
local real x
local real y
local real ACO=30
local integer i=28
local integer n=$96
local unit f=null
local trigger tm=null
local real r=0
set eZ=JFV
if GetTriggerEvalCount(t)>i then
call KGV(g)
call a7(K3V)
call KJV(t)
call ShowUnit(oA,false)
call KillUnit(oA)
else
set x=GetUnitX(oA)
set y=GetUnitY(oA)
set S8V=KHV()
set rL=g
set xL=oA
set wl=JFV*70
call GroupEnumUnitsInRange(S8V,x,y,n,Condition(function P9V))
if H3V(oA)then
call GroupRemoveGroup(g,S8V)
loop
set f=FirstOfGroup(S8V)
exitwhen f==null
if DZV(f,'A173')==false and GUV(f)==false then
call DYV(f,'A173',true)
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function ANO))
call DFV(t,'s',ie[GetPlayerId(GetOwningPlayer(oA))])
call DFV(t,'u',f)
call DUV(t,'d',$F*$E)
call HVV(f,-$F*$E)
set t=null
endif
set r=GetUnitState(f,UNIT_STATE_MAX_LIFE)*(.03+.02*JFV)+H4V(oA,2)
call HPV(oA,f,1,r)
call H1V(C_V(r),$FF,0,0,f)
call GroupAddUnit(g,f)
call GroupRemoveUnit(S8V,f)
endloop
else
call ForGroup(S8V,function AAO)
endif
call KGV(S8V)
call SetUnitX(oA,L1V(x+ACO*Cos(RK*bj_DEGTORAD)))
call SetUnitY(oA,L2V(y+ACO*Sin(RK*bj_DEGTORAD)))
endif
set t=null
set g=null
set S8V=null
set oA=null
return false
endfunction
function ADO takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local group g=KHV()
local unit K8V=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real x1=GetUnitX(K8V)
local real y1=GetUnitY(K8V)
local real x2=GetLocationX(l)
local real y2=GetLocationY(l)
local real RK=MDV(x1,y1,x2,y2)
local integer JFV=GetUnitAbilityLevel(K8V,'A173')
local unit oA=CreateUnit(GetOwningPlayer(K8V),'h07K',x1,y1,RK)
call MUV(QR,x1,y1)
call A7(K3V,"Caster",oA)
call n7(K3V,"Level",JFV)
call F7(K3V,"g",g)
call E7(K3V,"Angle",RK)
call A7(K3V,"Hero",K8V)
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function ABO))
call RemoveLocation(l)
set t=null
set oA=null
set g=null
set K8V=null
set l=null
endfunction
