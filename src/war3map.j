call DFV(t,'s',s)
call DUV(t,'x',x)
call DUV(t,'y',y)
call D1V(t,'e',AddSpecialEffect("EarthlyEminence.mdl",x,y))
set f=FZV(s,"TetherTarget")
if f!=null and GetUnitAbilityLevel(f,'AB66')+GetUnitAbilityLevel(f,'AB67')>0 then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,f,EVENT_UNIT_DAMAGED)
call TriggerRegisterTimerEvent(t,$C,false)
call TriggerAddCondition(t,Condition(function ECI))
call DFV(t,'s',f)
call DUV(t,'x',GetUnitX(f))
call DUV(t,'y',GetUnitY(f))
call D1V(t,'e',AddSpecialEffect("EarthlyEminence.mdl",x,y))
set a=HYV(s,f)
set d=DNV(s,f)
if GetLocalPlayer()==GetOwningPlayer(f)then
call PanCameraToTimed(x1+Cos(a)*d,y1+Sin(a)*d,0)
endif
call SetUnitX(f,x1+Cos(a)*d)
call SetUnitY(f,y1+Sin(a)*d)
endif
if GetLocalPlayer()==GetOwningPlayer(s)then
call PanCameraToTimed(x1,y1,0)
endif
call SetUnitX(s,x1)
call SetUnitY(s,y1)
endif
set t=null
set s=null
set f=null
endfunction
function EDI takes nothing returns nothing
local unit s=GetTriggerUnit()
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real x=GetUnitX(s)
local real y=GetUnitY(s)
local integer i=GetUnitAbilityLevel(s,'AA5L')
local unit u=GetSpellTargetUnit()
local integer l=GetRandomInt(0,OEV)
local unit f=null
set OVV=OXV[l]
call UnitAddAbility(s,OXV[l])
call SetUnitAbilityLevel(s,OXV[l],i)
if ORV[l]==1 then
set x=x1
set y=y1
endif
if OAV[l]!=null then
call ExecuteFunc(OAV[l])
else
set f=CreateUnit(GetTriggerPlayer(),'e00E',x,y,0)
call DYV(f,'link',true)
call UnitAddAbility(f,OXV[l])
call SetUnitAbilityLevel(f,OXV[l],i)
if ORV[l]==1 then
call IssueImmediateOrderById(f,OOV[l])
elseif ORV[l]==2 then
call IssueTargetOrderById(f,OOV[l],u)
else
call IssuePointOrderById(f,OOV[l],x1,y1)
endif
call UnitApplyTimedLife(f,'BTLF',$A)
set f=null
endif
call QCV(s,OXV[l])
set u=null
set s=null
endfunction
function EFI takes nothing returns nothing
