function A1X takes nothing returns nothing
local integer i=0
local integer l=0
if IsPlayerAlly(RVV,Player(6))then
set l=0
else
set l=7
endif
if GetTriggerEventId()==EVENT_PLAYER_ARROW_LEFT_DOWN or GetTriggerEventId()==EVENT_PLAYER_ARROW_UP_DOWN or GetTriggerEventId()==EVENT_PLAYER_ARROW_DOWN_DOWN or GetTriggerEventId()==EVENT_PLAYER_ARROW_RIGHT_DOWN then
if OZV[0]==0 then
set i=0
else
if OZV[1]==0 then
set i=1
else
set i=2
if OZV[2]!=0 then
set OZV[0]=OZV[1]
set OZV[1]=OZV[2]
set OZV[2]=0
endif
endif
endif
if GetTriggerEventId()==EVENT_PLAYER_ARROW_UP_DOWN then
set OZV[i]=1
endif
if GetTriggerEventId()==EVENT_PLAYER_ARROW_DOWN_DOWN then
set OZV[i]=2
endif
if GetTriggerEventId()==EVENT_PLAYER_ARROW_LEFT_DOWN then
set OZV[i]=3
endif
if GetTriggerEventId()==EVENT_PLAYER_ARROW_RIGHT_DOWN then
set OZV[i]=4
endif
set i=0
call A_X(1,1,1,"AYX")
call A_X(2,2,2,"AZX")
if A0X(1,3,3)then
call AWX(l+0)
endif
if A0X(1,3,1)then
call AWX(l+1)
endif
if A0X(1,3,4)then
call AWX(l+2)
endif
if A0X(1,3,2)then
call AWX(l+3)
endif
if A0X(1,4,3)then
call AWX(l+4)
endif
if A0X(4,3,3)then
call AUX($A)
endif
if A0X(4,3,1)then
call AUX('d')
endif
if A0X(4,3,2)then
call AUX($3E8)
endif
else
set OZV[0]=0
set OZV[1]=0
set OZV[2]=0
endif
endfunction
