function WXE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local integer WOE=E8(K3V,"u1Index")
local integer WRE=E8(K3V,"u2Index")
local unit u1=B8(WOE)
local unit u2=B8(WRE)
local real PNV=X8(K3V,"Duration")
local lightning WIE=i8(K3V,"Lightning")
if I2R(GetTriggerEvalCount(t))*.025>PNV then
call DestroyLightning(WIE)
call b8(WOE)
call b8(WRE)
call a7(K3V)
call KJV(t)
else
call MoveLightning(WIE,true,GetUnitX(u1),GetUnitY(u1),GetUnitX(u2),GetUnitY(u2))
endif
set t=null
set u1=null
set u2=null
set WIE=null
return false
endfunction
function WAE takes string WNE,unit u1,unit u2,real r,real g,real b,real a,real PNV returns nothing
local real x1=GetUnitX(u1)
local real y1=GetUnitY(u1)
local real x2=GetUnitX(u2)
local real y2=GetUnitY(u2)
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
local lightning WIE=AddLightning(WNE,true,x1,y1,x2,y2)
call SetLightningColor(WIE,r,g,b,a)
call c7(K3V,"Lightning",WIE)
call n7(K3V,"u1Index",c8(u1))
call n7(K3V,"u2Index",c8(u2))
call E7(K3V,"Duration",PNV)
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function WXE))
set t=null
set WIE=null
endfunction
function WBE takes string WCE returns nothing
