if x>GetRectMaxX(bj_mapInitialPlayableArea)then
return GetRectMaxX(bj_mapInitialPlayableArea)
elseif x<GetRectMinX(bj_mapInitialPlayableArea)then
return GetRectMinX(bj_mapInitialPlayableArea)
endif
