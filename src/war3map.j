elseif((Q_O=='A03R')or(Q_O=='A0AV'))then
call TriggerSleepAction(.5)
loop
call TriggerSleepAction(.6)
exitwhen((GetUnitCurrentOrder(j5)!=$D0278)or(not A5(j5)))
call IV(GetUnitX(j5),GetUnitY(j5),900.,Condition(function KP),function W5O)
endloop
elseif((Q_O=='A073')or(Q_O=='A03J')or(Q_O=='A04J')or(Q_O=='A04M')or(Q_O=='A04N'))then
set LBO=Bz
loop
exitwhen((RAbsBJ(Bz-LBO)>=29.)or(not A5(j5)))
call IV(GetUnitX(j5),GetUnitY(j5),1200.,Condition(function KP),function W1O)
call TriggerSleepAction(.8)
endloop
elseif(Q_O=='A1BX')then
set JD=GetLocationX(HC[GetPlayerId(GetOwningPlayer(j5))])
set Je=GetLocationY(HC[GetPlayerId(GetOwningPlayer(j5))])
loop
call TriggerSleepAction(.6)
exitwhen((GetUnitCurrentOrder(j5)!=$D00DC)or(not A5(j5)))
call MoveLocation(Hb,JD,Je)
call IV(JD,Je,1000.,Condition(function KP),function W7O)
endloop
elseif((Q_O=='A06X')or(Q_O=='A0AQ'))then
loop
call TriggerSleepAction(1.)
exitwhen((GetUnitAbilityLevel(j5,'B024')==0)or(not A5(j5)))
call IV(GetUnitX(j5),GetUnitY(j5),350.,Condition(function KP),function W8O)
endloop
endif
set j5=null
set m5=null
endfunction
function YEO takes unit u returns nothing
local integer O5=GetPlayerId(GetOwningPlayer(u))
local integer UP=0
if(N5(u))then
call jW(u,$D0012,h9[O5])
else
if(M5(u,Jx(u))<12000.)then
if(not IsUnitAlly(u,A7V[0]))then
set UP='d'
endif
if(h9[16+O5]==h7[35])then
set h8[16+O5]=h7[35+UP]
set h8[O5]=h7[35+UP]
elseif(h9[16+O5]==h7[55])then
set h8[16+O5]=h7[55+UP]
set h8[O5]=h7[55+UP]
elseif(h9[16+O5]==h7[$E])then
set h8[16+O5]=h7[$E+UP]
set h8[O5]=h7[$E+UP]
endif
set h9[O5]=Jx(u)
set h9[16+O5]=Jx(u)
endif
call jW(u,$D000F,h8[O5])
set eY[O5]=1
set G0[32+O5]=false
set hq[528+O5]=Bz+60.
if(hG[32+O5]!=-1)then
if((hG[32+O5]-GetPlayerState(GetOwningPlayer(u),PLAYER_STATE_RESOURCE_GOLD))<$3E8)then
set hG[32+O5]=GetPlayerState(GetOwningPlayer(u),PLAYER_STATE_RESOURCE_GOLD)+$3E8
endif
endif
endif
endfunction
function YXO takes nothing returns nothing
call YEO(GetEnumUnit())
endfunction
function YOO takes unit u returns nothing
if(N5(u))then
call jW(u,$D0012,h9[GetPlayerId(GetOwningPlayer(u))])
elseif(M5(u,Jx(u))>5500.)then
call jW(u,$D0012,h9[GetPlayerId(GetOwningPlayer(u))])
set h4[GetPlayerId(GetOwningPlayer(u))]=null
else
call jW(u,$D000F,JW(u))
endif
if((eY[GetPlayerId(GetOwningPlayer(u))]!=4)and(eY[GetPlayerId(GetOwningPlayer(u))]!=2))then
set eY[GetPlayerId(GetOwningPlayer(u))]=3
endif
endfunction
function YRO takes unit u returns nothing
if(N5(u))then
call jW(u,$D0012,h9[GetPlayerId(GetOwningPlayer(u))])
elseif(M5(u,Jx(u))>5500.)then
call jW(u,$D0012,h9[GetPlayerId(GetOwningPlayer(u))])
set h4[GetPlayerId(GetOwningPlayer(u))]=null
else
call jW(u,$D000F,JW(u))
endif
set eY[GetPlayerId(GetOwningPlayer(u))]=4
set GZ[480+GetPlayerId(GetOwningPlayer(u))]=true
endfunction
function YIO takes nothing returns nothing
call YOO(GetEnumUnit())
endfunction
function YAO takes nothing returns nothing
local integer O5=GetPlayerId(GetOwningPlayer(GetEnumUnit()))
if((M5(GetEnumUnit(),Jx(GetEnumUnit()))<5000.)and(eY[O5]!=4))then
if(IsUnitAlly(GetEnumUnit(),A8V[0]))then
if(G3==0)then
set h8[O5]=h7['o']
set h8[16+O5]=h7['r']
elseif(G3==1)then
set h8[O5]=h7[$83]
set h8[16+O5]=h7[$87]
elseif(G3==2)then
set h8[O5]=h7[$97]
set h8[16+O5]=h7[$9B]
endif
elseif(IsUnitAlly(GetEnumUnit(),A7V[0]))then
if(G4==0)then
set h8[O5]=h7[$B]
set h8[16+O5]=h7[$E]
elseif(G4==1)then
set h8[O5]=h7[31]
set h8[16+O5]=h7[35]
elseif(G4==2)then
set h8[O5]=h7[51]
set h8[16+O5]=h7[55]
endif
endif
set h9[O5]=Jx(GetEnumUnit())
set h9[16+O5]=Jx(GetEnumUnit())
if(i0(GetEnumUnit()))then
call jW(GetEnumUnit(),$D000F,h8[O5])
endif
set eY[O5]=1
elseif((IsUnitAlly(GetEnumUnit(),A7V[0]))and(eY[O5]!=9))then
if(((G4==1)and(JTO(GetEnumUnit())==2))or((G4==2)and(JTO(GetEnumUnit())==1)))then
set G0[32+O5]=true
call J3(GetEnumUnit(),true)
elseif(G4==0)then
call LYO(GetEnumUnit(),h7[9+hB])
elseif(G4==1)then
call LYO(GetEnumUnit(),h7[29+hc])
elseif(G4==2)then
call LYO(GetEnumUnit(),h7[49+hC])
endif
elseif((IsUnitAlly(GetEnumUnit(),A8V[0]))and(eY[O5]!=9))then
if(((G3==1)and(JTO(GetEnumUnit())==2))or((G3==2)and(JTO(GetEnumUnit())==1)))then
set G0[32+O5]=true
call J3(GetEnumUnit(),true)
elseif(G3==0)then
call LYO(GetEnumUnit(),h7['u'-hB])
elseif(G3==1)then
call LYO(GetEnumUnit(),h7[$8B-hc])
elseif(G3==2)then
call LYO(GetEnumUnit(),h7[$9F-hC])
endif
endif
endfunction
function YNO takes nothing returns nothing
set eY[GetPlayerId(GetOwningPlayer(GetEnumUnit()))]=$B
set h8[48+GetPlayerId(GetOwningPlayer(GetEnumUnit()))]=h7[$FA]
endfunction
function YBO takes boolean YCO returns nothing
if(YCO)then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Automatic Lane changing is turned on")
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Automatic Lane changing is turned off")
endif
endfunction
function YDO takes nothing returns nothing
local unit it=Y7(tz,"OB|g_mbScoreboard")
local integer LGO
if(i0(it))then
call jW(it,$D0012,h9[GetPlayerId(GetOwningPlayer(it))])
endif
call TriggerSleepAction(.5)
if(i0(it))then
call jW(it,$D0012,h9[GetPlayerId(GetOwningPlayer(it))])
endif
set G0[48+GetPlayerId(GetOwningPlayer(it))]=true
set LGO=LRO(6.,it,false,true)
set G0[48+GetPlayerId(GetOwningPlayer(it))]=false
if(GetWidgetLife(it)<=.405)then
elseif((LGO==2)and(not N5(it))and(not G0[32+GetPlayerId(GetOwningPlayer(it))])and(i0(it)))then
call IssueImmediateOrderById(it,$D0019)
elseif(LGO==3)then
if((not N5(it))and(not G0[32+GetPlayerId(GetOwningPlayer(it))]))then
call jW(it,$D000F,h8[GetPlayerId(GetOwningPlayer(it))])
else
call J1(it,false)
endif
endif
endfunction
function YFO takes string VH returns nothing
local player pl=null
local unit m5=null
local integer UP
local integer JDO=0
local integer kg
if((SubString(VH,0,2)=="-o")or(SubString(VH,0,2)=="-c")or(SubString(VH,0,2)==" c"))then
set VH=SubString(VH,2,StringLength(VH))
else
return
endif
if(VH=="tango")then
if(Bz<60.)then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Tango will be used instead of Flasks")
set Gz=true
endif
elseif(VH=="flask")then
if(Bz<60.)then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Flasks will be used instead of Tangoes")
set Gz=false
endif
elseif(VH=="a")then
if(GetTriggerPlayer()==Dz)then
call ju(BAV(bj_mapInitialPlayableArea,Condition(function KT)),function YXO)
elseif(GetTriggerPlayer()==dz)then
call ju(BAV(bj_mapInitialPlayableArea,Condition(function Kt)),function YXO)
endif
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"All ally AI will resume in pushing")
elseif(VH=="d")then
if(GetTriggerPlayer()==Dz)then
call ju(BAV(bj_mapInitialPlayableArea,Condition(function KT)),function YIO)
elseif(GetTriggerPlayer()==dz)then
call ju(BAV(bj_mapInitialPlayableArea,Condition(function Kt)),function YIO)
endif
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"All ally AI will defend the base")
elseif(VH=="roshan")then
if(GetTriggerPlayer()==Dz)then
call ju(BAV(bj_mapInitialPlayableArea,Condition(function KT)),function YNO)
elseif(GetTriggerPlayer()==dz)then
call ju(BAV(bj_mapInitialPlayableArea,Condition(function Kt)),function YNO)
endif
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"All ally AI will attack Roshan")
elseif(VH=="neut")then
if(GetTriggerPlayer()==dz)then
set Gv=not Gv
if(Gv)then
set JDO=1
endif
else
set Gw=not Gw
if(Gw)then
set JDO=1
endif
endif
if(JDO==1)then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Neutral Creeping is turned on")
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Neutral Creeping is turned off")
endif
elseif(VH=="ui")then
call ExecuteFunc("YGO")
elseif(SubString(VH,0,1)=="b")then
set VH=SubString(VH,1,StringLength(VH))
loop
call TriggerSleepAction(.0)
set kg=kh(VH)
if(kg>=0)then
set pl=i3(S2I(SubString(VH,0,kg)))
set VH=SubString(VH,kg+1,StringLength(VH))
else
set pl=i3(S2I(SubString(VH,0,StringLength(VH))))
endif
if((pl!=null)and(m8(pl))and(GetPlayerController(pl)==MAP_CONTROL_COMPUTER)and(IsPlayerAlly(pl,GetTriggerPlayer())))then
set UP=GetPlayerId(pl)
if((ie[UP]!=null)and(A5(ie[UP]))and(i0(ie[UP])))then
call A7(tz,"OB|g_mbScoreboard",ie[UP])
call ExecuteFunc("YDO")
if(eY[UP]>=9)then
set eY[UP]=1
endif
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,R[UP]+GetPlayerName(pl)+"|r is now moving back")
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,R[UP]+GetPlayerName(pl)+"|r |cffffcc00cannot move back|r")
endif
endif
exitwhen kg<0
endloop
elseif(SubString(VH,0,1)=="f")then
set VH=SubString(VH,1,StringLength(VH))
loop
call TriggerSleepAction(.0)
set kg=kh(VH)
if(kg>=0)then
set pl=i3(S2I(SubString(VH,0,kg)))
set VH=SubString(VH,kg+1,StringLength(VH))
else
set pl=i3(S2I(SubString(VH,0,StringLength(VH))))
endif
