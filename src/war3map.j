set cT[i]="Slithereen Crush requires good positioning, so do your best to stand next to the hero you are trying to stun."
set CT[i]="Sprint is a great spell for both chasing and escaping but be careful when using it because you will take bonus damage."
set DT[i]="In addition to lowering armor, Amplify Damage provides vision of enemies, even heroes that have the ability to become invisible."
set fT[i]="Bash is usually more effective later in the game when you have more items like Armlet of Mordiggan."
set FT[i]="Slardar's role in battles is to initiate with Slithereen Crush and focus an enemy with Bash and Amplify Damage. Pick off escapees with Sprint."
set i=i+1
set qt[67]='UC01'
set IT[67]='h05Q'
set Qt[67]='n0C2'
set RT[67]="ReplaceableTextures\\CommandButtons\\BTNBlueDemoness.tga"
call LQV(qt[67],"spell slam")
call LKV(qt[67],1.3,IT[67])
set cT[i]="Blink provides you with an escape mechanism and spell dodge but on higher levels it becomes a powerful chasing tool as well."
set CT[i]="Scream of Pain is used for killing creeps and harassing opponents, making it more useful than Shadow Strike early game."
set DT[i]="Try to hit as many targets as possible with Sonic Wave by targeting the ground instead of on an enemy hero directly."
set fT[i]="Shadow Strike does decent damage but its primary use is for the slow it provides for chasing and outrunning opponents."
set FT[i]="Her spell reliance, mobility and survivability allows her to buy expensive Intelligence items such as a Guinsoo's Scythe of Vyse."
set i=i+1
