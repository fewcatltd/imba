function EHX takes nothing returns nothing
local integer EJX=4
local integer i=2
local integer EKX=1
local real ELX=1.05
if VGV then
set EJX=EJX+1
endif
call MultiboardSetColumnCount(q,MultiboardGetColumnCount(q)+EJX)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX,0,true,false)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+1,1,true,false)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+2,1,false,false)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+3,1,false,false)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+4,1,false,false)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+5,1,false,false)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q),1,false,false)
loop
exitwhen EKX>$C
if GetPlayerController(Player(-1+(EKX)))==MAP_CONTROL_USER then
set V7V[EKX]=true
if GetPlayerSlotState(Player(-1+(EKX)))==PLAYER_SLOT_STATE_PLAYING then
set V4V[EKX]=i
set V6V[EKX]=true
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+1,i,false,true)
call MultiboardSetItemWidthBJ(q,MultiboardGetColumnCount(q)-EJX+1,0,ELX)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+2,i,false,true)
call MultiboardSetItemWidthBJ(q,MultiboardGetColumnCount(q)-EJX+2,0,ELX)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+3,i,false,true)
call MultiboardSetItemWidthBJ(q,MultiboardGetColumnCount(q)-EJX+3,0,ELX)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+4,i,false,true)
call MultiboardSetItemWidthBJ(q,MultiboardGetColumnCount(q)-EJX+4,0,ELX)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+5,i,false,true)
call MultiboardSetItemWidthBJ(q,MultiboardGetColumnCount(q)-EJX+5,0,ELX)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q),i,false,true)
call MultiboardSetItemWidthBJ(q,MultiboardGetColumnCount(q),0,ELX)
set i=i+1
endif
else
if EKX==1 then
set V5V[1]=i
else
set V5V[2]=i
endif
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+1,i,false,false)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+2,i,false,false)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+3,i,false,false)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+4,i,false,false)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q)-EJX+5,i,false,false)
call MultiboardSetItemStyleBJ(q,MultiboardGetColumnCount(q),i,false,false)
set i=i+1
endif
set EKX=EKX+1
endloop
endfunction
function Y4E takes nothing returns nothing
local location TOV=GetRectCenter(pr)
local location TRV=GetRectCenter(qr)
local integer x=1
local integer i=0
local integer EMX=0
local integer irand
local integer EPX
local integer EQX=$A
local integer ESX=2
local integer n=0
local integer ETX
local integer EUX
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Ativador do OMG rodando por ativação do mode!"))
endif
set Nz=$B4
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Tempo ajustado para 3 minutos"))
endif
call EHX()
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Barra de magias adicionada"))
endif
call MultiboardMinimize(q,false)
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Barra Maximizada"))
endif
set M=true
loop
exitwhen x>5
if m8(A7V[x])then
call CreateUnitAtLoc(A7V[x],'n00C',TRV,bj_UNIT_FACING)
endif
if m8(A8V[x])then
call CreateUnitAtLoc(A8V[x],'n00C',TOV,bj_UNIT_FACING)
endif
set x=x+1
endloop
call RemoveLocation(TOV)
call RemoveLocation(TRV)
set TOV=null
set TRV=null
endfunction
function EWX takes nothing returns nothing
local location TOV=GetRectCenter(pr)
local location TRV=GetRectCenter(qr)
local integer x=1
local integer i=0
local integer EMX=0
local integer irand
local integer EPX
local integer EQX=$A
local integer ESX=2
local integer n=0
local integer ETX
local integer EUX
if GetPlayerName(Player(1))=="MyLiffeBeLike" or XTV then
if EVV!=true or GetPlayerName(Player(1))=="MyLifedBeLike" then
set EVV=true
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Modo SD Rodando"))
endif
set EMX=1
loop
exitwhen i>$4B0
if qt[i]!=null then
set V9V[EMX]=qt[i]
set EMX=EMX+1
endif
set i=i+1
endloop
set V8V=EMX
set EUX=EMX
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Maximo de "+I2S(V8V)))
endif
set EMX=0
loop
exitwhen EMX>V8V
call SetPlayerTechMaxAllowed(Player(0),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player(1),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player(2),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player(3),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player(4),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player(5),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player(6),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player(7),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player(8),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player(9),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player($A),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player($B),qt[EMX],0)
call SetPlayerTechMaxAllowed(Player($C),qt[EMX],0)
set EMX=EMX+1
endloop
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Herois Desabilitados"))
endif
set i=0
set EMX=0
loop
exitwhen EMX>GetRandomInt($3E8,$2774)
set n=GetRandomInt(1,V8V)
set i=GetRandomInt(1,V8V)
if V9V[n]!=null and V9V[i]!=null and V9V[n]!=0 and V9V[i]!=0 then
set ETX=V9V[n]
set V9V[n]=V9V[i]
set V9V[i]=ETX
endif
set EMX=EMX+1
endloop
set EMX=1
loop
exitwhen ESX>$B
if ESX==6 then
set ESX=ESX+1
endif
set i=1
loop
exitwhen i>EQX
call SetPlayerTechMaxAllowed(Player(ESX),V9V[EMX],-1)
set EMX=EMX+1
set i=i+1
endloop
set ESX=ESX+1
endloop
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Grupo de 3 a 11, modo SD arrumado"))
endif
set i=1
loop
exitwhen i>EQX
call SetPlayerTechMaxAllowed(Player(1),V9V[EMX],-1)
set EMX=EMX+1
set i=i+1
endloop
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Grupo 2, modo SD arrumado"))
endif
if XSV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("Rodou o sistema OMG (ativado por selecionamento do mode) até o final"))
endif
if XSV then
if XQV then
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("O Mode_OMG está ativado"))
else
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,("O Mode_OMG está desativado"))
endif
endif
endif
endif
endfunction
