endif
elseif(VH=="t")then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"Commands:
Type \"-o\",\"-c\" or \" c\" before any of these, you can order more than one by using \",\":
 t <Player no>[,<Player no2>] <target Player no>- Selected bots attack the target hero")
elseif(SubString(VH,0,1)=="t")then
set VH=SubString(VH,1,StringLength(VH))
set kg=kE(VH," ")
