function MDX takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit K8V=Y7(K3V,"Hero")
local real x=X8(K3V,"x")
local real y=X8(K3V,"y")
local unit oA=CreateUnit(GetOwningPlayer(K8V),'e00E',x,y,0)
local integer JFV=GetUnitAbilityLevel(K8V,'A0LL')
local group g=KHV()
local unit f=null
call UnitAddAbility(oA,'A10J')
call SetUnitAbilityLevel(oA,'A10J',JFV)
set gB=K8V
if JFV==1 then
set lB='d'
elseif JFV==2 then
set lB=$B4
elseif JFV==3 then
set lB=260
elseif JFV==4 then
set lB=300
endif
set lB=lB/7
set ANV=GetTriggerEvalCount(t)
set AUV=K8V
call GroupEnumUnitsInRange(g,x,y,275+24,Condition(function PJV))
loop
set f=FirstOfGroup(g)
exitwhen f==null
if ANV>1 then
call QDV(f,1,false)
call HPV(K8V,f,1,lB)
endif
if ANV<7 then
if KUV(f,"Tossed")then
call HPV(K8V,f,1,lB)
endif
endif
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
if GetTriggerEvalCount(t)>7 then
call a7(K3V)
call KJV(t)
endif
set t=null
set K8V=null
set oA=null
set g=null
return false
endfunction
function MFX takes nothing returns nothing
