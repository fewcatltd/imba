call TriggerRegisterTimerEvent(t,Hk+.4,false)
call TriggerAddCondition(t,Condition(function BUO))
set IHV=true
call GYV('n0KD',p5,NY,BQO,C3V(NY,BQO)/(Hk+.4),null,0,0)
endif
endif
set t=null
set p5=null
set NY=null
set BQO=null
