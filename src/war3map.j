set W5X=0
set W6X=0+(75-(W4X-W3X))
endif
if a<0 then
set a=a+360
elseif a>360 then
set a=a-360
endif
if(a>c1 and a<c2)or(W1X!=-1 and a>W1X and a<W2X)or(a>W3X and a<W4X)or(W5X!=-1 and a>W5X and a<W6X)then
return true
endif
