set x1=x-$C8
set y1=y+$C8
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FlyingMachine\\FlyingMachineImpact.mdl",x1,y1))
set x1=x-$C8
set y1=y-$C8
