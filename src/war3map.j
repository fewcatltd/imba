function UHR takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'Sour')
local unit u=DHV(tm,'Targ')
local group g=CreateGroup()
local group g1=DKV(tm,'Dmgd')
local integer i=DTV(tm,'Levl')
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local boolexpr b=Condition(function PTV)
local real r=624
if XXV then
set r=$F423F
endif
set AUV=s
call GroupEnumUnitsInRange(g,x,y,r,b)
call DestroyBoolExpr(b)
set b=null
call GroupAddUnit(g1,u)
call GroupRemoveGroup(g1,g)
set u=GroupPickRandomUnit(g)
if u==null then
call DestroyGroup(g1)
call FIV()
else
call DFV(tm,'Targ',u)
set s=CreateUnit(GetOwningPlayer(s),'e00E',x,y,0)
call UnitAddAbility(s,'A08N')
call SetUnitAbilityLevel(s,'A08N',i)
call IssueTargetOrderById(s,$D0101,u)
call UnitApplyTimedLife(s,'BTLF',1)
endif
call DestroyGroup(g)
if DTV(tm,'Loop')==9999 then
call DestroyGroup(g1)
call FIV()
else
call DQV(tm,'Loop',1)
endif
set tm=null
set s=null
set u=null
set g=null
set g1=null
endfunction
