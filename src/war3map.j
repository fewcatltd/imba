function H4X takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local integer Q4V=E8(K3V,"TargetIndex")
local unit K8V=B8(Q4V)
local integer R3X=E8(K3V,"Count")
local integer JFV=E8(K3V,"Level")
if GetTriggerEventId()==EVENT_PLAYER_UNIT_ATTACKED and O8(K3V,"NaturesGuise|Special")and GetAttacker()==K8V then
call UnitRemoveAbility(K8V,'B021')
call UnitRemoveAbility(K8V,'A1GA')
call a7(K3V)
call KJV(t)
else
if GetTriggerEventId()!=EVENT_PLAYER_UNIT_ATTACKED and GetTriggerEventId()!=EVENT_PLAYER_UNIT_SPELL_EFFECT then
set R3X=R3X+1
call n7(K3V,"Count",R3X)
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT and GetSpellAbilityId()=='A01Z' and GetTriggerUnit()==K8V then
call DisableTrigger(GetTriggeringTrigger())
call H3X(K8V,JFV)
call EnableTrigger(GetTriggeringTrigger())
call n7(K3V,"Count",0)
endif
if nA(GetUnitX(K8V),GetUnitY(K8V),375)==false then
call UnitRemoveAbility(K8V,'B021')
call UnitRemoveAbility(K8V,'A1GA')
call a7(K3V)
call KJV(t)
elseif R3X>($F*JFV)then
if O8(K3V,"NaturesGuise|Special")then
call UnitRemoveAbility(K8V,'B021')
call UnitRemoveAbility(K8V,'A1GA')
endif
call a7(K3V)
call KJV(t)
elseif O8(K3V,"NaturesGuise|Special")and GetUnitAbilityLevel(K8V,'B021')==0 and GetUnitAbilityLevel(K8V,'A1GA')>0 then
call DisableTrigger(GetTriggeringTrigger())
call H3X(K8V,JFV)
call EnableTrigger(GetTriggeringTrigger())
endif
endif
set t=null
set K8V=null
return false
endfunction
function H5X takes nothing returns nothing
local trigger t=CreateTrigger()
local integer K3V=GetHandleId(t)
call n7(K3V,"TargetIndex",c8(GetSpellTargetUnit()))
call n7(K3V,"Level",GetUnitAbilityLevel(GetTriggerUnit(),'A01Z'))
call n7(K3V,"Count",0)
call TriggerAddCondition(t,Condition(function H4X))
call TriggerRegisterTimerEvent(t,1,true)
if GetTriggerUnit()==GetSpellTargetUnit()then
call UnitAddAbility(GetTriggerUnit(),'A1GA')
call O7(K3V,"NaturesGuise|Special",true)
call MKV(t,EVENT_PLAYER_UNIT_ATTACKED)
call MKV(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
endif
set t=null
endfunction
