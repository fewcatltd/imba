local real y1=GetUnitY(K8V)
local real x2
local real y2
local real d='}'
local unit GNR
local real Hk=2+JFV
local real BufferDuration=5
local group g
local rect GTR
local player GUR
if C8(GetOwningPlayer(K8V))then
set GUR=A8V[0]
else
set GUR=A7V[0]
endif
call a7(K3V)
call KJV(t)
set t=CreateTrigger()
set K3V=GetHandleId(t)
call O7(K3V,"NeedFix",false)
set x2=x1+d
set y2=y1
set GNR=CreateUnit(GetOwningPlayer(K8V),ID,x2,y2,0)
call SetUnitPosition(GNR,x2,y2)
call GLR(GNR,K3V,1,GUR)
set x2=x1+d
set y2=y1+d
set GNR=CreateUnit(GetOwningPlayer(K8V),ID,x2,y2,0)
call SetUnitPosition(GNR,x2,y2)
call GLR(GNR,K3V,2,GUR)
set x2=x1
set y2=y1+d
set GNR=CreateUnit(GetOwningPlayer(K8V),ID,x2,y2,0)
call SetUnitPosition(GNR,x2,y2)
call GLR(GNR,K3V,3,GUR)
set x2=x1-d
set y2=y1+d
set GNR=CreateUnit(GetOwningPlayer(K8V),ID,x2,y2,0)
call SetUnitPosition(GNR,x2,y2)
call GLR(GNR,K3V,4,GUR)
set x2=x1-d
set y2=y1
set GNR=CreateUnit(GetOwningPlayer(K8V),ID,x2,y2,0)
call SetUnitPosition(GNR,x2,y2)
call GLR(GNR,K3V,5,GUR)
set x2=x1-d
set y2=y1-d
set GNR=CreateUnit(GetOwningPlayer(K8V),ID,x2,y2,0)
call SetUnitPosition(GNR,x2,y2)
call GLR(GNR,K3V,6,GUR)
set x2=x1
set y2=y1-d
set GNR=CreateUnit(GetOwningPlayer(K8V),ID,x2,y2,0)
