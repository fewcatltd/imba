function NSO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local integer NTO=E8(K3V,"ShellCache")
local unit p5=Y7(NTO,"Source")
local integer NQO=E8(NTO,"ShellCounter")
local integer JFV=GetUnitAbilityLevel(p5,'A0VX')
set NQO=L9V(NQO+1,4)
call n7(NTO,"ShellCounter",NQO)
call NPO(p5,JFV,NQO)
call a7(K3V)
call KJV(t)
set t=null
set p5=null
return false
endfunction
function NUO takes nothing returns boolean
