call RemoveUnit(amimage)
endfunction  
function WISPFILTER takes nothing returns boolean 
return IsUnitAlly(GetFilterUnit(),GetOwningPlayer(WISPU)) and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)
endfunction
function WISPTPBACK takes nothing returns nothing
local unit f=null
loop
exitwhen CountUnitsInGroup(WISPG)==0
set f=GroupPickRandomUnit(WISPG)
call SetCameraPositionForPlayer(GetOwningPlayer(f),GetUnitX(f),GetUnitY(f))
call DestroyEffect(AddSpecialEffect("war3mapImported\\VirtualUnitBirth_ByEpsilon.mdx",GetUnitX(f),GetUnitY(f)))
call SetUnitX(f,WISPX+GetRandomReal(-100,200))
call SetUnitY(f,WISPY+GetRandomReal(-250,200))
call DestroyEffect(AddSpecialEffect("war3mapImported\\VirtualUnitBirth_ByEpsilon.mdx",GetUnitX(f),GetUnitY(f)))
call SetCameraPositionForPlayer(GetOwningPlayer(f),WISPX,WISPY)
call GroupRemoveUnit(WISPG,f)
endloop
set WISPG=null
set f=null
set WISPU=null
endfunction
function SHOWWISP takes nothing returns nothing
local unit f=null
loop
exitwhen CountUnitsInGroup(WISPG)==0
set f=GroupPickRandomUnit(WISPG)
call SetCameraPositionForPlayer(GetOwningPlayer(f),GetUnitX(f),GetUnitY(f))
call DestroyEffect(AddSpecialEffect("war3mapImported\\VirtualUnitBirth_ByEpsilon.mdx",GetUnitX(f),GetUnitY(f)))
call ShowUnit(f,true)
call GroupRemoveUnit(WISPG,f)
endloop
call GroupEnumUnitsInRange(WISPG,GetUnitX(WISPU),GetUnitY(WISPU),900,Condition(function WISPFILTER ))
call TimerStart(CreateTimer(),11.,false,function WISPTPBACK)
set f=null
endfunction
function YKR2 takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit HOV=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local integer id=GetSpellAbilityId()
local integer i=GetUnitAbilityLevel(u,id)
local integer n=0
local real d=SquareRoot((x-x1)*(x-x1)+(y-y1)*(y-y1))
local real a=Atan2(y1-y,x1-x)
local timer tm=null
local trigger t=null
local group g=null
local boolexpr b=null
local group g1=null
local real r=0
local unit f=null
local boolean b5=DZV(u,'skst')
local integer l=0
local boolean YLR=DZV(u,'link')
local string fx=null  
if id=='AA5L' then
set WISPU=u
set WISPX=GetUnitX(u)
set WISPY=GetUnitY(u)
set g=CreateGroup()
set WISPG=CreateGroup()
call GroupEnumUnitsInRange(WISPG,GetUnitX(WISPU),GetUnitY(WISPU),900,Condition(function WISPFILTER ))
call GroupEnumUnitsInRange(g,GetUnitX(WISPU),GetUnitY(WISPU),900,Condition(function WISPFILTER ))
loop
exitwhen CountUnitsInGroup(g)==0
set f=GroupPickRandomUnit(g)
call SetCameraPositionForPlayer(GetOwningPlayer(f),x,y)
call DestroyEffect(AddSpecialEffect("war3mapImported\\VirtualUnitBirth_ByEpsilon.mdx",GetUnitX(f),GetUnitY(f)))
call SetUnitX(f,x1+GetRandomReal(-100,200))
call SetUnitY(f,y1+GetRandomReal(-250,200))
call ShowUnit(f,false)
call GroupRemoveUnit(g,f)
endloop    
call TimerStart(CreateTimer(),1.,false,function SHOWWISP)
set f=null
set g=null
endif
if id=='A01P' or id=='A095' and i==1 then
call UnitDamageTarget(u,HOV,(GetUnitState(HOV,UNIT_STATE_MAX_MANA)-GetUnitState(HOV,UNIT_STATE_MANA)),false,false,null,DAMAGE_TYPE_MAGIC,null)         //lina ulti
elseif id=='A01P' or id=='A095' and i==2 then
call UnitDamageTarget(u,HOV,(GetUnitState(HOV,UNIT_STATE_MAX_MANA)-GetUnitState(HOV,UNIT_STATE_MANA)*1.3),false,false,null,DAMAGE_TYPE_MAGIC,null) 
elseif id=='A01P' or id=='A095' and i==3 then
call UnitDamageTarget(u,HOV,(GetUnitState(HOV,UNIT_STATE_MAX_MANA)-GetUnitState(HOV,UNIT_STATE_MANA)*1.6),false,false,null,DAMAGE_TYPE_MAGIC,null)  
endif
if id=='AEbl' then
set amimage=CreateUnit(GetOwningPlayer(u),GetUnitTypeId(u),x,y,GetUnitFacing(u))  // am image
call TimerStart(CreateTimer(),4,false,function killam)
call IssuePointOrder(amimage,"move",GetRandomReal(-10000,10000),GetRandomReal(-10000,10000))
call UnitAddAbility(amimage,'Aloc')
endif
if (UnitHasBuffBJ(u,'BB05')) and GetRandomReal(0,100)<=15 and id!='A14A' then   //zealotbuff
set manarestoreu=u
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.3,false)
call TriggerAddCondition(t,Condition(function manarestore))
set t=null 
endif
endfunction 

