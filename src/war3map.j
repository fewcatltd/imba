call TriggerRegisterPlayerEvent(t,RVV,EVENT_PLAYER_ARROW_RIGHT_DOWN)
call TriggerRegisterPlayerEvent(t,RVV,EVENT_PLAYER_ARROW_DOWN_DOWN)
