local boolean NFR=false
local item NGR
local integer NHR
local integer NJR
local integer newCharges
local item Z4
local integer targetCount
local item NKR
local boolean NLR=false
local integer MLV
call DisableTrigger(T2)
if NNR then
set NKR=null
set NCR=v8(K3V,"p")
set NDR=E8(K3V,"charges")
else
set NBR=n8(K3V,"Item")
set NKR=NBR
set NCR=GetItemPlayer(NBR)
set NDR=GetItemCharges(NBR)
endif
if NIR==1 then
if p!=NCR and GetUnitTypeId(NRR)=='ncop' then
if DBE(DOE(NAR))or DCE(DOE(NAR))then
set NFR=true
endif
call RTR(Oc[NAR],Ft[GetPlayerId(NCR)],gt[GetPlayerId(NCR)],NCR,NFR,NDR)
call LYV(p,(GetObjectName(('n0DR'))))
if NNR==false then
set NLR=true
call CTV(NBR)
endif
elseif by==false and NNR==false and GetItemType(NBR)==ITEM_TYPE_CAMPAIGN and RZR(NBR)!=0 and(p==NCR or(GetPlayerSlotState((NCR))==PLAYER_SLOT_STATE_LEFT))then
