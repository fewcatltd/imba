function ZOE takes nothing returns nothing
local integer i=1
local multiboarditem ZRE=null
local integer x=0
local integer y=0
set i=0
loop
loop
exitwhen i>Wt or(v[i]==false and qt[i]>0)
set i=i+1
endloop
if i>Wt then
set ZRE=MultiboardGetItem(EWV,x,y)
call MultiboardSetItemStyle(ZRE,false,false)
call MultiboardReleaseItem(ZRE)
set ZRE=MultiboardGetItem(EWV,x+1,y)
call MultiboardSetItemStyle(ZRE,false,false)
call MultiboardReleaseItem(ZRE)
else
set ZRE=MultiboardGetItem(EWV,x,y)
call MultiboardSetItemStyle(ZRE,true,false)
call MultiboardSetItemValue(ZRE,GetObjectName('CM04')+I2S(i))
call MultiboardSetItemWidth(ZRE,.08)
call MultiboardReleaseItem(ZRE)
set ZRE=MultiboardGetItem(EWV,x+1,y)
call MultiboardSetItemStyle(ZRE,true,true)
call MultiboardSetItemWidth(ZRE,.08)
call MultiboardSetItemValue(ZRE,GetObjectName(qt[i]))
call MultiboardSetItemIcon(ZRE,RT[i])
call MultiboardReleaseItem(ZRE)
endif
if y==9 then
set y=0
set x=x+2
else
set y=y+1
endif
exitwhen x>=20
set i=i+1
endloop
call MultiboardDisplay(EWV,true)
call MultiboardMinimize(EWV,false)
set ZRE=null
endfunction
function ZIE takes nothing returns nothing
local player p=GetTriggerPlayer()
local trigger t=GetTriggeringTrigger()
local integer i=GetTriggerEvalCount(t)
local string s=SubString(GetEventPlayerChatString(),6,9)
local integer id=S2I(s)
local real x=0
local real y=0
if p==null then
if EYV==0 then
set p=A7V[1]
elseif EYV==1 then
set p=A8V[1]
elseif EYV==2 then
set p=A7V[2]
elseif EYV==3 then
set p=A8V[2]
elseif EYV==4 then
set p=A7V[3]
elseif EYV==5 then
set p=A8V[3]
elseif EYV==6 then
set p=A7V[4]
elseif EYV==7 then
set p=A8V[4]
elseif EYV==8 then
set p=A7V[5]
elseif EYV==9 then
set p=A8V[5]
else
set p=null
endif
if i==30 then
call GDV()
loop
set id=GetRandomInt(1,Wt)
exitwhen v[id]==false and qt[id]>0
endloop
if EYV<9 then
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function ZIE))
call TriggerRegisterPlayerChatEvent(t,A7V[1],"-pick",false)
call TriggerRegisterPlayerChatEvent(t,A8V[1],"-pick",false)
else
call MultiboardDisplay(EWV,false)
call DestroyMultiboard(EWV)
call O2E()
call MHE()
call MPE()
endif
else
set id=-1
if IsPlayerAlly(p,A7V[0])then
call MultiboardSetTitleText(EWV,GetObjectName('CM03')+R[GetPlayerId(p)]+(lt[GetPlayerId((p))])+"|r"+GetObjectName('CM00')+I2S(30-i))
else
call MultiboardSetTitleText(EWV,GetObjectName('CM0B')+R[GetPlayerId(p)]+(lt[GetPlayerId((p))])+"|r"+GetObjectName('CM00')+I2S(30-i))
endif
endif
elseif v[id]==false and qt[id]>0 then
if IsPlayerAlly(p,GetTriggerPlayer())==false then
set p=null
set t=null
return
endif
call GDV()
if EYV-EYV/2*2==1 then
set p=A8V[EYV/2+1]
else
set p=A7V[EYV/2+1]
endif
if EYV<9 then
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function ZIE))
call TriggerRegisterPlayerChatEvent(t,A7V[1],"-pick",false)
call TriggerRegisterPlayerChatEvent(t,A8V[1],"-pick",false)
else
call MultiboardDisplay(EWV,false)
call DestroyMultiboard(EWV)
call O2E()
call MHE()
call MPE()
endif
else
set id=-1
call LYV(p,GetObjectName('CM05'))
endif
if EYV==0 then
set p=A7V[1]
elseif EYV==1 then
set p=A8V[1]
elseif EYV==2 then
set p=A7V[2]
elseif EYV==3 then
set p=A8V[2]
elseif EYV==4 then
set p=A7V[3]
elseif EYV==5 then
set p=A8V[3]
elseif EYV==6 then
set p=A7V[4]
elseif EYV==7 then
set p=A8V[4]
elseif EYV==8 then
set p=A7V[5]
elseif EYV==9 then
set p=A8V[5]
else
set p=null
endif
if id>0 then
set EYV=EYV+1
if GetPlayerController(p)==MAP_CONTROL_USER and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING then
if C8(p)then
set x=GetRandomReal(GetRectMinX(rr),GetRectMaxX(rr))
set y=GetRandomReal(GetRectMinY(rr),GetRectMaxY(rr))
else
set x=GetRandomReal(GetRectMinX(Mo),GetRectMaxX(Mo))
set y=GetRandomReal(GetRectMinY(Mo),GetRectMaxY(Mo))
endif
call CreateUnit(p,qt[id],x,y,0)
call s8(qt[id])
call ZOE()
endif
endif
set p=null
set t=null
endfunction
function ZAE takes nothing returns nothing
local player p=GetTriggerPlayer()
local trigger t=GetTriggeringTrigger()
local integer i=GetTriggerEvalCount(t)
local string s=SubString(GetEventPlayerChatString(),5,8)
local integer id=S2I(s)
if p==null then
if i==30 then
call GDV()
loop
set id=GetRandomInt(1,Wt)
exitwhen v[id]==false and qt[id]>0
endloop
if EYV==7 then
set EYV=0
if EYV-EYV/2*2==1 then
set p=A8V[(EYV+1)/2]
else
set p=A7V[EYV/2+1]
endif
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function ZIE))
call TriggerRegisterPlayerChatEvent(t,p,"-pick",false)
else
set EYV=EYV+1
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function ZAE))
if EYV-EYV/2*2==1 then
call TriggerRegisterPlayerChatEvent(t,A8V[1],"-ban",false)
else
call TriggerRegisterPlayerChatEvent(t,A7V[1],"-ban",false)
endif
endif
else
set id=-1
if(EYV-EYV/2*2==1)then
call MultiboardSetTitleText(EWV,GetObjectName('CM02')+I2S(30-i))
else
call MultiboardSetTitleText(EWV,GetObjectName('CM01')+I2S(30-i))
endif
endif
elseif v[id]==false and qt[id]>0 then
call GDV()
if EYV==7 then
set EYV=0
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function ZIE))
call TriggerRegisterPlayerChatEvent(t,A7V[1],"-pick",false)
else
set EYV=EYV+1
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function ZAE))
if EYV-EYV/2*2==1 then
call TriggerRegisterPlayerChatEvent(t,A8V[1],"-ban",false)
else
call TriggerRegisterPlayerChatEvent(t,A7V[1],"-ban",false)
endif
endif
else
set id=-1
call LYV(p,GetObjectName('CM05'))
endif
if id>0 then
call s8(qt[id])
call LYV(GetLocalPlayer(),GetObjectName(qt[id])+GetObjectName('CM06'))
call ZOE()
endif
set p=null
set t=null
endfunction
function CM_Active takes nothing returns nothing
local integer i=1
local trigger t=CreateTrigger()
set EWV=CreateMultiboard()
loop
exitwhen i>5
call t8(A7V[i])
call t8(A8V[i])
set i=i+1
endloop
set Nz=60
call C4E(0,0,true)
call MultiboardSetTitleText(EWV,GetObjectName('CM01')+"30")
call MultiboardSetRowCount(EWV,20)
call MultiboardSetColumnCount(EWV,$A)
call MultiboardSetItemsStyle(EWV,false,false)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterPlayerChatEvent(t,A7V[1],"-ban",false)
call TriggerAddCondition(t,Condition(function ZAE))
set t=null
call ClearTextMessages()
call ZOE()
endfunction
