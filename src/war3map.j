call n7(K3V,"Limit",Tq)
call n7(K3V,"TargetLimit",D7X)
call A7(K3V,"Hero",K8V)
call TriggerRegisterTimerEvent(t,.6,true)
call TriggerAddCondition(t,Condition(function D5X))
else
call DFV(t,'s',K8V)
call DPV(t,'Loop',Tq)
call DPV(t,'Levl',D6X)
call TriggerRegisterUnitEvent(t,K8V,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.6,true)
call TriggerAddCondition(t,Condition(function FVX))
endif
call TriggerEvaluate(t)
set t=null
set K8V=null
endfunction
