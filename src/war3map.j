function Q_V takes unit s,real x,real y,real r,real d,integer i returns nothing
local group g=CreateGroup()
local boolexpr b=Condition(function PJV)
local unit u=null
set AUV=s
call GroupEnumUnitsInRange(g,x,y,r,b)
call DestroyBoolExpr(b)
set b=null
if RJV!=null then
call GroupRemoveUnit(g,RJV)
set RJV=null
endif
loop
set u=FirstOfGroup(g)
exitwhen u==null
call HPV(s,u,i,d)
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
set g=null
endfunction
function Q0V takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'s')
local real a=DWV(tm,'a')
local real x=DWV(tm,'x')
local real y=DWV(tm,'y')
local real n=DWV(tm,'sped')
local real d=DWV(tm,'d')
local real r=DWV(tm,'r')
local group g=DKV(tm,'g')
local group g1=null
local boolexpr b=null
local unit u=null
if DTV(tm,'Loop')<1 then
call DestroyGroup(g)
call FIV()
else
set x=x+Cos(a)*n
set y=y+Sin(a)*n
call DUV(tm,'x',x)
call DUV(tm,'y',y)
call DQV(tm,'Loop',-1)
set g1=CreateGroup()
set b=Condition(function PJV)
set AUV=s
call GroupEnumUnitsInRange(g1,x,y,r,b)
loop
set u=FirstOfGroup(g1)
exitwhen u==null
if IsUnitInGroup(u,g)==false then
call GroupAddUnit(g,u)
call HPV(s,u,1,d)
endif
call GroupRemoveUnit(g1,u)
endloop
call DestroyBoolExpr(b)
call DestroyGroup(g1)
set b=null
set g1=null
endif
set tm=null
set s=null
set g=null
endfunction
function Q1V takes unit s,real a,real Q2V,real d,real r,real n returns nothing
local timer tm=CreateTimer()
call DFV(tm,'s',s)
call DUV(tm,'a',a)
call DUV(tm,'sped',Q2V*.025)
call DPV(tm,'Loop',R2I(n/(Q2V*.025)))
call DUV(tm,'d',d)
call DUV(tm,'r',r)
call DJV(tm,'g',CreateGroup())
call DUV(tm,'x',GetUnitX(s))
call DUV(tm,'y',GetUnitY(s))
call TimerStart(tm,.025,true,function Q0V)
set tm=null
endfunction
