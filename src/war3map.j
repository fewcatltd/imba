local integer OER=E8(K3V,"Invoker|Current2")
if X3R==3 and X4R==0 and X5R==0 then
set X9R=1
elseif X3R==2 and X4R==1 and X5R==0 then
set X9R=2
elseif X3R==2 and X4R==0 and X5R==1 then
set X9R=3
