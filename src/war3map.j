call TriggerRegisterTimerEvent(t,DWV(s,'AA64'),false)
call DFV(t,'s',s)
call DPV(t,'i',i)
call DUV(t,'x',x)
call DUV(t,'y',y)
set t=null
set s=null
endfunction
function EKI takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
