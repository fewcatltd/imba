else
set i=DTV(u,'A03K')
if(r>18 or r<6)then
if J_V()-DWV(u,'a03k')>5 then
call DUV(u,'a03k',J_V())
if i!=0 then
call UnitRemoveAbility(u,A3V[i-1])
call G6V(u,-i*2)
call G7V(u,-2*i)
endif
set i=IMinBJ(i+1,20)
call DPV(u,'A03K',i)
call UnitAddAbility(u,A3V[i-1])
call G6V(u,2*i)
call G7V(u,2*i)
endif
else
if i!=0 then
call UnitRemoveAbility(u,A3V[i-1])
call DPV(u,'A03K',0)
call G6V(u,-i*2)
call G7V(u,-2*i)
endif
endif
endif
set u=null
endfunction
function T2R takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
local integer i=GetUnitAbilityLevel(u,'A062')
local integer n=0
if IVV then
if i==0 then
call DYV(u,'a062',false)
call FIV()
else
set n=R2I((GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetUnitState(u,UNIT_STATE_LIFE))/(20*(5-i)))
endif
call G5V(u,n-DTV(u,'A062'))
call DPV(u,'A062',n)
endif
set u=null
endfunction
function T3R takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
local integer i=GetUnitAbilityLevel(u,'A0FU')
local group g=null
local boolexpr b=null
local unit s=null
local integer n=DTV(u,'AA18')/20
if i==0 then
call DYV(u,'a0fu',false)
call FIV()
else
set g=CreateGroup()
set AUV=u
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),350+$96*i,b)
loop
set s=FirstOfGroup(g)
exitwhen s==null
if GetUnitAbilityLevel(s,'B03R')>0 then
if IVV then
call J6V(s,'B03R','B03R',2,0,-n,0,0,0,0,0)
endif
endif
call GroupRemoveUnit(g,s)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set u=null
endfunction
function T4R takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
local integer i=GetUnitAbilityLevel(u,'A0CL')
local integer l=0
if IVV then
if i==0 then
call DYV(u,'a0cl',false)
call FIV()
else
call HGV(u,true,B6V(u,true)*(.07+.03*i)*.5)
set l=R2I(B7V(u,true)*(.18+.02*i))
endif
call G5V(u,l-DTV(u,'A0CL'))
call DPV(u,'A0CL',l)
endif
set u=null
endfunction
function A0NA takes nothing returns nothing
local unit u=DHV(GetExpiredTimer(),'s')
local integer i=GetUnitAbilityLevel(u,'A1NA')
local integer n=0
if i==0 then
set i=DTV(u,'A1NA')
call G5V(u,-i*2)
call G6V(u,-i*$A)
call DPV(u,'A1NA',0)
call DYV(u,'a0na',false)
call FIV()
else
set i=DTV(u,'A1NA')
set n=E8(GetHandleId(u),"Level")
if i!=n then
call G6V(u,n*$A-i*$A)
call G5V(u,n*2-i*2)
call DPV(u,'A1NA',n)
endif
endif
set u=null
endfunction
function T5R takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=DHV(t,'s')
local integer i=GetUnitAbilityLevel(u,'A06K')
local group g=null
local boolexpr b=null
local unit f=null
if i==0 or u==null or(J and IsUnitType(u,UNIT_TYPE_DEAD))then
call DYV(u,'A06K',false)
call FIV()
elseif GetUnitAbilityLevel(u,'B02T')>0 then
if GetUnitAbilityLevel(u,'A0AZ')==0 then
call UnitAddAbility(u,'A0AZ')
call SetUnitAbilityLevel(u,'A0AZ',GetUnitAbilityLevel(u,'A06K'))
endif
set AUV=u
set g=KHV()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),275,b)
call HPV(u,u,1,25*i*.3)
loop
set f=FirstOfGroup(g)
exitwhen f==null
call HPV(u,f,1,25*i*.3)
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
elseif GetUnitAbilityLevel(u,'A0AZ')>0 then
call UnitRemoveAbility(u,'A0AZ')
endif
set t=null
set u=null
endfunction
function T6R takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit u=DHV(tm,'s')
local integer i=GetUnitAbilityLevel(u,'A0CY')
local real r=DWV(tm,'r')
local real d=0
local integer l=DTV(tm,'l')
if i==0 then
call DYV(u,'A0CY',false)
call G6V(u,-l)
call HEV(u)
set r=GVV(u)
call SetUnitScalePercent(u,100+(35*GetUnitAbilityLevel(u,'A0CY')),100+(35*GetUnitAbilityLevel(u,'A0CY')),100+(35*GetUnitAbilityLevel(u,'A0CY')))   
call FIV()
else
if C7V(u,'IA02')>0 then
set i=i+1
endif
if GetUnitTypeId(u)=='Ucrl'then
set d=GVV(u)*(i+1)
else
set d=GVV(u)*(.5*i+1)
endif
if r>d then
set r=RMaxBJ(d,r-.006-.004*i)
elseif r<d then
set r=RMinBJ(r+.006+.004*i,d)
endif
call SetUnitScalePercent(u,100+(35*GetUnitAbilityLevel(u,'A0CY')),100+(35*GetUnitAbilityLevel(u,'A0CY')),100+(35*GetUnitAbilityLevel(u,'A0CY')))    
call DUV(tm,'r',r)
set l=i*40-l
call DPV(tm,'l',i*40)
call G6V(u,l)
endif
set tm=null
set u=null
endfunction
function T7R takes nothing returns nothing
local unit s=DHV(GetExpiredTimer(),'s')
local integer i=GetUnitAbilityLevel(s,'A03K')+GetUnitAbilityLevel(s,'A1B0')
local real t=GetFloatGameState(GAME_STATE_TIME_OF_DAY)
if i==0 then
call DYV(s,'A1B0',false)
call FIV()
else
if t>24-i or t<i then
call UnitAddAbility(s,'AA89')
else
call UnitRemoveAbility(s,'AA89')
endif
endif
set s=null
endfunction
function T8R takes nothing returns nothing
local unit s=DHV(GetExpiredTimer(),'s')
local group g=null
local boolexpr b=null
local unit f=null
local integer i=GetUnitAbilityLevel(s,'A0SW')
local real r=0
if i==0 then
call DYV(s,'A0SW',false)
call FIV()
elseif GetWidgetLife(s)>1 then
set AUV=s
set g=KHV()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),$AF+75*i+24,b)
loop
set f=FirstOfGroup(g)
exitwhen f==null
if GetUnitAbilityLevel(f,'AB39')==0 then
set r=1
else
set r=DWV(f,'AB39')+.3
endif
call DUV(f,'AB39',r)
call J6V(f,'AB39','B939',1,-2*R2I(r),-R2I(r),0,0,0,0,0)
call HPV(s,f,2,24*.3)
call GroupRemoveUnit(g,f)
endloop
call KGV(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set s=null
endfunction
function T9R takes nothing returns nothing
local unit s=DHV(GetExpiredTimer(),'s')
local integer i=GetUnitAbilityLevel(s,'A01L')
local boolean b=false
if i==0 then
set b=true
set i=GetUnitAbilityLevel(s,'AIA0')
endif
if i==0 then
call DYV(s,'AIA0',false)
call FIV()
else
if b then
set i=40*i
else
set i=30*i
endif
call G2V(s,i-DTV(s,'aia0'))
call DPV(s,'aia0',i)
endif
set s=null
endfunction
function UVR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local integer i=GetUnitAbilityLevel(s,'A0I8')
local integer l=1
local integer r=0
local string J9V=""
if i==0 then
call DYV(s,'A0I8',false)
call FIV()
else
set l=1
set r=0
loop
exitwhen l>$B
if l!=6 and ie[l]!=null and IsUnitAlly(s,Player(l))==false then
if GetUnitLifePercent(ie[l])<40 and IsUnitInRange(ie[l],s,$5DC*i)and GetWidgetLife(ie[l])>1 then
call UnitShareVision(ie[l],GetOwningPlayer(s),true)
if GetLocalPlayer()==GetOwningPlayer(s)then
set J9V="Abilities\\Weapons\\HydraliskImpact\\HydraliskImpact.mdl"
else
set J9V=""
endif
call DestroyEffect(AddSpecialEffectTarget(J9V,ie[l],"overhead"))
set r=r+1
else
call UnitShareVision(ie[l],GetOwningPlayer(s),false)
endif
endif
set l=l+1
endloop
call HVV(s,-DTV(s,'a0i8'))
set r=R2I(.11*i*r*GEV(s))
call HVV(s,r)
call DPV(s,'a0i8',r)
endif
set t=null
set s=null
endfunction
function UER takes nothing returns boolean
return GetWidgetLife(GetFilterUnit())>1 and IsUnitOwnedByPlayer(GetFilterUnit(),Player($C))and IsUnitIllusion(GetFilterUnit())==false
endfunction
function UXR takes unit s returns boolean
local group g=CreateGroup()
local boolexpr b=Condition(function UER)
local boolean UOR=false
call GroupEnumUnitsInRange(g,GetUnitX(s),GetUnitY(s),425,b)
set UOR=FirstOfGroup(g)!=null
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
return UOR
endfunction
function URR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit s=DHV(t,'s')
local integer i=GetUnitAbilityLevel(s,'A1IN')
local real r=GetFloatGameState(GAME_STATE_TIME_OF_DAY)
local integer id=0
local player p=A7V[1]
if i==0 then
call DYV(s,'a1IN',false)
call FIV()
else
if IVV then
if EMV then
if r<8-2*i or r>24-2*i or GetUnitAbilityLevel(s,'AA94')>0 then
call UnitAddAbility(s,'A1HW')
call UnitAddAbility(s,'A1HX')
else
call UnitRemoveAbility(s,'A1HW')
call UnitRemoveAbility(s,'A1HX')
endif
else
if r<4 or r>22 or GetUnitAbilityLevel(s,'AA94')>0 then
call UnitAddAbility(s,'A1HW')
call UnitAddAbility(s,'A1HX')
else
call UnitRemoveAbility(s,'A1HW')
call UnitRemoveAbility(s,'A1HX')
endif
endif
endif
if IsUnitAlly(s,p)then
set p=A8V[1]
endif
if IsUnitVisible(s,p)==false and GetUnitAbilityLevel(s,'BNdo')==0 and(IsUnitVisible(s,Player($C))==false or UXR(s)==false)then
if i==1 then
set id='A1I8'
if UnitRemoveAbility(s,'A1I9')then
call UnitRemoveAbility(s,'B0C9')
endif
if UnitRemoveAbility(s,'A1IA')then
call UnitRemoveAbility(s,'B0C9')
endif
elseif i==2 then
set id='A1I9'
if UnitRemoveAbility(s,'A1IA')then
call UnitRemoveAbility(s,'B0C9')
endif
if UnitRemoveAbility(s,'A1I8')then
call UnitRemoveAbility(s,'B0C9')
endif
else
set id='A1IA'
if UnitRemoveAbility(s,'A1I8')then
call UnitRemoveAbility(s,'B0C9')
endif
if UnitRemoveAbility(s,'A1I9')then
call UnitRemoveAbility(s,'B0C9')
endif
endif
call UnitAddAbility(s,'A1I7')
call UnitMakeAbilityPermanent(s,true,'A1I7')
call UnitAddAbility(s,id)
call UnitMakeAbilityPermanent(s,true,id)
set r=GetUnitState(s,UNIT_STATE_MAX_LIFE)*(.01+.01*i)*.3
call HGV(s,true,r)
else
call UnitRemoveAbility(s,'A1I9')
call UnitRemoveAbility(s,'A1IA')
call UnitRemoveAbility(s,'A1I8')
call UnitRemoveAbility(s,'A1I7')
call UnitRemoveAbility(s,'B0C9')
endif
endif
set p=null
set t=null
set s=null
endfunction
