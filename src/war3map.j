loop
set f=FirstOfGroup(g)
exitwhen f==null
call HPV(s,f,1,d)
call GroupRemoveUnit(g,f)
endloop
set a=GetUnitFacing(s)*bj_DEGTORAD
set x=GetUnitX(s)+Cos(a)*325
set y=GetUnitY(s)+Sin(a)*325
set a=(GetUnitFacing(s)-90)*bj_DEGTORAD
set x=x+Cos(a)*$FA
set y=y+Sin(a)*$FA
if IVV then
call DestroyEffect(AddSpecialEffect("ShadowRazeTarget.mdx",x,y))
call GroupEnumUnitsInRange(g,x,y,275,Condition(function PJV))
loop
set f=FirstOfGroup(g)
exitwhen f==null
call HPV(s,f,1,d)
call GroupRemoveUnit(g,f)
endloop
set a=GetUnitFacing(s)*bj_DEGTORAD
set x=GetUnitX(s)+Cos(a)*325
set y=GetUnitY(s)+Sin(a)*325
set a=(GetUnitFacing(s)+90)*bj_DEGTORAD
set x=x+Cos(a)*$FA
set y=y+Sin(a)*$FA
call DestroyEffect(AddSpecialEffect("ShadowRazeTarget.mdx",x,y))
