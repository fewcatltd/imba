function RMO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local unit m5
local integer NAE=GetTriggerEvalCount(t)
local integer RPO
local integer JFV
local real l4
local timer tm=null
if GetTriggerEventId()==EVENT_UNIT_DEATH or NAE==$C8 then
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF)
set m5=Y7(K3V,"Target")
call UnitShareVision(m5,GetOwningPlayer(p5),false)
call UnitRemoveAbility(p5,'A179')
call a7(K3V)
call KJV(t)
else
if NAE<'d' then
set RPO=NAE
else
set RPO=$C8-NAE
endif
call SetUnitVertexColor(p5,$FF,$FF,$FF,$FF*('d'-RPO)/ 'd')
if NAE=='d' then
set m5=Y7(K3V,"Target")
set JFV=E8(K3V,"Level")
set l4=Atan2(GetUnitY(m5)-GetUnitY(p5),GetUnitX(m5)-GetUnitX(p5))
call SetUnitPosition(p5,GetUnitX(m5)+80*Cos(l4),GetUnitY(m5)+80*Sin(l4))
call SetUnitAnimation(p5,"attack")
call IssueTargetOrderById(p5,$D000F,m5)
call HPV(p5,m5,1,'d'*JFV)
call RKO(p5,m5)
if IsUnitType(p5,UNIT_TYPE_HERO)or DZV(p5,'link')then
set tm=CreateTimer()
call DFV(tm,'Sour',p5)
call DFV(tm,'Targ',m5)
call DPV(tm,'Levl',JFV)
if IVV then
call DPV(tm,'Loop',2)
else
call DPV(tm,'Loop',0)
endif
call TimerStart(tm,1.35,true,function RLO)
set tm=null
endif
endif
endif
set t=null
set p5=null
set m5=null
return false
endfunction
