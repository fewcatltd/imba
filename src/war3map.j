call GroupAddUnit(g,m5)
set B0=QJV
loop
set f=FirstOfGroup(g)
exitwhen f==null
call QHV(null,f,2)
call HPV(xL,f,1,25+75*JFV)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\StormBolt\\StormBoltMissile.mdl",f,"origin"))
call GroupRemoveUnit(g,f)
