else
if OVR!=0 and OER!=0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),OVR,false)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),OER,false)
set OVR=OER
set OER=aN[X9R]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),OVR,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),OER,true)
elseif OVR==0 and OER!=0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),OER,false)
set OVR=OER
set OER=aN[X9R]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),OVR,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),OER,true)
else
set OER=aN[X9R]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),OER,true)
endif
endif
call n7(K3V,"Invoker|Current1",OVR)
call n7(K3V,"Invoker|Current2",OER)
call X7R(hn)
set hn=null
endfunction
