function QSV takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit s=DHV(tm,'s')
local unit u=DHV(tm,'u')
local group g=DKV(tm,'g')
local integer l=DTV(tm,'i')
local real d=DWV(tm,'d')
local group g1=CreateGroup()
local boolexpr b=Condition(function PJV)
local unit f=null
set AUV=s
call GroupAddUnit(g,u)
call GroupEnumUnitsInRange(g1,GetUnitX(u),GetUnitY(u),500,b)
call GroupRemoveGroup(g,g1)
set f=GroupPickRandomUnit(g1)
if f!=null then
set l=l-1
call H0V(u,f,.4,"CLSB",false)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",f,"origin"))
call HPV(s,f,1,d)
call DFV(tm,'u',f)
else
set l=1
endif
call DestroyGroup(g1)
call DestroyBoolExpr(b)
if l==1 then
call DestroyGroup(g)
call FIV()
endif
set g=null
set b=null
set tm=null
set s=null
set u=null
endfunction
function QTV takes unit s,unit u,integer i,real d returns nothing
local timer tm=CreateTimer()
call H0V(u,s,.4,"CLPB",false)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",u,"origin"))
call HPV(s,u,1,d)
call DFV(tm,'s',s)
call DFV(tm,'u',u)
call DJV(tm,'g',CreateGroup())
call DPV(tm,'i',i)
call DUV(tm,'d',d)
call TimerStart(tm,.35,true,function QSV)
set tm=null
endfunction
function QUV takes unit s,unit u,real r returns nothing
local trigger t=null
local unit f=null
call UnitDamageTarget(s,u,r,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
endfunction
function QWV takes nothing returns nothing
set RKV=GetEventDamage()
call GDV()
endfunction
function QYV takes unit u returns real
local real QZV=0
local real r=0
local integer i=1
local trigger t=CreateTrigger()
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function QWV))
set t=null
set QZV=GetWidgetLife(u)
if QZV<'d' then
call SetUnitState(u,UNIT_STATE_LIFE,'e')
endif
set r=GetWidgetLife(u)
set ONV=true
call HPV(u,u,2,$A)
set ONV=false
set XBV=RKV/$A
if RKV<=$A then
set r=RKV/$A
set r=(50-50*r)/(3*r)
else
set r=(RKV-$A)/$A
loop
exitwhen 1-Pow(.94,i)>r
