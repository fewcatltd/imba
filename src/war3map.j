function GKR takes integer K3V,real x,real y,boolean GHR,player p returns nothing
local unit F3R=Y7(K3V,"Cog1")
local unit F4R=Y7(K3V,"Cog2")
local unit F5R=Y7(K3V,"Cog3")
local unit F6R=Y7(K3V,"Cog4")
local unit F7R=Y7(K3V,"Cog5")
local unit F8R=Y7(K3V,"Cog6")
local unit F9R=Y7(K3V,"Cog7")
local unit GVR=Y7(K3V,"Cog8")
local trigger t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.1,false)
call TriggerAddCondition(t,Condition(function GGR))
call E7(GetHandleId(t),"x",x)
call E7(GetHandleId(t),"y",y)
call D7(GetHandleId(t),"p",p)
call O7(GetHandleId(t),"NeedFix",GHR)
call GJR(F3R)
call RemoveUnit(F3R)
call GJR(F4R)
call RemoveUnit(F4R)
call GJR(F5R)
call RemoveUnit(F5R)
call GJR(F6R)
call RemoveUnit(F6R)
call GJR(F7R)
call RemoveUnit(F7R)
call GJR(F8R)
call RemoveUnit(F8R)
call GJR(F9R)
call RemoveUnit(F9R)
call GJR(GVR)
call RemoveUnit(GVR)
set F3R=null
set F4R=null
set F5R=null
set F6R=null
set F7R=null
set F8R=null
set F9R=null
set GVR=null
endfunction
function GLR takes unit GNR,integer K3V,integer GMR,player p returns nothing
if IsUnitVisible(GNR,p)then
call O7(K3V,"NeedFix",true)
endif
call A7(K3V,"Cog"+I2S(GMR),GNR)
endfunction
function GPR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local real Hk=X8(K3V,"Duration")
local integer XOO=GetTriggerEvalCount(t)
if XOO>R2I(Hk*$A)then
call GKR(K3V,X8(K3V,"x"),X8(K3V,"y"),O8(K3V,"NeedFix"),v8(K3V,"Enemy"))
call a7(K3V)
call KJV(t)
else
call GDR(t,Y7(K3V,"Hero"),X8(K3V,"x"),X8(K3V,"y"),X8(K3V,"d"),E8(K3V,"Level"))
endif
set t=null
return false
endfunction
function GQR takes nothing returns nothing
call SetUnitPosition(GetEnumUnit(),GetUnitX(xL),GetUnitY(xL))
endfunction
function GSR takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
