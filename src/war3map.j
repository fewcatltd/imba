function AQR takes nothing returns nothing
local group g
local unit SFV=GetTriggerUnit()
local player p=GetOwningPlayer(SFV)
if(C8(p)and Th==false)or(C8(p)==false and Uh==false)then
set g=KHV()
set Sh=p
call GroupEnumUnitsInRange(g,0,0,$2EE0,Condition(function ALR))
call ForGroup(g,function AMR)
call KGV(g)
if C8(p)then
set Th=true
call APR(SFV,p)
set Th=false
else
set Uh=true
call APR(SFV,p)
set Uh=false
endif
endif
set g=null
set SFV=null
set p=null
endfunction
function ASR takes nothing returns nothing
