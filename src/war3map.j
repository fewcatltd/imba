call G7V(hn,-DTV(hn,'!Wex'))
set i=2*VQR*X3R
call G7V(hn,i)
call DPV(hn,'!Wex',i)
call HVV(hn,-DWV(hn,'!wex'))
set r=GEV(hn)*.01*VQR*X3R
call HVV(hn,r)
call DUV(hn,'!wex',r)
call G6V(hn,-DTV(hn,'Exor'))
set i=3*X5R*VSR
call G6V(hn,i)
call DPV(hn,'Exor',i)
call HEV(hn)
endfunction
