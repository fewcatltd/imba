function NNO takes unit p5,real HSV returns nothing
local integer JFV=0
local real NBO='n'
if HSV>NBO*6 then
set JFV=6
elseif HSV>NBO*5 then
set JFV=5
elseif HSV>NBO*4 then
set JFV=4
elseif HSV>NBO*3 then
set JFV=3
elseif HSV>NBO*2 then
set JFV=2
elseif HSV>NBO*1 then
set JFV=1
endif
set JFV=L9V(JFV,2+GetUnitAbilityLevel(p5,'A1NA'))
call n7(GetHandleId(p5),"Level",JFV)
call NAO(p5,JFV)
endfunction
function NCO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local integer JFV=GetUnitAbilityLevel(p5,'A1NA')
call NXO(p5,E8(GetHandleId(p5),"Level"),JFV)
call NNO(p5,X8(GetHandleId(p5),"RecentDamage"))
set t=null
set p5=null
return false
endfunction
function NDO takes nothing returns nothing
local integer K3V=GetHandleId(GetTriggeringTrigger())
local unit p5=xL
local unit m5=oL
local real HSV=X8(K3V,"Damage")
if IsUnitAlly(m5,GetOwningPlayer(p5))==false then
set f3=true
call HPV(p5,m5,1,HSV)
set f3=false
else
call SetUnitState(m5,UNIT_STATE_LIFE,GetUnitState(m5,UNIT_STATE_LIFE)+HSV)
endif
set p5=null
set m5=null
endfunction
function NFO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
call NNO(p5,X8(GetHandleId(p5),"RecentDamage"))
call a7(K3V)
call KJV(t)
set t=null
set p5=null
return false
endfunction
function NGO takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer JFV=E8(GetHandleId(p5),"Level")
local trigger t=MZV(p5,m5,'h0BE',"NDO",$3E8)
local integer K3V=GetHandleId(t)
call E7(K3V,"Damage",(20+JFV*60+H4V(p5,1))*1.)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AntiMagicShell\\AntiMagicShell.mdl",p5,"chest"))
call E7(GetHandleId(p5),"RecentDamage",0*1.)
call NNO(p5,0)
call K5V(p5,"SoulAssumptionState",4)
set t=CreateTrigger()
set K3V=GetHandleId(t)
call TriggerAddCondition(t,Condition(function NFO))
call TriggerRegisterTimerEvent(t,4,false)
call A7(K3V,"Source",p5)
set p5=null
set m5=null
set t=null
endfunction
function NHO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local unit p5=Y7(K3V,"Source")
local real HSV=X8(K3V,"Damage")
if GetTriggerEventId()!=EVENT_UNIT_SPELL_EFFECT or(GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and GetSpellAbilityId()=='A1NA')then
if GetTriggerEventId()!=EVENT_UNIT_SPELL_EFFECT then
call E7(GetHandleId(p5),"RecentDamage",(X8(GetHandleId(p5),"RecentDamage")-HSV)*1.)
endif
call NNO(p5,X8(GetHandleId(p5),"RecentDamage"))
call a7(K3V)
call KJV(t)
endif
set t=null
set p5=null
return false
endfunction
function P6v takes nothing returns nothing
local unit p5=GetTriggerUnit()
local integer K3V=GetHandleId(p5)
local texttag tt=CreateTextTag()
local boolean NIO=false
local trigger t=CreateTrigger()
if GetLearnedSkill()==0 then
set p5=AOV
endif
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerAddCondition(t,Condition(function NCO))
call A7(GetHandleId(t),"Source",p5)
if GetOwningPlayer(p5)==GetLocalPlayer()then
set NIO=true
endif
call SetTextTagText(tt," ",.023)
call SetTextTagPosUnit(tt,p5,0)
call SetTextTagVisibility(tt,NIO)
call SetTextTagPermanent(tt,true)
set D3[GetPlayerId(GetOwningPlayer(p5))]=p5
call E7(K3V,"RecentDamage",0*1.)
call NNO(p5,0)
call M7(K3V,"SoulAssumption|Text",tt)
set p5=null
set t=null
set tt=null
endfunction
function NJO takes unit NKO,unit NLO returns nothing
local real HSV=GetEventDamage()
local integer JFV=GetUnitAbilityLevel(NKO,'A1NA')
local real NMO=X8(GetHandleId(NKO),"RecentDamage")
local trigger t
local integer K3V
local integer i=6
if H3V(NKO)then
set i=$E10
endif
if M5(NKO,NLO)<$578 and f3==false then
if SKV(HSV)and GetEventDamage()>2 and GetEventDamageSource()!=GetTriggerUnit()and(H7V(GetOwningPlayer(GetEventDamageSource()))or GetUnitTypeId(GetEventDamageSource())=='n00L')then
set NMO=NMO+HSV
call E7(GetHandleId(NKO),"RecentDamage",NMO*1.)
set t=CreateTrigger()
set K3V=GetHandleId(t)
call A7(K3V,"Source",NKO)
call E7(K3V,"Damage",HSV*1.)
call TriggerRegisterTimerEvent(t,i,false)
call TriggerRegisterUnitEvent(t,NKO,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,NKO,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function NHO))
call NNO(NKO,NMO)
endif
endif
set t=null
endfunction
