if GetTriggerEventId()==EVENT_UNIT_DEATH or ITV-DWV(t,'t')>0 or IsUnitVisible(u,GetOwningPlayer(s))==false then
call DestroyLightning(D0V(t,'l'))
call GDV()
elseif GetTriggerEvalCount(t)==1 and IsUnitIllusion(s)==false then
call D_V(t,'l',HZV(AddLightning("DRAB",false,0,0,0,0),s,u))
call IssueImmediateOrderById(s,$D0004)
call HPV(s,u,1,2*i)
call HGV(s,true,2*i)
else
call HZV(D0V(t,'l'),s,u)
call HPV(s,u,1,2*i)
call HGV(s,true,2*i)
endif
set t=null
set s=null
set u=null
