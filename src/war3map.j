set UP=GetPlayerId(pl)
if((ie[UP]!=null)and(A5(ie[UP]))and(i0(ie[UP])))then
call J1(ie[UP],true)
set hq[528+UP]=Bz+30.
call A7(tz,"OB|g_mbScoreboard",ie[UP])
call ExecuteFunc("YDO")
if(eY[UP]>=9)then
set eY[UP]=1
endif
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,R[UP]+GetPlayerName(pl)+"|r is now going back to base")
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,R[UP]+GetPlayerName(pl)+"|r |cffffcc00cannot go back to base|r")
endif
endif
exitwhen kg<0
endloop
elseif((SubString(VH,0,1)=="a")and(VH!="auto"))then
set VH=SubString(VH,1,StringLength(VH))
loop
call TriggerSleepAction(.0)
set kg=kh(VH)
if(kg>=0)then
set pl=i3(S2I(SubString(VH,0,kg)))
