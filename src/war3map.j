function VWO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer K3V=GetHandleId(t)
local integer VQO=E8(K3V,"LinkNumber")
local integer JFV=E8(K3V,"Level")
local real l4=X8(K3V,"Angle")
local unit K8V=Y7(K3V,"Hero")
local trigger VYO=x8(K3V,"RetractTrigger")
local integer VZO=GetHandleId(VYO)
local group g
local unit u
local real x
local real y
local integer i=$A+5*JFV
local boolexpr b=Condition(function VUO)
local boolean l=false
if IVV then
if EMV then
set i=i*3
else
set i=i*4
endif
else
set i=i
endif
set AUV=K8V
if VQO<i then
set VQO=VQO+1
call n7(K3V,"LinkNumber",VQO)
set x=GetUnitX(K8V)+VQO*40*Cos(l4*bj_DEGTORAD)
set y=GetUnitY(K8V)+VQO*40*Sin(l4*bj_DEGTORAD)
call A7(VZO,"Link"+I2S(VQO),CreateUnit(GetOwningPlayer(K8V),'u00H',x,y,l4))
set g=KHV()
call GroupEnumUnitsInRange(g,x,y,'}',b)
call DestroyBoolExpr(b)
set b=null
call GroupRemoveUnit(g,K8V)
set u=GroupPickRandomUnit(g)
call KGV(g)
if u!=null then
call a7(K3V)
call KJV(t)
call TriggerRegisterTimerEvent(VYO,.03,true)
call TriggerAddCondition(VYO,Condition(function VPO))
call n7(VZO,"LinkNumber",VQO)
call O7(VZO,"FoundTarget",true)
call A7(VZO,"Target",u)
call DFV(VYO,'s',K8V)
call DUV(VYO,'d',20)
if IsUnitEnemy(u,GetOwningPlayer(K8V))then
if IsUnitType(u,UNIT_TYPE_HERO) then
set Tz[GetPlayerId(GetOwningPlayer(K8V))]=Tz[GetPlayerId(GetOwningPlayer(K8V))]+1
endif
set wz[GetPlayerId(GetOwningPlayer(K8V))]=wz[GetPlayerId(GetOwningPlayer(K8V))]+1
call VMO(K8V,u)
if GetUnitTypeId(u)!='n00L' then
call HPV(K8V,u,2,'d'*JFV)
endif
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",u,"origin"))
endif
endif
else
call a7(K3V)
call KJV(t)
set wz[GetPlayerId(GetOwningPlayer(K8V))]=wz[GetPlayerId(GetOwningPlayer(K8V))]+1
call TriggerRegisterTimerEvent(VYO,.03,true)
call TriggerAddCondition(VYO,Condition(function VPO))
call n7(VZO,"LinkNumber",VQO)
call O7(VZO,"FoundTarget",false)
endif
set t=null
set K8V=null
set VYO=null
set g=null
set u=null
return false
endfunction
