function PZR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit NER=Y7(GetHandleId(t),"FormlessUnit")
local integer P_R=E8(GetHandleId(t),"EME")
call IssueImmediateOrderById(NER,$D00D2)
if P_R=='A504' then
call PJR(NER)
call PPR(NER)
call PTR(NER)
call PWR(NER)
elseif P_R=='A505' then
call PJR(NER)
elseif P_R=='A506' then
call PPR(NER)
elseif P_R=='A507' then
call PTR(NER)
elseif P_R=='A508' then
call PWR(NER)
endif
call DestroyTimer(t)
set NER=null
set t=null
endfunction
function P0R takes unit NER,integer P_R returns nothing
local integer PKR=GetPlayerId(GetOwningPlayer(NER))
