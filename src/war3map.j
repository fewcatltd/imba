function APX takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer i=GetUnitAbilityLevel(u,'A0FV')
local real r=GEV(u)*.03+.02*i+C0V(i==3)*.01
local integer k=$A*i
if GetUnitAbilityLevel(u,'AB17')>0 then
set r=GEV(u)*.01*i+DWV(u,'ab17')
set k=4*i+DTV(u,'AB17')
endif
call DUV(u,'ab17',r)
call DPV(u,'AB17',k)
