call E7(K3V,"IcePathX",GetUnitX(K8V))
call E7(K3V,"IcePathY",GetUnitY(K8V))
call E7(K3V,"IcePathAngle",AngleBetweenPoints(TH,sy))
call n7(K3V,"IcePath|Counter",0)
call RemoveLocation(TH)
call RemoveLocation(sy)
call TimerStart(t,.05,true,function Tg)
set t=null
set K8V=null
set sy=null
set TH=null
endfunction
function UIV takes nothing returns nothing
local trigger t=CreateTrigger()
