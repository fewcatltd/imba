if GetLocalPlayer()==GetTriggerPlayer()then
if s=="-music off" then
call StopMusic(false)
elseif s=="-music random" then
call U4E(Gb[JIV])
elseif s=="-music nightelf1" then
call U4E(fI)
elseif s=="-music nightelf2" then
call U4E(gI)
elseif s=="-music nightelf3" then
call U4E(GI)
elseif s=="-music human1" then
call U4E(JI)
elseif s=="-music human2" then
call U4E(lI)
elseif s=="-music human3" then
call U4E(LI)
elseif s=="-music orc1" then
call U4E(CI)
elseif s=="-music orc2" then
call U4E(dI)
elseif s=="-music orc3" then
call U4E(DI)
elseif s=="-music undead1" then
call U4E(cI)
elseif s=="-music undead2" then
call U4E(bI)
elseif s=="-music undead3" then
call U4E(BI)
elseif s=="-music other1" then
call U4E(pI)
elseif s=="-music other2" then
call U4E(PI)
elseif s=="-music other3" then
call U4E(UI)
elseif s=="-music other4" then
call U4E(SI)
elseif s=="-music other5" then
call U4E(TI)
elseif s=="-music special" then
call U4E(wI)
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,$A,(GetObjectName(('n0CW')))+" ")
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,Qx,$A,"off, random, nightelf1, nightelf2, nightelf3, human1, human2, human3, orc1, orc2, orc3, undead1, undead2, undead3, other1, other2, other3, other4, other5, special")
endif
