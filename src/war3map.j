function XPX takes nothing returns nothing
if IRV or IIV or O1V then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$F,GetObjectName('Aroc'))
call TimerStart(CreateTimer(),.05,true,function E3X)
endif
endfunction
function ZXE takes nothing returns nothing
call TimerStart(CreateTimer(),.5,false,function XPX)
endfunction
function XQX takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
if GetTriggerEventId()==EVENT_UNIT_DEATH or J_V()-DWV(t,0)>5 then
call G6V(u,-$96)
call DYV(u,'DKSW',false)
call GDV()
else
call HPV(s,u,5,GetUnitState(u,UNIT_STATE_MAX_LIFE)*.15*.5)
endif
set t=null
set s=null
set u=null
endfunction
function XSX takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit s=DHV(t,'s')
local unit u=DHV(t,'u')
local group g=null
local boolexpr b=null
if GetTriggerEventId()==EVENT_UNIT_DEATH or J_V()-DWV(t,0)>0 then
call DestroyEffect(D2V(t,'e'))
call GDV()
else
call HPV(s,u,1,700*.5)
call DPV(u,'BS21',0)
set AUV=s
set g=CreateGroup()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),375,b)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call HPV(s,u,1,$96)
call DPV(u,'BS21',0)
call GroupRemoveUnit(g,u)
endloop
call DestroyGroup(g)
call DestroyBoolExpr(b)
set g=null
set b=null
endif
set t=null
set s=null
set u=null
endfunction
function XTX takes nothing returns nothing
local timer tm=GetExpiredTimer()
local unit u=DHV(tm,'u')
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer i=0
call CPV(u,false)
call IssueImmediateOrderById(u,$D0004)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",x,y))
loop
exitwhen i>8
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",x+Cos(bj_PI/4.5*i)*$FA,y+Sin(bj_PI/4.5*i)*$FA))
set i=i+1
endloop
call Q_V(u,x,y,600,GetRandomInt(5525,7475),1)
call FIV()
set tm=null
set u=null
endfunction
function XUX takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit u=DHV(t,'u')
local unit k=DHV(t,'Targ')
local integer i=0
local integer l=0
local real d=0
local real r=0
local unit s=null
local unit f=null
local group g=null
local boolexpr b=null
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(k)
local real y1=GetUnitY(k)
local real x2=0
local real y2=0
local real a=0
local timer tm=null
local trigger t2=null
local real XWX=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real p=GetUnitLifePercent(u)
local group g2=null
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set d=GetEventDamage()
if d<1 then
call HWV(u,0)
set u=null
set k=null
set t=null
return
endif
if DZV(t,'stat')==false then
set I6V=0
call DYV(t,'stat',true)
endif
set i=GetPlayerId(GetOwningPlayer(GetEventDamageSource()))
call DSV(u,i,d)
if k==null then
call DFV(t,'Targ',ie[i])
call IssueTargetOrderById(u,$D000F,ie[i])
else
set i=1
loop
exitwhen ie[i]!=null and IsUnitType(ie[i],UNIT_TYPE_DEAD)==false and DWV(u,i)>0 and IsUnitHidden(ie[i])==false
set i=i+1
endloop
set l=i
set i=l+1
loop
exitwhen i>$B
if DWV(u,l)<DWV(u,i)and ie[i]!=null and IsUnitType(ie[i],UNIT_TYPE_DEAD)==false and i!=6 and IsUnitHidden(u)==false then
set l=i
endif
set i=i+1
endloop
if k!=ie[l]then
call DFV(t,'Targ',ie[l])
call IssueTargetOrderById(u,$D000F,ie[l])
endif
endif
elseif GetTriggerEventId()==EVENT_UNIT_DEATH then
call PauseTimer(ISV)
set x2=I6V/60
set i=R2I(x2)
set y2=I6V-i*60
call ExecuteFunc("XYX")
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$E10," ")
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$E10,GetObjectName('Amls')+"|cffffff00"+I2S(i)+"|r"+GetObjectName('AHta')+"|cffffff00"+R2S(y2)+"|r"+GetObjectName('Acmg'))
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,$E10," ")
call GDV()
else
if DZV(t,'stat')==false or IsUnitPaused(u)then
set u=null
set k=null
set t=null
return
endif
if J_V()-DWV(t,'time')>1.9-1.5*C0V(p<$A)then
call DUV(t,'time',J_V())
call CCV(u,false,true)
endif
set AUV=u
set g=CreateGroup()
set i=1
loop
exitwhen i>$B
if DWV(u,i)>1 and i!=6 and IsUnitType(ie[i],UNIT_TYPE_DEAD)==false and ie[i]!=null and IsUnitHidden(ie[i])==false and DDV(ie[i],-500,-700)>$7D0 then
set x2=GetUnitX(ie[i])
set y2=GetUnitY(ie[i])
set a=Atan2(y2+700,x2+500)
set x2=-500+Cos(a)*$76C
set y2=-700+Sin(a)*$76C
call MMV(x2,y2,$DC)
call SetUnitPosition(ie[i],x2,y2)
endif
set i=i+1
endloop
if DDV(u,-500,-700)>$7D0 then
call SetUnitPosition(u,-500,-700)
endif
set i=1
loop
exitwhen(ie[i]!=null and IsUnitType(ie[i],UNIT_TYPE_DEAD)==false and DWV(u,i)>0 and IsUnitHidden(ie[i])==false)or i>$B
set i=i+1
endloop
set l=i
set i=l+1
loop
exitwhen i>$B
if DWV(u,l)<DWV(u,i)and ie[i]!=null and IsUnitType(ie[i],UNIT_TYPE_DEAD)==false and i!=6 and IsUnitHidden(ie[i])==false then
set l=i
endif
set i=i+1
endloop
set k=ie[l]
if k!=null and DWV(u,l)>1 then
call IssueTargetOrderById(u,$D000F,k)
endif
set b=Condition(function PQV)
call GroupEnumUnitsInRange(g,-500,-700,$4E20,b)
call DestroyBoolExpr(b)
set b=null
if FirstOfGroup(g)==null then
call SetUnitPosition(u,-500,-700)
call HGV(u,true,$5F5E0FF)
call DYV(t,'stat',false)
call CPV(u,false)
call SetUnitFlyHeight(u,GetUnitDefaultFlyHeight(u),0)
call UnitRemoveAbility(u,'Avul')
call SetUnitInvulnerable(u,false)
call UnitResetCooldown(u)
set t=null
set u=null
set k=null
return
endif
if p>85 then
call DPV(u,'DBGH',1)
set i=GetRandomInt(0,99)
if i<2 then
if J_V()-DWV(t,'chao')>25 then
call DUV(t,'chao',J_V())
call HPV(u,k,1,GetRandomInt($D19,4947))
call DUV(u,GetPlayerId(GetOwningPlayer(k)),0)
call DPV(u,'BS20',0)
call DestroyEffect(AddSpecialEffect("newdarkpillar.mdx",GetUnitX(u),GetUnitY(u)))
endif
elseif i<7 then
if J_V()-DWV(t,'dark')>5 then
set k=GroupPickRandomUnit(g)
if k!=null then
call DUV(t,'dark',J_V())
set t2=CreateTrigger()
call TriggerRegisterUnitEvent(t2,k,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t2,.5,true)
call TriggerAddCondition(t2,Condition(function XQX))
call DFV(t2,'s',u)
call DFV(t2,'u',k)
call DUV(t2,0,J_V())
call G6V(k,$96)
call DYV(k,'DKSW',true)
set t2=null
endif
endif
elseif i<$A then
if J_V()-DWV(t,'dkxx')>27 then
call DUV(t,'dkxx',J_V())
set f=CreateUnit(GetOwningPlayer(u),'h0B2',x,y,0)
call UnitApplyTimedLife(f,'BTLF',1)
call SetUnitScale(f,5,5,5)
set f=CreateUnit(GetOwningPlayer(u),'h0B2',x,y,0)
call UnitApplyTimedLife(f,'BTLF',1)
call SetUnitScale(f,5,5,5)
set f=CreateUnit(GetOwningPlayer(u),'h0B2',x,y,0)
call UnitApplyTimedLife(f,'BTLF',1)
call SetUnitScale(f,5,5,5)
set f=null
set g2=CreateGroup()
set b=Condition(function PJV)
call GroupEnumUnitsInRange(g2,x,y,$4B0,b)
loop
set f=FirstOfGroup(g2)
exitwhen f==null
call HPV(u,f,1,GetRandomInt($9EA,$AE8))
call DPV(f,'BS20',0)
call GroupRemoveUnit(g2,f)
endloop
call DestroyGroup(g2)
call DestroyBoolExpr(b)
set g2=null
set b=null
endif
elseif i<$C then
if J_V()-DWV(t,'dkyx')>25 then
call DUV(t,'dkyx',J_V())
set i=4
loop
exitwhen i==0
set IUV=CreateUnit(GetOwningPlayer(u),'e00E',GetUnitX(u),GetUnitY(u),0)
call UnitAddAbility(IUV,'A968')
call UnitApplyTimedLife(IUV,'BTLF',1)
call IssueTargetOrderById(IUV,$D0132,u)
set k=GroupPickRandomUnit(g)
call UnitAddAbility(IWV,'Aloc')
call UnitApplyTimedLife(IWV,'BTLF',$A)
call SetUnitPosition(IWV,GetUnitX(k),GetUnitY(k))
call IssueTargetOrderById(IWV,$D000F,k)
set i=i-1
endloop
endif
